{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "useTabs": false,
  "tabWidth": 2,
  "printWidth": 120,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "quoteProps": "as-needed",
  "trailingComma": "all",
  "semi": false,
  "arrowParens": "always",
  "bracketSameLine": false,
  "bracketSpacing": true,
  "sortImports": false,
  "ignorePatterns": [
    "apps/**/*.open-api.json",
    "apps/**/*.astro",
    "apps/**/dist",
    "**/*.md",
    "**/*.mdx",
    "**/*.css",
    "**/*.html",
    ".claude/**",
    ".vscode/**"
  ]
}
