{
  "name": "planetnik",
  "private": true,
  "packageManager": "bun@1.4.2",
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "effect": "4.0.6",
      "@effect/platform-node": "4.0.6",
      "@effect/platform-browser": "4.0.6",
      "@effect/atom-react": "4.0.6",
      "fast-check": "^4.10.2",
      "simple-git": "^4.0.2"
    }
  },
  "scripts": {
    "dev:site": "bun run --cwd apps/site dev",
    "dev:cli": "bun run --cwd apps/cli dev",
    "dev:app": "bun run --cwd apps/app dev",
    "dev:runtime": "bun run --cwd apps/runtime dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "bun x biome check .",
    "lint:fix": "bun x biome check --write .",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@emnapi/runtime": "^1.11.3",
    "@biomejs/biome": "^2.6.2",
    "@effect/language-service": "^0.87.5",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "typescript": "^6.0.3"
  }
}
