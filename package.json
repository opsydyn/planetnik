{
  "name": "planetnik",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/*",
      "apps/*"
    ],
    "catalog": {
      "fast-check": "^4.10.2",
      "simple-git": "^4.0.2"
    },
    "catalogs": {
      "effect": {
        "effect": "4.1.3",
        "@effect/atom-react": "4.1.3",
        "@effect/language-service": "^0.87.5",
        "@effect/platform-browser": "4.1.3",
        "@effect/platform-node": "4.1.3"
      }
    }
  },
  "scripts": {
    "dev:site": "bun run --cwd apps/site dev",
    "dev:cli": "bun run --cwd apps/cli dev",
    "dev:app": "bun run --cwd apps/app dev",
    "dev:runtime": "bun run --cwd apps/runtime dev",
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "typecheck": "bun run --filter '*' typecheck",
    "lint": "NODE_OPTIONS=\"--experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON\" oxlint . && oxfmt --check .",
    "lint:fix": "oxfmt . && NODE_OPTIONS=\"--experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON\" oxlint --fix .",
    "knip": "knip --treat-config-hints-as-errors"
  },
  "devDependencies": {
    "@effect/language-service": "catalog:effect",
    "@emnapi/runtime": "^1.11.3",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "knip": "^6.43.0",
    "oxfmt": "0.78.0",
    "oxlint": "1.93.0",
    "typescript": "^6.0.3"
  },
  "packageManager": "bun@1.4.2"
}
