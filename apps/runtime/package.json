{
  "name": "@planetnik/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@copilotkit/runtime": "^1.79.1",
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/openapi": "^1.4.16",
    "@neondatabase/serverless": "^1.2.0",
    "@sinclair/typebox": "^0.34.52",
    "better-auth": "^1.7.12",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "effect": "catalog:",
    "elysia": "^1.4.30",
    "openai": "^7.43.0"
  },
  "devDependencies": {
    "@opsydyn/elysia-spectral": "^1.5.4",
    "@types/bun": "^1.4.4",
    "drizzle-kit": "^0.31.11",
    "pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
