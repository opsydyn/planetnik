{
  "openapi": "3.0.3",
  "info": {
    "title": "Planetnik Runtime API",
    "description": "Authenticated runtime APIs for the hosted Planetnik application.",
    "version": "0.1.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Runtime health check",
        "tags": [
          "Health"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "required": [
                    "status",
                    "service",
                    "nodeEnv"
                  ],
                  "properties": {
                    "status": {
                      "type": "string",
                      "enum": [
                        "ok"
                      ]
                    },
                    "service": {
                      "type": "string",
                      "enum": [
                        "planetnik-runtime"
                      ]
                    },
                    "nodeEnv": {
                      "type": "string",
                      "enum": [
                        "development",
                        "test",
                        "production"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "getHealth"
      }
    },
    "/api/me": {
      "get": {
        "summary": "Authenticated user and session summary",
        "tags": [
          "Auth",
          "Users"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "required": [
                    "user",
                    "session"
                  ],
                  "properties": {
                    "user": {
                      "type": "object",
                      "required": [
                        "id",
                        "email",
                        "name",
                        "image",
                        "emailVerified",
                        "role"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "email": {
                          "type": "string"
                        },
                        "name": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "image": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        },
                        "emailVerified": {
                          "type": "boolean"
                        },
                        "role": {
                          "anyOf": [
                            {
                              "type": "string"
                            },
                            {
                              "type": "null"
                            }
                          ]
                        }
                      },
                      "additionalProperties": false
                    },
                    "session": {
                      "type": "object",
                      "required": [
                        "id",
                        "userId",
                        "expiresAt"
                      ],
                      "properties": {
                        "id": {
                          "type": "string"
                        },
                        "userId": {
                          "type": "string"
                        },
                        "expiresAt": {
                          "type": "string"
                        }
                      },
                      "additionalProperties": false
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Response for status 401",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "getApiMe"
      }
    },
    "/api/workspaces": {
      "get": {
        "summary": "List workspaces for the authenticated user",
        "tags": [
          "Workspaces"
        ],
        "responses": {
          "200": {
            "description": "Response for status 200",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "required": [
                    "workspaces"
                  ],
                  "properties": {
                    "workspaces": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "required": [
                          "id",
                          "slug",
                          "name",
                          "ownerUserId",
                          "createdAt",
                          "updatedAt"
                        ],
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          },
                          "name": {
                            "type": "string"
                          },
                          "ownerUserId": {
                            "type": "string"
                          },
                          "createdAt": {
                            "type": "string"
                          },
                          "updatedAt": {
                            "type": "string"
                          }
                        },
                        "additionalProperties": false
                      }
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          },
          "401": {
            "description": "Response for status 401",
            "content": {
              "application/json": {
                "schema": {
                  "$schema": "http://json-schema.org/draft-07/schema#",
                  "type": "object",
                  "required": [
                    "error"
                  ],
                  "properties": {
                    "error": {
                      "type": "string",
                      "enum": [
                        "unauthorized"
                      ]
                    }
                  },
                  "additionalProperties": false
                }
              }
            }
          }
        },
        "operationId": "getApiWorkspaces"
      }
    },
    "/api/reports": {
      "get": {
        "operationId": "getApiReports"
      },
      "post": {
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "datasetName": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "analysisRoot": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                }
              }
            },
            "application/x-www-form-urlencoded": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "datasetName": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "analysisRoot": {
                    "minLength": 1,
                    "maxLength": 4096,
                    "type": "string"
                  }
                }
              }
            },
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "datasetName": {
                    "minLength": 1,
                    "maxLength": 120,
                    "type": "string"
                  },
                  "analysisRoot": {
                    "minLength": 1,
