NODE_ENV=development
PORT=1337
CORS_ORIGIN=http://localhost:4321
OPENAI_API_KEY=your-openai-api-key
COPILOT_MODEL=gpt-4o
# Runtime queries can use either a Neon pooled or direct URL.
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Drizzle schema tools should use a direct Neon URL, not the `-pooler` host.
DATABASE_URL_DIRECT=postgresql://user:password@direct-host/database?sslmode=require
BETTER_AUTH_URL=http://localhost:1337
BETTER_AUTH_SECRET=change-me
COOKIE_DOMAIN=
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
# Optional local dataset discovery root for hosted report import.
PLANETNIK_DATASETS_ROOT=/Users/alan/Projects/planetnik/datasets
