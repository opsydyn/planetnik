---
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	buildReportMetricsViewModel,
} from "../../../lib/report-metrics-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportMetrics,
} from "../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const metrics = await getRuntimeReportMetrics(cookie, slug);
if (!metrics) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportMetricsViewModel({
	reportName: reportDetail.report.name,
	metrics,
});
---

<AppShell
	title={`${viewModel.heading} Metrics`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<div class="dashboard-stack">
		<section class="dashboard-card dashboard-card-primary">
			<p class="card-kicker">Metrics</p>
			<h2>{viewModel.heading}</h2>
			<p>
				This hosted route reads the same `metrics.txt` contract as the static report
				app and keeps the API surface explicit before we do any UI unification.
			</p>
			<div class="card-actions">
				<a class="button-secondary" href={`/reports/${slug}/overview`}>
					Open overview
				</a>
				<a class="button-secondary" href={`/reports/${slug}/topology`}>
					Open topology
				</a>
				<a class="button" href="/sign-out">Sign out</a>
			</div>
		</section>

		<section class="overview-cards">
			{viewModel.cards.map((card) => (
				<article class="dashboard-card">
					<p class="card-kicker">{card.label}</p>
					<h2>{card.value}</h2>
					{card.detail ? <p>{card.detail}</p> : <p> </p>}
				</article>
			))}
		</section>

		<section class="dashboard-stack">
			{viewModel.groups.map((group) => (
				<article class="dashboard-card">
					<p class="card-kicker">Metric Group</p>
					<h2>{group.label}</h2>
					<div class="contributors-table-wrap">
						<table class="contributors-table">
							<thead>
								<tr>
									<th>Metric</th>
									<th>Value</th>
								</tr>
							</thead>
							<tbody>
								{group.rows.map((row) => (
									<tr>
										<td>
											<div class="table-primary">{row.metric}</div>
										</td>
										<td>{row.value}</td>
									</tr>
								))}
							</tbody>
						</table>
					</div>
				</article>
			))}
		</section>
	</div>
</AppShell>
