---
import LandscapeContributorsView from "@planetnik/report-ui/views/LandscapeContributorsView";
import ReportDataGrid from "@planetnik/report-ui/tables/ReportDataGrid";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";
import {
	buildReportContributorsViewModel,
} from "../../../lib/report-contributors-view-model.js";
import { buildReportLandscapeContributorsViewModel } from "../../../lib/report-landscape-contributors-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportContributors,
} from "../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const contributors = await getRuntimeReportContributors(cookie, slug);
const isLandscapeReport = reportDetail.context?.mode === "landscape";
const landscapeViewModel = isLandscapeReport
	? buildReportLandscapeContributorsViewModel({
			slug,
			contributors,
		})
	: null;
const viewModel = !isLandscapeReport
	? buildReportContributorsViewModel({
			slug,
			reportName: reportDetail.report.name,
			contributors,
		})
	: null;
---

<AppShell
	title={`${isLandscapeReport ? (landscapeViewModel?.heading ?? "Contributors") : (viewModel?.heading ?? "Contributors")} Contributors`}
	subtitle={isLandscapeReport ? (landscapeViewModel?.subtitle ?? "") : (viewModel?.subtitle ?? "")}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	{
		isLandscapeReport && landscapeViewModel ? (
			<LandscapeContributorsView
				subtitle={landscapeViewModel.subtitle}
				cards={landscapeViewModel.cards}
				topContributorBars={landscapeViewModel.topContributorBars}
				rows={landscapeViewModel.rows}
				searchPlaceholder="Search contributor or repository"
			/>
		) : viewModel ? (
			<>
				<header class="page-header">
					<h2>{viewModel.heading}</h2>
					<p class="subtitle">{viewModel.subtitle}</p>
				</header>

				<section class="stats-grid">
					{viewModel.cards.map((card) => (
						<article class="stat-card">
							<div class="stat-value">{card.value}</div>
							<div class="stat-label">{card.label}</div>
							{card.detail ? <div class="stat-detail">{card.detail}</div> : null}
						</article>
					))}
				</section>

				<ReportDataGrid
					client:load
					title="Contributors"
					description="Contributor activity and knowledge spread across the codebase."
					searchPlaceholder="Search contributor"
					rows={viewModel.rows.map((row, i) => ({ id: String(i), ...row }))}
					columns={[
						{ field: "contributor", headerName: "Contributor", type: "link", hrefField: "href", flex: 2, sort: "asc" },
						{ field: "email", headerName: "Email", type: "text", flex: 2 },
						{ field: "status", headerName: "Status", type: "text", flex: 1 },
						{ field: "allTime", headerName: "All Time", type: "text", flex: 1 },
						{ field: "commits30Days", headerName: "30d", type: "text", flex: 1 },
						{ field: "componentsTouched", headerName: "Components", type: "text", flex: 1 },
						{ field: "primaryComponent", headerName: "Primary Component", type: "text", flex: 2 },
						{ field: "knowledgeSignal", headerName: "Signal", type: "text", flex: 1 },
					]}
				/>
			</>
		) : null
	}
</AppShell>

<style>
	.page-header { margin-bottom: 1.25rem; }
	.page-header h2 { margin-bottom: 0.25rem; }
	.subtitle { color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.35rem; }

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.stat-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 1.25rem;
	}
	.stat-value { font-size: 1.75rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
	.stat-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
	.stat-detail { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.35rem; }
</style>
