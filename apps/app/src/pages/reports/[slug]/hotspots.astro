---
import RepositoryHotspotsView from "@planetnik/report-ui/views/RepositoryHotspotsView";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import { buildReportHotspotsViewModel } from "../../../lib/report-hotspots-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportHotspots,
} from "../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const hotspots = await getRuntimeReportHotspots(cookie, slug);
if (!hotspots) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportHotspotsViewModel({
	reportName: reportDetail.report.name,
	hotspots,
});
---

<AppShell
	title={`${viewModel.heading} Hotspots`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryHotspotsView
		heading={viewModel.heading}
		subtitle={viewModel.subtitle}
		cards={viewModel.cards}
		severityData={viewModel.severityData}
		severityColors={viewModel.severityColors}
		kindData={viewModel.kindData}
		dominantDimensionData={viewModel.dominantDimensionData}
		topHotspotData={viewModel.topHotspotData}
		hotspotRows={viewModel.hotspotRows}
	/>
</AppShell>
