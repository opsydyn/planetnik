---
import DonutChart from "@planetnik/report-ui/charts/DonutChart";
import HorizontalBarChart from "@planetnik/report-ui/charts/HorizontalBarChart";
import SystemIcon from "@planetnik/report-ui/icons/SystemIcon";
import type { SystemIconName } from "@planetnik/report-ui/icons/SystemIcon.react";
import { SecurityActionCenter } from "@planetnik/report-ui";
import ReportDataGrid from "@planetnik/report-ui/tables/ReportDataGrid";
import SecurityBallChart from "@planetnik/report-ui/security/SecurityBallChart";
import SharedPackagesGraph from "@planetnik/report-ui/security/SharedPackagesGraph";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	getHostedReportRepositoryHref,
} from "../../../lib/hosted-routes.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepositories,
	getRuntimeReportSecurity,
} from "../../../lib/runtime-client.js";

type MetricTone = "critical" | "warning" | "info" | "healthy" | "neutral";

type SecurityMetric = {
	label: string;
	value: string;
	hint: string;
	iconName: SystemIconName;
	tone: MetricTone;
};

function formatIsoDate(value: string | null | undefined) {
	if (!value) return "—";
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return "—";
	return date.toISOString().slice(0, 10);
}

function getDaysSince(value: string | null | undefined) {
	if (!value) return null;
	const date = new Date(value);
	if (Number.isNaN(date.getTime())) return null;
	const diffMs = Date.now() - date.getTime();
	return Math.max(0, Math.floor(diffMs / 86_400_000));
}

function getRiskCountTone(
	value: number,
	criticalThreshold: number,
	warningThreshold: number,
): MetricTone {
	if (value >= criticalThreshold) return "critical";
	if (value >= warningThreshold) return "warning";
	if (value > 0) return "info";
	return "healthy";
}

function getRatioRiskTone(
	value: number,
	criticalThreshold: number,
	warningThreshold: number,
): MetricTone {
	if (value >= criticalThreshold) return "critical";
	if (value >= warningThreshold) return "warning";
	if (value > 0) return "info";
	return "healthy";
}

function getBacklogAgeTone(value: number | null | undefined): MetricTone {
	if (value == null) return "neutral";
	if (value > 365) return "critical";
	if (value > 90) return "warning";
	if (value > 30) return "info";
	return "healthy";
}

function getRecentActivityTone(value: number | null | undefined): MetricTone {
	if (value == null) return "neutral";
	if (value <= 7) return "warning";
	if (value <= 30) return "info";
	return "neutral";
}

function getFreshnessTone(value: number | null | undefined): MetricTone {
	if (value == null) return "neutral";
	if (value <= 1) return "healthy";
	if (value <= 7) return "info";
	return "warning";
}

function getCoverageTone(covered: number, total: number): MetricTone {
	if (total <= 0) return "neutral";
	const ratio = covered / total;
	if (ratio >= 0.85) return "healthy";
	if (ratio >= 0.5) return "info";
	if (ratio > 0) return "warning";
	return "neutral";
}

function getRepoRiskLevel(repo: {
	openAlerts: number;
	severityCounts: { critical: number; high: number; medium: number; low: number };
	oldestOpenAlertDays: number | null;
}) {
	if (repo.severityCounts.critical > 0) return "Critical backlog";
	if (repo.severityCounts.high > 0 || (repo.oldestOpenAlertDays ?? 0) > 365) {
		return "High risk";
	}
	if (repo.severityCounts.medium > 0 || repo.openAlerts > 0) return "Watchlist";
	return "Clear";
}

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const [security, repositories] = await Promise.all([
	getRuntimeReportSecurity(cookie, slug),
	getRuntimeReportLandscapeRepositories(cookie, slug),
]);

if (!security) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repoHrefMap: Record<string, string> = {};
for (const repo of repositories?.repositories ?? []) {
	repoHrefMap[repo.name] = getHostedReportRepositoryHref(slug, repo.repoKey);
}

const exposurePercent = Math.round(security.supplyChainExposureScore * 100);

const severityItems = [
	{ label: "Critical", value: security.severityCounts.critical, color: "#ef4444" },
	{ label: "High", value: security.severityCounts.high, color: "#f59e0b" },
	{ label: "Medium", value: security.severityCounts.medium, color: "#eab308" },
	{ label: "Low", value: security.severityCounts.low, color: "#22c55e" },
].filter((b) => b.value > 0);
const severityColors = severityItems.map((s) => s.color);

const repoAlertBars = security.repoHealth
	.filter((r) => r.openAlerts > 0)
	.sort((a, b) => b.openAlerts - a.openAlerts)
	.slice(0, 15)
	.map((r) => ({ label: r.repo, value: r.openAlerts, href: repoHrefMap[r.repo] }));

const topRiskRepoNames = new Set(
	[...security.repoHealth]
		.sort(
			(a, b) =>
				(b.severityCounts.critical > 0 ? 4 : b.severityCounts.high > 0 ? 3 : b.severityCounts.medium > 0 ? 2 : 1) -
				(a.severityCounts.critical > 0 ? 4 : a.severityCounts.high > 0 ? 3 : a.severityCounts.medium > 0 ? 2 : 1) ||
				b.openAlerts - a.openAlerts ||
				(b.oldestOpenAlertDays ?? 0) - (a.oldestOpenAlertDays ?? 0),
		)
		.slice(0, 5)
		.map((repo) => repo.repo),
)

const securityBallRepos = security.repoHealth.map((r) => ({
	repo: r.repo,
	href: repoHrefMap[r.repo],
	totalAlerts: r.totalAlerts,
	openAlerts: r.openAlerts,
	critical: r.severityCounts.critical,
	high: r.severityCounts.high,
	medium: r.severityCounts.medium,
	low: r.severityCounts.low,
	mttrDays: r.meanTimeToResolveDays ?? null,
	oldestOpenDays: r.oldestOpenAlertDays ?? null,
}));

const repoRows = security.repoHealth.map((r) => ({
	id: r.repo,
	repo: r.repo,
	repoHref: repoHrefMap[r.repo] ?? "",
	riskLevel: getRepoRiskLevel(r),
	rowTone: topRiskRepoNames.has(r.repo)
		? r.severityCounts.critical > 0
			? "critical"
			: r.severityCounts.high > 0
				? "warning"
				: "info"
		: undefined,
	openAlerts: r.openAlerts,
	riskSummary:
		r.severityCounts.critical > 0
			? `${r.severityCounts.critical} critical · ${r.severityCounts.high} high`
			: r.severityCounts.high > 0
				? `${r.severityCounts.high} high · ${r.severityCounts.medium} medium`
				: `${r.severityCounts.medium} medium · ${r.severityCounts.low} low`,
	progressSummary: `${r.fixedAlerts} fixed · ${r.totalAlerts} total`,
	mttr: r.meanTimeToResolveDays !== null ? String(r.meanTimeToResolveDays) : "—",
	oldestDays: r.oldestOpenAlertDays !== null ? `${r.oldestOpenAlertDays}d` : "Clear",
}));

const actionCenterItems = security.topActionableVulnerabilities.map((item, index) => ({
	id: `${item.repo}-${item.advisoryId}-${index}`,
	advisory: item.advisoryId,
	advisoryHref: item.cveId
		? `https://nvd.nist.gov/vuln/detail/${item.cveId}`
		: `https://github.com/advisories/${item.ghsaId}`,
	repo: item.repo,
	repoHref: repoHrefMap[item.repo] ?? "",
	manifestPath: item.manifestPath,
	severity: item.severity.toUpperCase(),
	package: item.package,
	ecosystem: item.ecosystem,
	ageDays: item.ageDays,
	sharedRepoCount: item.sharedRepoCount,
	action: item.recommendedAction,
	patchedVersion: item.firstPatchedVersion ?? "—",
	summary: item.summary,
	knownExploited: item.knownExploited,
	epssPercentile: item.epssPercentile,
	epssPercentileLabel:
		item.epssPercentile !== null ? `${Math.round(item.epssPercentile * 100)}%` : "—",
	hasPatch: item.firstPatchedVersion !== null,
	isExploitLikely: item.knownExploited || (item.epssPercentile ?? 0) >= 0.95,
}));

const advisoryGroupMap = new Map<string, {
	id: string;
	advisory: string;
	advisoryHref: string;
	severity: string;
	summary: string;
	packageNames: Set<string>;
	repoNames: Set<string>;
	openCount: number;
	patchAvailableCount: number;
	knownExploited: boolean;
	epssPercentile: number | null;
	epssPercentileLabel: string;
	isExploitLikely: boolean;
	affectedRepos: Array<{
		id: string;
		repo: string;
		repoHref: string;
		manifestPath: string;
		package: string;
		ecosystem: string;
		ageDays: number;
		action: string;
		patchedVersion: string;
	}>;
}>();

for (const item of actionCenterItems) {
	const current = advisoryGroupMap.get(item.advisory);
	if (!current) {
		advisoryGroupMap.set(item.advisory, {
			id: item.advisory,
			advisory: item.advisory,
			advisoryHref: item.advisoryHref,
			severity: item.severity,
			summary: item.summary,
			packageNames: new Set([item.package]),
			repoNames: new Set([item.repo]),
			openCount: 1,
			patchAvailableCount: item.hasPatch ? 1 : 0,
			knownExploited: item.knownExploited,
			epssPercentile: item.epssPercentile ?? null,
			epssPercentileLabel: item.epssPercentileLabel,
			isExploitLikely: item.isExploitLikely,
			affectedRepos: [
				{
					id: item.id,
					repo: item.repo,
					repoHref: item.repoHref,
					manifestPath: item.manifestPath,
					package: item.package,
					ecosystem: item.ecosystem,
					ageDays: item.ageDays,
					action: item.action,
					patchedVersion: item.patchedVersion,
				},
			],
		});
		continue;
	}

	current.packageNames.add(item.package);
	current.repoNames.add(item.repo);
	current.openCount += 1;
	if (item.hasPatch) current.patchAvailableCount += 1;
	current.knownExploited = current.knownExploited || item.knownExploited;
	current.isExploitLikely = current.isExploitLikely || item.isExploitLikely;
	if ((item.epssPercentile ?? 0) > (current.epssPercentile ?? 0)) {
		current.epssPercentile = item.epssPercentile ?? null;
		current.epssPercentileLabel = item.epssPercentileLabel;
	}
	current.affectedRepos.push({
		id: item.id,
		repo: item.repo,
		repoHref: item.repoHref,
		manifestPath: item.manifestPath,
		package: item.package,
		ecosystem: item.ecosystem,
		ageDays: item.ageDays,
		action: item.action,
		patchedVersion: item.patchedVersion,
	});
}

const advisoryGroups = Array.from(advisoryGroupMap.values())
	.map((group: {
		id: string;
		advisory: string;
		advisoryHref: string;
		severity: string;
		summary: string;
		packageNames: Set<string>;
		repoNames: Set<string>;
		openCount: number;
		patchAvailableCount: number;
		knownExploited: boolean;
		epssPercentile: number | null;
		epssPercentileLabel: string;
		isExploitLikely: boolean;
		affectedRepos: Array<{
			id: string;
			repo: string;
			repoHref: string;
			manifestPath: string;
			package: string;
			ecosystem: string;
			ageDays: number;
			action: string;
			patchedVersion: string;
		}>;
	}) => ({
		...group,
		packageCount: group.packageNames.size,
		repoCount: group.repoNames.size,
		affectedRepos: group.affectedRepos.sort(
			(a: { ageDays: number }, b: { ageDays: number }) => b.ageDays - a.ageDays,
		),
	}));

const enrichedAtLabel = formatIsoDate(security.enrichmentSummary.enrichedAt);
const latestAlertOpenedLabel = formatIsoDate(
	security.enrichmentSummary.latestAlertOpenedAt,
);
const latestAdvisoryPublishedLabel = formatIsoDate(
	security.enrichmentSummary.latestAdvisoryPublishedAt,
);
const oldestOpenAlertDays = security.repoHealth.reduce<number | null>(
	(max, repo) => {
		if (repo.oldestOpenAlertDays === null) return max;
		return max === null
			? repo.oldestOpenAlertDays
			: Math.max(max, repo.oldestOpenAlertDays);
	},
	null,
);

const headlineMetrics: SecurityMetric[] = [
	{
		label: "Total Alerts",
		value: security.totalAlerts.toLocaleString(),
		hint: "Landscape-wide backlog is heavy",
		iconName: "list",
		tone: getRiskCountTone(security.totalAlerts, 2500, 1000),
	},
	{
		label: "Open Alerts",
		value: security.totalOpenAlerts.toLocaleString(),
		hint: "Unresolved issues currently competing for attention",
		iconName: "warning-circle",
		tone: getRiskCountTone(security.totalOpenAlerts, 1500, 500),
	},
	{
		label: "Critical",
		value: security.severityCounts.critical.toLocaleString(),
		hint: "Immediate remediation candidates",
		iconName: "bug-beetle",
		tone:
			security.severityCounts.critical > 0
				? getRiskCountTone(security.severityCounts.critical, 100, 1)
				: "healthy",
	},
	{
		label: "Repos with Alerts",
		value: `${security.reposWithAlerts}/${security.totalRepos}`,
		hint: "Blast radius across the repo set",
		iconName: "hard-drives",
		tone: getRatioRiskTone(
			security.totalRepos > 0 ? security.reposWithAlerts / security.totalRepos : 0,
			0.75,
			0.4,
		),
	},
	{
		label: "Mean Time to Resolve",
		value:
			security.meanTimeToResolveDays !== null
				? `${security.meanTimeToResolveDays}d`
				: "—",
		hint: "How sticky the security backlog has become",
		iconName: "trend-up",
		tone: getBacklogAgeTone(security.meanTimeToResolveDays),
	},
	{
		label: "Supply Chain Exposure",
		value: `${exposurePercent}%`,
		hint: "Shared-package blast radius remains high",
		iconName: "circuitry",
		tone: getRatioRiskTone(security.supplyChainExposureScore, 0.9, 0.6),
	},
];

const metaMetrics: SecurityMetric[] = [
	{
		label: "Alert Records",
		value: security.totalAlerts.toLocaleString(),
		hint: "All advisory instances captured in this run",
		iconName: "rows",
		tone: getRiskCountTone(security.totalAlerts, 2500, 1000),
	},
	{
		label: "Repos with Alert Records",
		value: security.reposWithAlerts.toLocaleString(),
		hint: "Repositories contributing real alert evidence",
		iconName: "hard-drives",
		tone: getRatioRiskTone(
			security.totalRepos > 0 ? security.reposWithAlerts / security.totalRepos : 0,
			0.75,
			0.4,
		),
	},
	{
		label: "Unique CVEs",
		value: security.enrichmentSummary.uniqueCveCount.toLocaleString(),
		hint: "Distinct vulnerabilities in play",
		iconName: "bug-beetle",
		tone: getRiskCountTone(security.enrichmentSummary.uniqueCveCount, 500, 100),
	},
	{
		label: "EPSS Coverage",
		value: security.enrichmentSummary.epssCoverageCount.toLocaleString(),
		hint: "Exploit-likelihood coverage for tracked CVEs",
		iconName: "graph",
		tone: getCoverageTone(
			security.enrichmentSummary.epssCoverageCount,
			security.enrichmentSummary.uniqueCveCount,
		),
	},
	{
		label: "Known Exploited",
		value: security.enrichmentSummary.knownExploitedCount.toLocaleString(),
		hint: "CISA KEV overlap needs quick attention",
		iconName: "lightning",
		tone:
			security.enrichmentSummary.knownExploitedCount > 0
				? "critical"
				: "healthy",
	},
	{
		label: "Newest Alert Opened",
		value: latestAlertOpenedLabel,
		hint: "How recently new risk entered the queue",
		iconName: "warning-circle",
		tone: getRecentActivityTone(
			getDaysSince(security.enrichmentSummary.latestAlertOpenedAt),
		),
	},
	{
		label: "Latest Advisory Published",
		value: latestAdvisoryPublishedLabel,
		hint: "Fresh upstream vulnerability disclosures",
		iconName: "bug-beetle",
		tone: getRecentActivityTone(
			getDaysSince(security.enrichmentSummary.latestAdvisoryPublishedAt),
		),
	},
	{
		label: "Oldest Open Alert",
		value: oldestOpenAlertDays !== null ? `${oldestOpenAlertDays} days` : "—",
		hint: "Longest-running unresolved item",
		iconName: "pause",
		tone: getBacklogAgeTone(oldestOpenAlertDays),
	},
	{
		label: "Enriched At",
		value: enrichedAtLabel,
		hint: "How fresh the EPSS / KEV overlay is",
		iconName: "circuitry",
		tone: getFreshnessTone(getDaysSince(security.enrichmentSummary.enrichedAt)),
	},
];

const sharedRows = security.sharedVulnerablePackages.map((p, i) => ({
	id: `shared-${i}`,
	package: p.name,
	ecosystem: p.ecosystem,
	severity: p.severity,
	repoCount: p.affectedRepos.length,
	affectedRepos: [...p.affectedRepos].join(", "),
}));
---

<AppShell
	title="Dependency Security"
	subtitle="Dependabot vulnerability alerts across the landscape"
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<header class="page-header">
		<h2>Dependency Security</h2>
		<p class="subtitle">Dependabot vulnerability alerts across the landscape — severity breakdown, patch status, and supply chain exposure.</p>
	</header>

	{securityBallRepos.some((r) => r.totalAlerts > 0) && (
		<div class="section-block section-block--hero">
			<h3 class="section-heading">Vulnerability Landscape</h3>
			<SecurityBallChart
				client:load
				repos={securityBallRepos}
				totalOpen={security.totalOpenAlerts}
				severityCounts={security.severityCounts}
				exposureScore={security.supplyChainExposureScore}
				helpText="Vulnerability landscape — repos orbit the central vulnerability mass, sized by open alerts, colored by highest severity. Pulsing rings indicate critical vulnerabilities."
			/>
		</div>
	)}

	<section class="stats-grid">
		{headlineMetrics.map((metric) => (
			<article class={`stat-card stat-card--${metric.tone}`}>
				<div class="stat-card__icon" aria-hidden="true">
					<SystemIcon name={metric.iconName} size={18} />
				</div>
				<div class="stat-value">{metric.value}</div>
				<div class="stat-label">{metric.label}</div>
				<div class="stat-hint">{metric.hint}</div>
			</article>
		))}
	</section>

	<div class="security-legend" aria-label="Metric tone legend">
		<span class="security-legend__title">Tone legend</span>
		<span class="security-legend__item security-legend__item--critical">Critical risk</span>
		<span class="security-legend__item security-legend__item--warning">Needs attention</span>
		<span class="security-legend__item security-legend__item--info">Active signal</span>
		<span class="security-legend__item security-legend__item--healthy">Healthy / fresh</span>
	</div>

	<div class="meta-strip" aria-label="Security enrichment freshness and coverage">
		{metaMetrics.map((metric) => (
			<div class={`meta-pill meta-pill--${metric.tone}`}>
				<div class="meta-pill__icon" aria-hidden="true">
					<SystemIcon name={metric.iconName} size={16} />
				</div>
				<span class="meta-pill__label">{metric.label}</span>
				<strong>{metric.value}</strong>
				<div class="meta-pill__hint">{metric.hint}</div>
			</div>
		))}
	</div>

	<h3 class="section-heading">Alert Distribution</h3>

	{(severityItems.length > 0 || repoAlertBars.length > 0) && (
		<section class="chart-row">
			{severityItems.length > 0 && (
				<div class="chart-col">
					<DonutChart
						client:load
						data={severityItems}
						valueLabel="Alerts"
						colors={severityColors}
						helpText="Distribution of vulnerability alerts by severity level across all repositories."
					/>
				</div>
			)}
			{repoAlertBars.length > 0 && (
				<div class="chart-col">
					<HorizontalBarChart
						client:load
						data={repoAlertBars}
						valueLabel="Open Alerts"
						barColor="var(--color-warning, #f59e0b)"
						helpText="Repositories with the most open vulnerability alerts."
					/>
				</div>
			)}
		</section>
	)}

	{security.sharedVulnerablePackages.length > 0 && (
		<div class="section-block">
			<h3 class="section-heading">Supply Chain Risk</h3>
			<SharedPackagesGraph
				client:load
				packages={[...security.sharedVulnerablePackages].map((p) => ({
					name: p.name,
					ecosystem: p.ecosystem,
					severity: p.severity,
					affectedRepos: [...p.affectedRepos],
				}))}
				repoHrefMap={repoHrefMap}
				helpText="Supply chain risk — package nodes (colored by severity) connect to repos that depend on them. Larger nodes affect more repos."
			/>
		</div>
	)}

	{actionCenterItems.length > 0 && (
		<div class="section-block">
			<SecurityActionCenter
				client:load
				title="Top actionable vulnerabilities"
				description="Filter KEV, critical, patch-ready, or exploit-likely issues, then expand grouped advisory drilldowns to inspect the affected repositories cleanly."
				items={actionCenterItems}
				advisoryGroups={advisoryGroups}
			/>
		</div>
	)}

	<h3 class="section-heading">Repository Details</h3>

	<div class="section-block">
		<ReportDataGrid
			client:load
			title="Repository Security Health"
			description="A cleaner triage view of repository security pressure: open load first, then risk mix, remediation progress, and backlog age."
			searchPlaceholder="Search repositories"
			rows={repoRows}
			columns={[
				{ field: "repo", headerName: "Repository", type: "link", hrefField: "repoHref", flex: 2, sort: "asc" },
				{ field: "riskLevel", headerName: "Risk Level", type: "status", minWidth: 190 },
				{ field: "openAlerts", headerName: "Open", type: "number", flex: 1, sort: "desc" },
				{ field: "riskSummary", headerName: "Risk Mix", type: "text", flex: 2 },
				{ field: "progressSummary", headerName: "Progress", type: "text", flex: 1.5 },
				{ field: "mttr", headerName: "MTTR (days)", type: "text", flex: 1 },
				{ field: "oldestDays", headerName: "Oldest Open (days)", type: "text", flex: 1 },
			]}
		/>
	</div>

	{sharedRows.length > 0 && (
		<div class="section-block">
			<ReportDataGrid
				client:load
				title="Shared Vulnerable Packages"
				description="Packages with known vulnerabilities appearing in multiple repositories — highest supply chain risk."
				searchPlaceholder="Search packages"
				rows={sharedRows}
				columns={[
					{ field: "package", headerName: "Package", type: "text", flex: 2, sort: "asc" },
					{ field: "ecosystem", headerName: "Ecosystem", type: "text", flex: 1 },
					{ field: "severity", headerName: "Severity", type: "text", flex: 1 },
					{ field: "repoCount", headerName: "Repos Affected", type: "number", flex: 1, sort: "desc" },
					{ field: "affectedRepos", headerName: "Repositories", type: "text", flex: 3 },
				]}
			/>
		</div>
	)}
</AppShell>

<style>
