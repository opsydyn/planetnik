---
import RepositoryTopologyView from "@planetnik/report-ui/views/RepositoryTopologyView";
import AppShell from "../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../lib/hosted-shell.js";
import {
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../lib/hosted-routes.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryTopology,
} from "../../../../../lib/runtime-client.js";

type PeopleDep = { from: string; to: string; count: number; files: string[] };
type DimensionKey =
	| "complexity_reduction"
	| "boundary_shaping"
	| "knowledge_spread"
	| "coordination_relief"
	| "change_enablement";
type ContributorImpact = {
	email: string;
	display_name: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	visible_activity_score: number;
	collaborator_count: number;
	shared_files_count: number;
	commits_count: number;
	files_touched: number;
	components_touched: number;
	dominant_dimension: DimensionKey;
	dimensions: Record<DimensionKey, number>;
	top_components: Array<{ name: string; files: number; commits: number }>;
	top_routes: string[];
	reasons: string[];
	is_glue: boolean;
	is_snacking: boolean;
};

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const topology = await getRuntimeReportLandscapeRepositoryTopology(cookie, slug, repo);
if (!topology) {
	return Astro.redirect(getHostedReportRepositoryHref(slug, repo));
}

const hasData = Object.keys(topology.periodsData).length > 0;
const contributorHrefBase = getHostedReportRepositoryPageHref(slug, repo, "/contributors");
const periods = topology.periodsData as Record<string, PeopleDep[]>;
const impactPeriods = topology.impactPeriods as Record<string, ContributorImpact[]>;
---

<AppShell
	title={`${repository.name} Topology`}
	subtitle={`Contributors connected by shared file modifications inside ${repository.name}.`}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	{!hasData ? (
		<div class="empty">
			<p>No people dependency data available for this repository.</p>
			<p class="hint">Generate repository reports inside the landscape analysis root to enable repo-scoped topology.</p>
		</div>
	) : (
		<RepositoryTopologyView
			heading={repository.name}
			subtitle={`Contributors connected by shared file modifications inside ${repository.name}.`}
			backHref={getHostedReportRepositoryHref(slug, repo)}
			periods={periods}
			impactPeriods={impactPeriods}
			contributorHrefBase={contributorHrefBase}
			componentsHref={null}
		/>
	)}
</AppShell>

<style>
	.empty {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 2rem;
		text-align: center;
	}

	.empty p {
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.hint {
		font-size: 0.85rem;
	}
</style>
