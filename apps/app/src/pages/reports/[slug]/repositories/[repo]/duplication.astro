---
import RepositoryDuplicationView from "@planetnik/report-ui/views/RepositoryDuplicationView";
import AppShell from "../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../lib/hosted-shell.js";
import {
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryHref,
} from "../../../../../lib/hosted-routes.js";
import {
	buildReportDuplicationViewModel,
} from "../../../../../lib/report-duplication-view-model.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryDuplication,
} from "../../../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const duplication = await getRuntimeReportLandscapeRepositoryDuplication(
	cookie,
	slug,
	repo,
);
if (!duplication) {
	return Astro.redirect(getHostedReportRepositoryHref(slug, repo));
}

const viewModel = buildReportDuplicationViewModel({
	reportName: repository.name,
	duplication,
});
---

<AppShell
	title={`${viewModel.heading} Duplication`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<RepositoryDuplicationView
		heading={viewModel.heading}
		subtitle={viewModel.subtitle}
		backHref={getHostedReportRepositoryHref(slug, repo)}
		cards={viewModel.cards}
		blockSizeDistribution={viewModel.blockSizeDistribution}
		mostDuplicatedFiles={viewModel.mostDuplicatedFiles}
		blockGridRows={viewModel.blockGridRows}
	/>
</AppShell>
