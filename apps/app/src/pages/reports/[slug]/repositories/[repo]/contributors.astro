---
import AppShell from "../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../lib/hosted-shell.js";
import {
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryContributorHref,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../lib/hosted-routes.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryContributors,
} from "../../../../../lib/runtime-client.js";
import RepositoryContributorsView from "@planetnik/report-ui/views/RepositoryContributorsView";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const contributors = await getRuntimeReportLandscapeRepositoryContributors(
	cookie,
	slug,
	repo,
);

const rows = contributors.map((contributor) => ({
	id: contributor.email,
	contributor: contributor.displayName,
	email: contributor.userName.trim().length > 0 ? contributor.email : "",
	href: getHostedReportRepositoryContributorHref(slug, repo, contributor.email),
	type: contributor.isBot === true ? "Bot" : contributor.isBot === false ? "Human" : "—",
	commitsCount: contributor.commitsAllTime,
	commits30d: contributor.commits30Days,
	commits90d: contributor.commits90Days,
	firstCommitDate: contributor.firstCommit,
	latestCommitDate: contributor.latestCommitDate,
	glueScore: "—",
	structuralImpact: "—",
	snackRisk: "—",
	signal: contributor.knowledgeSignal || "—",
}));

const botCount = rows.filter((r) => r.type === "Bot").length;
const humanCount = rows.filter((r) => r.type === "Human").length;
const topContributor = [...rows].sort((a, b) => b.commitsCount - a.commitsCount)[0]?.contributor ?? "—";
---

<AppShell
	title={`${repository.name} Contributors`}
	subtitle={`${repository.name} · Contributors`}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<RepositoryContributorsView
		repoName={repository.name}
		description="Contributor activity and knowledge spread from the linked Planetnik dataset."
		backHref={getHostedReportRepositoryHref(slug, repo)}
		totalCount={rows.length}
		humanCount={humanCount}
		botCount={botCount}
		topContributor={topContributor}
		rows={rows}
	/>
</AppShell>
