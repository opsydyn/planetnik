---
import RepositoryImpactView from "@planetnik/report-ui/views/RepositoryImpactView";
import AppShell from "../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../lib/hosted-shell.js";
import {
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../lib/hosted-routes.js";
import {
	buildReportImpactViewModel,
} from "../../../../../lib/report-impact-view-model.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryImpact,
} from "../../../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const impact = await getRuntimeReportLandscapeRepositoryImpact(cookie, slug, repo);
if (!impact) {
	return Astro.redirect(getHostedReportRepositoryHref(slug, repo));
}

const playbookHrefs = {
	hotspots: getHostedReportRepositoryPageHref(slug, repo, "/hotspots"),
	components: getHostedReportRepositoryPageHref(slug, repo, "/components"),
	contributors: getHostedReportRepositoryPageHref(slug, repo, "/contributors"),
	controls: getHostedReportRepositoryPageHref(slug, repo, "/controls"),
};

const viewModel = buildReportImpactViewModel({
	reportName: repository.name,
	impact,
	playbookHrefs,
});
---

<AppShell
	title={`${viewModel.heading} Impact`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<RepositoryImpactView
		heading={viewModel.heading}
		subtitle={viewModel.subtitle}
		backHref={getHostedReportRepositoryHref(slug, repo)}
		cards={viewModel.cards}
		dimensionChartData={viewModel.dimensionChartData}
		topOpportunityData={viewModel.topOpportunityData}
		snackingChartData={viewModel.snackingChartData}
		conceptCards={viewModel.conceptCards}
		playbookItems={viewModel.playbookItems}
		opportunityRows={viewModel.opportunityRows}
		snackingRows={viewModel.snackingRows}
	/>
</AppShell>
