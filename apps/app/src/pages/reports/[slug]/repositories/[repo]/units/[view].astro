---
import AppShell from "../../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../../lib/hosted-shell.js";
import { buildReportUnitsViewModel } from "../../../../../../lib/report-units-view-model.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryUnitsView,
} from "../../../../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = Astro.params.repo ?? "";
const view = Astro.params.view;

if (view !== "size" && view !== "complexity") {
	return Astro.redirect(`/reports/${slug}/repositories/${repo}`);
}

const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const units = await getRuntimeReportLandscapeRepositoryUnitsView(
	cookie,
	slug,
	repo,
	view,
);
if (!units) {
	return Astro.redirect(`/reports/${slug}/repositories/${repo}`);
}

const viewModel = buildReportUnitsViewModel({
	reportName: repository.name,
	slug,
	routeBase: `/reports/${slug}/repositories/${repo}/units`,
	units,
});
---

<AppShell
	title={`${viewModel.heading} Units`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<div class="dashboard-stack">
		<section class="dashboard-card dashboard-card-primary">
			<p class="card-kicker">Repository Units</p>
			<h2>{viewModel.heading}</h2>
			<p>
				This hosted route keeps the repo-drilldown unit-view semantics aligned
				with the static landscape shell while the shared UI extraction is still
				pending.
			</p>
			<div class="card-actions">
				{viewModel.viewLinks.map((link) => (
					<a
						class={link.active ? "button" : "button-secondary"}
						href={link.href}
					>
						{link.label}
					</a>
				))}
				<a class="button-secondary" href={`/reports/${slug}/repositories/${repo}`}>
					Open repository dashboard
				</a>
			</div>
		</section>

		<section class="overview-cards">
			{viewModel.cards.map((card) => (
				<article class="dashboard-card">
					<p class="card-kicker">{card.label}</p>
					<h2>{card.value}</h2>
					{card.detail ? <p>{card.detail}</p> : <p> </p>}
				</article>
			))}
		</section>

		<section class="dashboard-grid">
			{viewModel.sections.map((section) => (
				<article class="dashboard-card">
					<p class="card-kicker">Units</p>
					<h2>{section.title}</h2>
					{section.rows.length > 0 ? (
						<ul class="todo-list">
							{section.rows.map((row) => (
								<li>
									<strong>{row.label}</strong>: {row.value}
								</li>
							))}
						</ul>
					) : (
						<p class="muted-copy">No exported rows are available for this view.</p>
					)}
				</article>
			))}
		</section>
	</div>
</AppShell>
