---
import AppShell from "../../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../../lib/hosted-shell.js";
import {
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../../lib/hosted-routes.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryUnitsView,
} from "../../../../../../lib/runtime-client.js";
import RepositoryUnitsView from "@planetnik/report-ui/views/RepositoryUnitsView";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const view = Astro.params.view;

if (view !== "size" && view !== "complexity") {
	return Astro.redirect(getHostedReportRepositoryHref(slug, repo));
}

const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const units = await getRuntimeReportLandscapeRepositoryUnitsView(
	cookie,
	slug,
	repo,
	view,
);
if (!units) {
	return Astro.redirect(getHostedReportRepositoryHref(slug, repo));
}

const routeBase = getHostedReportRepositoryPageHref(slug, repo, "/units");
const unitViews = [
	{ value: "size", label: "Size" },
	{ value: "complexity", label: "Complexity" },
] as const;
const viewLinks = unitViews.map((v) => ({
	label: v.label,
	href: `${routeBase}/${v.value}`,
	active: v.value === view,
}));

const complexityColors = ["#22c55e", "#eab308", "#f97316", "#ef4444"];

const sizeProps =
	units.view === "size"
		? {
				unitCount: units.headline.unitCount,
				totalLoc: units.headline.totalLinesOfCode,
				sizeRisk: [...units.sizeRisk],
				sizeDistribution: [...units.sizeDistribution],
				rows: units.rows.map((row) => ({
					id: `${row.relativeFileName}:${row.startLine}`,
					unit: row.shortName,
					file: row.relativeFileName,
					linesOfCode: row.linesOfCode,
					mcCabeIndex: row.mcCabeIndex,
					numberOfParameters: row.numberOfParameters,
				})),
			}
		: undefined;

const complexityProps =
	units.view === "complexity"
		? {
				unitCount: units.headline.unitCount,
				complexityRisk: [...units.complexityRisk],
				complexityDistribution: units.complexityDistribution.map((item, i) => ({
					...item,
					color: complexityColors[i] ?? "#888",
				})),
				complexityScatter: units.rows.slice(0, 200).map((row) => ({
					x: row.linesOfCode,
					y: row.mcCabeIndex,
					label: row.shortName,
				})),
				rows: units.rows.map((row) => ({
					id: `${row.relativeFileName}:${row.startLine}`,
					unit: row.shortName,
					file: row.relativeFileName,
					mcCabeIndex: row.mcCabeIndex,
					linesOfCode: row.linesOfCode,
				})),
			}
		: undefined;

const viewHeadings = {
	size: "Unit Size",
	complexity: "Conditional Complexity",
} as const;
---

<AppShell
	title={`${repository.name} ${viewHeadings[view]}`}
	subtitle={`${repository.name} · Units`}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<RepositoryUnitsView
		view={view}
		repoName={repository.name}
		viewLinks={viewLinks}
		size={sizeProps}
		complexity={complexityProps}
	/>
</AppShell>
