---
import AppShell from "../../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../../lib/hosted-shell.js";
import {
	getHostedReportContributorEmailFromParam,
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../../lib/hosted-routes.js";
import {
	buildReportContributorDetailViewModel,
} from "../../../../../../lib/report-contributor-detail-view-model.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryContributorDetail,
} from "../../../../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const email = getHostedReportContributorEmailFromParam(Astro.params.email ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const contributor = email
	? await getRuntimeReportLandscapeRepositoryContributorDetail(
			cookie,
			slug,
			repo,
			email,
		)
	: null;

if (!contributor) {
	return Astro.redirect(getHostedReportRepositoryPageHref(slug, repo, "/contributors"));
}

const viewModel = buildReportContributorDetailViewModel({
	slug,
	reportName: repository.name,
	routeBase: getHostedReportRepositoryPageHref(slug, repo, "/contributors"),
	contributor,
});
---

<AppShell
	title={`${viewModel.heading} Contributor`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<div class="dashboard-stack">
		<section class="dashboard-card dashboard-card-primary">
			<p class="card-kicker">Repository Contributor</p>
			<h2>{viewModel.heading}</h2>
			<p>
				Hosted repo contributor drilldown stays tied to the same repo export
				contract as the static landscape shell without copying the static Astro
				pages directly.
			</p>
			<div class="card-actions">
				<a class="button-secondary" href={viewModel.backHref}>
					Back to contributors
				</a>
				<a class="button-secondary" href={getHostedReportRepositoryHref(slug, repo)}>
					Open repository dashboard
				</a>
				<a class="button" href="/sign-out">Sign out</a>
			</div>
		</section>

		<section class="overview-cards">
			{viewModel.cards.map((card) => (
				<article class="dashboard-card">
					<p class="card-kicker">{card.label}</p>
					<h2>{card.value}</h2>
					{card.detail ? <p>{card.detail}</p> : <p> </p>}
				</article>
			))}
		</section>

		<section class="dashboard-grid">
			<article class="dashboard-card">
				<p class="card-kicker">Profile</p>
				<h2>Contributor facts</h2>
				<dl class="fact-list">
					{viewModel.facts.map((fact) => (
						<div>
							<dt>{fact.label}</dt>
							<dd>{fact.value}</dd>
						</div>
					))}
				</dl>
			</article>

			<article class="dashboard-card">
				<p class="card-kicker">Languages</p>
				<h2>Extension footprint</h2>
				{viewModel.extensions.length > 0 ? (
					<ul class="todo-list">
						{viewModel.extensions.map((item) => (
							<li>
								<strong>{item.label}</strong>: {item.value}
							</li>
						))}
					</ul>
				) : (
					<p class="muted-copy">No extension footprint is available.</p>
				)}
			</article>

			<article class="dashboard-card">
				<p class="card-kicker">Components</p>
				<h2>Logical component footprint</h2>
				{viewModel.components.length > 0 ? (
					<ul class="todo-list">
						{viewModel.components.map((item) => (
							<li>
								<strong>{item.label}</strong>: {item.value}
							</li>
						))}
					</ul>
				) : (
					<p class="muted-copy">No logical component footprint is available.</p>
				)}
			</article>

			<article class="dashboard-card">
				<p class="card-kicker">Files</p>
				<h2>Top touched files</h2>
				{viewModel.topFiles.length > 0 ? (
					<ul class="todo-list">
						{viewModel.topFiles.map((item) => (
							<li>
								<strong>{item.label}</strong>: {item.value}
							</li>
						))}
					</ul>
				) : (
					<p class="muted-copy">No ranked source-file footprint is available.</p>
				)}
			</article>
		</section>
	</div>
</AppShell>
