---
import AppShell from "../../../../../../layouts/AppShell.astro";
import { buildHostedRepositoryShellContext } from "../../../../../../lib/hosted-shell.js";
import {
	getHostedReportContributorEmailFromParam,
	getHostedReportRepoKeyFromParam,
	getHostedReportRepositoryContributorHref,
	getHostedReportRepositoryHref,
	getHostedReportRepositoryPageHref,
} from "../../../../../../lib/hosted-routes.js";
import {
	shouldRedirectReportDetail,
} from "../../../../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeRepository,
	getRuntimeReportLandscapeRepositoryContributorDetail,
} from "../../../../../../lib/runtime-client.js";
import { getContributorMonthlyActivity } from "@planetnik/report-ui/contributors/contributorHeatmap";
import RepositoryContributorDetailView from "@planetnik/report-ui/views/RepositoryContributorDetailView";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const repo = getHostedReportRepoKeyFromParam(Astro.params.repo ?? "");
const email = getHostedReportContributorEmailFromParam(Astro.params.email ?? "");
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

if (reportDetail.context?.reportMode !== "landscape") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const repository = repo
	? await getRuntimeReportLandscapeRepository(cookie, slug, repo)
	: null;
if (!repository) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const contributor = email
	? await getRuntimeReportLandscapeRepositoryContributorDetail(cookie, slug, repo, email)
	: null;

if (!contributor) {
	return Astro.redirect(getHostedReportRepositoryPageHref(slug, repo, "/contributors"));
}

const collaborators = contributor.collaborators.map((entry) => ({
	email: entry.email,
	displayName: entry.displayName,
	sharedFiles: entry.sharedFiles,
	href: getHostedReportRepositoryContributorHref(slug, repo, entry.email),
}));

const dailyActivity = [...contributor.dailyActivity];
const monthlyActivity = getContributorMonthlyActivity(dailyActivity);

const topCollaboratorHref = contributor.topCollaboratorEmail
	? getHostedReportRepositoryContributorHref(slug, repo, contributor.topCollaboratorEmail)
	: null;
---

<AppShell
	title={`${contributor.displayName} Contributor`}
	subtitle={`${repository.name} · Contributors`}
	shellContext={buildHostedRepositoryShellContext(reportDetail, repository)}
>
	<RepositoryContributorDetailView
		repoName={repository.name}
		backHref={getHostedReportRepositoryPageHref(slug, repo, "/contributors")}
		contributorName={contributor.displayName}
		email={contributor.email}
		isActive={contributor.status === "Active"}
		isRookie={contributor.status === "Rookie"}
		commitsCount={contributor.commitsCount}
		activeDays={contributor.activeDays}
		filesCount={contributor.filesCount}
		collaboratorsCount={contributor.collaboratorsCount}
		firstCommitDate={contributor.firstCommitDate}
		latestCommitDate={contributor.latestCommitDate}
		commitsCount30Days={contributor.commitsCount30Days}
		commitsCount90Days={contributor.commitsCount90Days}
		commitsCount180Days={contributor.commitsCount180Days}
		commitsCount365Days={contributor.commitsCount365Days}
		topCollaboratorName={contributor.topCollaboratorDisplayName}
		topCollaboratorHref={topCollaboratorHref}
		extensions={[...contributor.extensions]}
		components={[...contributor.logicalComponents]}
		collaborators={collaborators}
		touchedFiles={contributor.topFiles.map((f) => ({
			relativePath: f.relativePath,
			commits: f.commits,
			logicalComponents: [...f.logicalComponents],
			concerns: [...f.concerns],
		}))}
		dailyActivity={dailyActivity}
		monthlyActivity={monthlyActivity}
		{...(contributor.impact ? { impact: {
			glueScore: contributor.impact.glueScore,
			snackingScore: contributor.impact.snackingScore,
			structuralImpactScore: contributor.impact.structuralImpactScore,
			visibleActivityScore: contributor.impact.visibleActivityScore,
			dominantDimension: contributor.impact.dominantDimension,
			isGlue: contributor.impact.isGlue,
			isSnacking: contributor.impact.isSnacking,
			reasons: [...contributor.impact.reasons],
		} } : {})}
	/>
</AppShell>
