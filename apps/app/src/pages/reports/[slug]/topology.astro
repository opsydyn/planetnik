---
import RepositoryTopologyView from "@planetnik/report-ui/views/RepositoryTopologyView";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportTopology,
} from "../../../lib/runtime-client.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const topology = await getRuntimeReportTopology(cookie, slug);
if (!topology) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

type DimKey =
	| "complexity_reduction"
	| "boundary_shaping"
	| "knowledge_spread"
	| "coordination_relief"
	| "change_enablement";

const periods = Object.fromEntries(
	Object.entries(topology.periodsData).map(([k, v]) => [
		k,
		v.map((d) => ({ from: d.from, to: d.to, count: d.count, files: [...d.files] })),
	]),
);

const impactPeriods = Object.fromEntries(
	Object.entries(topology.impactPeriods).map(([k, v]) => [
		k,
		v.map((c) => ({
			email: c.email,
			display_name: c.display_name,
			glue_score: c.glue_score,
			snacking_score: c.snacking_score,
			structural_impact_score: c.structural_impact_score,
			visible_activity_score: c.visible_activity_score,
			collaborator_count: c.collaborator_count,
			shared_files_count: c.shared_files_count,
			commits_count: c.commits_count,
			files_touched: c.files_touched,
			components_touched: c.components_touched,
			dominant_dimension: c.dominant_dimension as DimKey,
			dimensions: c.dimensions as Record<DimKey, number>,
			top_components: [...c.top_components],
			top_routes: [...c.top_routes],
			reasons: [...c.reasons],
			is_glue: c.is_glue,
			is_snacking: c.is_snacking,
		})),
	]),
);
---

<AppShell
	title={`${reportDetail.report.name} Topology`}
	subtitle="Contributors connected by shared file modifications"
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryTopologyView
		heading={reportDetail.report.name}
		subtitle="Contributors connected by shared file modifications"
		periods={periods}
		impactPeriods={impactPeriods}
	/>
</AppShell>
