---
import RepositoryDuplicationView from "@planetnik/report-ui/views/RepositoryDuplicationView";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	buildReportDuplicationViewModel,
} from "../../../lib/report-duplication-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportDuplication,
} from "../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const duplication = await getRuntimeReportDuplication(cookie, slug);
if (!duplication) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportDuplicationViewModel({
	reportName: reportDetail.report.name,
	duplication,
});
---

<AppShell
	title={`${viewModel.heading} Duplication`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryDuplicationView
		heading={viewModel.heading}
		subtitle={viewModel.subtitle}
		cards={viewModel.cards}
		blockSizeDistribution={viewModel.blockSizeDistribution}
		mostDuplicatedFiles={viewModel.mostDuplicatedFiles}
		blockGridRows={viewModel.blockGridRows}
	/>
</AppShell>
