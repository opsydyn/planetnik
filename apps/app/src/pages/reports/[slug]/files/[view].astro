---
import AppShell from "../../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../../lib/hosted-shell.js";
import {
	getRuntimeReport,
	getRuntimeReportFilesView,
} from "../../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../../lib/report-detail-view-model.js";
import RepositoryFilesView from "@planetnik/report-ui/views/RepositoryFilesView";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const view = Astro.params.view;

if (view !== "size" && view !== "age" && view !== "churn" && view !== "temporal") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const files = await getRuntimeReportFilesView(cookie, slug, view);
if (!files) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const routeBase = `/reports/${slug}/files`;
const viewLinks = [
	{ label: "Size", href: `${routeBase}/size`, active: view === "size" },
	{ label: "Age", href: `${routeBase}/age`, active: view === "age" },
	{ label: "Churn", href: `${routeBase}/churn`, active: view === "churn" },
	{ label: "Temporal", href: `${routeBase}/temporal`, active: view === "temporal" },
];

const AGE_RISK_COLORS = ["#22c55e", "#84cc16", "#eab308", "#f97316", "#ef4444"];

const sizeProps = files.view === "size" ? {
	fileCount: files.headline.fileCount,
	totalLoc: files.headline.totalLinesOfCode,
	distribution: files.sizeDistribution.map((item) => ({
		label: item.label,
		value: item.value,
		detail: item.detail,
	})),
	largestFiles: [...files.largestFiles],
	rows: files.rows.map((r) => ({
		id: r.relativePath,
		file: r.relativePath,
		extension: r.extension,
		linesOfCode: r.linesOfCode,
	})),
} : undefined;

const ageProps = files.view === "age" ? {
	ageInDays: files.headline.ageInDays,
	activeDays: files.headline.activeDays,
	weeks: files.headline.weeks,
	distribution: files.categories.map((cat, i) => ({
		label: cat.label,
		value: cat.value,
		detail: `${cat.value.toLocaleString()} files`,
		color: AGE_RISK_COLORS[i] ?? "#94a3b8",
	})).filter((d) => d.value > 0),
	detailRows: files.categories.map((cat, i) => ({
		id: String(i),
		category: cat.label,
		files: cat.value,
	})),
} : undefined;

const churnProps = files.view === "churn" ? (() => {
	const rowsWithHistory = files.rows.filter((r) => (r.commitsCount ?? 0) > 0);
	const churnScatter = rowsWithHistory.slice(0, 200).map((r) => ({
		x: r.commitsCount ?? 0,
		y: r.contributorsCount ?? 0,
		label: r.relativePath.split("/").pop() ?? r.relativePath,
	}));
	const volatilityScatter = rowsWithHistory.slice(0, 200).map((r) => ({
		x: r.linesOfCode,
		y: r.commitsCount ?? 0,
		label: r.relativePath.split("/").pop() ?? r.relativePath,
	}));
	const mostChanged = [...files.mostChangedFiles];
	return {
		activeDays: files.headline.activeDays,
		weeks: files.headline.weeks,
		estimatedWorkingDays: files.headline.estimatedWorkingDays,
		filesWithHistoryCount: files.headline.filesWithHistoryCount,
		churnScatter,
		volatilityScatter,
		mostChanged,
		rows: rowsWithHistory.map((r) => ({
			id: r.relativePath,
			file: r.relativePath,
			commits: r.commitsCount ?? 0,
			contributors: r.contributorsCount ?? 0,
			firstChange: r.firstDate ?? "",
			lastChange: r.latestDate ?? "",
		})),
	};
})() : undefined;

const temporalProps = files.view === "temporal" ? {
	sections: files.sections.map((s) => ({
		periodKey: s.periodKey,
		periodLabel: s.periodLabel,
		periodDays: s.periodDays,
		dependencies: s.dependencies.map((d) => ({
			periodKey: s.periodKey,
			periodLabel: s.periodLabel,
			periodDays: s.periodDays,
			file1: d.file1,
			file2: d.file2,
			sameCommits: d.sameCommits,
			commitsFile1: d.commitsFile1,
			commitsFile2: d.commitsFile2,
			latestCommit: d.latestCommit,
		})),
	})),
} : undefined;

const viewTitle = view === "size" ? "File Size" : view === "age" ? "File Age" : view === "churn" ? "File Churn" : "Temporal Dependencies";
---

<AppShell
	title={viewTitle}
	subtitle={`${reportDetail.report.name} · Files`}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryFilesView
		view={view}
		repoName={reportDetail.report.name}
		viewLinks={viewLinks}
		{...(sizeProps ? { size: sizeProps } : {})}
		{...(ageProps ? { age: ageProps } : {})}
		{...(churnProps ? { churn: churnProps } : {})}
		{...(temporalProps ? { temporal: temporalProps } : {})}
	/>
</AppShell>
