---
import RepositoryDependenciesView from "@planetnik/report-ui/views/RepositoryDependenciesView";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	buildReportDependenciesViewModel,
} from "../../../lib/report-dependencies-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportDependencies,
} from "../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const dependencies = await getRuntimeReportDependencies(cookie, slug);
if (!dependencies) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportDependenciesViewModel({
	reportName: reportDetail.report.name,
	dependencies,
});
---

<AppShell
	title={`${viewModel.heading} Dependencies`}
	subtitle={viewModel.subtitle}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryDependenciesView
		heading={viewModel.heading}
		subtitle={viewModel.subtitle}
		cards={viewModel.cards}
		sections={viewModel.sections}
	/>
</AppShell>
