---
import LandscapeOverviewView from "@planetnik/report-ui/views/LandscapeOverviewView";
import AppShell from "../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../lib/hosted-shell.js";
import {
	buildReportOverviewViewModel,
} from "../../../lib/report-overview-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportLandscapeOverview,
} from "../../../lib/runtime-client.js";
import { buildReportLandscapeOverviewViewModel } from "../../../lib/report-landscape-overview-view-model.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const viewModel = buildReportOverviewViewModel(reportDetail);
const reportCreated = Astro.url.searchParams.get("reportCreated") === "1";
const isLandscapeReport = reportDetail.context?.reportMode === "landscape";
const landscapeOverview =
	isLandscapeReport ? await getRuntimeReportLandscapeOverview(cookie, slug) : null;
const landscapeViewModel =
	isLandscapeReport && landscapeOverview
		? buildReportLandscapeOverviewViewModel({
				slug,
				overview: landscapeOverview,
			})
		: null;
const shellTitle = landscapeViewModel
	? "Landscape Dashboard"
	: `${viewModel.heading} Overview`;
const shellSubtitle = landscapeViewModel ? "" : viewModel.subtitle;
---

<AppShell
	title={shellTitle}
	subtitle={shellSubtitle}
	shellContext={buildHostedReportShellContext(reportDetail)}
	headerMode={landscapeViewModel ? "breadcrumbs" : "full"}
>
	<div class="dashboard-stack">
		{reportCreated ? (
			<section class="callout">
				<strong>Report created.</strong>
				<span> The hosted overview is now reading the linked report summary.</span>
			</section>
		) : null}

		{landscapeViewModel ? (
			<LandscapeOverviewView
				heading={landscapeViewModel.heading}
				subtitle={landscapeViewModel.subtitle}
				cards={landscapeViewModel.cards}
				languageMix={landscapeViewModel.languageMix}
				largestLanguages={landscapeViewModel.largestLanguages}
				topRepositories={landscapeViewModel.topRepositories}
				languageInventory={landscapeViewModel.languageInventory}
				mutedNote={landscapeViewModel.mutedNote}
			/>
		) : (
			<>
				<header class="page-header">
					<h2>{viewModel.heading}</h2>
					<p class="subtitle">{viewModel.subtitle}</p>
				</header>

				<section class="stats-grid">
					{viewModel.cards.map((card) => (
						<article class="stat-card">
							<div class="stat-value">{card.value}</div>
							<div class="stat-label">{card.label}</div>
							{card.detail ? <div class="stat-detail">{card.detail}</div> : null}
						</article>
					))}
				</section>

				<nav class="report-nav">
					<a href={`/reports/${slug}/contributors`}>Contributors</a>
					<a href={`/reports/${slug}/topology`}>Topology</a>
					<a href={`/reports/${slug}/files/size`}>Files</a>
					<a href={`/reports/${slug}/units/size`}>Units</a>
					<a href={`/reports/${slug}/hotspots`}>Hotspots</a>
					<a href={`/reports/${slug}/commits`}>Commits</a>
					<a href={`/reports/${slug}/metrics`}>Metrics</a>
					<a href={`/reports/${slug}/dependencies`}>Dependencies</a>
					<a href={`/reports/${slug}/duplication`}>Duplication</a>
					<a href={`/reports/${slug}/controls`}>Controls</a>
					<a href={`/reports/${slug}/impact`}>Impact</a>
					<a href={`/reports/${slug}/trends`}>Trends</a>
					{isLandscapeReport ? (
						<a href={`/reports/${slug}/repositories`}>Repositories</a>
					) : null}
					{isLandscapeReport ? (
						<a href={`/reports/${slug}/security`}>Security</a>
					) : null}
				</nav>
			</>
		)}
	</div>
</AppShell>

<style>
	.page-header { margin-bottom: 1.25rem; }
	.page-header h2 { margin-bottom: 0.25rem; }
	.subtitle { color: var(--color-text-muted); font-size: 0.9rem; margin-top: 0.35rem; }

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}
	.stat-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 1.25rem;
	}
	.stat-value { font-size: 1.75rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
	.stat-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
	.stat-detail { font-size: 0.75rem; color: var(--color-text-muted); margin-top: 0.35rem; }

	.report-nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
	.report-nav a {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-drawer);
		color: var(--color-text);
		font-size: 0.875rem;
		padding: 0.5rem 1rem;
		text-decoration: none;
		transition: border-color 0.15s, color 0.15s;
	}
	.report-nav a:hover {
		border-color: var(--color-accent);
		color: var(--color-accent);
	}
</style>
