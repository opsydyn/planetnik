---
import AppShell from "../../../layouts/AppShell.astro";
import { buildReportCommitsViewModel } from "../../../lib/report-commits-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportCommits,
} from "../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const commits = await getRuntimeReportCommits(cookie, slug);
if (!commits) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportCommitsViewModel({
	reportName: reportDetail.report.name,
	commits,
});
---

<AppShell
	title={`${viewModel.heading} Commits`}
	subtitle={viewModel.subtitle}
>
	<div class="dashboard-stack">
		<section class="dashboard-card dashboard-card-primary">
			<p class="card-kicker">Commits</p>
			<h2>{viewModel.heading}</h2>
			<p>
				This hosted route reads the same commit activity exports as the static
				report app and keeps the backend contract explicit before the shared UI
				pass.
			</p>
			<div class="card-actions">
				<a class="button-secondary" href={`/reports/${slug}/overview`}>
					Open overview
				</a>
				<a class="button-secondary" href={`/reports/${slug}/contributors`}>
					Open contributors
				</a>
				<a class="button" href="/sign-out">Sign out</a>
			</div>
		</section>

		<section class="overview-cards">
			{viewModel.cards.map((card) => (
				<article class="dashboard-card">
					<p class="card-kicker">{card.label}</p>
					<h2>{card.value}</h2>
					{card.detail ? <p>{card.detail}</p> : <p> </p>}
				</article>
			))}
		</section>

		<section class="dashboard-grid">
			{viewModel.sections.map((section) => (
				<article class="dashboard-card">
					<p class="card-kicker">Commits</p>
					<h2>{section.title}</h2>
					{section.rows.length > 0 ? (
						<ul class="todo-list">
							{section.rows.map((row) => (
								<li>
									<strong>{row.label}</strong>: {row.value}
								</li>
							))}
						</ul>
					) : (
						<p class="muted-copy">No exported commit rows are available.</p>
					)}
				</article>
			))}
		</section>
	</div>
</AppShell>
