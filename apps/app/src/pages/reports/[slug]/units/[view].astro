---
import AppShell from "../../../../layouts/AppShell.astro";
import { buildHostedReportShellContext } from "../../../../lib/hosted-shell.js";
import {
	getRuntimeReport,
	getRuntimeReportUnitsView,
} from "../../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../../lib/report-detail-view-model.js";
import RepositoryUnitsView from "@planetnik/report-ui/views/RepositoryUnitsView";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const view = Astro.params.view;

if (view !== "size" && view !== "complexity") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const units = await getRuntimeReportUnitsView(cookie, slug, view);
if (!units) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const routeBase = `/reports/${slug}/units`;
const viewLinks = [
	{ label: "Size", href: `${routeBase}/size`, active: view === "size" },
	{ label: "Complexity", href: `${routeBase}/complexity`, active: view === "complexity" },
];

const sizeProps = units.view === "size" ? {
	unitCount: units.headline.unitCount,
	totalLoc: units.headline.totalLinesOfCode,
	sizeRisk: [...units.sizeRisk],
	sizeDistribution: units.sizeDistribution.map((item) => ({
		label: item.label,
		value: item.value,
		detail: item.detail,
	})),
	rows: units.rows.map((r) => ({
		id: `${r.relativeFileName}:${r.startLine}`,
		unit: r.shortName,
		file: r.relativeFileName,
		linesOfCode: r.linesOfCode,
		mcCabeIndex: r.mcCabeIndex,
		numberOfParameters: r.numberOfParameters,
	})),
} : undefined;

const complexityProps = units.view === "complexity" ? (() => {
	const sorted = [...units.rows].sort((a, b) => b.mcCabeIndex - a.mcCabeIndex);
	const complexityScatter = sorted.slice(0, 200).map((r) => ({
		x: r.linesOfCode,
		y: r.mcCabeIndex,
		label: r.shortName,
	}));
	return {
		unitCount: units.headline.unitCount,
		complexityRisk: [...units.complexityRisk],
		complexityDistribution: units.complexityDistribution.map((item) => ({
			label: item.label,
			value: item.value,
			detail: item.detail,
		})),
		complexityScatter,
		rows: sorted.map((r) => ({
			id: `${r.relativeFileName}:${r.startLine}`,
			unit: r.shortName,
			file: r.relativeFileName,
			mcCabeIndex: r.mcCabeIndex,
			linesOfCode: r.linesOfCode,
		})),
	};
})() : undefined;

const viewTitle = view === "size" ? "Unit Size" : "Conditional Complexity";
---

<AppShell
	title={viewTitle}
	subtitle={`${reportDetail.report.name} · Units`}
	shellContext={buildHostedReportShellContext(reportDetail)}
>
	<RepositoryUnitsView
		view={view}
		repoName={reportDetail.report.name}
		viewLinks={viewLinks}
		{...(sizeProps ? { size: sizeProps } : {})}
		{...(complexityProps ? { complexity: complexityProps } : {})}
	/>
</AppShell>
