---
import AppShell from "../../../../layouts/AppShell.astro";
import { buildReportUnitsViewModel } from "../../../../lib/report-units-view-model.js";
import {
	getRuntimeReport,
	getRuntimeReportUnitsView,
} from "../../../../lib/runtime-client.js";
import {
	shouldRedirectReportDetail,
} from "../../../../lib/report-detail-view-model.js";

const cookie = Astro.request.headers.get("cookie") ?? "";
const slug = Astro.params.slug ?? "";
const view = Astro.params.view;

if (view !== "size" && view !== "complexity") {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const reportDetail = slug ? await getRuntimeReport(cookie, slug) : null;

if (shouldRedirectReportDetail(reportDetail)) {
	return Astro.redirect("/");
}

const units = await getRuntimeReportUnitsView(cookie, slug, view);
if (!units) {
	return Astro.redirect(`/reports/${slug}/overview`);
}

const viewModel = buildReportUnitsViewModel({
	reportName: reportDetail.report.name,
	slug,
	units,
});
---

<AppShell title={`${viewModel.heading} Units`} subtitle={viewModel.subtitle}>
	<div class="dashboard-stack">
		<section class="dashboard-card dashboard-card-primary">
			<p class="card-kicker">Units</p>
			<h2>{viewModel.heading}</h2>
			<p>
				This hosted route keeps the static unit-view semantics intact while the
				shared chart and grid extraction is still deferred.
			</p>
			<div class="card-actions">
				{viewModel.viewLinks.map((link) => (
					<a
						class={link.active ? "button" : "button-secondary"}
						href={link.href}
					>
						{link.label}
					</a>
				))}
				<a class="button-secondary" href={`/reports/${slug}/overview`}>
					Open overview
				</a>
			</div>
		</section>

		<section class="overview-cards">
			{viewModel.cards.map((card) => (
				<article class="dashboard-card">
					<p class="card-kicker">{card.label}</p>
					<h2>{card.value}</h2>
					{card.detail ? <p>{card.detail}</p> : <p> </p>}
				</article>
			))}
		</section>

		<section class="dashboard-grid">
			{viewModel.sections.map((section) => (
				<article class="dashboard-card">
					<p class="card-kicker">Units</p>
					<h2>{section.title}</h2>
					{section.rows.length > 0 ? (
						<ul class="todo-list">
							{section.rows.map((row) => (
								<li>
									<strong>{row.label}</strong>: {row.value}
								</li>
							))}
						</ul>
					) : (
						<p class="muted-copy">No exported rows are available for this view.</p>
					)}
				</article>
			))}
		</section>
	</div>
</AppShell>
