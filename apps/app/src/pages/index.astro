---
import AppShell from "../layouts/AppShell.astro";
import { SERVER_BASE_URL } from "../lib/constants.js";

const sessionSnapshot = JSON.stringify(
	{
		user: Astro.locals.user,
		session: Astro.locals.session,
	},
	null,
	2,
);
---

<AppShell
	title="Hosted intelligence shell"
	subtitle="Authenticated SSR placeholder for the future hosted product. The app shell is intentionally thin; data-rich screens come after auth and session flow are proven."
>
	<div class="stack">
		<p class="callout">
			Session resolution happens in Astro middleware, and the browser talks
			directly to the runtime auth server just like the reference application.
		</p>

		<div class="split-actions">
			<a class="button" href="/sign-out">Sign out</a>
			<a class="button-secondary" href={`${SERVER_BASE_URL}/api/auth/get-session`}>
				Inspect session JSON
			</a>
		</div>

		<div class="json-card">
			<h2>Current Session Snapshot</h2>
			<pre class="json-block">{sessionSnapshot}</pre>
		</div>
	</div>
</AppShell>
