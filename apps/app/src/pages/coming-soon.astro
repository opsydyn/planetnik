---
import PublicVideoToggle from "../components/public/PublicVideoToggle";
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Planetnik Platform — Coming Soon</title>
    <script is:inline data-astro-rerun>
      (() => {
        const THEME_ATTR = "data-theme"
        const PREFERENCE_ATTR = "data-theme-preference"
        const STORAGE_KEY = "planetnik-theme-preference"
        const root = document.documentElement
        const isPreference = (value) => value === "light" || value === "dark" || value === "system"
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        const storedPreference = localStorage.getItem(STORAGE_KEY)
        const preference = isPreference(storedPreference) ? storedPreference : "system"
        const effectiveTheme = preference === "system" ? systemTheme : preference
        root.setAttribute(PREFERENCE_ATTR, preference)
        root.setAttribute(THEME_ATTR, effectiveTheme)
        root.style.colorScheme = effectiveTheme
      })()
    </script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-height: 100vh;
        display: grid;
        align-items: center;
        padding: 2rem 2.5rem;
        position: relative;
        isolation: isolate;
        overflow: hidden;
        background: #020817;
        color: #f8fafc;
      }

      .video-layer {
        position: absolute;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }

      .bg-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.9) contrast(1.02);
        opacity: 0.3;
      }

      .video-overlay {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 16% 18%, rgba(245, 158, 11, 0.22), transparent 28%),
          radial-gradient(circle at 82% 16%, rgba(249, 115, 22, 0.16), transparent 24%),
          radial-gradient(circle at 72% 72%, rgba(132, 204, 22, 0.12), transparent 22%),
          radial-gradient(circle at 18% 78%, rgba(59, 130, 246, 0.12), transparent 26%),
          linear-gradient(
            135deg,
            rgba(54, 33, 11, 0.42) 0%,
            rgba(116, 63, 17, 0.28) 22%,
            rgba(74, 56, 24, 0.22) 46%,
            rgba(24, 36, 62, 0.3) 70%,
            rgba(2, 8, 23, 0.58) 100%
          );
      }

      .inner {
        display: grid;
        gap: 2rem;
        width: min(1240px, 100%);
        margin: 0 auto;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        width: 100%;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        color: rgba(248, 250, 252, 0.6);
        font-size: 0.875rem;
        text-decoration: none;
        transition: color 0.15s;
      }
      .back-link:hover { color: #f8fafc; }

      .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 0.65rem;
        padding: 0.7rem 0.95rem;
        border: 1px solid rgba(248, 250, 252, 0.12);
        border-radius: 999px;
        background: rgba(15, 23, 42, 0.6);
        color: rgba(248, 250, 252, 0.6);
        font-size: 0.875rem;
        backdrop-filter: blur(8px);
      }

      .status-dot {
        width: 0.6rem;
        height: 0.6rem;
        border-radius: 999px;
        background: linear-gradient(180deg, #6366f1, #84cc16);
        box-shadow: 0 0 0 6px rgba(99, 102, 241, 0.12);
      }

      .content-grid {
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        min-height: min(720px, calc(100vh - 10rem));
      }

      .auth-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.35rem;
        width: min(520px, 100%);
      }

      .panel {
        min-width: 0;
        border: 1px solid rgba(248, 250, 252, 0.1);
        border-radius: 24px;
        background: color-mix(in srgb, rgba(15, 23, 42, 0.9) 76%, transparent);
        backdrop-filter: blur(16px);
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.4);
      }

      .hero-panel { padding: 1.9rem 2rem; }

      .eyebrow {
        color: #6366f1;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-panel h1 {
        margin: 0.6rem 0 0.8rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.6rem, 3.6vw, 4.4rem);
        line-height: 0.94;
        max-width: 8ch;
        color: #f8fafc;
      }

      .lede {
        margin: 0;
        max-width: 24rem;
        color: rgba(248, 250, 252, 0.6);
        font-size: 1.05rem;
        line-height: 1.6;
      }

      .surface-panel { padding: 2rem; overflow: hidden; }

      .coming-soon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #a5b4fc;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
      }

      .coming-soon-badge-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #6366f1;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.8); }
      }

      .coming-soon-heading {
        font-size: 1.35rem;
        font-weight: 700;
        color: #f8fafc;
        margin-bottom: 0.75rem;
        line-height: 1.3;
      }

      .coming-soon-body {
        color: rgba(248, 250, 252, 0.65);
        font-size: 0.95rem;
        line-height: 1.65;
        margin-bottom: 1.5rem;
      }

      .coming-soon-features {
        list-style: none;
        display: grid;
        gap: 0.6rem;
        margin-bottom: 1.75rem;
      }

      .coming-soon-features li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        font-size: 0.9rem;
        color: rgba(248, 250, 252, 0.7);
        line-height: 1.4;
      }

      .feature-dot {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: #6366f1;
        flex-shrink: 0;
        margin-top: 0.45rem;
      }

      .coming-soon-cta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: #6366f1;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        transition: background 0.15s, transform 0.15s;
      }
      .btn-primary:hover { background: #4f46e5; transform: translateY(-1px); }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: transparent;
        color: rgba(248, 250, 252, 0.7);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid rgba(248, 250, 252, 0.15);
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-secondary:hover { border-color: rgba(248, 250, 252, 0.35); color: #f8fafc; }

      .coming-soon-video-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.4rem 0.85rem;
        border-radius: 999px;
        background: rgba(248, 250, 252, 0.06);
        border: 1px solid rgba(248, 250, 252, 0.12);
        color: rgba(248, 250, 252, 0.55);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .coming-soon-video-toggle:hover {
        background: rgba(248, 250, 252, 0.1);
        color: rgba(248, 250, 252, 0.85);
      }

      @media (max-width: 640px) {
        body { padding: 1.5rem 1.25rem; }
        .content-grid { justify-content: center; min-height: auto; }
        .auth-stack { width: 100%; }
      }
    </style>
  </head>
  <body>
    <div class="video-layer" aria-hidden="true">
      <video
        id="public-video-player"
        class="bg-video"
        autoplay
        muted
        playsinline
        preload="metadata"
        src="/movie.mp4"
        data-playlist="/movie.mp4,/movie-2.mp4,/movie-3.mp4,/movie-4.mp4,/movie-5.mp4,/movie-6.mp4"
      >
        <source src="/movie.mp4" type="video/mp4" />
      </video>
      <audio id="public-audio-player" preload="metadata" src="/Lightningcore.mp3" loop></audio>
      <div class="video-overlay"></div>
    </div>

    <div class="inner">
      <header class="topbar">
        <a href="/" class="back-link">← Back to workspace</a>
        <span class="status-pill">
          <span class="status-dot"></span>
          Planetnik Platform
        </span>
      </header>

      <main class="content-grid">
        <div class="auth-stack">
          <div class="panel hero-panel">
            <p class="eyebrow">Astro + Bun + Effect</p>
            <h1>The platform is coming.</h1>
            <p class="lede">A hosted workspace for every team that cares about the shape of their software.</p>
          </div>

          <div class="panel surface-panel">
            <div class="coming-soon-badge">
              <span class="coming-soon-badge-dot"></span>
              In development
            </div>

            <h2 class="coming-soon-heading">Planetnik Platform — Early Access</h2>

            <p class="coming-soon-body">
              We're building a fully hosted version of Planetnik — connect your repositories,
              invite your team, and get continuous structural health monitoring without running
              anything yourself.
            </p>

            <ul class="coming-soon-features">
              <li><span class="feature-dot"></span>Hosted analysis runs on every push — no CI configuration required</li>
              <li><span class="feature-dot"></span>Multi-repository landscape view across your entire organisation</li>
              <li><span class="feature-dot"></span>Team-aware hotspot tracking and structural impact scoring</li>
              <li><span class="feature-dot"></span>Płanetnik AI — ask questions, get answers grounded in your codebase</li>
              <li><span class="feature-dot"></span>Goals &amp; Controls with trend tracking over time</li>
            </ul>

            <div class="coming-soon-cta">
              <a
                href="https://github.com/planetnik"
                class="btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                Follow on GitHub
              </a>
              <a href="/" class="btn-secondary">Back to workspace</a>
              <PublicVideoToggle client:load />
            </div>
          </div>
        </div>
      </main>
    </div>

    <script is:inline>
      function setupVideoPlaylist() {
        const video = document.getElementById("public-video-player")
        if (!(video instanceof HTMLVideoElement)) return

        const playlist = (video.dataset.playlist ?? "")
          .split(",").map(s => s.trim()).filter(Boolean)
        if (playlist.length < 2) return

        let currentIndex = Math.max(0, playlist.indexOf(video.getAttribute("src") ?? ""))

        const playIndex = (index) => {
          currentIndex = index
          const src = playlist[currentIndex]
          if (!src) return
          if (video.getAttribute("src") !== src) {
            video.setAttribute("src", src)
            video.load()
          }
          video.play().catch(() => {})
        }

        video.onended = () => playIndex((currentIndex + 1) % playlist.length)
        video.onloadedmetadata = () => video.play().catch(() => {})

        const paused = localStorage.getItem("planetnik.publicVideoPaused") === "true"
        if (!paused) playIndex(currentIndex)
      }

      document.addEventListener("astro:page-load", setupVideoPlaylist)
      setupVideoPlaylist()
    </script>
  </body>
</html>
