---
import AdminUserDashboard from "../../components/admin/AdminUserDashboard";
import AppShell from "../../layouts/AppShell.astro";

const userRole =
	typeof Astro.locals.user?.role === "string" ? Astro.locals.user.role : "unknown";
const userId = typeof Astro.locals.user?.id === "string" ? Astro.locals.user.id : "";
---

<AppShell
	title="Admin dashboard"
	subtitle="Manage hosted users, roles, and passwords through the runtime-backed Better Auth admin surface."
	shellContext={{ kind: "dashboard" }}
>
	<AdminUserDashboard
		client:load
		currentUserId={userId}
		currentUserRole={userRole}
	/>
</AppShell>
