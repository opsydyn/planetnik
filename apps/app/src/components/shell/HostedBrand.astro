---
import type { HostedBrandModel } from "../../lib/hosted-shell.js";

interface Props {
	brand: HostedBrandModel;
}

const { brand } = Astro.props;
---

<a class:list={["nav-logo-link", `hosted-brand-${brand.variant}`]} href={brand.href}>
	<span class="nav-wordmark">
		<span class="nav-wordmark-kicker">{brand.kicker}</span>
		<span class="nav-wordmark-title">{brand.title}</span>
		{brand.subtitle ? <span class="nav-wordmark-subtitle">{brand.subtitle}</span> : null}
	</span>
</a>
