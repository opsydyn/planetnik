---
import type { HostedBrandModel } from "../../lib/hosted-shell.js";

interface Props {
	brand: HostedBrandModel;
}

const { brand } = Astro.props;
---

<a class:list={["hosted-brand", `hosted-brand-${brand.variant}`]} href={brand.href}>
	<span class="hosted-brand-kicker">{brand.kicker}</span>
	<span class="hosted-brand-title">{brand.title}</span>
	{brand.subtitle ? <span class="hosted-brand-subtitle">{brand.subtitle}</span> : null}
</a>
