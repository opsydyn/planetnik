---
import SystemIcon from "@planetnik/report-ui/icons/SystemIcon";
import Breadcrumb from "@planetnik/report-ui/shell/Breadcrumb";
import PlanetnikLogo from "@planetnik/report-ui/shell/PlanetnikLogo";
import ThemeSwitcher from "@planetnik/report-ui/theme-switcher/ThemeSwitcher";
import "@planetnik/report-ui/theme/dashboard-shell.css";
import { ClientRouter } from "astro:transitions";
import GlobalSearch from "../components/search/GlobalSearch";
import IntelligencePanelLoader from "../components/intelligence/IntelligencePanelLoader.astro";
import { isHostedIntelligenceEnabled } from "../lib/feature-flags.js";
import {
	buildHostedShellModel,
	isHostedNavItemActive,
	type HostedShellContext,
} from "../lib/hosted-shell.js";
import "../styles/global.css";

interface Props {
	title: string;
	subtitle: string;
	shellContext?: HostedShellContext;
	headerMode?: "full" | "breadcrumbs";
}

const { title, subtitle, shellContext, headerMode = "full" } = Astro.props;
const panelSlug =
	shellContext?.kind === "report" || shellContext?.kind === "repository"
		? shellContext.reportSlug
		: null;
const panelIsLandscape =
	shellContext?.kind === "report" || shellContext?.kind === "repository"
		? shellContext.reportMode === "landscape"
		: false;
const panelBaseHref = panelSlug ? `/reports/${panelSlug}` : null;
const showIntelligence = isHostedIntelligenceEnabled();
const userEmail =
	typeof Astro.locals.user?.email === "string" ? Astro.locals.user.email : null;
const shell = buildHostedShellModel({
	title,
	subtitle,
	currentPath: Astro.url.pathname,
	userEmail,
	context: shellContext,
	showIntelligence,
});
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="system">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="color-scheme" content="light dark" />
		<title>{title} | Planetnik App</title>
		<ClientRouter />
		<script is:inline data-astro-rerun>
			(() => {
				const THEME_ATTR = "data-theme"
				const PREFERENCE_ATTR = "data-theme-preference"
				const STORAGE_KEY = "planetnik-theme-preference"
				const root = document.documentElement
				const isPreference = (value) =>
					value === "light" || value === "dark" || value === "system"
				const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches
					? "dark"
					: "light"
				const storedPreference = localStorage.getItem(STORAGE_KEY)
				const preference = isPreference(storedPreference) ? storedPreference : "system"
				const effectiveTheme = preference === "system" ? systemTheme : preference

				root.setAttribute(PREFERENCE_ATTR, preference)
				root.setAttribute(THEME_ATTR, effectiveTheme)
				root.style.colorScheme = effectiveTheme
			})()
		</script>
	</head>
	<body data-shell={shell.chrome}>
		{shell.chrome === "public" ? (
			<div class="shell-public">
				<div class="public-video-layer" aria-hidden="true">
					<video
						id="public-video-player"
						class="public-video"
						muted
						loop
						playsinline
						preload="metadata"
						src="/movie-loop.mp4"
					>
						<source src="/movie-loop.mp4" type="video/mp4" />
					</video> 
					<audio
						id="public-audio-player"
						preload="metadata"
						src="/Lightningcore.mp3"
						loop
					></audio>
					<div class="public-video-overlay"></div>
				</div>
				<div class="shell-public-inner">
					<header class="public-topbar">
						<div class="topbar-meta">
							<span class="status-pill">
								<span class="status-dot"></span>
								{shell.sessionLabel}
							</span>
						</div>
					</header>

					<main class="public-content-grid">
						<div class="public-auth-stack">
						<section class="hero-panel">
							<p class="eyebrow">Astro + Bun + runtime auth boundary</p>
							<h1>{title}</h1>
							<p class="lede">{subtitle}</p>
						</section>

						<section class="surface-panel">
							<slot />
						</section>
						</div>
					</main>
				</div>
			</div>
		) : (
			<>
				<header class="topbar">
					<PlanetnikLogo href="/" src="/planetnik-logo-2.webp" variant="topbar" />
					<span class="topbar-project">
						{shell.scopeLabel ? <strong>{shell.scopeLabel}</strong> : "Hosted workspace"}
					</span>
					<button class="menu-toggle" id="menu-open" aria-label="Open navigation">
						<SystemIcon name="list" size={22} />
					</button>
				</header>

				<div class="nav-overlay" id="nav-overlay"></div>

				<nav id="sidebar">
					<div class="nav-header">
						<div class="nav-header-content">
							<PlanetnikLogo href="/" src="/planetnik-logo-2.webp" variant="sidebar" />
							{shell.scopeLabel ? <div class="project-name">{shell.scopeLabel}</div> : null}
						</div>
						<button class="nav-close" id="menu-close" aria-label="Close navigation">
							<SystemIcon name="x" size={20} />
						</button>
					</div>

					<div>
						{shell.navSections.map((section) => (
							<div class="nav-section">
								<div class="nav-section-label">
									<span>{section.label}</span>
								</div>
								<div>
									{section.items.map((item) => (
										<a
											class:list={[
												isHostedNavItemActive(Astro.url.pathname, item.href)
													? "active"
													: null,
											]}
											href={item.href}
										>
											{item.label}
										</a>
									))}
								</div>
							</div>
						))}
					</div>

					<button class="sidebar-toggle" id="sidebar-collapse" aria-label="Collapse sidebar">
						<SystemIcon name="sidebar-simple" size={14} />
						<span>Collapse</span>
					</button>
				</nav>

				<button class="sidebar-expand" id="sidebar-expand" aria-label="Expand sidebar">
					<SystemIcon name="sidebar-simple" size={14} />
					<span>Menu</span>
				</button>

				<main>
					{headerMode === "full" ? (
						<div class="app-main-header">
							<div class="app-main-copy">
								{shell.breadcrumbs.length > 0 ? (
									<Breadcrumb items={shell.breadcrumbs} />
								) : null}
								<p class="eyebrow">Hosted report shell</p>
								<h1 class="app-page-title">{shell.pageTitle}</h1>
								<p class="app-page-subtitle">{shell.subtitle}</p>
							</div>

							<div class="app-topbar-meta">
								<span class="status-pill">
									<span class="status-dot"></span>
									{shell.sessionLabel}
								</span>
								<a class="button-secondary" href="/sign-out">Sign out</a>
							</div>
						</div>
					) : shell.breadcrumbs.length > 0 ? (
						<div class="app-breadcrumbs-only">
							<Breadcrumb items={shell.breadcrumbs} />
						</div>
					) : null}

					<section class="app-surface-panel">
						<slot />
					</section>
				</main>
				<div class="top-right-tools">
					<ThemeSwitcher />
					{panelSlug && (
						<GlobalSearch
							client:load
							projectName={shell.scopeLabel ?? title}
							searchIndexUrl={`/api/reports/${panelSlug}/search-index.json`}
						/>
					)}
				</div>
			</>
		)}

		<script is:inline data-astro-rerun>
			(() => {
				window.__planetnikPublicVideoController?.abort()

				const controller = new AbortController()
				window.__planetnikPublicVideoController = controller
				const { signal } = controller
				const PUBLIC_VIDEO_PAUSED_KEY = "planetnik.publicVideoPaused"

				function isVideoPaused() {
					const storedValue = localStorage.getItem(PUBLIC_VIDEO_PAUSED_KEY)
					if (storedValue === "true") return true
					if (storedValue === "false") return false
					localStorage.setItem(PUBLIC_VIDEO_PAUSED_KEY, "true")
					return true
				}

				function hasUserActivation() {
					const userActivation = navigator.userActivation
					return Boolean(userActivation?.isActive || userActivation?.hasBeenActive)
				}

				function setupPublicVideoPlaylist() {
					const video = document.getElementById("public-video-player")
					const audio = document.getElementById("public-audio-player")
					if (!(video instanceof HTMLVideoElement)) return

					const pauseAudio = () => {
						if (audio instanceof HTMLAudioElement) audio.pause()
					}

					const pauseAll = () => {
						video.pause()
						pauseAudio()
					}

					const resumeAll = () => {
						video.play().catch(() => {})
						if (audio instanceof HTMLAudioElement && hasUserActivation()) {
							audio.play().catch(() => {})
						} else {
							pauseAudio()
						}
					}

					const primePausedFrame = () => {
						pauseAudio()
						video.pause()
						if (video.networkState === HTMLMediaElement.NETWORK_EMPTY) {
							video.load()
						}
					}

					video.onloadeddata = () => {
						if (isVideoPaused()) {
							video.pause()
							return
						}
						resumeAll()
					}

					// Respond to atom changes dispatched by the React toggle.
					document.addEventListener("planetnik:video-paused-change", (e) => {
						if (e.detail?.paused) pauseAll()
						else resumeAll()
					}, { signal })

					// Spacebar toggles media (skip if focus is in an input/button).
					document.addEventListener("keydown", (e) => {
						if (e.code !== "Space") return
						if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement || e.target instanceof HTMLButtonElement) return
						e.preventDefault()
						const nowPaused = !isVideoPaused()
						localStorage.setItem(PUBLIC_VIDEO_PAUSED_KEY, String(nowPaused))
						document.dispatchEvent(new CustomEvent("planetnik:video-paused-change", { detail: { paused: nowPaused } }))
					}, { signal })

					if (isVideoPaused()) primePausedFrame()
					else resumeAll()
				}

				document.addEventListener("astro:page-load", setupPublicVideoPlaylist, { signal })
				setupPublicVideoPlaylist()
			})()
		</script>
		<script is:inline>
			function setupHostedShellNavigation() {
				const sidebar = document.getElementById("sidebar")
				const overlay = document.getElementById("nav-overlay")
				const openBtn = document.getElementById("menu-open")
				const closeBtn = document.getElementById("menu-close")

				if (!(sidebar instanceof HTMLElement)) return
				if (!(overlay instanceof HTMLElement)) return
				if (!(openBtn instanceof HTMLButtonElement)) return
				if (!(closeBtn instanceof HTMLButtonElement)) return

				function openNav() {
					sidebar.classList.add("open")
					overlay.classList.add("open")
					document.body.style.overflow = "hidden"
				}

				function closeNav() {
					sidebar.classList.remove("open")
					overlay.classList.remove("open")
					document.body.style.overflow = ""
				}

				openBtn.onclick = openNav
				closeBtn.onclick = closeNav
				overlay.onclick = closeNav

				sidebar.querySelectorAll(".nav-section a").forEach((link) => {
					if (link instanceof HTMLAnchorElement) {
						link.onclick = closeNav
					}
				})
			}

			document.addEventListener("astro:page-load", setupHostedShellNavigation)
			setupHostedShellNavigation()
		</script>
		<script is:inline>
			function setupHostedSidebarToggle() {
				const collapseBtn = document.getElementById("sidebar-collapse")
				const expandBtn = document.getElementById("sidebar-expand")

				if (!(collapseBtn instanceof HTMLButtonElement)) return
				if (!(expandBtn instanceof HTMLButtonElement)) return

				if (localStorage.getItem("sidebar-collapsed") === "true") {
					document.body.classList.add("sidebar-collapsed")
				}

				collapseBtn.onclick = () => {
					document.body.classList.add("sidebar-collapsed")
					localStorage.setItem("sidebar-collapsed", "true")
				}

				expandBtn.onclick = () => {
					document.body.classList.remove("sidebar-collapsed")
					localStorage.setItem("sidebar-collapsed", "false")
				}
			}

			document.addEventListener("astro:page-load", setupHostedSidebarToggle)
			setupHostedSidebarToggle()
		</script>
		<div transition:persist="intelligence-panel">
			{showIntelligence && panelSlug && panelBaseHref && (
				<IntelligencePanelLoader
					slug={panelSlug}
					isLandscape={panelIsLandscape}
					baseHref={panelBaseHref}
				/>
			)}
		</div>
	</body>
</html>
