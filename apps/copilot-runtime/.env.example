# Copy to .env for local development.

# OpenAI API key (required) — used by CopilotKit runtime
OPENAI_API_KEY=sk-...

# LLM model to use (optional, default: gpt-4o)
# COPILOT_MODEL=gpt-4o

# Server port (optional, default: 4111)
# COPILOT_PORT=4111

# CORS origin for the Astro site (optional, default: http://localhost:4321)
# COPILOT_CORS_ORIGIN=http://localhost:4321

# Analysis data directory for server-side tools (optional)
# When set, registers 6 server-side actions that give the agent direct access
# to the full analysis dataset (hotspots, files, contributors, impact, controls).
# Point at a previously analyzed repo's data dir:
# PLANETNIK_DATA_DIR=/absolute/path/to/repo/_planetnik/reports/data
