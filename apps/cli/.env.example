# Copy to .env for local development.
# Bun automatically loads .env from the working directory.

# GitHub API token for landscape analysis (optional)
# Used by `analyzeLandscape` to discover repositories via the GitHub API.
# If omitted, you can also set githubToken in the landscape config JSON.
# Tip: GITHUB_TOKEN=$(gh auth token) to use your gh CLI session.
GITHUB_TOKEN=

# Log verbosity: DEBUG | INFO (default) | WARNING | ERROR | NONE
# PLANETNIK_LOG_LEVEL=INFO

# Analysis data directory (optional, used by copilot-runtime server-side tools)
# PLANETNIK_DATA_DIR=/absolute/path/to/repo/_planetnik/reports/data
