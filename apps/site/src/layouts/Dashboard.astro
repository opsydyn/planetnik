---
import { getEntry } from "astro:content"
import { ClientRouter } from "astro:transitions"
import GlobalSearch from "../components/search/GlobalSearch"
import SystemIcon from "../components/icons/SystemIcon.astro"
import ThemeSwitcher from "../components/theme-switcher/ThemeSwitcher.astro"
import {
  getLandscapeRepositoryCommitsHref,
  getLandscapeRepositoryComponentsHref,
  getLandscapeRepositoryControlsHref,
  getLandscapeRepositoryDuplicationHref,
  getLandscapeRepositoryFilePageHref,
  getLandscapeRepositoryHotspotsHref,
  getLandscapeRepositoryHref,
  getLandscapeRepositoryImpactHref,
  getLandscapeRepositoryMetricsHref,
  getLandscapeRepositoryUnitPageHref,
} from "../lib/landscape"
import { shouldBypassClientRouter } from "../lib/reloadRoutes"
import { route } from "../lib/route"

interface Props {
  title: string
  projectName?: string
  repoScope?: {
    repoKey: string
    repoName: string
  }
}

const reportContext = await getEntry("reportContext", "context")
const reportMode = reportContext?.data.reportMode ?? "single_repository"
const { title, projectName = reportContext?.data.title ?? "Planetnik", repoScope } = Astro.props

const singleRepoNavSections = [
  {
    label: "Overview",
    iconName: "house",
    items: [
      { href: route("/about"), label: "About" },
      { href: route("/guide"), label: "Guide" },
      { href: route("/technology"), label: "Technology" },
      { href: route("/"), label: "Dashboard" },
      { href: route("/overview"), label: "Source Code Overview" },
      { href: route("/metrics"), label: "Metrics" },
    ],
  },
  {
    label: "Structure",
    iconName: "stack",
    items: [
      { href: route("/components"), label: "Components" },
      { href: route("/coupling"), label: "Balanced Coupling" },
      { href: route("/dependencies"), label: "Dependencies" },
      { href: route("/duplication"), label: "Duplication" },
    ],
  },
  {
    label: "Files",
    iconName: "files",
    items: [
      { href: route("/files/size"), label: "File Size" },
      { href: route("/files/age"), label: "File Age" },
      { href: route("/files/churn"), label: "File Churn" },
      { href: route("/files/temporal"), label: "Temporal Dependencies" },
    ],
  },
  {
    label: "Units",
    iconName: "brackets-curly",
    items: [
      { href: route("/units/size"), label: "Unit Size" },
      { href: route("/units/complexity"), label: "Conditional Complexity" },
    ],
  },
  {
    label: "Team",
    iconName: "users-three",
    items: [
      { href: route("/contributors"), label: "Contributors" },
      { href: route("/commits"), label: "Commits" },
      { href: route("/topology"), label: "Team Topology" },
    ],
  },
  {
    label: "Quality",
    iconName: "chart-line-up",
    items: [
      { href: route("/hotspots"), label: "Hotspots" },
      { href: route("/impact"), label: "Impact" },
      { href: route("/concerns"), label: "Features of Interest" },
      { href: route("/findings"), label: "Findings" },
      { href: route("/controls"), label: "Goals & Controls" },
      { href: route("/trends"), label: "Trend" },
    ],
  },
]

const landscapeNavSections = [
  {
    label: "Overview",
    iconName: "house",
    items: [
      { href: route("/landscape"), label: "Landscape Dashboard" },
      { href: route("/about"), label: "About" },
      { href: route("/guide"), label: "Guide" },
      { href: route("/technology"), label: "Technology" },
    ],
  },
  {
    label: "Landscape",
    iconName: "stack",
    items: [
      { href: route("/landscape/repositories"), label: "Repositories" },
      { href: route("/landscape/contributors"), label: "Contributors" },
      { href: route("/landscape/teams"), label: "Teams" },
      { href: route("/landscape/topology"), label: "Team Topology" },
      { href: route("/landscape/tags"), label: "Tags" },
    ],
  },
]

function getLandscapeRepoNavSections(repoKey: string, repoName: string) {
  const repoHref = getLandscapeRepositoryHref(repoKey)

  return [
    {
      label: "Landscape",
      iconName: "house",
      items: [
        { href: route("/landscape"), label: "Landscape Dashboard" },
        { href: route("/about"), label: "About" },
        { href: route("/guide"), label: "Guide" },
        { href: route("/technology"), label: "Technology" },
        { href: route("/landscape/repositories"), label: "Repositories" },
      ],
    },
    {
      label: "Repository",
      iconName: "house",
      items: [
        { href: repoHref, label: `${repoName} Dashboard` },
        { href: getLandscapeRepositoryMetricsHref(repoKey), label: "Metrics" },
        { href: getLandscapeRepositoryCommitsHref(repoKey), label: "Commits" },
      ],
    },
    {
      label: "Structure",
      iconName: "stack",
      items: [
        { href: getLandscapeRepositoryComponentsHref(repoKey), label: "Components" },
        { href: getLandscapeRepositoryDuplicationHref(repoKey), label: "Duplication" },
      ],
    },
    {
      label: "Files",
      iconName: "files",
      items: [
        { href: getLandscapeRepositoryFilePageHref(repoKey, "size"), label: "File Size" },
        { href: getLandscapeRepositoryFilePageHref(repoKey, "age"), label: "File Age" },
        { href: getLandscapeRepositoryFilePageHref(repoKey, "churn"), label: "File Churn" },
        { href: getLandscapeRepositoryFilePageHref(repoKey, "temporal"), label: "Temporal Dependencies" },
      ],
    },
    {
      label: "Units",
      iconName: "brackets-curly",
      items: [
        { href: getLandscapeRepositoryUnitPageHref(repoKey, "size"), label: "Unit Size" },
        { href: getLandscapeRepositoryUnitPageHref(repoKey, "complexity"), label: "Conditional Complexity" },
      ],
    },
    {
      label: "Team",
      iconName: "users-three",
      items: [
        { href: `${repoHref}/contributors`, label: "Contributors" },
        { href: `${repoHref}/topology`, label: "Team Topology" },
      ],
    },
    {
      label: "Quality",
      iconName: "chart-line-up",
      items: [
        { href: getLandscapeRepositoryHotspotsHref(repoKey), label: "Hotspots" },
        { href: getLandscapeRepositoryImpactHref(repoKey), label: "Impact" },
        { href: getLandscapeRepositoryControlsHref(repoKey), label: "Goals & Controls" },
      ],
    },
  ]
}

const currentPath = Astro.url.pathname
const isLandscapeRepoScope = reportMode === "landscape" && repoScope
const navSections = isLandscapeRepoScope
  ? getLandscapeRepoNavSections(repoScope.repoKey, repoScope.repoName)
  : reportMode === "landscape"
    ? landscapeNavSections
    : singleRepoNavSections
const rootHref = reportMode === "landscape" ? route("/landscape") : route("/")
function isActiveLink(href: string): boolean {
  if (href === route("/")) return currentPath === href
  return currentPath === href || currentPath.startsWith(`${href}/`)
}
---

<!doctype html>
<html lang="en" data-theme="light" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>{title} — {projectName}</title>
    <script is:inline data-astro-rerun>
      (() => {
        const THEME_ATTR = "data-theme"
        const PREFERENCE_ATTR = "data-theme-preference"
        const STORAGE_KEY = "planetnik-theme-preference"
        const root = document.documentElement
        const isPreference = (value) => value === "light" || value === "dark" || value === "system"
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        const storedPreference = localStorage.getItem(STORAGE_KEY)
        const preference = isPreference(storedPreference) ? storedPreference : "system"
        const effectiveTheme = preference === "system" ? systemTheme : preference

        root.setAttribute(PREFERENCE_ATTR, preference)
        root.setAttribute(THEME_ATTR, effectiveTheme)
        root.style.colorScheme = effectiveTheme
      })()
    </script>
    <ClientRouter />
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --sidebar-width: 260px;
        --topbar-height: 56px;
        --color-accent: #6366f1;
        --color-green: #22c55e;
        --color-yellow: #eab308;
        --color-orange: #f97316;
        --color-red: #ef4444;
      }

      html[data-theme="light"] {
        color-scheme: light;
        --color-bg: #fafafa;
        --color-sidebar: #1a1a2e;
        --color-sidebar-text: #c4c4d4;
        --color-sidebar-active: #e2e8f0;
        --color-sidebar-strong: #ffffff;
        --color-sidebar-hover: rgba(255, 255, 255, 0.08);
        --color-sidebar-divider: rgba(255, 255, 255, 0.1);
        --color-sidebar-section-label: rgba(255, 255, 255, 0.35);
        --color-sidebar-active-bg: rgba(99, 102, 241, 0.2);
        --color-text: #1e293b;
        --color-text-muted: #64748b;
        --color-border: #e2e8f0;
        --color-card: #ffffff;
        --color-surface-subtle: #f8fafc;
        --color-surface-muted: #f1f5f9;
        --color-accent-soft: #eef2ff;
        --color-accent-strong: #4338ca;
        --color-danger-soft: #fee2e2;
        --color-overlay: rgba(0, 0, 0, 0.4);
        --chart-accent: var(--color-accent);
        --chart-accent-light: #818cf8;
        --chart-text: var(--color-text);
        --chart-text-muted: var(--color-text-muted);
        --chart-border: var(--color-border);
        --chart-card: var(--color-card);
        --chart-bg: var(--color-bg);
        --chart-bar-bg: #f1f5f9;
        --chart-green: var(--color-green);
        --chart-yellow: var(--color-yellow);
        --chart-orange: var(--color-orange);
        --chart-red: var(--color-red);
        --chart-palette-1: #6366f1;
        --chart-palette-2: #8b5cf6;
        --chart-palette-3: #06b6d4;
        --chart-palette-4: #10b981;
        --chart-palette-5: #f59e0b;
        --chart-palette-6: #ef4444;
      }

      html[data-theme="dark"] {
        color-scheme: dark;
        --color-bg: #020817;
        --color-sidebar: #020617;
        --color-sidebar-text: #94a3b8;
        --color-sidebar-active: #f8fafc;
        --color-sidebar-strong: #ffffff;
        --color-sidebar-hover: rgba(148, 163, 184, 0.14);
        --color-sidebar-divider: rgba(148, 163, 184, 0.16);
        --color-sidebar-section-label: rgba(226, 232, 240, 0.42);
        --color-sidebar-active-bg: rgba(129, 140, 248, 0.22);
        --color-text: #e2e8f0;
        --color-text-muted: #94a3b8;
        --color-border: #1e293b;
        --color-card: #0f172a;
        --color-surface-subtle: #111c2f;
        --color-surface-muted: #182334;
        --color-accent-soft: rgba(129, 140, 248, 0.18);
        --color-accent-strong: #a5b4fc;
        --color-danger-soft: rgba(248, 113, 113, 0.16);
        --color-overlay: rgba(2, 6, 23, 0.7);
        --chart-accent: #818cf8;
        --chart-accent-light: #a5b4fc;
        --chart-text: var(--color-text);
        --chart-text-muted: var(--color-text-muted);
        --chart-border: #243244;
        --chart-card: var(--color-card);
        --chart-bg: var(--color-bg);
        --chart-bar-bg: #182334;
        --chart-green: #4ade80;
        --chart-yellow: #facc15;
        --chart-orange: #fb923c;
        --chart-red: #f87171;
        --chart-palette-1: #818cf8;
        --chart-palette-2: #a78bfa;
        --chart-palette-3: #22d3ee;
        --chart-palette-4: #34d399;
        --chart-palette-5: #fbbf24;
        --chart-palette-6: #f87171;
      }

      html, body {
        overflow-x: hidden;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
        isolation: isolate;
      }

      /* ── Mobile top bar ── */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--topbar-height);
        background: var(--color-sidebar);
        padding: 0 1rem;
        z-index: 100;
      }

      .topbar-logo {
        height: 36px;
        width: auto;
      }

      .topbar-project {
        font-size: 0.75rem;
        color: var(--color-sidebar-text);
        margin-left: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
      }

      .topbar-project strong {
        color: var(--color-sidebar-strong);
      }

      .menu-toggle {
        background: none;
        border: none;
        color: var(--color-sidebar-strong);
        cursor: pointer;
        padding: 0.5rem;
        margin-left: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: background 0.15s;
      }

      .menu-toggle:hover {
        background: var(--color-sidebar-hover);
      }

      .menu-toggle svg {
        width: 22px;
        height: 22px;
      }

      /* ── Overlay ── */
      .nav-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: var(--color-overlay);
        z-index: 199;
      }

      .nav-overlay.open {
        display: block;
      }

      /* ── Sidebar ── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--color-sidebar);
        color: var(--color-sidebar-text);
        overflow-y: auto;
        z-index: 200;
        padding: 1.25rem 0 2rem;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
      }

      nav.open {
        transform: translateX(0);
      }

      .nav-header {
        padding: 0.5rem 1.25rem 1rem;
        border-bottom: 1px solid var(--color-sidebar-divider);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-header-content {
        flex: 1;
      }

      .nav-logo-link {
        display: block;
      }

      .nav-logo {
        max-width: 140px;
        height: auto;
        display: block;
      }

      .nav-header .project-name {
        font-size: 0.75rem;
        color: var(--color-sidebar-text);
        margin-top: 0.35rem;
        line-height: 1.4;
      }

      .nav-header .project-separator {
        margin: 0 0.35rem;
      }

      .nav-header .repo-scope-name {
        color: var(--color-sidebar-strong);
      }

      .nav-close {
        background: none;
        border: none;
        color: var(--color-sidebar-text);
        cursor: pointer;
        padding: 0.35rem;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s, color 0.15s;
      }

      .nav-close:hover {
        background: var(--color-sidebar-hover);
        color: var(--color-sidebar-strong);
      }

      .nav-close svg {
        width: 20px;
        height: 20px;
      }

      .nav-section {
        margin-bottom: 0.35rem;
      }

      .nav-section-label {
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.6rem 1.25rem 0.25rem;
        color: var(--color-sidebar-section-label);
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .nav-section-label :global(svg) {
        flex: none;
      }

      .nav-section a {
        display: block;
        padding: 0.5rem 1.25rem;
        color: var(--color-sidebar-text);
        text-decoration: none;
        font-size: 0.875rem;
        transition: background 0.15s, color 0.15s;
      }

      .nav-section a:hover {
        background: var(--color-sidebar-hover);
        color: var(--color-sidebar-strong);
      }

      .nav-section a.active {
        color: var(--color-sidebar-active);
        background: var(--color-sidebar-active-bg);
        font-weight: 500;
      }

      .sidebar-toggle {
        display: none;
      }

      .sidebar-expand {
        display: none;
      }

      .top-right-tools {
        position: fixed;
        top: 0.625rem;
        right: 3.75rem;
        z-index: 320;
        display: flex;
        align-items: center;
        gap: 0.65rem;
      }

      /* ── Main content ── */
      main {
        padding: calc(var(--topbar-height) + 1.25rem) 1rem 2rem;
        width: 100%;
        min-width: 0;
        overflow-x: hidden;
      }

      main h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        color: var(--color-text);
      }

      /* ── Desktop: sidebar always visible ── */
      @media (min-width: 768px) {
        .topbar {
          display: none;
        }

        .nav-overlay {
          display: none !important;
        }

        nav {
          transform: translateX(0);
          transition: transform 0.2s ease;
        }

        .nav-close {
          display: none;
        }

        .nav-logo {
          max-width: 180px;
        }

        .sidebar-toggle {
          display: flex;
          align-items: center;
          gap: 0.4rem;
          background: none;
          border: none;
          color: var(--color-sidebar-text);
          cursor: pointer;
          padding: 0.5rem 1.25rem;
          border-radius: 6px;
          margin: auto 0 0;
          font-size: 0.75rem;
          letter-spacing: 0.02em;
          transition: background 0.15s, color 0.15s;
        }

        .sidebar-toggle:hover {
          background: var(--color-sidebar-hover);
          color: var(--color-sidebar-strong);
        }

        .sidebar-expand {
          position: fixed;
          top: 1rem;
          left: 0;
          z-index: 190;
          display: none;
          align-items: center;
          gap: 0.35rem;
          padding: 0.45rem 0.7rem 0.45rem 0.55rem;
          background: var(--color-sidebar);
          color: var(--color-sidebar-text);
          border: 1px solid var(--color-sidebar-divider);
          border-left: none;
          border-radius: 0 8px 8px 0;
          cursor: pointer;
          font-size: 0.75rem;
          letter-spacing: 0.02em;
          transition: background 0.15s, color 0.15s, opacity 0.2s;
        }

        .sidebar-expand:hover {
          background: var(--color-sidebar-hover);
          color: var(--color-sidebar-strong);
        }

        /* ── Collapsed state ── */
        body.sidebar-collapsed nav {
          transform: translateX(-100%);
        }

        body.sidebar-collapsed .sidebar-expand {
          display: flex;
        }

        body.sidebar-collapsed main {
          margin-left: 0;
          max-width: 100vw;
        }


        .top-right-tools {
          top: 1.5rem;
          right: 1.5rem;
        }

        main {
          margin-left: var(--sidebar-width);
          padding: 2rem 2.5rem;
          max-width: calc(100vw - var(--sidebar-width));
          transition: margin-left 0.2s ease, max-width 0.2s ease;
        }

        main h2 {
          font-size: 1.5rem;
          margin-bottom: 1.5rem;
        }
      }

      /* ── Global responsive overrides ── */
      :global(table) {
        max-width: 100%;
        table-layout: auto;
      }

      @media (max-width: 640px) {
        :global(table) {
          display: block;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
      }

      /* Prevent monospace paths from causing overflow */
      :global(code),
      :global(.filepath),
      :global(.loc) {
        word-break: break-all;
        overflow-wrap: break-word;
      }

      /* Constrain any child that might blow out */
      main :global(*) {
        max-width: 100%;
      }

      main :global(img),
      main :global(svg) {
        height: auto;
      }
    </style>
  </head>
  <body>
    <!-- Mobile top bar -->
    <header class="topbar">
      <img src={route("/planetnik-logo-2.webp")} alt="Planetnik" class="topbar-logo" />
      <span class="topbar-project">Report for <strong>{projectName}</strong></span>
      <button class="menu-toggle" id="menu-open" aria-label="Open navigation">
        <SystemIcon name="list" size={22} />
      </button>
    </header>

    <!-- Overlay -->
    <div class="nav-overlay" id="nav-overlay"></div>

    <!-- Sidebar -->
    <nav id="sidebar">
      <div class="nav-header">
        <div class="nav-header-content">
          <a href={rootHref} class="nav-logo-link">
            <img src={route("/planetnik-logo-2.webp")} alt="Planetnik" class="nav-logo" />
          </a>
          <div class="project-name">
            {reportMode === "landscape" ? "Landscape for " : "Report for "}
            <strong>{projectName}</strong>
            {repoScope ? (
              <>
                <span class="project-separator">•</span>
                <span class="repo-scope-name">{repoScope.repoName}</span>
              </>
            ) : null}
          </div>
        </div>
        <button class="nav-close" id="menu-close" aria-label="Close navigation">
          <SystemIcon name="x" size={20} />
        </button>
      </div>
      {
        navSections.map((section) => (
          <div class="nav-section">
            <div class="nav-section-label">
              <SystemIcon name={section.iconName} size={14} />
              <span>{section.label}</span>
            </div>
            {section.items.map((item) => (
              <a
                href={item.href}
                class={isActiveLink(item.href) ? "active" : ""}
                data-astro-reload={shouldBypassClientRouter(item.href) ? true : undefined}
              >
                {item.label}
              </a>
            ))}
          </div>
        ))
      }
      <button class="sidebar-toggle" id="sidebar-collapse" aria-label="Collapse sidebar">
        <SystemIcon name="sidebar-simple" size={14} />
        <span>Collapse</span>
      </button>
    </nav>

    <!-- Desktop sidebar re-open tab -->
    <button class="sidebar-expand" id="sidebar-expand" aria-label="Expand sidebar">
      <SystemIcon name="sidebar-simple" size={14} />
      <span>Menu</span>
    </button>

    <main transition:animate="fade">
      <slot />
    </main>

    <div class="top-right-tools">
      <ThemeSwitcher />
      <GlobalSearch client:idle projectName={projectName} />
    </div>

    <script is:inline>
      if (localStorage.getItem("sidebar-collapsed") === "true") {
        document.body.classList.add("sidebar-collapsed")
      }
    </script>

    <script is:inline>
      if (!window.__planetnikRouteVersionSetup) {
        window.__planetnikRouteVersionSetup = true
        window.__planetnikRouteVersion = window.__planetnikRouteVersion ?? 0

        document.addEventListener("astro:after-swap", () => {
          window.__planetnikRouteVersion += 1
          document.dispatchEvent(
            new CustomEvent("planetnik:route-version", {
              detail: { version: window.__planetnikRouteVersion },
            }),
          )
        })
      }
    </script>

    <script>
      function setupDashboardNavigation() {
        const sidebar = document.getElementById("sidebar")
        const overlay = document.getElementById("nav-overlay")
        const openBtn = document.getElementById("menu-open")
        const closeBtn = document.getElementById("menu-close")

        if (!(sidebar instanceof HTMLElement)) return
        if (!(overlay instanceof HTMLElement)) return
        if (!(openBtn instanceof HTMLButtonElement)) return
        if (!(closeBtn instanceof HTMLButtonElement)) return

        const sidebarElement = sidebar
        const overlayElement = overlay

        function openNav() {
          sidebarElement.classList.add("open")
          overlayElement.classList.add("open")
          document.body.style.overflow = "hidden"
        }

        function closeNav() {
          sidebarElement.classList.remove("open")
          overlayElement.classList.remove("open")
          document.body.style.overflow = ""
        }

        openBtn.onclick = openNav
        closeBtn.onclick = closeNav
        overlayElement.onclick = closeNav

        sidebarElement.querySelectorAll(".nav-section a").forEach((link) => {
          if (link instanceof HTMLAnchorElement) {
            link.onclick = closeNav
          }
        })

        closeNav()
      }

      document.addEventListener("astro:page-load", setupDashboardNavigation)
      setupDashboardNavigation()

      function setupSidebarToggle() {
        const collapseBtn = document.getElementById("sidebar-collapse")
        const expandBtn = document.getElementById("sidebar-expand")

        if (!(collapseBtn instanceof HTMLButtonElement)) return
        if (!(expandBtn instanceof HTMLButtonElement)) return

        if (localStorage.getItem("sidebar-collapsed") === "true") {
          document.body.classList.add("sidebar-collapsed")
        }

        collapseBtn.onclick = () => {
          document.body.classList.add("sidebar-collapsed")
          localStorage.setItem("sidebar-collapsed", "true")
        }

        expandBtn.onclick = () => {
          document.body.classList.remove("sidebar-collapsed")
          localStorage.setItem("sidebar-collapsed", "false")
        }
      }

      document.addEventListener("astro:page-load", setupSidebarToggle)
      setupSidebarToggle()
    </script>
  </body>
</html>
