---
import GlobalSearch from "../components/search/GlobalSearch"
import SystemIcon from "../components/icons/SystemIcon.astro"

interface Props {
  title: string
  projectName?: string
}

const { title, projectName = "Planetnik" } = Astro.props

const navSections = [
  {
    label: "Overview",
    iconName: "house",
    items: [
      { href: "/about", label: "About" },
      { href: "/", label: "Dashboard" },
      { href: "/overview", label: "Source Code Overview" },
      { href: "/metrics", label: "Metrics" },
    ],
  },
  {
    label: "Structure",
    iconName: "stack",
    items: [
      { href: "/components", label: "Components" },
      { href: "/dependencies", label: "Dependencies" },
      { href: "/duplication", label: "Duplication" },
    ],
  },
  {
    label: "Files",
    iconName: "files",
    items: [
      { href: "/files/size", label: "File Size" },
      { href: "/files/age", label: "File Age" },
      { href: "/files/churn", label: "File Churn" },
      { href: "/files/temporal", label: "Temporal Dependencies" },
    ],
  },
  {
    label: "Units",
    iconName: "brackets-curly",
    items: [
      { href: "/units/size", label: "Unit Size" },
      { href: "/units/complexity", label: "Conditional Complexity" },
    ],
  },
  {
    label: "Team",
    iconName: "users-three",
    items: [
      { href: "/contributors", label: "Contributors" },
      { href: "/commits", label: "Commits" },
      { href: "/topology", label: "Team Topology" },
    ],
  },
  {
    label: "Quality",
    iconName: "chart-line-up",
    items: [
      { href: "/concerns", label: "Features of Interest" },
      { href: "/findings", label: "Findings" },
      { href: "/controls", label: "Goals & Controls" },
      { href: "/trends", label: "Trend" },
    ],
  },
]

const currentPath = Astro.url.pathname
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — {projectName}</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      :root {
        --sidebar-width: 260px;
        --topbar-height: 56px;
        --color-bg: #fafafa;
        --color-sidebar: #1a1a2e;
        --color-sidebar-text: #c4c4d4;
        --color-sidebar-active: #e2e8f0;
        --color-sidebar-hover: rgba(255, 255, 255, 0.08);
        --color-accent: #6366f1;
        --color-text: #1e293b;
        --color-text-muted: #64748b;
        --color-border: #e2e8f0;
        --color-card: #ffffff;
      }

      html, body {
        overflow-x: hidden;
      }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: var(--color-bg);
        color: var(--color-text);
        min-height: 100vh;
      }

      /* ── Mobile top bar ── */
      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        height: var(--topbar-height);
        background: var(--color-sidebar);
        padding: 0 1rem;
        z-index: 100;
      }

      .topbar-logo {
        height: 36px;
        width: auto;
      }

      .topbar-project {
        font-size: 0.75rem;
        color: var(--color-sidebar-text);
        margin-left: 0.75rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        flex: 1;
      }

      .topbar-project strong {
        color: #fff;
      }

      .menu-toggle {
        background: none;
        border: none;
        color: #fff;
        cursor: pointer;
        padding: 0.5rem;
        margin-left: 0.5rem;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        transition: background 0.15s;
      }

      .menu-toggle:hover {
        background: var(--color-sidebar-hover);
      }

      .menu-toggle svg {
        width: 22px;
        height: 22px;
      }

      /* ── Overlay ── */
      .nav-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.4);
        z-index: 199;
      }

      .nav-overlay.open {
        display: block;
      }

      /* ── Sidebar ── */
      nav {
        position: fixed;
        top: 0;
        left: 0;
        bottom: 0;
        width: var(--sidebar-width);
        background: var(--color-sidebar);
        color: var(--color-sidebar-text);
        overflow-y: auto;
        z-index: 200;
        padding: 1.25rem 0 2rem;
        transform: translateX(-100%);
        transition: transform 0.25s ease;
      }

      nav.open {
        transform: translateX(0);
      }

      .nav-header {
        padding: 0.5rem 1.25rem 1rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
        margin-bottom: 0.75rem;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }

      .nav-header-content {
        flex: 1;
      }

      .nav-logo-link {
        display: block;
      }

      .nav-logo {
        max-width: 140px;
        height: auto;
        display: block;
      }

      .nav-header .project-name {
        font-size: 0.75rem;
        color: var(--color-sidebar-text);
        margin-top: 0.35rem;
      }

      .nav-close {
        background: none;
        border: none;
        color: var(--color-sidebar-text);
        cursor: pointer;
        padding: 0.35rem;
        border-radius: 6px;
        display: flex;
        align-items: center;
        transition: background 0.15s, color 0.15s;
      }

      .nav-close:hover {
        background: var(--color-sidebar-hover);
        color: #fff;
      }

      .nav-close svg {
        width: 20px;
        height: 20px;
      }

      .nav-section {
        margin-bottom: 0.35rem;
      }

      .nav-section-label {
        font-size: 0.6rem;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.08em;
        padding: 0.6rem 1.25rem 0.25rem;
        color: rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        gap: 0.4rem;
      }

      .nav-section-label :global(svg) {
        flex: none;
      }

      .nav-section a {
        display: block;
        padding: 0.5rem 1.25rem;
        color: var(--color-sidebar-text);
        text-decoration: none;
        font-size: 0.875rem;
        transition: background 0.15s, color 0.15s;
      }

      .nav-section a:hover {
        background: var(--color-sidebar-hover);
        color: #fff;
      }

      .nav-section a.active {
        color: var(--color-sidebar-active);
        background: rgba(99, 102, 241, 0.2);
        font-weight: 500;
      }

      /* ── Main content ── */
      main {
        padding: calc(var(--topbar-height) + 1.25rem) 1rem 2rem;
        width: 100%;
        min-width: 0;
        overflow-x: hidden;
      }

      main h2 {
        font-size: 1.25rem;
        font-weight: 600;
        margin-bottom: 1.25rem;
        color: var(--color-text);
      }

      /* ── Desktop: sidebar always visible ── */
      @media (min-width: 768px) {
        .topbar {
          display: none;
        }

        .nav-overlay {
          display: none !important;
        }

        nav {
          transform: translateX(0);
          transition: none;
        }

        .nav-close {
          display: none;
        }

        .nav-logo {
          max-width: 180px;
        }

        main {
          margin-left: var(--sidebar-width);
          padding: 2rem 2.5rem;
          max-width: calc(100vw - var(--sidebar-width));
        }

        main h2 {
          font-size: 1.5rem;
          margin-bottom: 1.5rem;
        }
      }

      /* ── Global responsive overrides ── */
      :global(table) {
        max-width: 100%;
        table-layout: auto;
      }

      @media (max-width: 640px) {
        :global(table) {
          display: block;
          overflow-x: auto;
          -webkit-overflow-scrolling: touch;
        }
      }

      /* Prevent monospace paths from causing overflow */
      :global(code),
      :global(.filepath),
      :global(.loc) {
        word-break: break-all;
        overflow-wrap: break-word;
      }

      /* Constrain any child that might blow out */
      main :global(*) {
        max-width: 100%;
      }

      main :global(img),
      main :global(svg) {
        height: auto;
      }
    </style>
  </head>
  <body>
    <!-- Mobile top bar -->
    <header class="topbar">
      <img src="/planetnik-logo-2.png" alt="Planetnik" class="topbar-logo" />
      <span class="topbar-project">Report for <strong>{projectName}</strong></span>
      <button class="menu-toggle" id="menu-open" aria-label="Open navigation">
        <SystemIcon name="list" size={22} />
      </button>
    </header>

    <!-- Overlay -->
    <div class="nav-overlay" id="nav-overlay"></div>

    <!-- Sidebar -->
    <nav id="sidebar">
      <div class="nav-header">
        <div class="nav-header-content">
          <a href="/" class="nav-logo-link">
            <img src="/planetnik-logo-2.png" alt="Planetnik" class="nav-logo" />
          </a>
          <div class="project-name">Report for <strong>{projectName}</strong></div>
        </div>
        <button class="nav-close" id="menu-close" aria-label="Close navigation">
          <SystemIcon name="x" size={20} />
        </button>
      </div>
      {
        navSections.map((section) => (
          <div class="nav-section">
            <div class="nav-section-label">
              <SystemIcon name={section.iconName} size={14} />
              <span>{section.label}</span>
            </div>
            {section.items.map((item) => (
              <a href={item.href} class={currentPath === item.href ? "active" : ""}>
                {item.label}
              </a>
            ))}
          </div>
        ))
      }
    </nav>

    <main>
      <slot />
    </main>

    <GlobalSearch client:load projectName={projectName} />

    <script>
      const sidebar = document.getElementById("sidebar")!
      const overlay = document.getElementById("nav-overlay")!
      const openBtn = document.getElementById("menu-open")!
      const closeBtn = document.getElementById("menu-close")!

      function openNav() {
        sidebar.classList.add("open")
        overlay.classList.add("open")
        document.body.style.overflow = "hidden"
      }

      function closeNav() {
        sidebar.classList.remove("open")
        overlay.classList.remove("open")
        document.body.style.overflow = ""
      }

      openBtn.addEventListener("click", openNav)
      closeBtn.addEventListener("click", closeNav)
      overlay.addEventListener("click", closeNav)

      // Close on nav link click (mobile)
      sidebar.querySelectorAll(".nav-section a").forEach((link) => {
        link.addEventListener("click", closeNav)
      })
    </script>
  </body>
</html>
