---
import {
	buildCodeCityModel,
	CodeCityInputError,
} from "@planetnik/common";
import {
	CodeCityView,
	parseCodeCityUrlState,
	resolveCodeCityRouteState,
	type CodeCityRouteResolution,
} from "@planetnik/report-ui";
import { getCollection, getEntry } from "astro:content";
import Dashboard from "../layouts/Dashboard.astro";
import { toCodeCitySnapshotInput } from "../lib/codeCitySnapshot";
import { route } from "../lib/route";

const [
	reportContext,
	filesMain,
	filesTest,
	units,
	dependencies,
	hotspots,
	impact,
] = await Promise.all([
	getEntry("reportContext", "context"),
	getCollection("filesMain"),
	getCollection("filesTest"),
	getCollection("units"),
	getCollection("dependencies"),
	getCollection("hotspots"),
	getEntry("impact", "impact"),
]);

const projectName = reportContext?.data.title ?? "Planetnik";

function resolveModel(): CodeCityRouteResolution {
	if (!reportContext) {
		return {
			tag: "invalid",
			message: "Code City requires a canonical v2 report context.",
		};
	}

	try {
		return {
			tag: "model",
			model: buildCodeCityModel(
				toCodeCitySnapshotInput({
					context: reportContext.data,
					filesMain,
					filesTest,
					units,
					dependencies,
					hotspots,
					impact: impact?.data,
				}),
			),
		};
	} catch (error) {
		if (error instanceof CodeCityInputError) {
			return { tag: "invalid", message: error.message };
		}

		throw error;
	}
}

const pageState = resolveCodeCityRouteState({
	title: projectName,
	reportMode: reportContext?.data.reportMode,
	resolution:
		reportContext?.data.reportMode === "landscape"
			? {
					tag: "invalid",
					message: "Code City does not build a single-repository model for landscapes.",
				}
			: resolveModel(),
});

const cityModel =
	pageState.tag === "ready" || pageState.tag === "partial"
		? pageState.model
		: null;
const invalidMessage = pageState.tag === "invalid" ? pageState.message : "";
const initialPresentationState = parseCodeCityUrlState(Astro.url);
---

<Dashboard title="Code City" projectName={projectName}>
	{cityModel ? (
		<>
			<section class="code-city-state code-city-state--summary" aria-labelledby="code-city-state-title">
				<h2 id="code-city-state-title">{cityModel.snapshot.title} Code City</h2>
				<p>
					Snapshot <code>{cityModel.snapshot.snapshotId ?? "current"}</code> contains{" "}
					{cityModel.coverage.counts.files} files, {cityModel.coverage.counts.districts} contexts,
					and {cityModel.coverage.counts.diagnostics} diagnostics.
				</p>
				{pageState.tag === "partial" ? (
					<>
						<p>
							Optional canonical shards are unavailable: {" "}
							<code>{cityModel.coverage.missingOptionalShards.join(", ")}</code>.
						</p>
						<p>
							Use the table view for the complete accessible record list, or inspect the available
							<a href={route("/files/size")}> file evidence</a>.
						</p>
					</>
				) : (
					<p>All optional Code City shards are available. Select a parcel or building to inspect its evidence.</p>
				)}
			</section>
			<CodeCityView
				client:load
				model={cityModel}
				evidenceBasePath={route("/")}
				initialAudience={initialPresentationState.audience}
				initialStoryId={initialPresentationState.story}
			/>
		</>
	) : pageState.tag === "unsupported-landscape" ? (
		<section class="code-city-state" aria-labelledby="code-city-state-title">
			<h2 id="code-city-state-title">Code City is not available for landscapes yet</h2>
			<p>
				Code City currently maps one repository at a time. Open a repository report to
					inspect its bounded contexts and evidence.
			</p>
			<a href={route("/landscape/repositories")}>Browse repositories</a>
		</section>
	) : pageState.tag === "empty" ? (
		<section class="code-city-state" aria-labelledby="code-city-state-title">
			<h2 id="code-city-state-title">{pageState.model.snapshot.title} has no buildings to map</h2>
			<p>
				The canonical v2 snapshot is valid but its <code>files_main</code> shard contains no files.
			</p>
			<p>
				Generate the report from a repository with analysed source files, then reload this page.
			</p>
			<a href={route("/overview")}>Review the report overview</a>
		</section>
	) : (
		<section class="code-city-state" aria-labelledby="code-city-state-title">
			<h2 id="code-city-state-title">Code City could not use this report</h2>
			<p>{invalidMessage}</p>
			<p>
				Generate a canonical v2 single-repository report, then reload this page.
			</p>
		</section>
	)}
</Dashboard>

<style>
	.code-city-state {
		max-width: 48rem;
		padding: 1.5rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background: var(--color-card);
	}

	.code-city-state h2 {
		margin-top: 0;
	}

	.code-city-state p {
		color: var(--color-text-muted);
	}

	.code-city-state--summary {
		display: grid;
		gap: 0.25rem;
	}

	.code-city-state--summary a {
		margin-left: 0.25rem;
	}
</style>
