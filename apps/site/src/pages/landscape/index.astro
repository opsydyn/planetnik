---
import { getCollection, getEntry } from "astro:content";
import Dashboard from "../../layouts/Dashboard.astro";
import LandscapeOverviewView from "@planetnik/report-ui/views/LandscapeOverviewView";
import { chartHelp } from "../../lib/chartHelp";
import { route } from "../../lib/route";

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const overview = await getEntry("landscapeOverview", "overview");
const teams = await getCollection("landscapeTeams");
const tags = await getEntry("landscapeTags", "tags");

const projectName = reportContext.data.title;
const data = overview?.data;
---

<Dashboard title="Landscape Dashboard" projectName={projectName}>
  {data ? (
    <LandscapeOverviewView
      heading={projectName}
      subtitle={`Multi-repository landscape view across ${data.repositoryCount.toLocaleString()} repositories.`}
      cards={[
        { label: "Repositories", value: data.repositoryCount.toLocaleString() },
        { label: "Contributors", value: data.contributorCount.toLocaleString() },
        { label: "Total LOC", value: data.totals.totalLinesOfCode.toLocaleString() },
        { label: "Main LOC", value: data.totals.mainLinesOfCode.toLocaleString() },
        { label: "Commits (30d)", value: data.totals.commits30d.toLocaleString() },
        { label: "Active Contributors (30d)", value: data.totals.contributorCount30Days.toLocaleString() },
        { label: "Teams", value: teams.length.toLocaleString() },
        { label: "Tags", value: tags?.data.tagCount.toLocaleString() ?? "0" },
      ]}
      languageMix={data.languages.map((language) => ({
        label: `.${language.extension}`,
        value: language.linesOfCode,
      }))}
      largestLanguages={data.languages.map((language) => ({
        label: `.${language.extension}`,
        value: language.linesOfCode,
      }))}
      topRepositories={data.topRepositories.map((repository) => ({
        name: repository.name,
        mainLinesOfCode: repository.mainLinesOfCode.toLocaleString(),
        contributors: repository.contributors.toLocaleString(),
        latestCommitDate: repository.latestCommitDate || "—",
      }))}
      languageInventory={data.languages.map((language) => ({
        extension: `.${language.extension}`,
        repositories: language.repositories.toLocaleString(),
        linesOfCode: language.linesOfCode.toLocaleString(),
        percentage: `${((language.linesOfCode / data.totals.totalLinesOfCode) * 100).toFixed(1)}%`,
      }))}
      languageMixHelpText={chartHelp.landscape.languageMix}
      largestLanguagesHelpText={chartHelp.landscape.languageMix}
      mutedNote="This landscape mode is portfolio-oriented. Use repositories, contributors, teams, topology, and tags to move from repo-local analysis to organization-level structure."
    />
  ) : (
    <div class="empty">
      <p>No landscape overview data was found.</p>
    </div>
  )}
</Dashboard>

<style>
  .empty {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.25rem;
    color: var(--color-text-muted);
  }
</style>
