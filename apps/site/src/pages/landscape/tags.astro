---
import { getEntry } from "astro:content";
import LandscapeTagsView from "@planetnik/report-ui/views/LandscapeTagsView";
import Dashboard from "../../layouts/Dashboard.astro";
import { chartHelp } from "../../lib/chartHelp";
import { route } from "../../lib/route";

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const tags = await getEntry("landscapeTags", "tags");
const tagMatrix = await getEntry("landscapeTagMatrix", "tag-matrix");
const projectName = reportContext.data.title;

const groups = tags?.data.groups ?? [];
const flatTags = groups.flatMap((group) =>
	group.tags.map((tag) => ({
		id: `${group.name}:${tag.key}`,
		group: group.name,
		tag: tag.name,
		repositoryCount: tag.repositoryCount,
		totalMainLinesOfCode: tag.totalMainLinesOfCode,
		repositories:
			tag.repositories.map((repository) => repository.name).join(" • ") || "—",
	})),
);
const topTagBars = flatTags
	.slice()
	.sort((left, right) => right.repositoryCount - left.repositoryCount)
	.slice(0, 12)
	.map((tag) => ({
		label: tag.tag,
		value: tag.repositoryCount,
	}));
const untaggedRows =
	tagMatrix?.data.repositories
		.filter((repository) => repository.isUntagged)
		.map((repository) => repository.name) ?? [];
---

<Dashboard title="Landscape Tags" projectName={projectName}>
	<LandscapeTagsView
		subtitle="Repository tags and grouping overlays across the landscape."
		cards={[
			{ label: "Tag Groups", value: tags?.data.groupCount.toLocaleString() ?? "0" },
			{ label: "Tags", value: tags?.data.tagCount.toLocaleString() ?? "0" },
			{
				label: "Untagged Repos",
				value: tags?.data.untaggedRepositoryCount.toLocaleString() ?? "0",
			},
		]}
		topTagBars={topTagBars}
		rows={flatTags}
		untaggedRepositories={untaggedRows}
		chartHelpText={chartHelp.landscape.tags}
	/>
</Dashboard>
