---
import { getEntry } from "astro:content"
import LandscapeTopologyExplorer from "../../components/LandscapeTopologyExplorer"
import { chartHelp } from "../../lib/chartHelp"
import { buildContributorForceGraph } from "../../lib/forceGraph"
import Dashboard from "../../layouts/Dashboard.astro"
import { route } from "../../lib/route"

const reportContext = await getEntry("reportContext", "context")
if (reportContext?.data.reportMode !== "landscape") {
  return Astro.redirect(route("/"))
}

const topology = await getEntry("landscapeTopology", "topology")
const projectName = reportContext.data.title
const maxVisualConnections = 1800

const sections = (topology?.data.periods ?? []).map((period) => {
  const fullPeriod = topology?.data.periodsByKey[period.periodKey]
  if (!fullPeriod) return null

  const sortedConnections = [...fullPeriod.connections]
    .sort((left, right) => {
      if (left.sharedFilesCount !== right.sharedFilesCount) return right.sharedFilesCount - left.sharedFilesCount
      if (left.from !== right.from) return left.from.localeCompare(right.from)
      return left.to.localeCompare(right.to)
    })
    .slice(0, maxVisualConnections)

  const isTrimmed = sortedConnections.length < fullPeriod.connectionCount
  const graph = buildContributorForceGraph(
    sortedConnections.map((c) => ({
      from: c.from,
      to: c.to,
      count: c.sharedFilesCount,
      files: c.sharedFiles,
    })),
  )

  return {
    periodKey: period.periodKey,
    periodLabel: period.periodLabel,
    connectionCount: period.connectionCount,
    period: {
      periodKey: fullPeriod.periodKey,
      periodLabel: fullPeriod.periodLabel,
      contributorCount: fullPeriod.contributorCount,
      connectionCount: fullPeriod.connectionCount,
      cMean: fullPeriod.cMean,
      mostConnectedContributor: fullPeriod.mostConnectedContributor,
      strongestConnections: fullPeriod.strongestConnections,
    },
    nodes: graph.nodes.map((node) => ({ ...node, href: undefined })),
    edges: graph.edges,
    isTrimmed,
    visibleCount: sortedConnections.length,
  }
}).filter((s): s is NonNullable<typeof s> => s !== null)
---

<Dashboard title="Landscape Team Topology" projectName={projectName}>
  <h2>Team Topology</h2>
  <p class="subtitle">
    Cross-repository contributor coordination derived from shared-file work in the selected period.
  </p>

  {sections.length === 0 ? (
    <div class="empty">
      <p>No landscape topology data was exported.</p>
    </div>
  ) : (
    <LandscapeTopologyExplorer
      client:load
      sections={sections}
      helpText={chartHelp.landscape.topology}
    />
  )}
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    max-width: 72ch;
  }

  .empty {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.1rem 1.2rem;
  }

  :global(.topo-periods) {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 1.5rem;
  }

  :global(.topo-period-btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.1rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-text);
    font-weight: 600;
    font-size: inherit;
    font-family: inherit;
    cursor: pointer;
    transition: border-color 0.15s, box-shadow 0.15s;
  }

  :global(.topo-period-btn:hover) {
    border-color: var(--color-accent);
  }

  :global(.topo-period-count) {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2rem;
    padding: 0.15rem 0.45rem;
    border-radius: 999px;
    background: var(--color-accent-soft);
    color: var(--color-accent);
  }

  :global(.topo-period-btn.active) {
    border-color: var(--color-accent);
    box-shadow: inset 0 0 0 1px var(--color-accent);
  }

  :global(.topo-cards) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.9rem;
    margin-bottom: 1.5rem;
  }

  :global(.topo-card) {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.1rem 1.2rem;
  }

  :global(.topo-card-value) {
    font-size: 1.9rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  :global(.topo-card-label) {
    margin-top: 0.45rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  :global(.topo-section) {
    margin-bottom: 1.75rem;
  }

  :global(.topo-section h3) {
    font-size: 1.1rem;
    font-weight: 700;
    margin-bottom: 0.8rem;
  }

  :global(.topo-hint) {
    margin: -0.2rem 0 0.85rem;
    color: var(--color-text-muted);
    max-width: 72ch;
  }

  :global(.topo-empty) {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.1rem 1.2rem;
  }

  :global(.topo-table-wrap) {
    overflow-x: auto;
  }

  :global(.topo-table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  :global(.topo-table th) {
    text-align: left;
    padding: 0.6rem 0.8rem;
    border-bottom: 2px solid var(--color-border);
    color: var(--color-text-muted);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    font-size: 0.75rem;
  }

  :global(.topo-table td) {
    padding: 0.55rem 0.8rem;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
  }

  :global(.topo-table code) {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.8rem;
  }

  :global(.topo-num) {
    text-align: right;
    font-variant-numeric: tabular-nums;
  }

  @media (min-width: 720px) {
    :global(.topo-cards) {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }
</style>
