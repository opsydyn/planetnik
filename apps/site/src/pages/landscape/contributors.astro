---
import { getCollection, getEntry } from "astro:content";
import LandscapeContributorsView from "@planetnik/report-ui/views/LandscapeContributorsView";
import Dashboard from "../../layouts/Dashboard.astro";
import { chartHelp } from "../../lib/chartHelp";
import { getLandscapeContributorHref } from "../../lib/landscape";
import { route } from "../../lib/route";

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const contributors = await getCollection("landscapeContributors");
const projectName = reportContext.data.title;

const people = [...contributors].sort(
	(left, right) => right.data.commitsCount - left.data.commitsCount,
);
const totalContributors = people.length;
const active30d = people.filter(
	(contributor) => contributor.data.commits30d > 0,
).length;
const botCount = people.filter((contributor) => contributor.data.isBot).length;
const multiRepoCount = people.filter(
	(contributor) => contributor.data.repositoryCount > 1,
).length;
const topBars = people.slice(0, 12).map((contributor) => ({
	label: contributor.data.displayName,
	value: contributor.data.repositoryCount,
	href: getLandscapeContributorHref(contributor.data.email),
}));
const rows = people.map((contributor) => ({
	id: contributor.id,
	displayName: contributor.data.displayName,
	href: getLandscapeContributorHref(contributor.data.email),
	email: contributor.data.email,
	commitsCount: contributor.data.commitsCount,
	commits30d: contributor.data.commits30d,
	commits90d: contributor.data.commits90d,
	repositoryCount: contributor.data.repositoryCount,
	latestCommitDate: contributor.data.latestCommitDate,
	isBot: contributor.data.isBot ? "Bot" : "Human",
	repositories: contributor.data.repositories
		.map((repository) => repository.name)
		.join(" • "),
}));
---

<Dashboard title="Landscape Contributors" projectName={projectName}>
  <LandscapeContributorsView
    subtitle="Organisation-wide contributor footprint across repositories, recent activity, and cross-repository reach."
    cards={[
      { label: "Contributors", value: totalContributors.toLocaleString() },
      { label: "Active (30d)", value: active30d.toLocaleString() },
      { label: "Multi-Repo", value: multiRepoCount.toLocaleString() },
      { label: "Bots", value: botCount.toLocaleString() },
    ]}
    topContributorBars={topBars}
    rows={rows}
    chartHelpText={chartHelp.landscape.contributorActivity}
    searchPlaceholder="Search contributor or repository"
  />
</Dashboard>
