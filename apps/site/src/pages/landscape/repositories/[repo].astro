---
import { getCollection, getEntry } from "astro:content"
import ReportDataGrid from "../../../components/tables/ReportDataGrid"
import { getContributorDisplayName } from "../../../lib/contributors"
import {
  getLandscapeRepoRouteParam,
  getLandscapeRepositoryContributorHref,
  readLandscapeRepoJson,
} from "../../../lib/landscape"
import Dashboard from "../../../layouts/Dashboard.astro"
import { route } from "../../../lib/route"

interface RepoAnalysisSummary {
  metadata?: {
    name?: string
    description?: string
    links?: Array<{ label?: string; href?: string }>
  }
  filesCount?: number
  linesOfCode?: number
  duplication?: {
    percentage?: number
    duplicatedLines?: number
    cleanedLines?: number
  }
}

interface RepoContributorSummary {
  email: string
  userName?: string
  commitsCount: number
  commitsCount30Days: number
  commitsCount90Days: number
  firstCommitDate: string
  latestCommitDate: string
  isBot?: boolean
}

interface RepoContributorsExport {
  contributorCount?: number
  contributors?: RepoContributorSummary[]
}

interface RepoContributorImpactEntry {
  email: string
  glue_score: number
  snacking_score: number
  structural_impact_score: number
  visible_activity_score: number
  dominant_dimension: string
  is_glue: boolean
  is_snacking: boolean
}

interface RepoContributorImpactExport {
  periods?: Array<{
    period_key?: string
    contributors?: RepoContributorImpactEntry[]
  }>
}

export async function getStaticPaths() {
  const repositories = await getCollection("landscapeRepositories")

  return repositories.map((repository) => ({
    params: { repo: getLandscapeRepoRouteParam(repository.data.repoKey) },
    props: {
      repositoryId: repository.id,
      repoKey: repository.data.repoKey,
    },
  }))
}

const { repositoryId, repoKey } = Astro.props as {
  repositoryId: string
  repoKey: string
}

const reportContext = await getEntry("reportContext", "context")
if (reportContext?.data.reportMode !== "landscape") {
  return Astro.redirect(route("/"))
}

const repository = await getEntry("landscapeRepositories", repositoryId)
if (!repository) {
  throw new Error(`Landscape repository entry not found for ${repositoryId}`)
}

const repoSummary = readLandscapeRepoJson<RepoAnalysisSummary>(repoKey, "analysisResults.json")
const repoContributors = readLandscapeRepoJson<RepoContributorsExport>(repoKey, "contributors.json")
const repoContributorImpact = readLandscapeRepoJson<RepoContributorImpactExport>(repoKey, "contributor_impact.json")

const impactByEmail = new Map(
  (repoContributorImpact?.periods?.find((period) => period.period_key === "all_time")?.contributors ?? []).map((entry) => [
    entry.email,
    entry,
  ]),
)

const contributorRows = (repoContributors?.contributors ?? [])
  .slice()
  .sort((left, right) => right.commitsCount - left.commitsCount || left.email.localeCompare(right.email))
  .map((contributor) => {
    const impact = impactByEmail.get(contributor.email)
    return {
      id: contributor.email,
      contributor: getContributorDisplayName({ email: contributor.email, userName: contributor.userName }),
      href: getLandscapeRepositoryContributorHref(repoKey, contributor.email),
      email: contributor.userName ? contributor.email : "",
      commitsCount: contributor.commitsCount,
      commits30d: contributor.commitsCount30Days,
      commits90d: contributor.commitsCount90Days,
      latestCommitDate: contributor.latestCommitDate,
      firstCommitDate: contributor.firstCommitDate,
      type: contributor.isBot ? "Bot" : "Human",
      glueScore: impact ? impact.glue_score.toFixed(1) : "—",
      structuralImpact: impact ? impact.structural_impact_score.toFixed(1) : "—",
      snackRisk: impact ? impact.snacking_score.toFixed(1) : "—",
      signal: impact?.is_glue ? "Glue" : impact?.is_snacking ? "Snacking" : impact ? impact.dominant_dimension.replace(/_/g, " ") : "—",
    }
  })

const repoLinks = (repoSummary?.metadata?.links ?? []).filter((link) => link?.href)
const projectName = reportContext.data.title
const filesCount = repoSummary?.filesCount ?? repository.data.mainFilesCount
const linesOfCode = repoSummary?.linesOfCode ?? repository.data.mainLinesOfCode
const duplicationPercentage = repoSummary?.duplication?.percentage ?? null
---

<Dashboard
  title={repository.data.name}
  projectName={projectName}
  repoScope={{ repoKey, repoName: repository.data.name }}
>
  <a class="back-link" href={route("/landscape/repositories")}>&larr; Back to repositories</a>

  <header class="page-header">
    <div>
      <h2>{repository.data.name}</h2>
      <p class="subtitle">{repository.data.description || repoSummary?.metadata?.description || "Repository drilldown within the current landscape analysis."}</p>
    </div>
    {repoLinks.length > 0 && (
      <div class="link-list">
        {repoLinks.map((link) => (
          <a href={link.href} target="_blank" rel="noreferrer">{link.label || "Open repository"}</a>
        ))}
      </div>
    )}
  </header>

  <section class="stats-grid">
    <article class="stat-card">
      <div class="stat-value">{linesOfCode.toLocaleString()}</div>
      <div class="stat-label">Lines of Code</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{filesCount.toLocaleString()}</div>
      <div class="stat-label">Files</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{repository.data.contributorsCount.toLocaleString()}</div>
      <div class="stat-label">Contributors</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{repository.data.commits30d.toLocaleString()}</div>
      <div class="stat-label">Commits (30d)</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{repository.data.commits90d.toLocaleString()}</div>
      <div class="stat-label">Commits (90d)</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{repository.data.latestCommitDate || "Unknown"}</div>
      <div class="stat-label">Latest Commit</div>
    </article>
    {duplicationPercentage !== null && (
      <article class="stat-card">
        <div class="stat-value">{duplicationPercentage.toFixed(1)}%</div>
        <div class="stat-label">Duplication</div>
      </article>
    )}
  </section>

  <ReportDataGrid
    client:visible
    title="Repository Contributors"
    description="Drill into the contributors active in this repository and open their repo-scoped detail pages."
    searchPlaceholder="Search contributor or impact signal"
    rows={contributorRows}
    columns={[
      { field: "contributor", headerName: "Contributor", type: "link", hrefField: "href", secondaryField: "email", minWidth: 240, flex: 1.3, sort: "asc" },
      { field: "type", headerName: "Type", minWidth: 100 },
      { field: "commitsCount", headerName: "Commits", type: "number", minWidth: 110, sort: "desc" },
      { field: "commits30d", headerName: "Commits (30d)", type: "number", minWidth: 130 },
      { field: "commits90d", headerName: "Commits (90d)", type: "number", minWidth: 130 },
      { field: "glueScore", headerName: "Glue Score", minWidth: 120 },
      { field: "structuralImpact", headerName: "Structural Impact", minWidth: 150 },
      { field: "snackRisk", headerName: "Snack Risk", minWidth: 120 },
      { field: "signal", headerName: "Signal", minWidth: 180 },
      { field: "firstCommitDate", headerName: "First Commit", type: "date", minWidth: 130 },
      { field: "latestCommitDate", headerName: "Latest Commit", type: "date", minWidth: 130 },
    ]}
  />
</Dashboard>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.92rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.25rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    max-width: 70ch;
    margin-top: 0.35rem;
  }

  .link-list {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .link-list a {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.85rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-card);
    color: var(--color-accent);
    text-decoration: none;
    font-size: 0.86rem;
    font-weight: 600;
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stat-card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 16px;
    padding: 1.15rem 1.2rem;
  }

  .stat-value {
    font-size: 1.85rem;
    font-weight: 700;
    line-height: 1;
    color: var(--color-accent);
  }

  .stat-label {
    margin-top: 0.45rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.78rem;
  }

  @media (max-width: 820px) {
    .page-header {
      flex-direction: column;
    }

    .link-list {
      justify-content: flex-start;
    }
  }
</style>
