---
import { getCollection, getEntry } from "astro:content";
import CommitHeatmap from "../../../../../components/charts/CommitHeatmap";
import DonutChart from "../../../../../components/charts/DonutChart";
import HorizontalBarChart from "../../../../../components/charts/HorizontalBarChart";
import LineChart from "../../../../../components/charts/LineChart";
import StaticReportTable from "../../../../../components/tables/StaticReportTable.astro";
import Dashboard from "../../../../../layouts/Dashboard.astro";
import { chartHelp } from "../../../../../lib/chartHelp";
import {
	getContributorDisplayName,
	getContributorMonthlyActivity,
	getContributorRouteParam,
} from "../../../../../lib/contributors";
import {
	getLandscapeRepoRouteParam,
	getLandscapeRepositoryContributorHref,
	getLandscapeRepositoryHref,
	readLandscapeRepoContributorDetailJson,
	readLandscapeRepoJson,
} from "../../../../../lib/landscape";

interface RepoContributorDetail {
	email: string;
	userName?: string;
	commitsCount: number;
	commitsCount30Days: number;
	commitsCount90Days: number;
	commitsCount180Days: number;
	commitsCount365Days: number;
	firstCommitDate: string;
	latestCommitDate: string;
	isActive: boolean;
	isRookie: boolean;
	dailyActivity: Array<{ date: string; commits: number }>;
	files: Array<{
		relativePath: string;
		extension: string;
		commits: number;
		logicalComponents: string[];
		concerns: string[];
	}>;
	extensions: Array<{
		extension: string;
		commits: number;
		files: number;
	}>;
	logicalComponents: Array<{
		name: string;
		files: number;
		linesOfCode: number;
	}>;
	collaborators: Array<{
		email: string;
		sharedFiles: number;
	}>;
}

interface RepoContributorImpactEntry {
	email: string;
	display_name: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	visible_activity_score: number;
	collaborator_count: number;
	shared_files_count: number;
	commits_count: number;
	files_touched: number;
	components_touched: number;
	dominant_dimension: string;
	reasons: string[];
	is_glue: boolean;
	is_snacking: boolean;
}

interface RepoContributorImpactExport {
	periods?: Array<{
		period_key?: string;
		contributors?: RepoContributorImpactEntry[];
	}>;
}

interface RepoAnalysisSummary {
	metadata?: {
		name?: string;
		description?: string;
	};
}

export async function getStaticPaths() {
	const contributors = await getCollection("landscapeContributors");

	return contributors.flatMap((contributor) =>
		contributor.data.repositories
			.filter(
				(repository) => repository.repoKey && repository.analysisResultsPath,
			)
			.map((repository) => ({
				params: {
					repo: getLandscapeRepoRouteParam(repository.repoKey),
					email: getContributorRouteParam(contributor.data.email),
				},
				props: {
					repoKey: repository.repoKey,
					contributorEmail: contributor.data.email,
				},
			})),
	);
}

const { repoKey, contributorEmail } = Astro.props as {
	repoKey: string;
	contributorEmail: string;
};

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const repositorySummary = readLandscapeRepoJson<RepoAnalysisSummary>(
	repoKey,
	"analysisResults.json",
);
const contributor =
	readLandscapeRepoContributorDetailJson<RepoContributorDetail>(
		repoKey,
		contributorEmail,
	);
const contributorImpactExport =
	readLandscapeRepoJson<RepoContributorImpactExport>(
		repoKey,
		"contributor_impact.json",
	);
const contributorImpact =
	contributorImpactExport?.periods
		?.find((period) => period.period_key === "all_time")
		?.contributors?.find((entry) => entry.email === contributorEmail) ?? null;

if (!contributor) {
	throw new Error(
		`Repo contributor detail not found for ${contributorEmail} in ${repoKey}`,
	);
}

const projectName = reportContext.data.title;
const repoName =
	repositorySummary?.metadata?.name || repoKey.split("/").at(-1) || repoKey;
const contributorName = getContributorDisplayName({
	email: contributor.email,
	userName: contributor.userName,
});

const monthlyActivity = getContributorMonthlyActivity(
	contributor.dailyActivity,
);
const extensionChartData = [...contributor.extensions]
	.sort(
		(a, b) => b.commits - a.commits || a.extension.localeCompare(b.extension),
	)
	.map((entry) => ({
		label: entry.extension ? `.${entry.extension}` : "No Extension",
		value: entry.commits,
	}));

const componentBarData = [...contributor.logicalComponents]
	.sort((a, b) => b.linesOfCode - a.linesOfCode || a.name.localeCompare(b.name))
	.slice(0, 10)
	.map((entry) => ({
		label: entry.name,
		value: entry.linesOfCode,
	}));

const collaboratorBarData = contributor.collaborators
	.slice(0, 10)
	.map((entry) => ({
		label: getContributorDisplayName({ email: entry.email }),
		value: entry.sharedFiles,
	}));

const touchedFiles = [...contributor.files].sort(
	(a, b) =>
		b.commits - a.commits || a.relativePath.localeCompare(b.relativePath),
);
const activeDays = contributor.dailyActivity.length;
const topCollaborator = contributor.collaborators[0];
const dominantImpactLabel =
	contributorImpact?.dominant_dimension.replace(/_/g, " ") ?? null;
---

<Dashboard
  title={contributorName}
  projectName={projectName}
  repoScope={{ repoKey, repoName }}
>
  <a class="back-link" href={getLandscapeRepositoryHref(repoKey)}>&larr; Back to {repoName}</a>

  <header class="page-header">
    <div>
      <h2>{contributorName}</h2>
      <p class="subtitle">
        <span class="email">{contributor.email}</span> &middot; {repoName}
      </p>
    </div>
    <div class="status-list">
      {contributor.isActive && <span class="badge active">active</span>}
      {contributor.isRookie && <span class="badge rookie">rookie</span>}
    </div>
  </header>

  <section class="stats-grid">
    <article class="stat-card">
      <div class="stat-value">{contributor.commitsCount.toLocaleString()}</div>
      <div class="stat-label">Repo Commits</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{activeDays.toLocaleString()}</div>
      <div class="stat-label">Active Days</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{contributor.files.length.toLocaleString()}</div>
      <div class="stat-label">Files Touched</div>
    </article>
    <article class="stat-card">
      <div class="stat-value">{contributor.collaborators.length.toLocaleString()}</div>
      <div class="stat-label">Collaborators</div>
    </article>
  </section>

  <section class="detail-grid">
    <article class="detail-card">
      <div class="detail-label">First Commit</div>
      <div class="detail-value">{contributor.firstCommitDate || "Unknown"}</div>
    </article>
    <article class="detail-card">
      <div class="detail-label">Latest Commit</div>
      <div class="detail-value">{contributor.latestCommitDate || "Unknown"}</div>
    </article>
    <article class="detail-card">
      <div class="detail-label">30 / 90 / 180 / 365 Days</div>
      <div class="detail-value monospace">
        {contributor.commitsCount30Days} / {contributor.commitsCount90Days} / {contributor.commitsCount180Days} / {contributor.commitsCount365Days}
      </div>
    </article>
    <article class="detail-card">
      <div class="detail-label">Top Collaborator</div>
      <div class="detail-value">
        {topCollaborator ? (
          <a href={getLandscapeRepositoryContributorHref(repoKey, topCollaborator.email)}>
            {getContributorDisplayName({ email: topCollaborator.email })}
          </a>
        ) : (
          "None"
        )}
      </div>
    </article>
    {contributorImpact && (
      <>
        <article class="detail-card impact-summary-card">
          <div class="detail-label">Contributor Impact</div>
          <div class="impact-badges">
            {contributorImpact.is_glue && <span class="impact-badge impact-badge--glue">Glue contributor</span>}
            {contributorImpact.is_snacking && <span class="impact-badge impact-badge--snack">Snacking risk</span>}
            {dominantImpactLabel && <span class="impact-badge impact-badge--neutral">{dominantImpactLabel}</span>}
          </div>
          <p class="impact-reasons">{contributorImpact.reasons.join(" • ")}</p>
        </article>
        <article class="detail-card impact-score-card">
          <div class="detail-label">Glue Score</div>
          <div class="detail-value impact-score impact-score--glue">{contributorImpact.glue_score.toFixed(1)}</div>
        </article>
        <article class="detail-card impact-score-card">
          <div class="detail-label">Snack Risk</div>
          <div class="detail-value impact-score impact-score--snack">{contributorImpact.snacking_score.toFixed(1)}</div>
        </article>
        <article class="detail-card impact-score-card">
          <div class="detail-label">Structural Impact</div>
          <div class="detail-value impact-score impact-score--structural">{contributorImpact.structural_impact_score.toFixed(1)}</div>
        </article>
        <article class="detail-card impact-score-card">
          <div class="detail-label">Visible Activity</div>
          <div class="detail-value impact-score impact-score--visible">{contributorImpact.visible_activity_score.toFixed(1)}</div>
        </article>
      </>
    )}
  </section>

  {monthlyActivity.length > 0 && (
    <section class="section">
      <h3>Commit Heatmap</h3>
      <p class="section-intro">Daily commit activity across the last 53 weeks ending on {contributor.latestCommitDate || contributor.firstCommitDate || "the latest available snapshot"}.</p>
      <CommitHeatmap
        client:load
        data={contributor.dailyActivity}
        endDate={contributor.latestCommitDate || contributor.firstCommitDate || undefined}
        helpText={chartHelp.contributorDetail.heatmap}
      />
    </section>
  )}

  {monthlyActivity.length > 0 && (
    <section class="section">
      <h3>Commit Activity</h3>
      <LineChart
        client:visible
        series={[{ name: "Commits", data: monthlyActivity }]}
        xLabel="Month"
        yLabel="Commits"
        helpText={chartHelp.contributorDetail.activity}
      />
    </section>
  )}

  <section class="chart-grid">
    {extensionChartData.length > 0 && (
      <div class="chart-panel">
        <h3>Language Footprint</h3>
        <DonutChart client:visible data={extensionChartData} valueLabel="commits" helpText={chartHelp.contributorDetail.languageFootprint} />
      </div>
    )}

    {componentBarData.length > 0 && (
      <div class="chart-panel">
        <h3>Component Footprint</h3>
        <HorizontalBarChart
          client:visible
          data={componentBarData}
          valueLabel="loc"
          maxItems={10}
          helpText={chartHelp.contributorDetail.componentFootprint}
        />
      </div>
    )}
  </section>

  {collaboratorBarData.length > 0 && (
    <section class="section">
      <h3>Top Collaborators</h3>
      <HorizontalBarChart
        client:visible
        data={collaboratorBarData}
        valueLabel="shared files"
        maxItems={10}
        helpText={chartHelp.contributorDetail.collaborators}
      />

      <StaticReportTable ariaLabel="Top collaborators">
        <thead>
          <tr>
            <th><span>Contributor</span></th>
            <th><span>Shared Files</span></th>
          </tr>
        </thead>
        <tbody>
          {contributor.collaborators.map((entry) => (
            <tr>
              <td>
                <a href={getLandscapeRepositoryContributorHref(repoKey, entry.email)}>
                  {getContributorDisplayName({ email: entry.email })}
                </a>
                <div class="email-sub">{entry.email}</div>
              </td>
              <td class="numeric">{entry.sharedFiles.toLocaleString()}</td>
            </tr>
          ))}
        </tbody>
      </StaticReportTable>
    </section>
  )}

  {touchedFiles.length > 0 && (
    <section class="section">
      <h3>Files Touched</h3>
      <StaticReportTable ariaLabel="Files touched">
        <thead>
          <tr>
            <th><span>File</span></th>
            <th><span>Commits</span></th>
            <th><span>Components</span></th>
            <th><span>Concerns</span></th>
          </tr>
        </thead>
        <tbody>
          {touchedFiles.map((file) => (
            <tr>
              <td class="file-path">
                <span class="monospace">{file.relativePath}</span>
              </td>
              <td class="numeric">{file.commits.toLocaleString()}</td>
              <td>
                <div class="tag-list">
                  {file.logicalComponents.length > 0 ? file.logicalComponents.map((component) => <span class="tag">{component}</span>) : <span class="placeholder">None</span>}
                </div>
              </td>
              <td>
                <div class="tag-list">
                  {file.concerns.length > 0 ? file.concerns.map((concern) => <span class="tag concern">{concern}</span>) : <span class="placeholder">None</span>}
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </StaticReportTable>
    </section>
  )}
</Dashboard>

<style>
  .back-link {
    display: inline-block;
    margin-bottom: 1rem;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .back-link:hover {
    color: var(--color-accent);
  }

  .page-header {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .subtitle {
    color: var(--color-text-muted);
    margin-top: 0.35rem;
    font-size: 0.95rem;
  }

  .email {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.85em;
  }

  .status-list {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    padding: 0.35rem 0.65rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .badge.active {
    background: #dcfce7;
    color: #166534;
  }

  .badge.rookie {
    background: #dbeafe;
    color: #1d4ed8;
  }

  .stats-grid,
  .detail-grid,
  .chart-grid {
    display: grid;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .stats-grid {
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
  }

  .detail-grid {
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  }

  .chart-grid {
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    align-items: start;
  }

  .stat-card,
  .detail-card,
  .chart-panel {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
  }

  .stat-value {
    font-size: 1.8rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .stat-label,
  .detail-label {
    margin-top: 0.4rem;
    font-size: 0.78rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .detail-value {
    margin-top: 0.35rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .impact-summary-card {
    display: grid;
    gap: 0.85rem;
    grid-column: span 2;
  }

  .impact-badges {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .impact-badge {
    display: inline-flex;
    align-items: center;
    padding: 0.32rem 0.62rem;
    border-radius: 999px;
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    border: 1px solid var(--color-border);
    background: var(--color-surface-subtle);
    color: var(--color-text-muted);
  }

  .impact-badge--glue {
    background: color-mix(in srgb, var(--chart-green) 18%, transparent);
    border-color: color-mix(in srgb, var(--chart-green) 40%, transparent);
    color: var(--chart-green);
  }

  .impact-badge--snack {
    background: color-mix(in srgb, var(--chart-orange) 18%, transparent);
    border-color: color-mix(in srgb, var(--chart-orange) 40%, transparent);
    color: var(--chart-orange);
  }

  .impact-reasons {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .impact-score-card {
    min-height: 132px;
  }

  .impact-score {
    font-size: 1.95rem;
    line-height: 1;
  }

  .impact-score--glue {
    color: var(--chart-green);
  }

  .impact-score--snack {
    color: var(--chart-orange);
  }

  .impact-score--structural {
    color: var(--color-accent);
  }

  .impact-score--visible {
    color: var(--chart-accent-light);
  }

  .section {
    margin-bottom: 1.5rem;
  }

  .section h3,
  .chart-panel h3 {
    font-size: 1.05rem;
    font-weight: 600;
    margin-bottom: 0.85rem;
  }

  .section-intro {
    margin-bottom: 0.85rem;
    color: var(--color-text-muted);
    font-size: 0.92rem;
  }

  .numeric {
    text-align: right !important;
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .email-sub,
  .placeholder {
    margin-top: 0.2rem;
    color: var(--color-text-muted);
    font-size: 0.8rem;
  }

  .monospace,
  .file-path {
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .tag-list {
    display: flex;
    gap: 0.35rem;
    flex-wrap: wrap;
  }

  .tag {
    display: inline-flex;
    align-items: center;
    padding: 0.2rem 0.45rem;
    border-radius: 999px;
    background: #eef2ff;
    color: #4338ca;
    font-size: 0.72rem;
    font-weight: 600;
  }

  .tag.concern {
    background: #ecfeff;
    color: #0f766e;
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
  }

  a:hover {
    text-decoration: underline;
  }

  @media (max-width: 768px) {
    .page-header {
      flex-direction: column;
    }

    .impact-summary-card {
      grid-column: span 1;
    }
  }
</style>
