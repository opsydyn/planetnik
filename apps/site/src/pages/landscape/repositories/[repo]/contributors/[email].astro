---
import { getCollection, getEntry } from "astro:content";
import RepositoryContributorDetailView from "@planetnik/report-ui/views/RepositoryContributorDetailView";
import Dashboard from "../../../../../layouts/Dashboard.astro";
import {
	getContributorDisplayName,
	getContributorMonthlyActivity,
	getContributorRouteParam,
} from "../../../../../lib/contributors";
import {
	getLandscapeRepoRouteParam,
	getLandscapeRepositoryContributorHref,
	getLandscapeRepositoryHref,
	readLandscapeRepoContributorDetailJson,
	readLandscapeRepoJson,
} from "../../../../../lib/landscape";
interface RepoContributorDetail {
	email: string;
	userName?: string;
	commitsCount: number;
	commitsCount30Days: number;
	commitsCount90Days: number;
	commitsCount180Days: number;
	commitsCount365Days: number;
	firstCommitDate: string;
	latestCommitDate: string;
	isActive: boolean;
	isRookie: boolean;
	dailyActivity: Array<{ date: string; commits: number }>;
	files: Array<{
		relativePath: string;
		extension: string;
		commits: number;
		logicalComponents: string[];
		concerns: string[];
	}>;
	extensions: Array<{ extension: string; commits: number; files: number }>;
	logicalComponents: Array<{ name: string; files: number; linesOfCode: number }>;
	collaborators: Array<{ email: string; sharedFiles: number }>;
}

interface RepoContributorImpactEntry {
	email: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	visible_activity_score: number;
	dominant_dimension: string;
	reasons: string[];
	is_glue: boolean;
	is_snacking: boolean;
}

interface RepoContributorImpactExport {
	periods?: Array<{
		period_key?: string;
		contributors?: RepoContributorImpactEntry[];
	}>;
}

interface RepoAnalysisSummary {
	metadata?: { name?: string };
}

export async function getStaticPaths() {
	const contributors = await getCollection("landscapeContributors");

	return contributors.flatMap((contributor) =>
		contributor.data.repositories
			.filter(
				(repository) => repository.repoKey && repository.analysisResultsPath,
			)
			.map((repository) => ({
				params: {
					repo: getLandscapeRepoRouteParam(repository.repoKey),
					email: getContributorRouteParam(contributor.data.email),
				},
				props: {
					repoKey: repository.repoKey,
					contributorEmail: contributor.data.email,
				},
			})),
	);
}

const { repoKey, contributorEmail } = Astro.props as {
	repoKey: string;
	contributorEmail: string;
};

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const repositorySummary = readLandscapeRepoJson<RepoAnalysisSummary>(
	repoKey,
	"analysisResults.json",
);
const contributor = readLandscapeRepoContributorDetailJson<RepoContributorDetail>(
	repoKey,
	contributorEmail,
);
const contributorImpactExport = readLandscapeRepoJson<RepoContributorImpactExport>(
	repoKey,
	"contributor_impact.json",
);
const contributorImpact =
	contributorImpactExport?.periods
		?.find((period) => period.period_key === "all_time")
		?.contributors?.find((entry) => entry.email === contributorEmail) ?? null;

if (!contributor) {
	throw new Error(
		`Repo contributor detail not found for ${contributorEmail} in ${repoKey}`,
	);
}

const projectName = reportContext.data.title;
const repoName =
	repositorySummary?.metadata?.name || repoKey.split("/").at(-1) || repoKey;
const contributorName = getContributorDisplayName({
	email: contributor.email,
	userName: contributor.userName,
});

const monthlyActivity = getContributorMonthlyActivity(contributor.dailyActivity);
const topCollaborator = contributor.collaborators[0] ?? null;

const collaborators = contributor.collaborators.map((entry) => ({
	email: entry.email,
	displayName: getContributorDisplayName({ email: entry.email }),
	sharedFiles: entry.sharedFiles,
	href: getLandscapeRepositoryContributorHref(repoKey, entry.email),
}));

const touchedFiles = [...contributor.files].sort(
	(a, b) => b.commits - a.commits || a.relativePath.localeCompare(b.relativePath),
);
---

<Dashboard
	title={contributorName}
	projectName={projectName}
	repoScope={{ repoKey, repoName }}
>
	<RepositoryContributorDetailView
		repoName={repoName}
		backHref={getLandscapeRepositoryHref(repoKey)}
		contributorName={contributorName}
		email={contributor.email}
		isActive={contributor.isActive}
		isRookie={contributor.isRookie}
		commitsCount={contributor.commitsCount}
		activeDays={contributor.dailyActivity.length}
		filesCount={contributor.files.length}
		collaboratorsCount={contributor.collaborators.length}
		firstCommitDate={contributor.firstCommitDate}
		latestCommitDate={contributor.latestCommitDate}
		commitsCount30Days={contributor.commitsCount30Days}
		commitsCount90Days={contributor.commitsCount90Days}
		commitsCount180Days={contributor.commitsCount180Days}
		commitsCount365Days={contributor.commitsCount365Days}
		topCollaboratorName={topCollaborator ? getContributorDisplayName({ email: topCollaborator.email }) : null}
		topCollaboratorHref={topCollaborator ? getLandscapeRepositoryContributorHref(repoKey, topCollaborator.email) : null}
		extensions={contributor.extensions}
		components={contributor.logicalComponents}
		collaborators={collaborators}
		touchedFiles={touchedFiles}
		dailyActivity={contributor.dailyActivity}
		monthlyActivity={monthlyActivity}
		impact={contributorImpact ? {
			glueScore: contributorImpact.glue_score,
			snackingScore: contributorImpact.snacking_score,
			structuralImpactScore: contributorImpact.structural_impact_score,
			visibleActivityScore: contributorImpact.visible_activity_score,
			dominantDimension: contributorImpact.dominant_dimension,
			isGlue: contributorImpact.is_glue,
			isSnacking: contributorImpact.is_snacking,
			reasons: contributorImpact.reasons,
		} : undefined}
	/>
</Dashboard>
