---
import RepositoryControlsView from "@planetnik/report-ui/views/RepositoryControlsView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
interface RepoControl {
	metricId: string;
	metricValue: number | null;
	metricDescription?: string;
	desiredRangeText: string;
	status: string;
	controlDescription?: string;
}

interface RepoControlsExport {
	goals?: Array<{
		goal?: string;
		description?: string;
		controls?: RepoControl[];
	}>;
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect("/");
}

const controlsExport = readLandscapeRepoJson<RepoControlsExport>(
	props.repoKey,
	"controls.json",
);
const controls =
	controlsExport?.goals?.flatMap((goal) =>
		(goal.controls ?? []).map((control, index) => ({
			id: `${goal.goal ?? "Controls"}::${control.metricId || `control-${index}`}`,
			goal: goal.goal ?? "Controls",
			metricId: control.metricId,
			metricValue: control.metricValue,
			desiredRangeText: control.desiredRangeText,
			status: control.status,
			description: control.controlDescription ?? control.metricDescription ?? "",
		})),
	) ?? [];

const statusOrder = new Map([["FAILED", 0], ["TOLERANT", 1], ["OK", 2]]);

const statusCounts = {
	failed: controls.filter((c) => c.status === "FAILED").length,
	tolerant: controls.filter((c) => c.status === "TOLERANT").length,
	ok: controls.filter((c) => c.status === "OK").length,
	ignored: controls.filter((c) => c.status.startsWith("IGNORED")).length,
};

const statusChartData = [
	...(statusCounts.failed > 0 ? [{ label: "Failed", value: statusCounts.failed }] : []),
	...(statusCounts.tolerant > 0 ? [{ label: "Tolerant", value: statusCounts.tolerant }] : []),
	...(statusCounts.ok > 0 ? [{ label: "OK", value: statusCounts.ok }] : []),
	...(statusCounts.ignored > 0 ? [{ label: "Ignored", value: statusCounts.ignored }] : []),
];
const statusChartColors = [
	...(statusCounts.failed > 0 ? ["#ef4444"] : []),
	...(statusCounts.tolerant > 0 ? ["#f59e0b"] : []),
	...(statusCounts.ok > 0 ? ["#22c55e"] : []),
	...(statusCounts.ignored > 0 ? ["#94a3b8"] : []),
];

const goalMap = new Map<string, { total: number; failed: number; tolerant: number; ok: number; ignored: number }>();
for (const control of controls) {
	const entry = goalMap.get(control.goal) ?? { total: 0, failed: 0, tolerant: 0, ok: 0, ignored: 0 };
	entry.total++;
	if (control.status === "FAILED") entry.failed++;
	else if (control.status === "TOLERANT") entry.tolerant++;
	else if (control.status === "OK") entry.ok++;
	else if (control.status.startsWith("IGNORED")) entry.ignored++;
	goalMap.set(control.goal, entry);
}

const goalRows = [...goalMap.entries()]
	.sort((l, r) => {
		if (r[1].failed !== l[1].failed) return r[1].failed - l[1].failed;
		if (r[1].tolerant !== l[1].tolerant) return r[1].tolerant - l[1].tolerant;
		return r[1].total - l[1].total;
	})
	.map(([goal, stats]) => ({
		label: goal,
		value: stats.total,
		detail: `${stats.failed} failed`,
		detailSecondary: `${stats.tolerant} tolerant`,
		color: stats.failed > 0 ? "#ef4444" : stats.tolerant > 0 ? "#f59e0b" : "#22c55e",
	}));

const controlRows = [...controls]
	.sort((a, b) => {
		const rankA = statusOrder.get(a.status) ?? 99;
		const rankB = statusOrder.get(b.status) ?? 99;
		if (rankA !== rankB) return rankA - rankB;
		return a.metricId.localeCompare(b.metricId);
	})
	.map((control) => ({
		id: control.id,
		goal: control.goal,
		metric: control.metricId,
		value: control.metricValue,
		desiredRange: control.desiredRangeText,
		status: control.status,
		description: control.description,
	}));

const cards = [
	{ label: "Controls", value: controls.length.toLocaleString(), detail: null },
	{ label: "Failed", value: statusCounts.failed.toLocaleString(), detail: null, color: "#dc2626" },
	{ label: "Tolerant", value: statusCounts.tolerant.toLocaleString(), detail: null, color: "#d97706" },
	{ label: "OK", value: statusCounts.ok.toLocaleString(), detail: null, color: "#16a34a" },
	...(statusCounts.ignored > 0 ? [{ label: "Ignored", value: statusCounts.ignored.toLocaleString(), detail: null }] : []),
];
---

<Dashboard title={`${repoName} Goals & Controls`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryControlsView
		heading={repoName}
		subtitle={`Goals and controls analysis for ${repoName}.`}
		cards={cards}
		statusChartData={statusChartData}
		statusChartColors={statusChartColors}
		goalRows={goalRows}
		controlRows={controlRows}
	/>
</Dashboard>
