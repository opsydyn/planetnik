---
import DistributionChart from "../../../../components/charts/DistributionChart";
import HorizontalBarChart from "../../../../components/charts/HorizontalBarChart";
import ReportDataGrid from "../../../../components/tables/ReportDataGrid";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { chartHelp } from "../../../../lib/chartHelp";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { route } from "../../../../lib/route";

interface DuplicateFileBlock {
	file: {
		relativePath: string;
	};
	startLine: number;
	endLine: number;
}

interface DuplicateBlock {
	blockSize: number;
	duplicatedFileBlocks: DuplicateFileBlock[];
}

interface DuplicatesExport {
	duplicates?: DuplicateBlock[];
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, repoSummary, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const duplicates =
	readLandscapeRepoJson<DuplicatesExport>(props.repoKey, "duplicates.json")
		?.duplicates ?? [];
const dupLines = repoSummary?.duplication?.duplicatedLines ?? 0;
const dupPct = repoSummary?.duplication?.percentage ?? 0;

const sorted = [...duplicates].sort(
	(left, right) => right.blockSize - left.blockSize,
);

const buckets = [
	{ label: "6-10 lines", min: 6, max: 10, count: 0 },
	{ label: "11-20 lines", min: 11, max: 20, count: 0 },
	{ label: "21-50 lines", min: 21, max: 50, count: 0 },
	{ label: "51-100 lines", min: 51, max: 100, count: 0 },
	{ label: "100+ lines", min: 101, max: Infinity, count: 0 },
];
for (const duplicate of sorted) {
	for (const bucket of buckets) {
		if (
			duplicate.blockSize >= bucket.min &&
			duplicate.blockSize <= bucket.max
		) {
			bucket.count++;
			break;
		}
	}
}

const distData = buckets.map((bucket) => ({
	label: bucket.label,
	value: bucket.count,
	detail: `${bucket.count} blocks`,
}));

const fileDupCount = new Map<string, number>();
for (const duplicate of sorted) {
	for (const block of duplicate.duplicatedFileBlocks) {
		const path = block.file.relativePath;
		fileDupCount.set(path, (fileDupCount.get(path) ?? 0) + 1);
	}
}

const mostDuplicatedFiles = [...fileDupCount.entries()]
	.sort((left, right) => right[1] - left[1])
	.slice(0, 15)
	.map(([path, count]) => ({
		label: path.split("/").pop() ?? path,
		value: count,
	}));

const duplicationRows = sorted.map((duplicate, index) => ({
	id: `dup-${index}-${duplicate.blockSize}`,
	blockSize: duplicate.blockSize,
	files: duplicate.duplicatedFileBlocks.length,
	locations: duplicate.duplicatedFileBlocks
		.map(
			(block) =>
				`${block.file.relativePath}:${block.startLine}-${block.endLine}`,
		)
		.join("\n"),
}));
---

<Dashboard title={`${repoName} Duplication`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
  <h2>Duplication</h2>

  <div class="cards">
    <div class="card">
      <div class="card-value">{dupPct.toFixed(1)}%</div>
      <div class="card-label">Duplication</div>
    </div>
    <div class="card">
      <div class="card-value">{dupLines.toLocaleString()}</div>
      <div class="card-label">Duplicated Lines</div>
    </div>
    <div class="card">
      <div class="card-value">{sorted.length.toLocaleString()}</div>
      <div class="card-label">Duplicate Blocks</div>
    </div>
  </div>

  <section class="section">
    <h3>Block Size Distribution</h3>
    <DistributionChart client:load data={distData} helpText={chartHelp.duplication.blockDistribution} />
  </section>

  {mostDuplicatedFiles.length > 0 && (
    <section class="section">
      <h3>Most Duplicated Files</h3>
      <HorizontalBarChart
        client:load
        data={mostDuplicatedFiles}
        valueLabel="duplicate blocks"
        helpText={chartHelp.duplication.mostDuplicatedFiles}
      />
    </section>
  )}

  <section class="section">
    <h3>Largest Duplicate Blocks</h3>
    <ReportDataGrid
      client:visible
      title="Duplicate Block Table"
      description="Search exact files and line ranges while paging through duplicate blocks in this repository."
      searchPlaceholder="Search duplicated file path or line range"
      rows={duplicationRows}
      columns={[
        { field: "blockSize", headerName: "Block Size", type: "number", minWidth: 130, sort: "desc" },
        { field: "files", headerName: "Files", type: "number", minWidth: 110 },
        { field: "locations", headerName: "Locations", type: "multiline", minWidth: 460, flex: 1.5, tooltipField: "locations" },
      ]}
      paginationPageSize={15}
    />
  </section>
</Dashboard>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .card { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; }
  .card-value { font-size: 1.75rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
  .card-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  @media (max-width: 640px) {
    .cards { grid-template-columns: repeat(2, 1fr); gap: 0.75rem; }
    .card { padding: 1rem; }
    .card-value { font-size: 1.35rem; }
  }
</style>
