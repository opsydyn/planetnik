---
import RepositoryDuplicationView from "@planetnik/report-ui/views/RepositoryDuplicationView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { route } from "../../../../lib/route";

interface DuplicateFileBlock {
	file: { relativePath: string };
	startLine: number;
	endLine: number;
}

interface DuplicateBlock {
	blockSize: number;
	duplicatedFileBlocks: DuplicateFileBlock[];
}

interface DuplicatesExport {
	duplicates?: DuplicateBlock[];
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, repoSummary, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const duplicates =
	readLandscapeRepoJson<DuplicatesExport>(props.repoKey, "duplicates.json")
		?.duplicates ?? [];
const dupLines = repoSummary?.duplication?.duplicatedLines ?? 0;
const dupPct = repoSummary?.duplication?.percentage ?? 0;

const sorted = [...duplicates].sort((a, b) => b.blockSize - a.blockSize);

const buckets = [
	{ label: "6-10 lines", min: 6, max: 10, count: 0 },
	{ label: "11-20 lines", min: 11, max: 20, count: 0 },
	{ label: "21-50 lines", min: 21, max: 50, count: 0 },
	{ label: "51-100 lines", min: 51, max: 100, count: 0 },
	{ label: "100+ lines", min: 101, max: Infinity, count: 0 },
];
for (const duplicate of sorted) {
	for (const bucket of buckets) {
		if (duplicate.blockSize >= bucket.min && duplicate.blockSize <= bucket.max) {
			bucket.count++;
			break;
		}
	}
}

const blockSizeDistribution = buckets
	.filter((b) => b.count > 0)
	.map((b) => ({ label: b.label, value: b.count, detail: `${b.count} blocks` }));

const fileDupCount = new Map<string, number>();
for (const duplicate of sorted) {
	for (const block of duplicate.duplicatedFileBlocks) {
		const path = block.file.relativePath;
		fileDupCount.set(path, (fileDupCount.get(path) ?? 0) + 1);
	}
}

const mostDuplicatedFiles = [...fileDupCount.entries()]
	.sort((a, b) => b[1] - a[1])
	.slice(0, 15)
	.map(([path, count]) => ({ label: path.split("/").pop() ?? path, value: count }));

const blockGridRows = sorted.map((duplicate, index) => ({
	id: `dup-${index}-${duplicate.blockSize}`,
	blockSize: duplicate.blockSize,
	files: duplicate.duplicatedFileBlocks.length,
	locations: duplicate.duplicatedFileBlocks
		.map((block) => `${block.file.relativePath}:${block.startLine}-${block.endLine}`)
		.join("\n"),
}));

const cards = [
	{ label: "Duplication", value: `${dupPct.toFixed(1)}%`, detail: null },
	{ label: "Duplicated Lines", value: dupLines.toLocaleString(), detail: null },
	{ label: "Duplicate Blocks", value: sorted.length.toLocaleString(), detail: null },
];
---

<Dashboard title={`${repoName} Duplication`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryDuplicationView
		heading={repoName}
		subtitle={`Duplicate block analysis for ${repoName}.`}
		cards={cards}
		blockSizeDistribution={blockSizeDistribution}
		mostDuplicatedFiles={mostDuplicatedFiles}
		blockGridRows={blockGridRows}
	/>
</Dashboard>
