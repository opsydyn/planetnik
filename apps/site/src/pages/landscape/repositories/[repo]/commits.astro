---
import RepositoryCommitsView from "@planetnik/report-ui/views/RepositoryCommitsView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import {
	readLandscapeRepoJson,
} from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { getMetric, parseMetricsJson } from "../../../../lib/metrics";
import { route } from "../../../../lib/route";

interface RepoContributor {
	email: string;
	commitsCount: number;
	commitsCount30Days: number;
	commitsCount90Days: number;
	commitsCount365Days: number;
	isRookie?: boolean;
}

interface RepoContributorsExport {
	contributors?: RepoContributor[];
}

interface RepoTimelineEntry {
	timeSlot: string;
	contributors: number;
	commits: number;
}

interface RepoTimelineExport {
	perYear?: RepoTimelineEntry[];
}

interface CommitsPerExtensionEntry {
	extension: string;
	commitsCount: number;
	committersCount: number;
	filesCount: number;
	commitsCount30Days?: number;
	commitsCount90Days?: number;
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const contributors =
	readLandscapeRepoJson<RepoContributorsExport>(
		props.repoKey,
		"contributors.json",
	)?.contributors ?? [];
const metrics = parseMetricsJson(
	readLandscapeRepoJson(props.repoKey, "metrics.json"),
);
const rawExtensions =
	readLandscapeRepoJson<CommitsPerExtensionEntry[]>(
		props.repoKey,
		"commits_per_extension.json",
	) ?? [];
const timeline = readLandscapeRepoJson<RepoTimelineExport>(
	props.repoKey,
	"contributor_timeline.json",
);

const totalContributors = contributors.length;
const totalCommits = contributors.reduce(
	(sum, c) => sum + c.commitsCount,
	0,
);
const activeContributors30 = contributors.filter((c) => c.commitsCount30Days > 0).length;
const activeContributors90 = contributors.filter((c) => c.commitsCount90Days > 0).length;
const activeContributors365 = contributors.filter((c) => c.commitsCount365Days > 0).length;
const ageDays = getMetric(metrics, "FILE_CHANGE_HISTORY_TOTAL_AGE_DAYS");
const activeDays = getMetric(metrics, "FILE_CHANGE_HISTORY_ACTIVE_DAYS");
const rookieCount = contributors.filter((c) => c.isRookie).length;

const cards = [
	{ label: "Total Commits", value: totalCommits.toLocaleString(), detail: null },
	{ label: "All-Time Contributors", value: totalContributors.toLocaleString(), detail: null },
	{ label: "Active (30d)", value: activeContributors30.toLocaleString(), detail: null },
	{ label: "Active (90d)", value: activeContributors90.toLocaleString(), detail: null },
	{ label: "Active (1yr)", value: activeContributors365.toLocaleString(), detail: null },
	{ label: "Rookies", value: rookieCount.toLocaleString(), detail: null },
	...(ageDays !== null ? [{ label: "Repo Age (Days)", value: ageDays.toLocaleString(), detail: null }] : []),
	...(activeDays !== null ? [{ label: "Active Days", value: activeDays.toLocaleString(), detail: null }] : []),
];

const sortedTimeline = [...(timeline?.perYear ?? [])].sort((a, b) =>
	a.timeSlot.localeCompare(b.timeSlot),
);
const commitsByYear = sortedTimeline.map((entry) => ({ label: entry.timeSlot, value: entry.commits }));
const contributorsByYear = sortedTimeline.map((entry) => ({ label: entry.timeSlot, value: entry.contributors }));
const timelineSeries = [
	...(commitsByYear.length > 0 ? [{ name: "Commits", data: commitsByYear, color: "#3b82f6" }] : []),
	...(contributorsByYear.length > 0 ? [{ name: "Contributors", data: contributorsByYear, color: "#22c55e" }] : []),
];

const activityData = [
	{ label: "Past 30 days", value: activeContributors30, detail: `${activeContributors30} contributors` },
	{ label: "Past 90 days", value: activeContributors90, detail: `${activeContributors90} contributors` },
	{ label: "Past year", value: activeContributors365, detail: `${activeContributors365} contributors` },
	{ label: "All time", value: totalContributors, detail: `${totalContributors} contributors` },
];

const sortedExtensions = [...rawExtensions].sort((a, b) => b.commitsCount - a.commitsCount);

const extensionBarData = sortedExtensions
	.slice(0, 15)
	.map((entry) => ({ label: `.${entry.extension}`, value: entry.commitsCount }));

const extensionRows = sortedExtensions.map((entry) => ({
	extension: entry.extension,
	commitsCount: entry.commitsCount.toLocaleString(),
	committersCount: entry.committersCount.toLocaleString(),
	filesCount: entry.filesCount.toLocaleString(),
	commitsCount30Days: entry.commitsCount30Days ? entry.commitsCount30Days.toLocaleString() : "—",
	commitsCount90Days: entry.commitsCount90Days ? entry.commitsCount90Days.toLocaleString() : "—",
}));
---

<Dashboard title={`${repoName} Commits`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryCommitsView
		heading={repoName}
		subtitle={`Commit activity and contributor cadence for ${repoName}.`}
		cards={cards}
		timelineSeries={timelineSeries}
		activityData={activityData}
		extensionBarData={extensionBarData}
		extensionRows={extensionRows}
	/>
</Dashboard>
