---
import RepositoryComponentsView from "@planetnik/report-ui/views/RepositoryComponentsView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { chartHelp } from "../../../../lib/chartHelp";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { route } from "../../../../lib/route";

interface RepoFileRecord {
	relativePath: string;
	linesOfCode: number;
	components: string[];
	contributors?: string[];
}

interface RepoFilesExport {
	files?: RepoFileRecord[];
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const filesMain =
	readLandscapeRepoJson<RepoFilesExport>(props.repoKey, "files_main.json")
		?.files ?? [];

const componentMap = new Map<
	string,
	{ files: number; loc: number; contributors: Set<string> }
>();
for (const file of filesMain) {
	for (const component of file.components ?? []) {
		const entry = componentMap.get(component) ?? {
			files: 0,
			loc: 0,
			contributors: new Set<string>(),
		};
		entry.files++;
		entry.loc += file.linesOfCode;
		if (file.contributors) {
			for (const contributor of file.contributors)
				entry.contributors.add(contributor);
		}
		componentMap.set(component, entry);
	}
}

const components = [...componentMap.entries()].sort(
	(left, right) => right[1].loc - left[1].loc,
);
const unassigned = filesMain.filter(
	(file) => (file.components ?? []).length === 0,
);
const singleOwnerComponents = components.filter(
	([, summary]) => summary.contributors.size === 1,
).length;
const lowBackupComponents = components.filter(
	([, summary]) =>
		summary.contributors.size > 0 && summary.contributors.size <= 2,
).length;
const distributedComponents = components.filter(
	([, summary]) => summary.contributors.size >= 3,
).length;
const twoContributors = lowBackupComponents - singleOwnerComponents;

const cards = [
	{ label: "Components", value: components.length.toLocaleString(), detail: null },
	{
		label: "Single Owner",
		value: singleOwnerComponents.toLocaleString(),
		detail: null,
		...(singleOwnerComponents > 0 ? { accentColor: "#dc2626" } : {}),
	},
	{
		label: "Low Backup",
		value: lowBackupComponents.toLocaleString(),
		detail: null,
		...(lowBackupComponents > 0 ? { accentColor: "#d97706" } : {}),
	},
	{
		label: "3+ Contributors",
		value: distributedComponents.toLocaleString(),
		detail: null,
		...(distributedComponents > 0 ? { accentColor: "#16a34a" } : {}),
	},
	{ label: "Unassigned Files", value: unassigned.length.toLocaleString(), detail: null },
];

const componentCoverageData = [
	...(singleOwnerComponents > 0 ? [{ label: "Single owner", value: singleOwnerComponents }] : []),
	...(twoContributors > 0 ? [{ label: "Two contributors", value: twoContributors }] : []),
	...(distributedComponents > 0 ? [{ label: "3+ contributors", value: distributedComponents }] : []),
	...(unassigned.length > 0 ? [{ label: "Unassigned files", value: unassigned.length }] : []),
];
const componentCoverageColors = [
	...(singleOwnerComponents > 0 ? ["#ef4444"] : []),
	...(twoContributors > 0 ? ["#f59e0b"] : []),
	...(distributedComponents > 0 ? ["#22c55e"] : []),
	...(unassigned.length > 0 ? ["#94a3b8"] : []),
];

const compBarData = components.slice(0, 15).map(([name, summary]) => ({
	label: name,
	value: summary.loc,
}));

const treemapData = components.map(([name, summary]) => ({
	label: name,
	value: summary.loc,
}));

const busFactorData = components
	.filter(([, summary]) => summary.contributors.size > 0)
	.map(([name, summary]) => ({
		x: summary.loc,
		y: summary.contributors.size,
		label: name,
	}));

const componentRows = [
	...components.map(([name, summary]) => ({
		id: name,
		component: name,
		files: summary.files,
		loc: summary.loc,
		contributors: summary.contributors.size > 0 ? summary.contributors.size : null,
		risk:
			summary.contributors.size > 0 && summary.contributors.size <= 2
				? "Bus factor risk"
				: "",
	})),
	...(unassigned.length > 0
		? [
				{
					id: "__unassigned__",
					component: "(unassigned)",
					files: unassigned.length,
					loc: unassigned.reduce((sum, file) => sum + file.linesOfCode, 0),
					contributors: null,
					risk: "",
				},
			]
		: []),
];
---

<Dashboard title={`${repoName} Components`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryComponentsView
		heading={repoName}
		subtitle={`Logical component coverage and bus-factor risk for ${repoName}.`}
		cards={cards}
		componentCoverageData={componentCoverageData}
		componentCoverageColors={componentCoverageColors}
		treemapData={treemapData}
		compBarData={compBarData}
		busFactorData={busFactorData}
		componentRows={componentRows}
	/>
</Dashboard>
