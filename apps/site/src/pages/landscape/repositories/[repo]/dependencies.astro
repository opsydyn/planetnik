---
import RepositoryDependenciesView from "@planetnik/report-ui/views/RepositoryDependenciesView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { route } from "../../../../lib/route";

interface ComponentDependencyRecord {
	decompositionKey: string;
	fromComponent: string;
	toComponent: string;
	count: number;
	locFrom: number;
	evidenceCount: number;
	color: string;
}

interface ComponentDependenciesExport {
	dependencies?: ComponentDependencyRecord[];
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const raw = readLandscapeRepoJson<ComponentDependenciesExport>(
	props.repoKey,
	"component_dependencies.json",
);
const allDeps = raw?.dependencies ?? [];

const groupedDependencies = new Map<string, ComponentDependencyRecord[]>();
for (const dep of allDeps) {
	const group = groupedDependencies.get(dep.decompositionKey) ?? [];
	group.push(dep);
	groupedDependencies.set(dep.decompositionKey, group);
}

const sections = [...groupedDependencies.entries()]
	.sort(([a], [b]) => a.localeCompare(b))
	.map(([decompositionKey, group]) => {
		const inDegree = new Map<string, number>();
		const outDegree = new Map<string, number>();
		for (const dep of group) {
			inDegree.set(dep.toComponent, (inDegree.get(dep.toComponent) ?? 0) + dep.count);
			outDegree.set(dep.fromComponent, (outDegree.get(dep.fromComponent) ?? 0) + dep.count);
		}

		return {
			label: decompositionKey,
			detail: `${group.length} component links`,
			matrixData: group.map((dep) => ({
				from: dep.fromComponent,
				to: dep.toComponent,
				count: dep.count,
			})),
			inDegreeData: [...inDegree.entries()]
				.sort((a, b) => b[1] - a[1])
				.map(([label, value]) => ({ label, value })),
			outDegreeData: [...outDegree.entries()]
				.sort((a, b) => b[1] - a[1])
				.map(([label, value]) => ({ label, value })),
			gridRows: group.map((dep) => ({
				id: `${decompositionKey}:${dep.fromComponent}:${dep.toComponent}`,
				fromComponent: dep.fromComponent,
				toComponent: dep.toComponent,
				count: dep.count,
				evidenceCount: dep.evidenceCount,
				locFrom: dep.locFrom,
			})),
		};
	});

const cards = [
	{ label: "Decompositions", value: sections.length.toLocaleString(), detail: null },
	{
		label: "Component Links",
		value: allDeps.length.toLocaleString(),
		detail: null,
	},
];
---

<Dashboard title={`${repoName} Dependencies`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryDependenciesView
		heading={repoName}
		subtitle={`Static component dependencies for ${repoName}.`}
		cards={cards}
		sections={sections}
	/>
</Dashboard>
