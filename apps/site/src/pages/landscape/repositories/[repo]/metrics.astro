---
import RepositoryMetricsView from "@planetnik/report-ui/views/RepositoryMetricsView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { readLandscapeRepoText } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";
import { getMetric, parseMetricsText } from "../../../../lib/metrics";
import { route } from "../../../../lib/route";

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const metrics = parseMetricsText(
	readLandscapeRepoText(props.repoKey, "metrics.txt"),
);

const metricById = new Map(
	metrics.map((metric) => [metric.id, metric.value] as const),
);

function getMetricStrict(id: string): number {
	return metricById.get(id) ?? 0;
}

function formatMilliseconds(ms: number): string {
	if (ms >= 1000) {
		return `${(ms / 1000).toFixed(1)}s`;
	}
	return `${ms.toFixed(0)}ms`;
}

function groupMetricId(id: string): string {
	if (id === "TOTAL_NUMBER_OF_FILES" || id.startsWith("NUMBER_OF_FILES_"))
		return "NUMBER_OF_FILES";
	if (
		id.startsWith("LINES_OF_CODE_") ||
		id.startsWith("TEST_VS_MAIN_LINES_OF_CODE")
	)
		return "LINES_OF_CODE";
	if (
		id.startsWith("NUMBER_OF_UNITS") ||
		id.startsWith("LINES_OF_CODE_IN_UNITS") ||
		id.startsWith("LINES_OF_CODE_OUTSIDE_UNITS")
	) {
		return "UNITS";
	}
	if (id.includes("_RISK_FILE_SIZE_")) return "FILE_SIZE_RISK";
	if (id.startsWith("CONDITIONAL_COMPLEXITY_")) return "CONDITIONAL_COMPLEXITY";
	if (id.startsWith("FILE_CHANGE_HISTORY_")) return "FILE_CHANGE_HISTORY";
	if (id.startsWith("FILE_AGE_")) return "FILE_AGE";
	if (
		id.startsWith("NUMBER_OF_DEPENDENCIES_") ||
		id.startsWith("NUMBER_OF_PLACES_WITH_CYCLIC_DEPENDENCIES_")
	) {
		return "DEPENDENCIES";
	}
	if (id.startsWith("DUPLICATION_") || id.startsWith("UNIT_DUPLICATES_"))
		return "DUPLICATION";
	if (id.startsWith("NUMBER_OF_CONTRIBUTORS")) return "TEAM";
	if (id.startsWith("TOTAL_ANALYSIS_TIME_")) return "ANALYSIS";

	const parts = id.split("_");
	return parts.slice(0, Math.min(3, parts.length)).join("_");
}

function formatGroupLabel(group: string): string {
	const labels: Record<string, string> = {
		NUMBER_OF_FILES: "Files",
		LINES_OF_CODE: "Lines of Code",
		UNITS: "Units",
		FILE_SIZE_RISK: "File Size Risk",
		CONDITIONAL_COMPLEXITY: "Conditional Complexity",
		FILE_CHANGE_HISTORY: "File Change History",
		FILE_AGE: "File Age",
		DEPENDENCIES: "Dependencies",
		DUPLICATION: "Duplication",
		TEAM: "Team",
		ANALYSIS: "Analysis",
	};

	return labels[group] ?? group.replace(/_/g, " ").toLowerCase();
}

const groupOrder = [
	"LINES_OF_CODE",
	"NUMBER_OF_FILES",
	"UNITS",
	"CONDITIONAL_COMPLEXITY",
	"FILE_SIZE_RISK",
	"FILE_AGE",
	"DEPENDENCIES",
	"FILE_CHANGE_HISTORY",
	"TEAM",
	"DUPLICATION",
	"ANALYSIS",
];

function sortGroups(a: string, b: string): number {
	const aIndex = groupOrder.indexOf(a);
	const bIndex = groupOrder.indexOf(b);
	const resolvedA = aIndex === -1 ? Number.MAX_SAFE_INTEGER : aIndex;
	const resolvedB = bIndex === -1 ? Number.MAX_SAFE_INTEGER : bIndex;

	if (resolvedA !== resolvedB) {
		return resolvedA - resolvedB;
	}

	return a.localeCompare(b);
}

const groups = new Map<string, Array<{ id: string; value: number }>>();
for (const metric of metrics) {
	const prefix = groupMetricId(metric.id);
	const list = groups.get(prefix) ?? [];
	list.push(metric);
	groups.set(prefix, list);
}

const sortedGroups = [...groups.entries()]
	.map(
		([group, items]) =>
			[group, [...items].sort((a, b) => a.id.localeCompare(b.id))] as const,
	)
	.sort((a, b) => sortGroups(a[0], b[0]));

const totalAnalysisTime =
	getMetric(metrics, "TOTAL_ANALYSIS_TIME_IN_MILLIS") ?? 0;
const duplicatedLines =
	getMetric(metrics, "DUPLICATION_NUMBER_OF_DUPLICATED_LINES") ?? 0;
const testVsMainPercentage =
	getMetric(metrics, "TEST_VS_MAIN_LINES_OF_CODE_PERCENTAGE") ?? 0;

const cards = [
	{
		label: "Main LOC",
		value: getMetricStrict("LINES_OF_CODE_MAIN").toLocaleString(),
		detail: null,
	},
	{
		label: "Test LOC",
		value: getMetricStrict("LINES_OF_CODE_TEST").toLocaleString(),
		detail: `${testVsMainPercentage.toFixed(1)}% of main`,
	},
	{
		label: "Duplicated Lines",
		value: duplicatedLines.toLocaleString(),
		detail: null,
	},
	{
		label: "Analysis Time",
		value: formatMilliseconds(totalAnalysisTime),
		detail: `${metrics.length.toLocaleString()} metrics`,
	},
];

const locBreakdown = [
	{ label: "Main", value: getMetricStrict("LINES_OF_CODE_MAIN") },
	{ label: "Test", value: getMetricStrict("LINES_OF_CODE_TEST") },
	{ label: "Generated", value: getMetricStrict("LINES_OF_CODE_GENERATED") },
	{
		label: "Build & Deploy",
		value: getMetricStrict("LINES_OF_CODE_BUILDANDDEPLOYMENT"),
	},
	{ label: "Other", value: getMetricStrict("LINES_OF_CODE_OTHER") },
].filter((item) => item.value > 0);

const mainLocByExtension = metrics
	.filter(
		(metric) =>
			metric.id.startsWith("LINES_OF_CODE_MAIN_EXT_") && metric.value > 0,
	)
	.map((metric) => ({
		label: `.${metric.id.slice("LINES_OF_CODE_MAIN_EXT_".length).toLowerCase()}`,
		value: metric.value,
	}))
	.sort((a, b) => b.value - a.value);

const viewGroups = sortedGroups.map(([group, items]) => ({
	label: formatGroupLabel(group),
	rows: items.map((item) => ({
		metric: item.id,
		value: item.value.toLocaleString(),
	})),
}));
---

<Dashboard title={`${repoName} Metrics`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryMetricsView
		heading={repoName}
		subtitle={`${metrics.length} metrics for ${repoName}`}
		cards={cards}
		locBreakdown={locBreakdown}
		mainLocByExtension={mainLocByExtension}
		groups={viewGroups}
	/>
</Dashboard>
