---
import RepositoryUnitsView from "@planetnik/report-ui/views/RepositoryUnitsView";
import Dashboard from "../../../../../layouts/Dashboard.astro";
import {
	getLandscapeRepositoryUnitPageHref,
	readLandscapeRepoJson,
} from "../../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	type LandscapeRepoPageProps,
} from "../../../../../lib/landscapeRepoContext";
import { route } from "../../../../../lib/route";

interface RepoUnitRecord {
	shortName: string;
	relativeFileName: string;
	linesOfCode: number;
	mcCabeIndex: number;
	numberOfParameters: number;
	startLine: number;
}

interface RepoUnitsExport {
	units?: RepoUnitRecord[];
}

const viewLabels = {
	size: { pageTitle: "Unit Size" },
	complexity: { pageTitle: "Conditional Complexity" },
} as const;

export async function getStaticPaths() {
	const { getCollection } = await import("astro:content");
	const { getLandscapeRepoRouteParam } = await import(
		"../../../../../lib/landscape"
	);
	const repositories = await getCollection("landscapeRepositories");
	const views = ["size", "complexity"] as const;

	return repositories.flatMap((repository) =>
		views.map((view) => ({
			params: {
				repo: getLandscapeRepoRouteParam(repository.data.repoKey),
				view,
			},
			props: {
				repositoryId: repository.id,
				repoKey: repository.data.repoKey,
				view,
			},
		})),
	);
}

const props = Astro.props as LandscapeRepoPageProps & {
	view: keyof typeof viewLabels;
};
const viewMeta = viewLabels[props.view];

if (!viewMeta) {
	throw new Error(`Unsupported repository unit view: ${props.view}`);
}

const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const units =
	readLandscapeRepoJson<RepoUnitsExport>(props.repoKey, "units.json")?.units ??
	[];

// View links
const viewLinks = (
	[
		{ value: "size", label: "Size" },
		{ value: "complexity", label: "Complexity" },
	] as const
).map((v) => ({
	label: v.label,
	href: getLandscapeRepositoryUnitPageHref(props.repoKey, v.value),
	active: v.value === props.view,
}));

// Size view
const sortedUnitsBySize = [...units].sort(
	(a, b) => b.linesOfCode - a.linesOfCode,
);
const totalUnitLoc = sortedUnitsBySize.reduce(
	(sum, unit) => sum + unit.linesOfCode,
	0,
);
const unitSizeBuckets = [
	{ label: "1-10", min: 1, max: 10, count: 0, loc: 0 },
	{ label: "11-20", min: 11, max: 20, count: 0, loc: 0 },
	{ label: "21-50", min: 21, max: 50, count: 0, loc: 0 },
	{ label: "51-100", min: 51, max: 100, count: 0, loc: 0 },
	{ label: "101+", min: 101, max: Infinity, count: 0, loc: 0 },
];
for (const unit of sortedUnitsBySize) {
	for (const bucket of unitSizeBuckets) {
		if (unit.linesOfCode >= bucket.min && unit.linesOfCode <= bucket.max) {
			bucket.count++;
			bucket.loc += unit.linesOfCode;
			break;
		}
	}
}
const sizeDistribution = unitSizeBuckets.map((bucket) => ({
	label: `${bucket.label} LOC`,
	value: bucket.loc,
	detail: `${bucket.count} units`,
	detailSecondary: `${bucket.loc.toLocaleString()} LOC`,
}));
const sizeRisk = [
	{
		label: "Low (1-20 LOC)",
		value: (unitSizeBuckets[0]?.count ?? 0) + (unitSizeBuckets[1]?.count ?? 0),
	},
	{ label: "Medium (21-50 LOC)", value: unitSizeBuckets[2]?.count ?? 0 },
	{ label: "High (51-100 LOC)", value: unitSizeBuckets[3]?.count ?? 0 },
	{ label: "Very High (101+ LOC)", value: unitSizeBuckets[4]?.count ?? 0 },
].filter((item) => item.value > 0);
const unitSizeRows = sortedUnitsBySize.map((unit) => ({
	id: `${unit.relativeFileName}:${unit.startLine}`,
	unit: unit.shortName,
	file: unit.relativeFileName,
	linesOfCode: unit.linesOfCode,
	mcCabeIndex: unit.mcCabeIndex,
	numberOfParameters: unit.numberOfParameters,
}));

// Complexity view
const sortedUnitsByComplexity = [...units].sort(
	(a, b) => b.mcCabeIndex - a.mcCabeIndex,
);
const complexityBuckets = [
	{ label: "1-5 (simple)", min: 1, max: 5, count: 0, color: "#22c55e" },
	{ label: "6-10 (moderate)", min: 6, max: 10, count: 0, color: "#eab308" },
	{ label: "11-25 (complex)", min: 11, max: 25, count: 0, color: "#f97316" },
	{ label: "26+ (very complex)", min: 26, max: Infinity, count: 0, color: "#ef4444" },
];
for (const unit of sortedUnitsByComplexity) {
	for (const bucket of complexityBuckets) {
		if (unit.mcCabeIndex >= bucket.min && unit.mcCabeIndex <= bucket.max) {
			bucket.count++;
			break;
		}
	}
}
const complexityRisk = complexityBuckets
	.filter((bucket) => bucket.count > 0)
	.map((bucket) => ({ label: bucket.label, value: bucket.count }));
const complexityDistribution = complexityBuckets.map((bucket) => ({
	label: bucket.label,
	value: bucket.count,
	detail: bucket.count.toString(),
	color: bucket.color,
}));
const complexityScatter = sortedUnitsByComplexity.slice(0, 200).map((unit) => ({
	x: unit.linesOfCode,
	y: unit.mcCabeIndex,
	label: unit.shortName,
}));
const complexityRows = sortedUnitsByComplexity.map((unit) => ({
	id: `${unit.relativeFileName}:${unit.startLine}`,
	unit: unit.shortName,
	file: unit.relativeFileName,
	mcCabeIndex: unit.mcCabeIndex,
	linesOfCode: unit.linesOfCode,
}));
---

<Dashboard title={`${repoName} ${viewMeta.pageTitle}`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	<RepositoryUnitsView
		view={props.view}
		repoName={repoName}
		viewLinks={viewLinks}
		size={{
			unitCount: sortedUnitsBySize.length,
			totalLoc: totalUnitLoc,
			sizeRisk,
			sizeDistribution,
			rows: unitSizeRows,
		}}
		complexity={{
			unitCount: sortedUnitsByComplexity.length,
			complexityRisk,
			complexityDistribution,
			complexityScatter,
			rows: complexityRows,
		}}
	/>
</Dashboard>
