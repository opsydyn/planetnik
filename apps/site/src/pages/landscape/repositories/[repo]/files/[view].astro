---
import DistributionChart from "../../../../../components/charts/DistributionChart"
import DonutChart from "../../../../../components/charts/DonutChart"
import HorizontalBarChart from "../../../../../components/charts/HorizontalBarChart"
import ReportDataGrid from "../../../../../components/tables/ReportDataGrid"
import ScatterPlot from "../../../../../components/charts/ScatterPlot"
import TemporalDependenciesExplorer from "../../../../../components/TemporalDependenciesExplorer"
import { chartHelp } from "../../../../../lib/chartHelp"
import { readLandscapeRepoJson, readLandscapeRepoText } from "../../../../../lib/landscape"
import {
  getLandscapeRepositoryPageContext,
  type LandscapeRepoPageProps,
} from "../../../../../lib/landscapeRepoContext"
import { getMetric, parseMetricsText } from "../../../../../lib/metrics"
import Dashboard from "../../../../../layouts/Dashboard.astro"
import { route } from "../../../../../lib/route"

interface RepoFileRecord {
  relativePath: string
  extension: string
  linesOfCode: number
  commitsCount?: number
  contributorsCount?: number
  firstDate?: string
  latestDate?: string
}

interface RepoFilesExport {
  files?: RepoFileRecord[]
}

interface RepoTemporalDependency {
  periodKey: string
  periodLabel: string
  periodDays: number
  file1: string
  file2: string
  sameCommits: number
  commitsFile1: number
  commitsFile2: number
  latestCommit: string
}

const viewLabels = {
  size: { pageTitle: "File Size", heading: "File Size" },
  age: { pageTitle: "File Age", heading: "File Age & Freshness" },
  churn: { pageTitle: "File Churn", heading: "File Change Frequency" },
  temporal: { pageTitle: "Temporal Dependencies", heading: "Temporal Dependencies" },
} as const

export async function getStaticPaths() {
  const { getCollection } = await import("astro:content")
  const { getLandscapeRepoRouteParam } = await import("../../../../../lib/landscape")
  const repositories = await getCollection("landscapeRepositories")
  const views = ["size", "age", "churn", "temporal"] as const

  return repositories.flatMap((repository) =>
    views.map((view) => ({
      params: {
        repo: getLandscapeRepoRouteParam(repository.data.repoKey),
        view,
      },
      props: {
        repositoryId: repository.id,
        repoKey: repository.data.repoKey,
        view,
      },
    })),
  )
}

const props = Astro.props as LandscapeRepoPageProps & { view: keyof typeof viewLabels }
const viewMeta = viewLabels[props.view]

if (!viewMeta) {
  throw new Error(`Unsupported repository file view: ${props.view}`)
}

const { reportContext, projectName, repoName } = await getLandscapeRepositoryPageContext(props)

if (reportContext?.data.reportMode !== "landscape") {
  return Astro.redirect(route("/"))
}

const filesMain = readLandscapeRepoJson<RepoFilesExport>(props.repoKey, "files_main.json")?.files ?? []
const metrics = parseMetricsText(readLandscapeRepoText(props.repoKey, "metrics.txt"))
const temporalDeps = readLandscapeRepoJson<{ dependencies?: RepoTemporalDependency[] }>(props.repoKey, "temporal_dependencies.json")?.dependencies ?? []

const sortedFilesBySize = [...filesMain].sort((a, b) => b.linesOfCode - a.linesOfCode)
const totalFileLoc = sortedFilesBySize.reduce((sum, file) => sum + file.linesOfCode, 0)
const sizeBuckets = [
  { label: "1-50", min: 1, max: 50, count: 0, loc: 0 },
  { label: "51-100", min: 51, max: 100, count: 0, loc: 0 },
  { label: "101-200", min: 101, max: 200, count: 0, loc: 0 },
  { label: "201-500", min: 201, max: 500, count: 0, loc: 0 },
  { label: "501-1000", min: 501, max: 1000, count: 0, loc: 0 },
  { label: "1001+", min: 1001, max: Infinity, count: 0, loc: 0 },
]

for (const file of sortedFilesBySize) {
  for (const bucket of sizeBuckets) {
    if (file.linesOfCode >= bucket.min && file.linesOfCode <= bucket.max) {
      bucket.count++
      bucket.loc += file.linesOfCode
      break
    }
  }
}

const fileSizeDistribution = sizeBuckets.map((bucket) => ({
  label: `${bucket.label} LOC`,
  value: bucket.loc,
  detail: `${bucket.count} files`,
  detailSecondary: `${bucket.loc.toLocaleString()} LOC`,
}))

const largestFilesBarData = sortedFilesBySize.slice(0, 15).map((file) => ({
  label: file.relativePath.split("/").pop() ?? file.relativePath,
  value: file.linesOfCode,
}))

const fileSizeRows = sortedFilesBySize.map((file) => ({
  id: file.relativePath,
  file: file.relativePath,
  extension: `.${file.extension}`,
  linesOfCode: file.linesOfCode,
}))

const ageInDays = getMetric(metrics, "FILE_CHANGE_HISTORY_TOTAL_AGE_DAYS")
const activeDays = getMetric(metrics, "FILE_CHANGE_HISTORY_ACTIVE_DAYS")
const weeks = getMetric(metrics, "FILE_CHANGE_HISTORY_WEEKS")
const estimatedWorkingDays = getMetric(metrics, "FILE_CHANGE_HISTORY_ESTIMATED_WORKING_DAYS")
const ageCategories = [
  { label: "Negligible Risk", metric: "FILE_AGE_NEGLIGIBLE_RISK_COUNT" },
  { label: "Low Risk", metric: "FILE_AGE_LOW_RISK_COUNT" },
  { label: "Medium Risk", metric: "FILE_AGE_MEDIUM_RISK_COUNT" },
  { label: "High Risk", metric: "FILE_AGE_HIGH_RISK_COUNT" },
  { label: "Very High Risk", metric: "FILE_AGE_VERY_HIGH_RISK_COUNT" },
]
const ageRiskColors = ["#22c55e", "#84cc16", "#eab308", "#f97316", "#ef4444"]
const ageDistribution = ageCategories
  .map((category, index) => {
    const value = getMetric(metrics, category.metric)
    return {
      label: category.label,
      value: value ?? 0,
      detail: `${(value ?? 0).toLocaleString()} files`,
      color: ageRiskColors[index],
    }
  })
  .filter((item) => item.value > 0)

const ageDetailRows = ageCategories
  .map((category) => {
    const value = getMetric(metrics, category.metric)
    return value === null ? null : { id: category.metric, category: category.label, files: value }
  })
  .filter((row): row is { id: string; category: string; files: number } => row !== null)

const filesWithHistory = filesMain
  .filter((file) => file.commitsCount && file.commitsCount > 0)
  .sort((a, b) => (b.commitsCount ?? 0) - (a.commitsCount ?? 0))

const churnScatterData = filesWithHistory.slice(0, 200).map((file) => ({
  x: file.commitsCount ?? 0,
  y: file.contributorsCount ?? 0,
  label: file.relativePath.split("/").pop() ?? file.relativePath,
}))

const mostChangedFilesBarData = filesWithHistory.slice(0, 15).map((file) => ({
  label: file.relativePath.split("/").pop() ?? file.relativePath,
  value: file.commitsCount ?? 0,
}))

const volatilityData = filesWithHistory.slice(0, 200).map((file) => ({
  x: file.linesOfCode,
  y: file.commitsCount ?? 0,
  label: file.relativePath.split("/").pop() ?? file.relativePath,
}))

const churnRows = filesWithHistory.map((file) => ({
  id: file.relativePath,
  file: file.relativePath,
  commits: file.commitsCount ?? 0,
  contributors: file.contributorsCount ?? 0,
  firstChange: file.firstDate ?? "—",
  lastChange: file.latestDate ?? "—",
}))

const groupedTemporalDeps = new Map<string, RepoTemporalDependency[]>()
for (const dependency of temporalDeps) {
  const group = groupedTemporalDeps.get(dependency.periodKey) ?? []
  group.push(dependency)
  groupedTemporalDeps.set(dependency.periodKey, group)
}

const temporalSections = [...groupedTemporalDeps.entries()]
  .map(([periodKey, group]) => {
    const first = group[0]
    if (!first) return null
    const sorted = [...group].sort((left, right) => right.sameCommits - left.sameCommits)
    return {
      periodKey,
      periodLabel: first.periodLabel,
      periodDays: first.periodDays,
      dependencies: sorted,
    }
  })
  .filter((section): section is NonNullable<typeof section> => section !== null)
  .sort((left, right) => left.periodDays - right.periodDays)
---

<Dashboard title={`${repoName} ${viewMeta.pageTitle}`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
  {props.view === "size" && (
    <div>
      <h2>{viewMeta.heading}</h2>
      <p class="subtitle">{sortedFilesBySize.length} files, {totalFileLoc.toLocaleString()} total lines of code</p>
      <section class="section">
        <h3>Size Distribution</h3>
        <DistributionChart client:load data={fileSizeDistribution} helpText={chartHelp.fileSize.distribution} />
      </section>
      <section class="section">
        <h3>Largest Files</h3>
        <HorizontalBarChart client:visible data={largestFilesBarData} valueLabel="LOC" helpText={chartHelp.fileSize.largestFiles} />
      </section>
      <section class="section">
        <ReportDataGrid
          client:visible
          title="Largest Files Table"
          description="Search, sort, and paginate the full file inventory for this repository."
          searchPlaceholder="Search file path or extension"
          rows={fileSizeRows}
          columns={[
            { field: "file", headerName: "File", type: "path", minWidth: 320, flex: 1.4 },
            { field: "extension", headerName: "Extension", type: "code", minWidth: 120 },
            { field: "linesOfCode", headerName: "Lines of Code", type: "number", minWidth: 150, sort: "desc" },
          ]}
        />
      </section>
    </div>
  )}

  {props.view === "age" && (
    <div>
      <h2>{viewMeta.heading}</h2>
      <div class="cards">
        {ageInDays !== null && <div class="card"><div class="card-value">{ageInDays.toLocaleString()}</div><div class="card-label">Age (Days)</div></div>}
        {activeDays !== null && <div class="card"><div class="card-value">{activeDays.toLocaleString()}</div><div class="card-label">Active Days</div></div>}
        {weeks !== null && <div class="card"><div class="card-value">{weeks.toLocaleString()}</div><div class="card-label">Weeks</div></div>}
      </div>
      {ageDistribution.length > 0 && (
        <div>
          <section class="section">
            <h3>Age Risk Overview</h3>
            <DonutChart client:load data={ageDistribution.map((item) => ({ label: item.label, value: item.value }))} valueLabel="files" helpText={chartHelp.fileAge.overview} />
          </section>
          <section class="section">
            <h3>File Age Distribution</h3>
            <DistributionChart client:visible data={ageDistribution} helpText={chartHelp.fileAge.distribution} />
          </section>
        </div>
      )}
      <section class="section">
        <h3>File Age Detail</h3>
        <ReportDataGrid
          client:visible
          title="Age Categories"
          description="Search and sort age-risk categories without losing the summary charts above."
          searchPlaceholder="Search age category"
          rows={ageDetailRows}
          columns={[
            { field: "category", headerName: "Category", minWidth: 240, flex: 1.1 },
            { field: "files", headerName: "Files", type: "number", minWidth: 140, sort: "desc" },
          ]}
          paginationPageSize={10}
        />
        {ageInDays === null && (
          <div class="empty">
            <p>No file history data available.</p>
            <p class="hint">Run git history extraction and regenerate reports to populate file age data.</p>
          </div>
        )}
      </section>
    </div>
  )}

  {props.view === "churn" && (
    <div>
      <h2>{viewMeta.heading}</h2>
      <div class="cards">
        {activeDays !== null && <div class="card"><div class="card-value">{activeDays.toLocaleString()}</div><div class="card-label">Active Days</div></div>}
        {weeks !== null && <div class="card"><div class="card-value">{weeks.toLocaleString()}</div><div class="card-label">Weeks Span</div></div>}
        {estimatedWorkingDays !== null && <div class="card"><div class="card-value">{estimatedWorkingDays.toLocaleString()}</div><div class="card-label">Est. Working Days</div></div>}
        {filesWithHistory.length > 0 && <div class="card"><div class="card-value">{filesWithHistory.length.toLocaleString()}</div><div class="card-label">Files With History</div></div>}
      </div>
      {filesWithHistory.length > 0 ? (
        <div>
          <section class="section">
            <h3>Commits vs Contributors per File</h3>
            <ScatterPlot client:load data={churnScatterData} xLabel="Commits" yLabel="Contributors" thresholds={{ x: 20, y: 5 }} helpText={chartHelp.churn.commitsVsContributors} />
          </section>
          <section class="section">
            <h3>File Size vs Change Frequency</h3>
            <ScatterPlot client:visible data={volatilityData} xLabel="Lines of Code" yLabel="Commits" thresholds={{ x: 200, y: 20 }} helpText={chartHelp.churn.sizeVsFrequency} />
          </section>
          <section class="section">
            <h3>Most Changed Files</h3>
            <HorizontalBarChart client:visible data={mostChangedFilesBarData} valueLabel="commits" helpText={chartHelp.churn.mostChanged} />
          </section>
          <ReportDataGrid
            client:visible
            title="Churn Table"
            description="Search and paginate every file with history while keeping the churn charts above."
            searchPlaceholder="Search file path or date"
            rows={churnRows}
            columns={[
              { field: "file", headerName: "File", type: "path", minWidth: 340, flex: 1.5 },
              { field: "commits", headerName: "Commits", type: "number", minWidth: 120, sort: "desc" },
              { field: "contributors", headerName: "Contributors", type: "number", minWidth: 140 },
              { field: "firstChange", headerName: "First Change", type: "date", minWidth: 140 },
              { field: "lastChange", headerName: "Last Change", type: "date", minWidth: 140 },
            ]}
          />
        </div>
      ) : activeDays === null ? (
        <div class="empty">
          <p>No file history data available.</p>
          <p class="hint">Run git history extraction and regenerate reports.</p>
        </div>
      ) : null}
    </div>
  )}

  {props.view === "temporal" && (
    <div>
      <h2>{viewMeta.heading}</h2>
      <p class="subtitle">Files that change together frequently inside {repoName}</p>
      {temporalSections.length === 0 ? (
        <div class="empty">
          <p>No temporal dependency data available.</p>
          <p class="hint">Run git history extraction and regenerate reports.</p>
        </div>
      ) : (
        <TemporalDependenciesExplorer
          client:load
          sections={temporalSections.map((section) => ({
            periodKey: section.periodKey,
            periodLabel: section.periodLabel,
            periodDays: section.periodDays,
            dependencies: section.dependencies.map((dependency) => ({
              periodKey: dependency.periodKey,
              periodLabel: dependency.periodLabel,
              periodDays: dependency.periodDays,
              file1: dependency.file1,
              file2: dependency.file2,
              sameCommits: dependency.sameCommits,
              commitsFile1: dependency.commitsFile1,
              commitsFile2: dependency.commitsFile2,
              latestCommit: dependency.latestCommit,
            })),
          }))}
        />
      )}
    </div>
  )}
</Dashboard>

<style>
  .subtitle { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .card { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; }
  .card-value { font-size: 1.75rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
  .card-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
</style>
