---
import RepositoryImpactView from "@planetnik/report-ui/views/RepositoryImpactView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { readLandscapeRepoJson } from "../../../../lib/landscape";
import {
	getLandscapeRepositoryComponentsHref,
	getLandscapeRepositoryContributorsHref,
	getLandscapeRepositoryControlsHref,
	getLandscapeRepositoryHotspotsHref,
	mapLandscapeRepositoryRoute,
} from "../../../../lib/landscape";
import {
	getLandscapeRepositoryPageContext,
	getLandscapeRepositoryStaticPaths,
	type LandscapeRepoPageProps,
} from "../../../../lib/landscapeRepoContext";

type ImpactDimensionKey =
	| "complexity_reduction"
	| "boundary_shaping"
	| "knowledge_spread"
	| "coordination_relief"
	| "change_enablement";

interface RepoImpactItem {
	id: string;
	name: string;
	route: string;
	kind: "file" | "unit" | "component";
	parent?: string;
	impact_score: number;
	visible_activity_score: number;
	structural_impact_score: number;
	dominant_dimension: ImpactDimensionKey;
	dimensions: Record<ImpactDimensionKey, number>;
	suggested_action: string;
	reasons: string[];
}

interface RepoImpactExport {
	title: string;
	visible_activity: {
		commits: number;
		contributors: number;
		changed_files: number;
		changed_units: number;
	};
	structural_impact: {
		summary: {
			overall_score: number;
			dominant_dimension: ImpactDimensionKey;
		};
	};
	impact_dimensions: Array<{
		id: ImpactDimensionKey;
		label: string;
		score: number;
		reasons: string[];
	}>;
	concept_mappings: Array<{
		concept: string;
		dimension: ImpactDimensionKey;
		evidence_count: number;
		example_ids: string[];
	}>;
	impact_opportunities: RepoImpactItem[];
	snacking_candidates: Array<{
		id: string;
		name: string;
		route: string;
		kind: "file" | "unit" | "component";
		visible_activity_score: number;
		structural_impact_score: number;
		reason: string;
	}>;
}

export async function getStaticPaths() {
	return getLandscapeRepositoryStaticPaths();
}

const props = Astro.props as LandscapeRepoPageProps;
const { reportContext, projectName, repoName } =
	await getLandscapeRepositoryPageContext(props);

if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect("/");
}

const impact = readLandscapeRepoJson<RepoImpactExport>(props.repoKey, "impact.json");

const dimensionLabels: Record<ImpactDimensionKey, string> = {
	complexity_reduction: "Complexity reduction",
	boundary_shaping: "Boundary shaping",
	knowledge_spread: "Knowledge spread",
	coordination_relief: "Coordination relief",
	change_enablement: "Change enablement",
};

function truncateLabel(value: string, max = 34): string {
	return value.length > max ? `${value.slice(0, max - 1)}…` : value;
}

function formatEvidenceExample(id: string): string {
	if (id.startsWith("component:")) {
		const parts = id.split(":");
		const componentName = parts[2] ?? parts[1] ?? "";
		return `component · ${componentName}`;
	}
	if (id.startsWith("file:")) {
		const filePath = id.slice("file:".length);
		return `file · ${filePath.split("/").pop() ?? filePath}`;
	}
	if (id.startsWith("unit:")) {
		const unitPath = id.slice("unit:".length);
		const sep = unitPath.lastIndexOf(":");
		const rel = sep >= 0 ? unitPath.slice(0, sep) : unitPath;
		const line = sep >= 0 ? unitPath.slice(sep + 1) : "";
		const fileName = rel.split("/").pop() ?? rel;
		return line ? `unit · ${fileName}:${line}` : `unit · ${fileName}`;
	}
	return id.length > 40 ? `${id.slice(0, 39)}…` : id;
}

const sorted = impact
	? [...impact.impact_opportunities].sort((a, b) => b.impact_score - a.impact_score).slice(0, 12)
	: [];
const sortedSnacking = impact ? [...impact.snacking_candidates].slice(0, 8) : [];

const dimensionChartData =
	impact?.impact_dimensions.map((d) => ({ label: d.label, value: d.score })) ?? [];
const topOpportunityData = sorted.map((item) => ({
	label: truncateLabel(item.name),
	value: item.impact_score,
}));
const snackingChartData = sortedSnacking.map((item) => {
	const delta = Math.max(item.visible_activity_score - item.structural_impact_score, 0);
	return {
		label: truncateLabel(item.name),
		value: delta,
		detail: `activity ${item.visible_activity_score.toFixed(1)}`,
		detailSecondary: `impact ${item.structural_impact_score.toFixed(1)}`,
	};
});

const conceptCards =
	impact?.concept_mappings.map((mapping) => ({
		concept: mapping.concept,
		dimension: dimensionLabels[mapping.dimension],
		evidenceCount: mapping.evidence_count,
		examples: mapping.example_ids.slice(0, 3).map((id) => formatEvidenceExample(id)),
	})) ?? [];

const playbookItems = [
	{
		title: "Reduce complexity in hotspot cores",
		body: "Start where large units, duplication, and structural hotspot pressure overlap. Those are usually the fastest durable wins.",
		href: getLandscapeRepositoryHotspotsHref(props.repoKey),
		label: "Open Hotspots",
	},
	{
		title: "Stabilize overloaded boundaries",
		body: "Use component and topology evidence together to tighten areas that pull too much coordination inside the repository.",
		href: getLandscapeRepositoryComponentsHref(props.repoKey),
		label: "Open Components",
	},
	{
		title: "Spread knowledge in fragile areas",
		body: "Large components with thin backup coverage raise delivery and offboarding risk. Use people signals before the next major change lands there.",
		href: getLandscapeRepositoryContributorsHref(props.repoKey),
		label: "Open Contributors",
	},
	{
		title: "Hold the line after improvement",
		body: "After a structural improvement, turn the insight into a control so the repository does not slide back into the same failure mode.",
		href: getLandscapeRepositoryControlsHref(props.repoKey),
		label: "Open Goals & Controls",
	},
];

const opportunityRows = sorted.map((item, index) => ({
	id: `opp-${index}`,
	name: item.name,
	href: mapLandscapeRepositoryRoute(props.repoKey, item.route),
	kind: item.kind.charAt(0).toUpperCase() + item.kind.slice(1),
	parent: item.parent || "System-wide",
	impactScore: item.impact_score,
	visibleActivity: item.visible_activity_score,
	structuralImpact: item.structural_impact_score,
	dominantDimension: dimensionLabels[item.dominant_dimension],
	complexityReduction: item.dimensions.complexity_reduction,
	boundaryShaping: item.dimensions.boundary_shaping,
	knowledgeSpread: item.dimensions.knowledge_spread,
	coordinationRelief: item.dimensions.coordination_relief,
	changeEnablement: item.dimensions.change_enablement,
	suggestedAction: item.suggested_action,
	reasons: item.reasons.join(" • "),
}));

const snackingRows = sortedSnacking.map((item, index) => ({
	id: `snack-${index}`,
	name: item.name,
	href: mapLandscapeRepositoryRoute(props.repoKey, item.route),
	kind: item.kind.charAt(0).toUpperCase() + item.kind.slice(1),
	visibleActivity: item.visible_activity_score,
	structuralImpact: item.structural_impact_score,
	delta: Math.max(item.visible_activity_score - item.structural_impact_score, 0),
	reason: item.reason,
}));

const dominantDimensionKey =
	impact?.structural_impact.summary.dominant_dimension as ImpactDimensionKey | undefined;

const cards = impact
	? [
			{ label: "Visible Commits", value: impact.visible_activity.commits.toLocaleString(), detail: null },
			{ label: "Changed Files", value: impact.visible_activity.changed_files.toLocaleString(), detail: null },
			{ label: "Contributors", value: impact.visible_activity.contributors.toLocaleString(), detail: null },
			{
				label: "Structural Impact",
				value: impact.structural_impact.summary.overall_score.toFixed(1),
				detail: dominantDimensionKey ? dimensionLabels[dominantDimensionKey] : null,
				accentColor: "var(--chart-green)",
			},
			{ label: "Impact Opportunities", value: impact.impact_opportunities.length.toLocaleString(), detail: null },
			{
				label: "Snacking Candidates",
				value: impact.snacking_candidates.length.toLocaleString(),
				detail: null,
				accentColor: "var(--chart-orange)",
			},
		]
	: [];
---

<Dashboard title={`${repoName} Impact`} projectName={projectName} repoScope={{ repoKey: props.repoKey, repoName }}>
	{impact ? (
		<RepositoryImpactView
			heading={repoName}
			subtitle={`Activity and structural impact analysis for ${repoName}.`}
			cards={cards}
			dimensionChartData={dimensionChartData}
			topOpportunityData={topOpportunityData}
			snackingChartData={snackingChartData}
			conceptCards={conceptCards}
			playbookItems={playbookItems}
			opportunityRows={opportunityRows}
			snackingRows={snackingRows}
		/>
	) : (
		<div class="empty">
			<p>No impact data exported yet.</p>
			<p class="hint">Generate reports with the latest Planetnik CLI to produce <code>impact.json</code>.</p>
		</div>
	)}
</Dashboard>

<style>
	.empty {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 2rem;
		text-align: center;
	}

	.empty p {
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.hint {
		font-size: 0.85rem;
	}

	code {
		font-family: "SF Mono", "Fira Code", monospace;
		font-size: 0.85em;
		background: var(--color-surface-muted);
		padding: 0.15em 0.4em;
		border-radius: 3px;
	}
</style>
