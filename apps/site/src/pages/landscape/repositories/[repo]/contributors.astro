---
import { getCollection, getEntry } from "astro:content";
import RepositoryContributorsView from "@planetnik/report-ui/views/RepositoryContributorsView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import { getContributorDisplayName } from "../../../../lib/contributors";
import {
	getLandscapeRepoRouteParam,
	getLandscapeRepositoryContributorHref,
	getLandscapeRepositoryHref,
	readLandscapeRepoJson,
} from "../../../../lib/landscape";
import { route } from "../../../../lib/route";

interface RepoAnalysisSummary {
	metadata?: {
		name?: string;
		description?: string;
	};
}

interface RepoContributorSummary {
	email: string;
	userName?: string;
	commitsCount: number;
	commitsCount30Days: number;
	commitsCount90Days: number;
	firstCommitDate: string;
	latestCommitDate: string;
	isBot?: boolean;
}

interface RepoContributorsExport {
	contributorCount?: number;
	contributors?: RepoContributorSummary[];
}

interface RepoContributorImpactEntry {
	email: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	dominant_dimension: string;
	is_glue: boolean;
	is_snacking: boolean;
}

interface RepoContributorImpactExport {
	periods?: Array<{
		period_key?: string;
		contributors?: RepoContributorImpactEntry[];
	}>;
}

export async function getStaticPaths() {
	const repositories = await getCollection("landscapeRepositories");

	return repositories.map((repository) => ({
		params: { repo: getLandscapeRepoRouteParam(repository.data.repoKey) },
		props: {
			repositoryId: repository.id,
			repoKey: repository.data.repoKey,
		},
	}));
}

const { repositoryId, repoKey } = Astro.props as {
	repositoryId: string;
	repoKey: string;
};

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const repository = await getEntry("landscapeRepositories", repositoryId);
if (!repository) {
	throw new Error(`Landscape repository entry not found for ${repositoryId}`);
}

const repoSummary = readLandscapeRepoJson<RepoAnalysisSummary>(
	repoKey,
	"analysisResults.json",
);
const repoContributors = readLandscapeRepoJson<RepoContributorsExport>(
	repoKey,
	"contributors.json",
);
const repoContributorImpact =
	readLandscapeRepoJson<RepoContributorImpactExport>(
		repoKey,
		"contributor_impact.json",
	);

const impactByEmail = new Map(
	(
		repoContributorImpact?.periods?.find(
			(period) => period.period_key === "all_time",
		)?.contributors ?? []
	).map((entry) => [entry.email, entry]),
);

const sortedContributors = (repoContributors?.contributors ?? [])
	.slice()
	.sort(
		(left, right) =>
			right.commitsCount - left.commitsCount ||
			left.email.localeCompare(right.email),
	);

const rows = sortedContributors.map((contributor) => {
	const impact = impactByEmail.get(contributor.email);
	return {
		id: contributor.email,
		contributor: getContributorDisplayName({
			email: contributor.email,
			userName: contributor.userName,
		}),
		href: getLandscapeRepositoryContributorHref(repoKey, contributor.email),
		email: contributor.userName ? contributor.email : "",
		type: contributor.isBot ? "Bot" : "Human",
		commitsCount: contributor.commitsCount,
		commits30d: contributor.commitsCount30Days,
		commits90d: contributor.commitsCount90Days,
		latestCommitDate: contributor.latestCommitDate,
		firstCommitDate: contributor.firstCommitDate,
		glueScore: impact ? impact.glue_score.toFixed(1) : "—",
		structuralImpact: impact
			? impact.structural_impact_score.toFixed(1)
			: "—",
		snackRisk: impact ? impact.snacking_score.toFixed(1) : "—",
		signal: impact?.is_glue
			? "Glue"
			: impact?.is_snacking
				? "Snacking"
				: impact
					? impact.dominant_dimension.replace(/_/g, " ")
					: "—",
	};
});

const projectName = reportContext.data.title;
const repoName = repository.data.name;
const description =
	repository.data.description ||
	repoSummary?.metadata?.description ||
	"Contributor inventory for the selected repository.";
const botCount = sortedContributors.filter((c) => c.isBot).length;
const humanCount = Math.max(rows.length - botCount, 0);
const topContributor = rows[0]?.contributor ?? "—";
---

<Dashboard
	title={`${repoName} Contributors`}
	projectName={projectName}
	repoScope={{ repoKey, repoName }}
>
	<RepositoryContributorsView
		repoName={repoName}
		description={description}
		backHref={getLandscapeRepositoryHref(repoKey)}
		totalCount={rows.length}
		humanCount={humanCount}
		botCount={botCount}
		topContributor={topContributor}
		rows={rows}
	/>
</Dashboard>
