---
import { getCollection, getEntry } from "astro:content";
import RepositoryTopologyView from "@planetnik/report-ui/views/RepositoryTopologyView";
import Dashboard from "../../../../layouts/Dashboard.astro";
import {
	getLandscapeRepoRouteParam,
	getLandscapeRepositoryContributorsHref,
	getLandscapeRepositoryHref,
	readLandscapeRepoJson,
} from "../../../../lib/landscape";
import { route } from "../../../../lib/route";

type PeopleDep = { from: string; to: string; count: number; files: string[] };
type ContributorImpactDimensionKey =
	| "complexity_reduction"
	| "boundary_shaping"
	| "knowledge_spread"
	| "coordination_relief"
	| "change_enablement";

type ContributorImpactContributor = {
	email: string;
	display_name: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	visible_activity_score: number;
	collaborator_count: number;
	shared_files_count: number;
	commits_count: number;
	files_touched: number;
	components_touched: number;
	dominant_dimension: ContributorImpactDimensionKey;
	dimensions: Record<ContributorImpactDimensionKey, number>;
	top_components: Array<{ name: string; files: number; commits: number }>;
	top_routes: string[];
	reasons: string[];
	is_glue: boolean;
	is_snacking: boolean;
};

type ContributorImpactPeriod = {
	period_key: "all_time" | "30d" | "90d" | "180d" | "365d";
	period_label: string;
	contributors: ContributorImpactContributor[];
};

type ContributorImpactExport = {
	periods?: ContributorImpactPeriod[];
};

interface RepoAnalysisSummary {
	metadata?: {
		name?: string;
	};
}

const periodFiles = {
	"All Time": "people_dependencies.json",
	"1 Year": "people_dependencies_365d.json",
	"6 Months": "people_dependencies_180d.json",
	Quarter: "people_dependencies_90d.json",
	Month: "people_dependencies_30d.json",
} as const;

export async function getStaticPaths() {
	const repositories = await getCollection("landscapeRepositories");

	return repositories.map((repository) => ({
		params: { repo: getLandscapeRepoRouteParam(repository.data.repoKey) },
		props: {
			repositoryId: repository.id,
			repoKey: repository.data.repoKey,
		},
	}));
}

const { repositoryId, repoKey } = Astro.props as {
	repositoryId: string;
	repoKey: string;
};

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode !== "landscape") {
	return Astro.redirect(route("/"));
}

const repository = await getEntry("landscapeRepositories", repositoryId);
if (!repository) {
	throw new Error(`Landscape repository entry not found for ${repositoryId}`);
}

const repoSummary = readLandscapeRepoJson<RepoAnalysisSummary>(
	repoKey,
	"analysisResults.json",
);

function loadPeriod(filename: string): PeopleDep[] {
	return readLandscapeRepoJson<PeopleDep[]>(repoKey, filename) ?? [];
}

function loadContributorImpact(): Record<
	string,
	ContributorImpactContributor[]
> {
	const raw = readLandscapeRepoJson<ContributorImpactExport>(
		repoKey,
		"contributor_impact.json",
	);
	if (!raw) return {};

	const labelByPeriodKey: Record<
		ContributorImpactPeriod["period_key"],
		string
	> = {
		all_time: "All Time",
		"365d": "1 Year",
		"180d": "6 Months",
		"90d": "Quarter",
		"30d": "Month",
	};

	return Object.fromEntries(
		(raw.periods ?? []).map((period) => [
			labelByPeriodKey[period.period_key],
			period.contributors ?? [],
		]),
	);
}

const periods = Object.fromEntries(
	Object.entries(periodFiles)
		.map(([label, fileName]) => [label, loadPeriod(fileName)])
		.filter(([, edges]) => edges.length > 0),
) as Record<string, PeopleDep[]>;

const contributorImpactPeriods = loadContributorImpact();
const availableImpactPeriods = Object.fromEntries(
	Object.keys(periods).map((key) => [key, contributorImpactPeriods[key] ?? []]),
) as Record<string, ContributorImpactContributor[]>;

const hasData = Object.keys(periods).length > 0;
const projectName = reportContext.data.title;
const repoName =
	repository.data.name ||
	repoSummary?.metadata?.name ||
	repoKey.split("/").at(-1) ||
	repoKey;
---

<Dashboard
  title={`${repoName} Topology`}
  projectName={projectName}
  repoScope={{ repoKey, repoName }}
>
  {!hasData ? (
    <div class="empty">
      <p>No people dependency data available for this repository.</p>
      <p class="hint">Generate repository reports inside the landscape analysis root to enable repo-scoped topology.</p>
    </div>
  ) : (
    <RepositoryTopologyView
      heading={repoName}
      subtitle={`Contributors connected by shared file modifications inside ${repoName}.`}
      backHref={getLandscapeRepositoryHref(repoKey)}
      periods={periods}
      impactPeriods={availableImpactPeriods}
      contributorHrefBase={getLandscapeRepositoryContributorsHref(repoKey)}
      componentsHref={null}
    />
  )}
</Dashboard>

<style>
  .empty {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 2rem;
    text-align: center;
  }

  .empty p {
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }

  .hint {
    font-size: 0.85rem;
  }
</style>
