---
import { Image } from "astro:assets";
import { getEntry } from "astro:content";
import Hero from "../components/Hero.astro";
import Dashboard from "../layouts/Dashboard.astro";
import { route } from "../lib/route";

const summary = await getEntry("analysis", "summary");
const reportContext = await getEntry("reportContext", "context");
const projectName =
	reportContext?.data.title ?? summary?.data.metadata.name ?? "Planetnik";
const reportMode = reportContext?.data.reportMode ?? "single_repository";
const isLandscape = reportMode === "landscape";

const tutorialSteps = isLandscape
	? [
			{
				title: "Read the landscape dashboard",
				body: "Start on the landscape dashboard to see which repositories are in scope, their relative size, and contributor spread across the organisation.",
				href: route("/landscape"),
				label: "Open Landscape",
			},
			{
				title: "Drill into a repository",
				body: "Pick a repository from the list to explore its structure, hotspots, contributors, and quality controls at the individual project level.",
				href: route("/landscape/repositories"),
				label: "Open Repositories",
			},
			{
				title: "Review cross-repo contributors",
				body: "Use landscape contributors and team topology to understand knowledge spread, collaboration patterns, and ownership concentration across repositories.",
				href: route("/landscape/contributors"),
				label: "Open Contributors",
			},
		]
	: [
			{
				title: "Read the dashboard first",
				body: "Start on the dashboard and overview pages to understand system scale, language mix, and obvious concentration points before diving into detail.",
				href: route("/"),
				label: "Open Dashboard",
			},
			{
				title: "Find the next thing to fix",
				body: "Use impact and hotspots to distinguish visible activity from structural leverage, then identify where risk, churn, ownership, and coupling are overlapping.",
				href: route("/impact"),
				label: "Open Impact",
			},
			{
				title: "Validate with evidence",
				body: "Cross-check hotspot candidates with dependencies, temporal coupling, contributors, and controls so you act on evidence instead of intuition.",
				href: route("/dependencies"),
				label: "Open Dependencies",
			},
		];

const howToGuides = isLandscape
	? [
			{
				title: "Understand the landscape",
				text: "Use the Landscape Dashboard and Repositories list to build an initial map of organisation-wide structure, size, and activity.",
				links: [
					{ href: route("/landscape"), label: "Landscape Dashboard" },
					{ href: route("/landscape/repositories"), label: "Repositories" },
				],
			},
			{
				title: "Assess team and knowledge risk",
				text: "Use Contributors and Team Topology to evaluate ownership spread, collaboration patterns, and knowledge concentration across the organisation.",
				links: [
					{ href: route("/landscape/contributors"), label: "Contributors" },
					{ href: route("/landscape/teams"), label: "Teams" },
					{ href: route("/landscape/topology"), label: "Team Topology" },
				],
			},
			{
				title: "Explore repository tags",
				text: "Use Tags to filter and group repositories by technology, domain, or any custom classification applied during analysis.",
				links: [{ href: route("/landscape/tags"), label: "Tags" }],
			},
			{
				title: "Deep-dive into a single repository",
				text: "From the Repositories list, click into any repository to access its full analysis: components, hotspots, contributors, file metrics, and quality controls.",
				links: [
					{ href: route("/landscape/repositories"), label: "Repositories" },
				],
			},
		]
	: [
			{
				title: "Understand a new codebase fast",
				text: "Use Dashboard, Overview, Components, and Contributors to build an initial map of structure, size, and ownership.",
				links: [
					{ href: route("/"), label: "Dashboard" },
					{ href: route("/overview"), label: "Overview" },
					{ href: route("/components"), label: "Components" },
					{ href: route("/contributors"), label: "Contributors" },
				],
			},
			{
				title: "Investigate risky change areas",
				text: "Start with Hotspots, then validate with File Churn, Temporal Dependencies, and Duplication before planning refactoring work.",
				links: [
					{ href: route("/hotspots"), label: "Hotspots" },
					{ href: route("/files/churn"), label: "File Churn" },
					{ href: route("/files/temporal"), label: "Temporal Dependencies" },
					{ href: route("/duplication"), label: "Duplication" },
				],
			},
			{
				title: "Review architectural boundaries",
				text: "Use Components, Balanced Coupling, Dependencies, and Features of Interest together to see whether intended boundaries match real code structure and change pressure.",
				links: [
					{ href: route("/components"), label: "Components" },
					{ href: route("/coupling"), label: "Balanced Coupling" },
					{ href: route("/dependencies"), label: "Dependencies" },
					{ href: route("/concerns"), label: "Features of Interest" },
				],
			},
			{
				title: "Evaluate coupling overload",
				text: "Start with Balanced Coupling to see which components are overloaded, then validate the story with static dependencies, temporal coupling, and hotspots.",
				links: [
					{ href: route("/coupling"), label: "Balanced Coupling" },
					{ href: route("/dependencies"), label: "Dependencies" },
					{ href: route("/files/temporal"), label: "Temporal Dependencies" },
					{ href: route("/hotspots"), label: "Hotspots" },
				],
			},
			{
				title: "Assess team and knowledge risk",
				text: "Use Contributors, Team Topology, and contributor detail pages to evaluate ownership spread, collaboration patterns, and concentration risk.",
				links: [
					{ href: route("/contributors"), label: "Contributors" },
					{ href: route("/topology"), label: "Team Topology" },
				],
			},
		];

const referenceSections = isLandscape
	? [
			{
				label: "Overview",
				items: [
					[
						route("/landscape"),
						"Landscape dashboard with organisation-wide summary.",
					],
					[route("/about"), "Płanetnik philosophy and weather metaphor."],
				],
			},
			{
				label: "Landscape",
				items: [
					[
						route("/landscape/repositories"),
						"All repositories in the landscape with size and activity.",
					],
					[
						route("/landscape/contributors"),
						"Contributor activity and ownership across repositories.",
					],
					[
						route("/landscape/teams"),
						"Team membership and repository coverage.",
					],
					[
						route("/landscape/topology"),
						"Contributor collaboration topology across the organisation.",
					],
					[route("/landscape/tags"), "Repository tags and classification."],
				],
			},
		]
	: [
			{
				label: "Overview",
				items: [
					[
						route("/"),
						"Project summary, language mix, and duplicate headline metrics.",
					],
					[
						route("/overview"),
						"Main vs test code shape and extension breakdown.",
					],
					[
						route("/metrics"),
						"Raw metric inventory and grouped numeric summaries.",
					],
					[route("/about"), "Płanetnik philosophy and weather metaphor."],
				],
			},
			{
				label: "Structure",
				items: [
					[
						route("/components"),
						"Logical component size and knowledge coverage.",
					],
					[
						route("/coupling"),
						"Balanced coupling pressure and Big Ball of Mud view.",
					],
					[
						route("/dependencies"),
						"Static component dependency relationships.",
					],
					[
						route("/duplication"),
						"Duplicate blocks and repeated code signals.",
					],
				],
			},
			{
				label: "Files & Units",
				items: [
					[route("/files/size"), "Large files by lines of code."],
					[route("/files/age"), "File age and legacy concentration."],
					[route("/files/churn"), "Frequently changed files and volatility."],
					[route("/files/temporal"), "Files that move together over time."],
					[route("/units/size"), "Large functions and methods."],
					[route("/units/complexity"), "High McCabe complexity units."],
				],
			},
			{
				label: "People & Quality",
				items: [
					[
						route("/contributors"),
						"Contributor activity, ownership, and knowledge spread.",
					],
					[route("/commits"), "Commit trends and extension-level change."],
					[route("/topology"), "Contributor collaboration topology."],
					[
						route("/impact"),
						"Visible activity versus structural impact and snacking signals.",
					],
					[
						route("/hotspots"),
						"Ranked queue of risky files, units, and components.",
					],
					[route("/controls"), "Quality controls and goal coverage."],
					[route("/findings"), "Configured findings, when exported."],
					[route("/trends"), "Movement of structural signals over time."],
				],
			},
		];
---

<Dashboard title="Guide" projectName={projectName}>
  <div class="guide">
    <Hero tagline="Learn the forecast before you change the weather" />

    <p class="lead">
      This guide is the fastest way to onboard into <strong>Płanetnik</strong> and understand how to use the reports in a
      practical sequence.
    </p>

    <p>
      It follows the <strong><a href="https://diataxis.fr/" target="_blank" rel="noopener noreferrer">Diátaxis</a></strong> model so that help is easier to use: start with a tutorial, move into
      task-focused how-to guidance, use the reference map when you need to locate information quickly, and read the
      explanation sections when you want the reasoning behind the product.
    </p>

    <div class="section-banner">
      <Image
        src={route("/plantnik-banner.webp")}
        alt="Planetnik guide banner"
        width={1536}
        height={1024}
        class="section-banner-image"
      />
    </div>

    <hr />

    <h3>Tutorials</h3>
    <p>Use these when you are new to Płanetnik and want a guided path instead of a menu of unrelated reports.</p>

    <div class="guide-grid">
      {tutorialSteps.map((step, index) => (
        <article class="guide-card">
          <div class="guide-card-kicker">tutorial {index + 1}</div>
          <h4>{step.title}</h4>
          <p>{step.body}</p>
          <a href={step.href} class="guide-link">{step.label}</a>
        </article>
      ))}
    </div>

    <blockquote>
      {isLandscape
        ? "Recommended first pass: landscape dashboard → repositories → pick a repo → hotspots → contributors."
        : "Recommended first pass: dashboard → hotspots → dependencies → contributors → controls."}
    </blockquote>

    <hr />

    <h3>How-To Guides</h3>
    <p>Use these when you already know what you are trying to accomplish and need the shortest route to the right view.</p>

    <div class="guide-grid">
      {howToGuides.map((guide) => (
        <article class="guide-card">
          <h4>{guide.title}</h4>
          <p>{guide.text}</p>
          <ul class="link-list">
            {guide.links.map((link) => (
              <li><a href={link.href}>{link.label}</a></li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <hr />

    <h3>Reference</h3>
    <p>Use this section when you know the name of a report area and want a quick description of what each page contains.</p>

    <div class="reference-grid">
      {referenceSections.map((section) => (
        <section class="reference-card">
          <h4>{section.label}</h4>
          <dl>
            {section.items.map(([href, text]) => (
              <>
                <dt><a href={href}>{href}</a></dt>
                <dd>{text}</dd>
              </>
            ))}
          </dl>
        </section>
      ))}
    </div>

    <hr />

    <h3>Explanation</h3>
    <p>Use these notes when you want to understand why the reports are organized the way they are and how to interpret them together.</p>

    {isLandscape ? (
      <>
        <h4>Start From the Landscape, Then Drill Down</h4>
        <p>
          The landscape dashboard gives you the organisation-wide view. When something stands out (size, contributor concentration,
          tag patterns) drill into the specific repository to investigate with the full single-repo analysis.
        </p>

        <h4>Read People and Code Together</h4>
        <p>
          Many delivery problems are socio-technical. Use <a href={route("/landscape/contributors")}>Contributors</a> and
          <a href={route("/landscape/topology")}>Team Topology</a> to understand knowledge spread, coordination
          risk, and ownership concentration across the organisation.
        </p>

        <h4>Use Repository-Level Views for Evidence</h4>
        <p>
          Landscape views show the big picture. When you need evidence for a specific change, drill into a repository
          to access its hotspots, components, file metrics, and quality controls.
        </p>
      </>
    ) : (
      <>
        <h4>Start With Queues, Not Charts</h4>
        <p>
          Płanetnik contains many charts, but the product is most useful when it helps you choose a better engineering action.
          That is why <a href={route("/impact")}>Impact</a>, <a href={route("/hotspots")}>Hotspots</a>, <a href={route("/controls")}>Goals &amp; Controls</a>, and
          <a href={route("/findings")}>Findings</a> should usually anchor triage.
        </p>

        <h4>Use Multiple Views to Validate a Story</h4>
        <p>
          A single metric is rarely enough. A file is more interesting when it is large <em>and</em> frequently changed.
          A component is more important when it is central <em>and</em> weakly owned. Use structure, history, and people
          views together.
        </p>

        <h4>Read People and Code Together</h4>
        <p>
          Many delivery problems are socio-technical. Use <a href={route("/contributors")}>Contributors</a> and
          <a href={route("/topology")}>Team Topology</a> alongside code-level reports to understand knowledge spread, coordination
          risk, and ownership concentration.
        </p>

        <h4>Prefer Evidence Before Refactoring</h4>
        <p>
          Use <a href={route("/dependencies")}>Dependencies</a>, <a href={route("/files/temporal")}>Temporal Dependencies</a>, and
          <a href={route("/duplication")}>Duplication</a> to build evidence for change. Refactoring is easier to defend when you can
          show structural pressure, not just discomfort.
        </p>

        <h4>Treat Balanced Coupling as a Pressure Map</h4>
        <p>
          Use <a href={route("/coupling")}>Balanced Coupling</a> when you want one page that blends static dependencies, co-change,
          coordination, and knowledge exposure. It is a triage surface, not a replacement for the underlying evidence views.
        </p>
      </>
    )}
  </div>
</Dashboard>

<style>
  .guide {
    max-width: none;
  }

  .guide > :not(.section-banner):not(.guide-grid):not(.reference-grid) {
    max-width: 720px;
  }

  .lead {
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  p {
    line-height: 1.7;
    margin-bottom: 0.85rem;
    color: var(--color-text);
  }

  hr {
    border: none;
    border-top: 1px solid var(--color-border);
    margin: 2rem 0;
  }

  h3 {
    font-size: 1.15rem;
    font-weight: 600;
    margin-bottom: 1rem;
    color: var(--color-text);
  }

  h4 {
    font-size: 0.95rem;
    font-weight: 600;
    margin-top: 0;
    margin-bottom: 0.5rem;
    color: var(--color-text);
  }

  a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  a:hover {
    text-decoration: underline;
  }

  blockquote {
    border-left: 3px solid var(--color-accent);
    padding: 0.5rem 1rem;
    margin: 1rem 0;
    font-style: italic;
    color: var(--color-text-muted);
    background: var(--color-accent-soft);
    border-radius: var(--radius-attached);
  }

  .guide-grid,
  .reference-grid {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    margin: 1.25rem 0 0;
  }

  .guide-card,
  .reference-card {
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
    padding: 1.2rem 1.2rem 1.1rem;
  }

  .guide-card p,
  .reference-card p,
  .reference-card dd {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }

  .guide-card-kicker {
    font-size: 0.72rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-accent);
    margin-bottom: 0.6rem;
  }

  .guide-link {
    display: inline-flex;
    margin-top: 0.9rem;
  }

  .link-list {
    margin: 0.85rem 0 0 1rem;
    line-height: 1.6;
  }

  .reference-card dl {
    margin: 0.75rem 0 0;
  }

  .reference-card dt {
    margin-top: 0.8rem;
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.8rem;
  }

  .reference-card dt:first-child {
    margin-top: 0;
  }

  .reference-card dd {
    margin: 0.2rem 0 0;
    line-height: 1.6;
  }

  @media (max-width: 720px) {
    .guide-grid,
    .reference-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
