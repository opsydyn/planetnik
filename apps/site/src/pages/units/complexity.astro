---
import { getCollection, getEntry } from "astro:content"
import DistributionChart from "../../components/charts/DistributionChart"
import DonutChart from "../../components/charts/DonutChart"
import ScatterPlot from "../../components/charts/ScatterPlot"
import ReportDataGrid from "../../components/tables/ReportDataGrid"
import Dashboard from "../../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const units = await getCollection("units")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by McCabe complexity descending
const sorted = [...units].sort((a, b) => b.data.mcCabeIndex - a.data.mcCabeIndex)

// Complexity distribution
const buckets = [
  { label: "1-5 (simple)", min: 1, max: 5, count: 0, color: "#22c55e" },
  { label: "6-10 (moderate)", min: 6, max: 10, count: 0, color: "#eab308" },
  { label: "11-25 (complex)", min: 11, max: 25, count: 0, color: "#f97316" },
  { label: "26+ (very complex)", min: 26, max: Infinity, count: 0, color: "#ef4444" },
]
for (const u of sorted) {
  for (const b of buckets) {
    if (u.data.mcCabeIndex >= b.min && u.data.mcCabeIndex <= b.max) { b.count++; break }
  }
}

const distData = buckets.map((b) => ({
  label: b.label,
  value: b.count,
  detail: b.count.toString(),
  color: b.color,
}))

const scatterData = sorted.slice(0, 200).map((u) => ({
  x: u.data.linesOfCode,
  y: u.data.mcCabeIndex,
  label: u.data.shortName,
}))

const complexityRows = sorted.map((u) => ({
  id: `${u.data.relativeFileName}:${u.data.shortName}`,
  unit: u.data.shortName,
  file: u.data.relativeFileName,
  mcCabeIndex: u.data.mcCabeIndex,
  linesOfCode: u.data.linesOfCode,
}))
---

<Dashboard title="Conditional Complexity" projectName={projectName}>
  <h2>Conditional Complexity</h2>
  <p class="subtitle">{sorted.length.toLocaleString()} units analyzed</p>

  <section class="section">
    <h3>Complexity Risk</h3>
    <DonutChart client:load data={buckets.filter((b) => b.count > 0).map((b) => ({ label: b.label, value: b.count }))} valueLabel="units" />
  </section>

  <section class="section">
    <h3>McCabe Complexity Distribution</h3>
    <DistributionChart client:load data={distData} />
  </section>

  <section class="section">
    <h3>LOC vs McCabe Complexity</h3>
    <ScatterPlot client:load data={scatterData} xLabel="Lines of Code" yLabel="McCabe Index" thresholds={{ x: 50, y: 10 }} />
  </section>

  <section class="section">
    <h3>Most Complex Units</h3>
    <ReportDataGrid
      client:load
      title="Complexity Table"
      description="Search and paginate the full complexity dataset while the charts stay focused on the highest-signal views."
      searchPlaceholder="Search unit or file path"
      rows={complexityRows}
      columns={[
        { field: "unit", headerName: "Unit", minWidth: 260, flex: 1.1 },
        { field: "file", headerName: "File", type: "path", minWidth: 320, flex: 1.2 },
        { field: "mcCabeIndex", headerName: "McCabe", type: "number", minWidth: 120, sort: "desc" },
        { field: "linesOfCode", headerName: "LOC", type: "number", minWidth: 120 },
      ]}
    />
  </section>
</Dashboard>

<style>
  .subtitle { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
</style>
