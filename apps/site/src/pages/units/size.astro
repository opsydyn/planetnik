---
import { getCollection, getEntry } from "astro:content"
import Dashboard from "../../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const units = await getCollection("units")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by LOC descending
const sorted = [...units].sort((a, b) => b.data.linesOfCode - a.data.linesOfCode)
const totalLoc = sorted.reduce((sum, u) => sum + u.data.linesOfCode, 0)

// Size distribution
const buckets = [
  { label: "1-10", min: 1, max: 10, count: 0, loc: 0 },
  { label: "11-20", min: 11, max: 20, count: 0, loc: 0 },
  { label: "21-50", min: 21, max: 50, count: 0, loc: 0 },
  { label: "51-100", min: 51, max: 100, count: 0, loc: 0 },
  { label: "101+", min: 101, max: Infinity, count: 0, loc: 0 },
]

for (const u of sorted) {
  for (const b of buckets) {
    if (u.data.linesOfCode >= b.min && u.data.linesOfCode <= b.max) {
      b.count++
      b.loc += u.data.linesOfCode
      break
    }
  }
}

const maxBucketLoc = Math.max(...buckets.map((b) => b.loc))
---

<Dashboard title="Unit Size" projectName={projectName}>
  <h2>Unit Size</h2>
  <p class="subtitle">{sorted.length.toLocaleString()} units, {totalLoc.toLocaleString()} total lines in units</p>

  <section class="section">
    <h3>Size Distribution</h3>
    <div class="distribution">
      {buckets.map((b) => (
        <div class="dist-row">
          <span class="dist-label">{b.label} LOC</span>
          <div class="dist-bar-container">
            <div
              class="dist-bar"
              style={`width: ${maxBucketLoc > 0 ? (b.loc / maxBucketLoc) * 100 : 0}%`}
            />
          </div>
          <span class="dist-count">{b.count} units</span>
          <span class="dist-loc">{b.loc.toLocaleString()} LOC</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <h3>Largest Units</h3>
    <table>
      <thead>
        <tr>
          <th>Unit</th>
          <th>File</th>
          <th>LOC</th>
          <th>McCabe</th>
          <th>Params</th>
        </tr>
      </thead>
      <tbody>
        {sorted.slice(0, 50).map((u) => (
          <tr>
            <td class="unit-name">{u.data.shortName}</td>
            <td class="filepath">{u.data.relativeFileName}</td>
            <td>{u.data.linesOfCode}</td>
            <td class={u.data.mcCabeIndex > 10 ? "high" : ""}>{u.data.mcCabeIndex}</td>
            <td>{u.data.numberOfParameters}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .section {
    margin-bottom: 2rem;
  }

  .section h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .distribution {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1rem;
  }

  .dist-row {
    display: grid;
    grid-template-columns: 80px 1fr 80px 100px;
    align-items: center;
    gap: 0.75rem;
    padding: 0.35rem 0;
  }

  .dist-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    font-family: "SF Mono", "Fira Code", monospace;
  }

  .dist-bar-container {
    height: 18px;
    background: #f1f5f9;
    border-radius: 3px;
    overflow: hidden;
  }

  .dist-bar {
    height: 100%;
    background: var(--color-accent);
    border-radius: 3px;
    min-width: 2px;
  }

  .dist-count, .dist-loc {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    text-align: right;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
  }

  th, td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    background: #f8fafc;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  td {
    font-size: 0.85rem;
  }

  .unit-name {
    font-weight: 500;
    max-width: min(300px, 40vw);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .filepath {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.75rem;
    color: var(--color-text-muted);
    max-width: min(400px, 40vw);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .high {
    color: #ef4444;
    font-weight: 600;
  }
</style>
