---
import { getCollection, getEntry } from "astro:content"
import DistributionChart from "../../components/charts/DistributionChart"
import Dashboard from "../../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const units = await getCollection("units")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by LOC descending
const sorted = [...units].sort((a, b) => b.data.linesOfCode - a.data.linesOfCode)
const totalLoc = sorted.reduce((sum, u) => sum + u.data.linesOfCode, 0)

// Size distribution
const buckets = [
  { label: "1-10", min: 1, max: 10, count: 0, loc: 0 },
  { label: "11-20", min: 11, max: 20, count: 0, loc: 0 },
  { label: "21-50", min: 21, max: 50, count: 0, loc: 0 },
  { label: "51-100", min: 51, max: 100, count: 0, loc: 0 },
  { label: "101+", min: 101, max: Infinity, count: 0, loc: 0 },
]

for (const u of sorted) {
  for (const b of buckets) {
    if (u.data.linesOfCode >= b.min && u.data.linesOfCode <= b.max) {
      b.count++
      b.loc += u.data.linesOfCode
      break
    }
  }
}

const distData = buckets.map((b) => ({
  label: b.label + " LOC",
  value: b.loc,
  detail: b.count + " units",
  detailSecondary: b.loc.toLocaleString() + " LOC",
}))
---

<Dashboard title="Unit Size" projectName={projectName}>
  <h2>Unit Size</h2>
  <p class="subtitle">{sorted.length.toLocaleString()} units, {totalLoc.toLocaleString()} total lines in units</p>

  <section class="section">
    <h3>Size Distribution</h3>
    <DistributionChart client:load data={distData} />
  </section>

  <section class="section">
    <h3>Largest Units</h3>
    <table>
      <thead>
        <tr>
          <th>Unit</th>
          <th>File</th>
          <th>LOC</th>
          <th>McCabe</th>
          <th>Params</th>
        </tr>
      </thead>
      <tbody>
        {sorted.slice(0, 50).map((u) => (
          <tr>
            <td class="unit-name">{u.data.shortName}</td>
            <td class="filepath">{u.data.relativeFileName}</td>
            <td>{u.data.linesOfCode}</td>
            <td class={u.data.mcCabeIndex > 10 ? "high" : ""}>{u.data.mcCabeIndex}</td>
            <td>{u.data.numberOfParameters}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </section>
</Dashboard>

<style>
  .subtitle { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  table { width: 100%; border-collapse: collapse; background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; }
  th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  th { background: #f8fafc; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); }
  td { font-size: 0.85rem; }
  .unit-name { font-weight: 500; max-width: min(300px, 40vw); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .filepath { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.75rem; color: var(--color-text-muted); max-width: min(400px, 40vw); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .high { color: #ef4444; font-weight: 600; }
</style>
