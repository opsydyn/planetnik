---
import { getCollection, getEntry } from "astro:content"
import DonutChart from "../components/charts/DonutChart"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import StaticReportTable from "../components/tables/StaticReportTable.astro"
import { chartHelp } from "../lib/chartHelp"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Aggregate concerns from files
const concernMap = new Map<string, { files: number; loc: number }>()
for (const f of filesMain) {
  for (const concern of f.data.concerns) {
    const entry = concernMap.get(concern) ?? { files: 0, loc: 0 }
    entry.files++
    entry.loc += f.data.linesOfCode
    concernMap.set(concern, entry)
  }
}
const concerns = [...concernMap.entries()].sort((a, b) => b[1].loc - a[1].loc)

const concernBarData = concerns.slice(0, 15).map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const donutData = concerns.map(([name, s]) => ({
  label: name,
  value: s.loc,
}))
---

<Dashboard title="Features of Interest" projectName={projectName}>
  <h2>Features of Interest</h2>

  {concerns.length === 0 ? (
    <div class="empty">
      <p>No features of interest (concerns) configured.</p>
      <p class="hint">Add <code>concerns</code> to your Planetnik config to track cross-cutting features across your codebase.</p>
    </div>
  ) : (
    <>
    <section class="section">
      <h3>Concern Distribution</h3>
      <DonutChart client:load data={donutData} valueLabel="LOC" helpText={chartHelp.concerns.distribution} />
    </section>
    <section class="section">
      <h3>Top Concerns by Size</h3>
      <HorizontalBarChart client:load data={concernBarData} valueLabel="LOC" helpText={chartHelp.concerns.topConcerns} />
    </section>
    <StaticReportTable ariaLabel="Concern inventory">
      <thead>
        <tr><th><span>Concern</span></th><th><span>Files</span></th><th><span>LOC</span></th></tr>
      </thead>
      <tbody>
        {concerns.map(([name, s]) => (
          <tr>
            <td class="concern-name">{name}</td>
            <td class="report-static-table__num">{s.files.toLocaleString()}</td>
            <td class="report-static-table__num">{s.loc.toLocaleString()}</td>
          </tr>
        ))}
      </tbody>
    </StaticReportTable>
    </>
  )}
</Dashboard>

<style>
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  .concern-name { font-weight: 500; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: var(--color-surface-muted); padding: 0.15em 0.4em; border-radius: 999px; }
</style>
