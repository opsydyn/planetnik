---
import { ClientRouter } from "astro:transitions";
import PublicVideoToggle from "../components/public/PublicVideoToggle";
import { route } from "../lib/route";
---

<!doctype html>
<html lang="en" data-theme="dark" data-theme-preference="system">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="light dark" />
    <title>Planetnik Platform — Coming Soon</title>
    <ClientRouter />
    <script is:inline data-astro-rerun>
      (() => {
        const THEME_ATTR = "data-theme"
        const PREFERENCE_ATTR = "data-theme-preference"
        const STORAGE_KEY = "planetnik-theme-preference"
        const root = document.documentElement
        const isPreference = (value) => value === "light" || value === "dark" || value === "system"
        const systemTheme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light"
        const storedPreference = localStorage.getItem(STORAGE_KEY)
        const preference = isPreference(storedPreference) ? storedPreference : "system"
        const effectiveTheme = preference === "system" ? systemTheme : preference
        root.setAttribute(PREFERENCE_ATTR, preference)
        root.setAttribute(THEME_ATTR, effectiveTheme)
        root.style.colorScheme = effectiveTheme
      })()
    </script>
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        min-height: 100vh;
        padding-top: calc(1.5rem + env(safe-area-inset-top, 0px));
        padding-right: calc(1.25rem + env(safe-area-inset-right, 0px));
        padding-bottom: calc(1.75rem + env(safe-area-inset-bottom, 0px));
        padding-left: calc(1.25rem + env(safe-area-inset-left, 0px));
        position: relative;
        isolation: isolate;
        overflow-x: hidden;
        background: #020817;
        color: #f8fafc;
      }

      .video-layer {
        position: fixed;
        inset: 0;
        z-index: -1;
        pointer-events: none;
      }

      .bg-video {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.9) contrast(1.02);
        opacity: 0.3;
        will-change: opacity;
      }

      .video-overlay {
        position: absolute;
        inset: 0;
        background:
          radial-gradient(circle at 16% 18%, rgba(245, 158, 11, 0.22), transparent 28%),
          radial-gradient(circle at 82% 16%, rgba(249, 115, 22, 0.16), transparent 24%),
          radial-gradient(circle at 72% 72%, rgba(132, 204, 22, 0.12), transparent 22%),
          radial-gradient(circle at 18% 78%, rgba(59, 130, 246, 0.12), transparent 26%),
          linear-gradient(
            135deg,
            rgba(54, 33, 11, 0.42) 0%,
            rgba(116, 63, 17, 0.28) 22%,
            rgba(74, 56, 24, 0.22) 46%,
            rgba(24, 36, 62, 0.3) 70%,
            rgba(2, 8, 23, 0.58) 100%
          );
      }

      .inner {
        display: flex;
        flex-direction: column;
        gap: 2.5rem;
        min-height: 100vh;
        width: min(1240px, 100%);
        margin: 0 auto;
        padding: 1.5rem 1.25rem 1.75rem;
      }

      .topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        width: 100%;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.6rem 0.9rem;
        border-radius: 999px;
        background: rgba(248, 250, 252, 0.04);
        color: rgba(248, 250, 252, 0.6);
        font-size: 0.875rem;
        text-decoration: none;
        transition: color 0.15s, background 0.15s;
      }
      .back-link:hover {
        color: #f8fafc;
        background: rgba(248, 250, 252, 0.08);
      }

      .content-grid {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: flex-end;
        width: 100%;
        padding: 2rem 0 3rem;
      }

      .auth-stack {
        display: grid;
        grid-template-columns: minmax(0, 1fr);
        gap: 1.35rem;
        width: min(520px, 100%);
      }

      .panel {
        min-width: 0;
        border: 1px solid rgba(248, 250, 252, 0.1);
        border-radius: 24px;
        background: rgba(10, 15, 35, 0.92);
        box-shadow: 0 28px 90px rgba(0, 0, 0, 0.4);
      }

      .hero-panel {
        padding: 1.9rem 2rem;
      }

      .eyebrow {
        color: #6366f1;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
      }

      .hero-panel h1 {
        margin: 0.6rem 0 0.8rem;
        font-family: Georgia, "Times New Roman", serif;
        font-size: clamp(2.6rem, 3.6vw, 4.4rem);
        line-height: 0.94;
        max-width: 8ch;
        color: #f8fafc;
      }

      /* Hero top row: eyebrow + badge inline */
      .hero-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 0.75rem;
        flex-wrap: wrap;
      }
      .hero-top .eyebrow { margin: 0; }

      /* Hero panel typography */
      .hero-line {
        margin: 0;
        font-size: 1.1rem;
        line-height: 1.55;
      }
      .hero-dim { color: rgba(248, 250, 252, 0.45); }
      .hero-bright { color: #f8fafc; font-weight: 600; }

      .hero-divider {
        width: 2rem;
        height: 1px;
        background: rgba(99, 102, 241, 0.5);
        margin: 1.25rem 0;
      }

      .hero-sub {
        margin: 0 0 0.85rem;
        font-size: 0.88rem;
        color: rgba(248, 250, 252, 0.4);
        letter-spacing: 0.01em;
      }

      .hero-imperatives {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 0.2rem;
        border-left: 2px solid rgba(99, 102, 241, 0.35);
        padding-left: 1rem;
      }
      .hero-imperatives li {
        font-size: 0.95rem;
        color: rgba(248, 250, 252, 0.6);
        line-height: 1.5;
      }
      .hero-imperatives li strong {
        color: #f8fafc;
        font-weight: 600;
      }

      .surface-panel {
        padding: 2rem;
        overflow: hidden;
      }

      .coming-soon-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.35rem 0.85rem;
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.15);
        border: 1px solid rgba(99, 102, 241, 0.3);
        color: #a5b4fc;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        margin-bottom: 1.25rem;
      }

      .coming-soon-badge-dot {
        width: 0.45rem;
        height: 0.45rem;
        border-radius: 999px;
        background: #6366f1;
        animation: pulse 2s ease-in-out infinite;
      }

      @keyframes pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.5; transform: scale(0.8); }
      }

      .coming-soon-heading {
        font-size: 0.8rem;
        font-weight: 600;
        color: rgba(248, 250, 252, 0.4);
        letter-spacing: 0.06em;
        text-transform: uppercase;
        margin: 0 0 0.5rem;
        line-height: 1.3;
      }

      .coming-soon-body {
        margin-bottom: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .body-setup {
        margin: 0;
        font-size: 0.92rem;
        color: rgba(248, 250, 252, 0.5);
        line-height: 1.5;
      }

      .body-punch {
        margin: 0;
        font-size: 1.35rem;
        font-weight: 700;
        color: #f8fafc;
        font-family: Georgia, "Times New Roman", serif;
        line-height: 1.2;
      }

      .body-triad {
        margin: 0;
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
      }
      .body-triad span {
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: #a5b4fc;
        padding: 0.2rem 0.65rem;
        border: 1px solid rgba(99, 102, 241, 0.3);
        border-radius: 999px;
        background: rgba(99, 102, 241, 0.08);
      }

      .body-stack {
        list-style: none;
        margin: 0;
        padding: 0;
        border-left: 2px solid rgba(99, 102, 241, 0.4);
        padding-left: 1rem;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
      }
      .body-stack li {
        font-size: 1rem;
        font-weight: 600;
        color: #f8fafc;
        line-height: 1.6;
      }

      .body-thesis {
        margin: 0;
        font-size: 0.92rem;
        color: rgba(248, 250, 252, 0.55);
        line-height: 1.6;
      }
      .body-thesis strong {
        display: block;
        font-size: 1rem;
        color: #f8fafc;
        font-weight: 600;
      }

      .coming-soon-features {
        list-style: none;
        display: grid;
        gap: 0.6rem;
        margin-bottom: 1.75rem;
      }

      .coming-soon-features li {
        display: flex;
        align-items: flex-start;
        gap: 0.65rem;
        font-size: 0.9rem;
        color: rgba(248, 250, 252, 0.7);
        line-height: 1.4;
      }

      .feature-dot {
        width: 0.35rem;
        height: 0.35rem;
        border-radius: 999px;
        background: #6366f1;
        flex-shrink: 0;
        margin-top: 0.45rem;
      }

      .coming-soon-cta {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        flex-wrap: wrap;
      }

      .btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: #6366f1;
        color: #fff;
        font-size: 0.9rem;
        font-weight: 600;
        text-decoration: none;
        border: none;
        cursor: pointer;
        transition: background 0.15s, transform 0.15s;
      }
      .btn-primary:hover { background: #4f46e5; transform: translateY(-1px); }

      .btn-secondary {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        padding: 0.65rem 1.25rem;
        border-radius: 10px;
        background: transparent;
        color: rgba(248, 250, 252, 0.7);
        font-size: 0.9rem;
        font-weight: 500;
        text-decoration: none;
        border: 1px solid rgba(248, 250, 252, 0.15);
        cursor: pointer;
        transition: border-color 0.15s, color 0.15s;
      }
      .btn-secondary:hover { border-color: rgba(248, 250, 252, 0.35); color: #f8fafc; }

      .coming-soon-video-toggle {
        display: inline-flex;
        align-items: center;
        gap: 0.4rem;
        padding: 0.55rem 1rem;
        border-radius: 999px;
        background: rgba(248, 250, 252, 0.06);
        border: 1px solid rgba(248, 250, 252, 0.12);
        color: rgba(248, 250, 252, 0.55);
        font-size: 0.8rem;
        font-weight: 500;
        cursor: pointer;
        transition: background 0.15s, color 0.15s;
      }
      .coming-soon-video-toggle:hover {
        background: rgba(248, 250, 252, 0.1);
        color: rgba(248, 250, 252, 0.85);
      }

      @media (max-width: 860px) {
        body {
          padding-top: calc(1.1rem + env(safe-area-inset-top, 0px));
          padding-right: calc(0.95rem + env(safe-area-inset-right, 0px));
          padding-bottom: calc(1.25rem + env(safe-area-inset-bottom, 0px));
          padding-left: calc(0.95rem + env(safe-area-inset-left, 0px));
        }
        .inner {
          gap: 1.75rem;
          padding: 0.95rem 0.95rem 1.25rem;
        }
        .content-grid { justify-content: center; padding: 1.5rem 0 2.5rem; }
        .auth-stack { width: 100%; max-width: 520px; }
      }
    </style>
  </head>
  <body>
    <div class="video-layer" aria-hidden="true">
      <video
        id="public-video-player"
        class="bg-video"
        muted
        playsinline
        preload="none"
        src={route("/movie.mp4")}
        data-playlist={[1,2,3,4,5,6].map(n => route(n === 1 ? "/movie.mp4" : `/movie-${n}.mp4`)).join(",")}
      ></video>
      <audio id="public-audio-player" preload="metadata" src={route("/Lightningcore.mp3")} loop></audio>
      <div class="video-overlay"></div>
    </div>

    <div class="inner">
      <header class="topbar">
        <a href={route("/")} class="back-link">← Back to report</a>
        <PublicVideoToggle client:load />
      </header>

      <main class="content-grid">
        <div class="auth-stack">
          <div class="panel hero-panel">
            <div class="hero-top">
              <p class="eyebrow">Structural intelligence for software.</p>
              <div class="coming-soon-badge">
                <span class="coming-soon-badge-dot"></span>
                Storm forming
              </div>
            </div>
            <h1>The system is shifting.</h1>
            <p class="hero-line"><span class="hero-dim">Do not begin with stories.</span><br /><span class="hero-bright">Begin with the code.</span></p>
            <div class="hero-divider"></div>
            <p class="hero-sub">A workspace for teams who refuse to guess.</p>
            <ul class="hero-imperatives">
              <li>See the pressure.</li>
              <li>Cut the noise.</li>
              <li><strong>Act on what matters.</strong></li>
            </ul>
          </div>
        </div>
      </main>
    </div>

    <script is:inline>
      (() => {
        const PUBLIC_VIDEO_PAUSED_KEY = "planetnik.publicVideoPaused"
        const CLEANUP_KEY = "__planetnikComingSoonMediaCleanup__"
        const RETRY_EVENTS = ["pointerdown", "keydown", "touchstart"]

        const previousCleanup = window[CLEANUP_KEY]
        if (typeof previousCleanup === "function") {
          previousCleanup()
        }

        const isVideoPaused = () => localStorage.getItem(PUBLIC_VIDEO_PAUSED_KEY) === "true"

        const setPausedState = (paused) => {
          localStorage.setItem(PUBLIC_VIDEO_PAUSED_KEY, String(paused))
          document.dispatchEvent(new CustomEvent("planetnik:video-paused-change", { detail: { paused } }))
        }

        const video = document.getElementById("public-video-player")
        const audio = document.getElementById("public-audio-player")

        if (!(video instanceof HTMLVideoElement)) {
          window[CLEANUP_KEY] = undefined
          return
        }

        const playlist = (video.dataset.playlist ?? "")
          .split(",")
          .map((entry) => entry.trim())
          .filter(Boolean)

        let currentIndex = Math.max(0, playlist.indexOf(video.getAttribute("src") ?? ""))
        let destroyed = false
        let retryBound = false

        const pauseAll = (reset = false) => {
          video.pause()
          if (audio instanceof HTMLAudioElement) {
            audio.pause()
            if (reset) {
              audio.currentTime = 0
            }
          }
          if (reset) {
            video.currentTime = 0
          }
        }

        const clearRetryListeners = () => {
          if (!retryBound) return
          retryBound = false
          for (const eventName of RETRY_EVENTS) {
            document.removeEventListener(eventName, retryResumeOnInteraction)
          }
        }

        const ensureSource = (index) => {
          const nextSource = playlist[index]
          if (!nextSource) return false
          if (video.getAttribute("src") !== nextSource) {
            video.setAttribute("src", nextSource)
            video.load()
          }
          return true
        }

        const resumeAll = async () => {
          if (destroyed || isVideoPaused()) {
            pauseAll()
            return
          }

          if (playlist.length > 0) {
            ensureSource(currentIndex)
          }

          const videoResult = await video.play().then(() => true).catch(() => false)
          const audioResult = audio instanceof HTMLAudioElement
            ? await audio.play().then(() => true).catch(() => false)
            : true

          if (destroyed || isVideoPaused()) {
            pauseAll()
            return
          }

          if (videoResult && audioResult) {
            clearRetryListeners()
            return
          }

          pauseAll()
          bindRetryListeners()
        }

        const playIndex = (index) => {
          if (playlist.length === 0 || destroyed) return
          currentIndex = index % playlist.length
          if (!ensureSource(currentIndex)) return
          void resumeAll()
        }

        function retryResumeOnInteraction() {
          clearRetryListeners()
          if (!isVideoPaused()) {
            void resumeAll()
          }
        }

        const bindRetryListeners = () => {
          if (retryBound) return
          retryBound = true
          for (const eventName of RETRY_EVENTS) {
            document.addEventListener(eventName, retryResumeOnInteraction, { once: true })
          }
        }

        const handlePauseChange = (event) => {
          const paused = Boolean(event.detail?.paused)
          if (paused) {
            clearRetryListeners()
            pauseAll()
            return
          }
          void resumeAll()
        }

        const handleKeydown = (event) => {
          if (event.code !== "Space") return
          if (
            event.target instanceof HTMLInputElement ||
            event.target instanceof HTMLTextAreaElement ||
            event.target instanceof HTMLButtonElement
          ) {
            return
          }
          event.preventDefault()
          setPausedState(!isVideoPaused())
        }

        const cleanup = () => {
          if (destroyed) return
          destroyed = true
          clearRetryListeners()
          pauseAll(true)
          video.onended = null
          video.onloadedmetadata = null
          document.removeEventListener("planetnik:video-paused-change", handlePauseChange)
          document.removeEventListener("keydown", handleKeydown)
          document.removeEventListener("astro:before-swap", cleanup)
          window.removeEventListener("pagehide", cleanup)
          if (window[CLEANUP_KEY] === cleanup) {
            window[CLEANUP_KEY] = undefined
          }
        }

        video.onended = () => playIndex((currentIndex + 1) % Math.max(playlist.length, 1))
        video.onloadedmetadata = () => {
          if (!isVideoPaused()) {
            void resumeAll()
          }
        }

        document.addEventListener("planetnik:video-paused-change", handlePauseChange)
        document.addEventListener("keydown", handleKeydown)
        document.addEventListener("astro:before-swap", cleanup)
        window.addEventListener("pagehide", cleanup)

        window[CLEANUP_KEY] = cleanup

        if (isVideoPaused()) {
          pauseAll()
        } else if (playlist.length > 0) {
          playIndex(currentIndex)
        } else {
          void resumeAll()
        }
      })()
    </script>
  </body>
</html>
