---
import PortfolioActionQueuePage from "../../components/datasets/PortfolioActionQueuePage.astro"
import ExploreLayout from "../../layouts/ExploreLayout.astro"
import {
  defaultActionQueueArtifactDirectory,
  loadActionQueueArtifactManifest,
  parseActionQueueArtifactParams,
  readActionQueueArtifactPage,
} from "../../lib/datasets/actionQueueArtifactRoutes.js"
import { parsePortfolioActionFilters } from "../../lib/datasets/actionQueueFilters.js"

const filters = parsePortfolioActionFilters(Astro.url.searchParams)
const artifactDirectory = defaultActionQueueArtifactDirectory()
const manifestResult = loadActionQueueArtifactManifest(artifactDirectory)
const firstParams = parseActionQueueArtifactParams(filters.window, "1")!
const page =
  manifestResult.tag === "ready"
    ? readActionQueueArtifactPage(artifactDirectory, manifestResult.manifest, firstParams)
    : undefined
---

{page ? (
  <PortfolioActionQueuePage page={page} filters={filters} />
) : (
  <ExploreLayout title="Portfolio actions" description="Portfolio action artifacts are unavailable for this build.">
    <main class="action-artifacts-unavailable">
      <p class="eyebrow">Canonical JSON · static evidence</p>
      <h1>Portfolio actions.</h1>
      <p>
        {manifestResult.tag === "ready"
          ? "No materialized action queue page is available for the selected snapshot."
          : manifestResult.message}
      </p>
    </main>
  </ExploreLayout>
)}

<style>
.action-artifacts-unavailable {
  max-width: 54rem;
  margin: 0 auto;
  padding: 3rem 0;
}
.action-artifacts-unavailable h1 {
  margin: 0;
  font-family: var(--font-heading-stack);
  font-size: clamp(2.2rem, 6vw, 4.5rem);
  letter-spacing: -0.05em;
}
.action-artifacts-unavailable p:last-child {
  color: var(--color-text-secondary);
  line-height: 1.6;
}
.eyebrow {
  margin: 0 0 0.45rem;
  color: var(--color-accent-strong);
  font-size: 0.68rem;
  font-weight: 700;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}
</style>
