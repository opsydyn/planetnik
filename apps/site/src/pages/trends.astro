---
import { getEntry } from "astro:content";
import SnapshotTrendsPanel from "../components/trends/SnapshotTrendsPanel.astro";
import Dashboard from "../layouts/Dashboard.astro";
import { resolveDataDir } from "../loaders/planetnik-loader.js";
import { readSnapshotHistory } from "../lib/datasets/snapshotHistory.js";

const summary = await getEntry("analysis", "summary");
const reportContext = await getEntry("reportContext", "context");
const projectName = reportContext?.data.title ?? summary?.data.metadata.name ?? "Unknown";
const history = readSnapshotHistory(resolveDataDir());
---

<Dashboard title="Trend" projectName={projectName}>
  <div class="trend-page">
    <header class="trend-page-header">
      <p class="trend-eyebrow">Quality / longitudinal evidence</p>
      <h2>Trend</h2>
      <p>Compare the two newest canonical snapshots without losing the source identity behind each movement.</p>
    </header>
    <SnapshotTrendsPanel result={history} />
  </div>
</Dashboard>

<style>
  .trend-page { display: grid; gap: 1.25rem; }
  .trend-page-header { display: grid; gap: 0.45rem; }
  .trend-eyebrow { margin: 0; color: var(--color-accent-strong); font-size: 0.68rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; }
  .trend-page-header h2 { margin: 0; font-family: var(--font-heading-stack); font-size: clamp(1.75rem, 4vw, 2.6rem); letter-spacing: -0.04em; }
  .trend-page-header p:last-child { max-width: 48rem; margin: 0; color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.55; }
</style>
