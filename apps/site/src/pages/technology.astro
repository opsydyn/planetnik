    font-size: 0.85rem;
    color: var(--color-text-muted);
    margin-top: 0.6rem;
  }

  .comparison-card dt:first-child {
    margin-top: 0;
  }

  .benchmark {
    border: 1px solid var(--color-accent);
    border-radius: 18px;
    background: var(--color-accent-soft, rgba(99, 102, 241, 0.06));
    padding: 1.5rem 1.5rem 1.3rem;
