---
import { getCollection, getEntry } from "astro:content"
import DependencyMatrix from "../components/charts/DependencyMatrix"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const dependencies = await getCollection("dependencies")
const projectName = summary?.data.metadata.name ?? "Unknown"

const matrixData = dependencies.map((d) => ({
  from: d.data.fromComponent ?? "unknown",
  to: d.data.toComponent ?? "unknown",
  count: d.data.count ?? 0,
}))

// In-degree: how many dependencies point TO each component
const inDegree = new Map<string, number>()
const outDegree = new Map<string, number>()
for (const d of dependencies) {
  const to = d.data.toComponent ?? "unknown"
  const from = d.data.fromComponent ?? "unknown"
  inDegree.set(to, (inDegree.get(to) ?? 0) + (d.data.count ?? 0))
  outDegree.set(from, (outDegree.get(from) ?? 0) + (d.data.count ?? 0))
}
const inDegreeData = [...inDegree.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ label: name, value: count }))
const outDegreeData = [...outDegree.entries()].sort((a, b) => b[1] - a[1]).map(([name, count]) => ({ label: name, value: count }))
---

<Dashboard title="Dependencies" projectName={projectName}>
  <h2>Static Component Dependencies</h2>

  {dependencies.length === 0 ? (
    <div class="empty">
      <p>No component dependencies found.</p>
      <p class="hint">Dependencies are detected when logical components are configured and files reference each other across component boundaries.</p>
    </div>
  ) : (
    <>
    <section class="section">
      <h3>Dependency Matrix</h3>
      <DependencyMatrix client:load data={matrixData} />
    </section>
    <section class="section">
      <h3>Most Depended-On (Incoming)</h3>
      <HorizontalBarChart client:load data={inDegreeData} valueLabel="incoming refs" />
    </section>
    <section class="section">
      <h3>Most Dependent (Outgoing)</h3>
      <HorizontalBarChart client:load data={outDegreeData} valueLabel="outgoing refs" barColor="#8b5cf6" />
    </section>
    <table>
      <thead>
        <tr><th>From</th><th>To</th><th>Count</th></tr>
      </thead>
      <tbody>
        {dependencies.map((d) => (
          <tr>
            <td>{d.data.fromComponent ?? "—"}</td>
            <td>{d.data.toComponent ?? "—"}</td>
            <td>{d.data.count ?? 0}</td>
          </tr>
        ))}
      </tbody>
    </table>
    </>
  )}
</Dashboard>

<style>
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  table { width: 100%; border-collapse: collapse; background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; }
  th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  th { background: #f8fafc; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); }
  td { font-size: 0.85rem; }
</style>
