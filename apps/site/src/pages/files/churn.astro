---
import { getCollection, getEntry } from "astro:content"
import HorizontalBarChart from "../../components/charts/HorizontalBarChart"
import ScatterPlot from "../../components/charts/ScatterPlot"
import ReportDataGrid from "../../components/tables/ReportDataGrid"
import { chartHelp } from "../../lib/chartHelp"
import Dashboard from "../../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const metrics = await getCollection("metrics")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

function getMetric(id: string): number | null {
  const m = metrics.find((m) => m.data.id === id)
  return m?.data.value ?? null
}

const activeDays = getMetric("FILE_CHANGE_HISTORY_ACTIVE_DAYS")
const weeks = getMetric("FILE_CHANGE_HISTORY_WEEKS")
const estimatedWorkingDays = getMetric("FILE_CHANGE_HISTORY_ESTIMATED_WORKING_DAYS")

// Files with history data, sorted by commits
const filesWithHistory = filesMain
  .filter((f) => f.data.commitsCount && f.data.commitsCount > 0)
  .sort((a, b) => (b.data.commitsCount ?? 0) - (a.data.commitsCount ?? 0))

const scatterData = filesWithHistory.slice(0, 200).map((f) => ({
  x: f.data.commitsCount ?? 0,
  y: f.data.contributorsCount ?? 0,
  label: f.data.relativePath.split("/").pop() ?? f.data.relativePath,
}))

const mostChangedBarData = filesWithHistory.slice(0, 15).map((f) => ({
  label: f.data.relativePath.split("/").pop() ?? f.data.relativePath,
  value: f.data.commitsCount ?? 0,
}))

const volatilityData = filesWithHistory.slice(0, 200).map((f) => ({
  x: f.data.linesOfCode,
  y: f.data.commitsCount ?? 0,
  label: f.data.relativePath.split("/").pop() ?? f.data.relativePath,
}))

const churnRows = filesWithHistory.map((f) => ({
  id: f.data.relativePath,
  file: f.data.relativePath,
  commits: f.data.commitsCount ?? 0,
  contributors: f.data.contributorsCount ?? 0,
  firstChange: f.data.firstDate ?? "—",
  lastChange: f.data.latestDate ?? "—",
}))
---

<Dashboard title="File Churn" projectName={projectName}>
  <h2>File Change Frequency</h2>

  <div class="cards">
    {activeDays !== null && (
      <div class="card">
        <div class="card-value">{activeDays.toLocaleString()}</div>
        <div class="card-label">Active Days</div>
      </div>
    )}
    {weeks !== null && (
      <div class="card">
        <div class="card-value">{weeks.toLocaleString()}</div>
        <div class="card-label">Weeks Span</div>
      </div>
    )}
    {estimatedWorkingDays !== null && (
      <div class="card">
        <div class="card-value">{estimatedWorkingDays.toLocaleString()}</div>
        <div class="card-label">Est. Working Days</div>
      </div>
    )}
    {filesWithHistory.length > 0 && (
      <div class="card">
        <div class="card-value">{filesWithHistory.length.toLocaleString()}</div>
        <div class="card-label">Files With History</div>
      </div>
    )}
  </div>

  {filesWithHistory.length > 0 ? (
    <>
      <section class="section">
        <h3>Commits vs Contributors per File</h3>
        <ScatterPlot
          client:load
          data={scatterData}
          xLabel="Commits"
          yLabel="Contributors"
          thresholds={{ x: 20, y: 5 }}
          helpText={chartHelp.churn.commitsVsContributors}
        />
      </section>

      <section class="section">
        <h3>File Size vs Change Frequency</h3>
        <ScatterPlot
          client:visible
          data={volatilityData}
          xLabel="Lines of Code"
          yLabel="Commits"
          thresholds={{ x: 200, y: 20 }}
          helpText={chartHelp.churn.sizeVsFrequency}
        />
      </section>

      <section class="section">
        <h3>Most Changed Files</h3>
        <HorizontalBarChart client:visible data={mostChangedBarData} valueLabel="commits" helpText={chartHelp.churn.mostChanged} />
      </section>

      <ReportDataGrid
        client:visible
        title="Churn Table"
        description="Search and paginate every file with history while keeping the churn charts above."
        searchPlaceholder="Search file path or date"
        rows={churnRows}
        columns={[
          { field: "file", headerName: "File", type: "path", minWidth: 340, flex: 1.5 },
          { field: "commits", headerName: "Commits", type: "number", minWidth: 120, sort: "desc" },
          { field: "contributors", headerName: "Contributors", type: "number", minWidth: 140 },
          { field: "firstChange", headerName: "First Change", type: "date", minWidth: 140 },
          { field: "lastChange", headerName: "Last Change", type: "date", minWidth: 140 },
        ]}
      />
    </>
  ) : activeDays === null ? (
    <div class="empty">
      <p>No file history data available.</p>
      <p class="hint">Run <code>planetnik extractGitHistory</code> then <code>planetnik generateReports</code>.</p>
    </div>
  ) : null}
</Dashboard>

<style>
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(160px, 1fr)); gap: 1rem; margin-bottom: 2rem; }
  .card { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 1.25rem; }
  .card-value { font-size: 1.75rem; font-weight: 700; color: var(--color-accent); line-height: 1; }
  .card-label { font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.35rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: #f1f5f9; padding: 0.15em 0.4em; border-radius: 3px; }
</style>
