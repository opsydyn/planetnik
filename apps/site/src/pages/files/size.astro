---
import { getCollection, getEntry } from "astro:content"
import DistributionChart from "../../components/charts/DistributionChart"
import HorizontalBarChart from "../../components/charts/HorizontalBarChart"
import ReportDataGrid from "../../components/tables/ReportDataGrid"
import { chartHelp } from "../../lib/chartHelp"
import Dashboard from "../../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by LOC descending
const sorted = [...filesMain].sort((a, b) => b.data.linesOfCode - a.data.linesOfCode)
const totalLoc = sorted.reduce((sum, f) => sum + f.data.linesOfCode, 0)

// Size distribution buckets
const buckets = [
  { label: "1-50", min: 1, max: 50, count: 0, loc: 0 },
  { label: "51-100", min: 51, max: 100, count: 0, loc: 0 },
  { label: "101-200", min: 101, max: 200, count: 0, loc: 0 },
  { label: "201-500", min: 201, max: 500, count: 0, loc: 0 },
  { label: "501-1000", min: 501, max: 1000, count: 0, loc: 0 },
  { label: "1001+", min: 1001, max: Infinity, count: 0, loc: 0 },
]

for (const f of sorted) {
  for (const b of buckets) {
    if (f.data.linesOfCode >= b.min && f.data.linesOfCode <= b.max) {
      b.count++
      b.loc += f.data.linesOfCode
      break
    }
  }
}

const distData = buckets.map((b) => ({
  label: b.label + " LOC",
  value: b.loc,
  detail: b.count + " files",
  detailSecondary: b.loc.toLocaleString() + " LOC",
}))

const largestBarData = sorted.slice(0, 15).map((f) => ({
  label: f.data.relativePath.split("/").pop() ?? f.data.relativePath,
  value: f.data.linesOfCode,
}))

const fileSizeRows = sorted.map((f) => ({
  id: f.data.relativePath,
  file: f.data.relativePath,
  extension: `.${f.data.extension}`,
  linesOfCode: f.data.linesOfCode,
}))
---

<Dashboard title="File Size" projectName={projectName}>
  <h2>File Size</h2>
  <p class="subtitle">{sorted.length} files, {totalLoc.toLocaleString()} total lines of code</p>

  <section class="section">
    <h3>Size Distribution</h3>
    <DistributionChart client:load data={distData} helpText={chartHelp.fileSize.distribution} />
  </section>

  <section class="section">
    <h3>Largest Files</h3>
    <HorizontalBarChart client:visible data={largestBarData} valueLabel="LOC" helpText={chartHelp.fileSize.largestFiles} />
  </section>

  <section class="section">
    <ReportDataGrid
      client:visible
      title="Largest Files Table"
      description="Search, sort, and paginate the full file inventory instead of a fixed top-50 slice."
      searchPlaceholder="Search file path or extension"
      rows={fileSizeRows}
      columns={[
        { field: "file", headerName: "File", type: "path", minWidth: 320, flex: 1.4 },
        { field: "extension", headerName: "Extension", type: "code", minWidth: 120 },
        { field: "linesOfCode", headerName: "Lines of Code", type: "number", minWidth: 150, sort: "desc" },
      ]}
    />
  </section>
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .section {
    margin-bottom: 2rem;
  }

  .section h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
</style>
