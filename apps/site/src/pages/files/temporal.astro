---
import { getCollection, getEntry } from "astro:content";
import TemporalDependenciesExplorer from "../../components/TemporalDependenciesExplorer";
import Dashboard from "../../layouts/Dashboard.astro";

const summary = await getEntry("analysis", "summary");
const temporalDeps = await getCollection("temporalDeps");
const projectName = summary?.data.metadata.name ?? "Unknown";

const groupedTemporalDeps = new Map<string, typeof temporalDeps>();
for (const dependency of temporalDeps) {
	const group = groupedTemporalDeps.get(dependency.data.periodKey) ?? [];
	group.push(dependency);
	groupedTemporalDeps.set(dependency.data.periodKey, group);
}

const temporalSections = [...groupedTemporalDeps.entries()]
	.map(([periodKey, group]) => {
		const first = group[0];
		if (!first) {
			return null;
		}

		const sorted = [...group].sort(
			(left, right) => right.data.sameCommits - left.data.sameCommits,
		);
		return {
			periodKey,
			periodLabel: first.data.periodLabel,
			periodDays: first.data.periodDays,
			dependencies: sorted,
		};
	})
	.filter((section): section is NonNullable<typeof section> => section !== null)
	.sort((left, right) => left.periodDays - right.periodDays);
---

<Dashboard title="Temporal Dependencies" projectName={projectName}>
  <h2>Temporal Dependencies</h2>
  <p class="subtitle">Files that change together frequently</p>

  {temporalSections.length === 0 ? (
    <div class="empty">
      <p>No temporal dependency data available.</p>
      <p class="hint">Run <code>planetnik extractGitHistory</code> then <code>planetnik generateReports</code>.</p>
    </div>
  ) : (
    <TemporalDependenciesExplorer
      client:load
      sections={temporalSections.map((section) => ({
        periodKey: section.periodKey,
        periodLabel: section.periodLabel,
        periodDays: section.periodDays,
        dependencies: section.dependencies.map((dependency) => ({
          periodKey: dependency.data.periodKey,
          periodLabel: dependency.data.periodLabel,
          periodDays: dependency.data.periodDays,
          file1: dependency.data.file1,
          file2: dependency.data.file2,
          sameCommits: dependency.data.sameCommits,
          commitsFile1: dependency.data.commitsFile1,
          commitsFile2: dependency.data.commitsFile2,
          latestCommit: dependency.data.latestCommit,
        })),
      }))}
    />
  )}
</Dashboard>

<style>
  .subtitle { color: var(--color-text-muted); margin-bottom: 1.5rem; font-size: 0.9rem; }
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: var(--color-surface-muted, #f1f5f9); color: var(--color-text, inherit); padding: 0.15em 0.4em; border-radius: 3px; }
</style>
