---
import { getCollection, getEntry } from "astro:content";
import DistributionChart from "../components/charts/DistributionChart";
import DonutChart from "../components/charts/DonutChart";
import HorizontalBarChart from "../components/charts/HorizontalBarChart";
import ReportDataGrid from "../components/tables/ReportDataGrid";
import Dashboard from "../layouts/Dashboard.astro";
import { chartHelp } from "../lib/chartHelp";
import {
	getContributorDisplayName,
	getContributorHref,
} from "../lib/contributors";
import { route } from "../lib/route";

const reportContext = await getEntry("reportContext", "context");
if (reportContext?.data.reportMode === "landscape") {
	return Astro.redirect(route("/landscape/contributors"));
}

const summary = await getEntry("analysis", "summary");
const contributors = await getCollection("contributors");
const contributorDetails = await getCollection("contributorDetails");
const projectName = summary?.data.metadata.name ?? "Unknown";
const contributorDetailsByEmail = new Map(
	contributorDetails.map((entry) => [entry.id, entry.data]),
);

// Sort by commits descending
const sorted = [...contributors].sort(
	(a, b) => b.data.commitsAllTime - a.data.commitsAllTime,
);
const totalCommits = sorted.reduce((sum, c) => sum + c.data.commitsAllTime, 0);

const contribBarData = sorted.slice(0, 15).map((c) => ({
	label: getContributorDisplayName(c.data),
	value: c.data.commitsAllTime,
}));

const rookieCount = sorted.filter((c) => c.data.isRookie).length;
const activeCount = sorted.filter((c) => c.data.isActive).length;
const inactiveCount = sorted.length - activeCount;
const topContributorShare =
	totalCommits > 0 && sorted[0]
		? (sorted[0].data.commitsAllTime / totalCommits) * 100
		: 0;
const topThreeCommits = sorted
	.slice(0, 3)
	.reduce((sum, contributor) => sum + contributor.data.commitsAllTime, 0);
const topThreeShare =
	totalCommits > 0 ? (topThreeCommits / totalCommits) * 100 : 0;
const singleComponentSpecialists = contributorDetails.filter(
	(entry) => entry.data.logicalComponents.length === 1,
).length;
const crossComponentContributors = contributorDetails.filter(
	(entry) => entry.data.logicalComponents.length >= 3,
).length;

const knowledgeDistribution = [
	{
		label: "1 component",
		value: contributorDetails.filter(
			(entry) => entry.data.logicalComponents.length === 1,
		).length,
		detail: "deep specialists",
	},
	{
		label: "2-3 components",
		value: contributorDetails.filter((entry) => {
			const count = entry.data.logicalComponents.length;
			return count >= 2 && count <= 3;
		}).length,
		detail: "balanced contributors",
	},
	{
		label: "4-7 components",
		value: contributorDetails.filter((entry) => {
			const count = entry.data.logicalComponents.length;
			return count >= 4 && count <= 7;
		}).length,
		detail: "broad contributors",
	},
	{
		label: "8+ components",
		value: contributorDetails.filter(
			(entry) => entry.data.logicalComponents.length >= 8,
		).length,
		detail: "system-wide reach",
	},
].filter((entry) => entry.value > 0);

const segmentData = [
	...(rookieCount > 0
		? [{ label: "Rookies (active, < 1yr)", value: rookieCount }]
		: []),
	...(activeCount - rookieCount > 0
		? [{ label: "Active (> 1yr)", value: activeCount - rookieCount }]
		: []),
	...(inactiveCount > 0 ? [{ label: "Inactive", value: inactiveCount }] : []),
];

const contributorRows = sorted.map((c) => {
	const detail = contributorDetailsByEmail.get(c.id);
	const componentsTouched = detail?.logicalComponents.length ?? null;
	const filesTouched = detail?.files.length ?? null;
	const primaryComponent =
		detail?.logicalComponents
			.slice()
			.sort((a, b) => b.linesOfCode - a.linesOfCode)[0]?.name ?? "";
	const knowledgeRisk =
		componentsTouched === 1
			? "Single-component specialist"
			: componentsTouched !== null && componentsTouched >= 5
				? "Cross-context knowledge"
				: "";

	return {
		id: c.data.email,
		contributor: getContributorDisplayName(c.data),
		href: getContributorHref(c.data.email),
		email: c.data.userName ? c.data.email : "",
		status: c.data.isRookie
			? "Rookie"
			: c.data.isActive
				? "Active"
				: "Inactive",
		allTime: c.data.commitsAllTime,
		commits30Days: c.data.commits30Days ?? null,
		commits90Days: c.data.commits90Days ?? null,
		commits180Days: c.data.commits180Days ?? null,
		commits365Days: c.data.commits365Days ?? null,
		filesTouched,
		componentsTouched,
		primaryComponent,
		knowledgeRisk,
		firstCommit: c.data.firstCommit,
		lastCommit: c.data.lastCommit,
		percentage: c.data.percentage,
	};
});
---

<Dashboard title="Contributors" projectName={projectName}>
  <h2>Contributors</h2>
  <p class="subtitle">
    {sorted.length} contributors, {totalCommits.toLocaleString()} total commits
    {activeCount > 0 && <> &middot; {activeCount} active</>}
    {rookieCount > 0 && <> &middot; {rookieCount} rookies</>}
  </p>

  <div class="cards">
    <div class="card">
      <div class="card-value">{topContributorShare.toFixed(1)}%</div>
      <div class="card-label">Top Contributor Share</div>
    </div>
    <div class="card">
      <div class="card-value">{topThreeShare.toFixed(1)}%</div>
      <div class="card-label">Top 3 Share</div>
    </div>
    <div class="card">
      <div class="card-value">{singleComponentSpecialists}</div>
      <div class="card-label">Single-Component Specialists</div>
    </div>
    <div class="card">
      <div class="card-value">{crossComponentContributors}</div>
      <div class="card-label">Cross-Component Contributors</div>
    </div>
  </div>

  {segmentData.length > 1 && (
    <section class="section">
      <h3>Contributor Activity</h3>
      <DonutChart client:load data={segmentData} valueLabel="contributors" helpText={chartHelp.contributors.activitySegments} />
    </section>
  )}

  {knowledgeDistribution.length > 0 && (
    <section class="section">
      <h3>Knowledge Distribution</h3>
      <DistributionChart client:visible data={knowledgeDistribution} helpText={chartHelp.contributors.knowledgeDistribution} />
    </section>
  )}

  <section class="section">
    <h3>Top Contributors</h3>
    <HorizontalBarChart client:visible data={contribBarData} valueLabel="commits" helpText={chartHelp.contributors.topContributors} />
  </section>

  <ReportDataGrid
    client:visible
    title="Contributor Table"
    description="Search by name, email, status, or commit window while keeping the activity charts above."
    searchPlaceholder="Search contributor, email, or status"
    rows={contributorRows}
    columns={[
      { field: "contributor", headerName: "Contributor", type: "link", hrefField: "href", secondaryField: "email", minWidth: 260, flex: 1.3 },
      { field: "status", headerName: "Status", minWidth: 120 },
      { field: "allTime", headerName: "All Time", type: "number", minWidth: 120, sort: "desc" },
      { field: "filesTouched", headerName: "Files", type: "number", minWidth: 100 },
      { field: "componentsTouched", headerName: "Components", type: "number", minWidth: 120 },
      { field: "primaryComponent", headerName: "Primary Component", minWidth: 180 },
      { field: "knowledgeRisk", headerName: "Knowledge Signal", minWidth: 210 },
      { field: "commits30Days", headerName: "30d", type: "number", minWidth: 100 },
      { field: "commits90Days", headerName: "90d", type: "number", minWidth: 100 },
      { field: "commits180Days", headerName: "180d", type: "number", minWidth: 100 },
      { field: "commits365Days", headerName: "365d", type: "number", minWidth: 100 },
      { field: "firstCommit", headerName: "First Commit", type: "date", minWidth: 140 },
      { field: "lastCommit", headerName: "Last Commit", type: "date", minWidth: 140 },
      { field: "percentage", headerName: "%", minWidth: 100 },
    ]}
  />
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .section { margin-bottom: 1.5rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    padding: 1.25rem;
  }

  .card-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }

  .card-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
