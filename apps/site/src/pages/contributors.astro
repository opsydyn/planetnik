---
import { getCollection, getEntry } from "astro:content"
import DonutChart from "../components/charts/DonutChart"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import ReportDataGrid from "../components/tables/ReportDataGrid"
import Dashboard from "../layouts/Dashboard.astro"
import { getContributorDisplayName, getContributorHref } from "../lib/contributors"

const summary = await getEntry("analysis", "summary")
const contributors = await getCollection("contributors")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by commits descending
const sorted = [...contributors].sort((a, b) => b.data.commitsAllTime - a.data.commitsAllTime)
const totalCommits = sorted.reduce((sum, c) => sum + c.data.commitsAllTime, 0)

const contribBarData = sorted.slice(0, 15).map((c) => ({
  label: getContributorDisplayName(c.data),
  value: c.data.commitsAllTime,
}))

const rookieCount = sorted.filter((c) => c.data.isRookie).length
const activeCount = sorted.filter((c) => c.data.isActive).length
const inactiveCount = sorted.length - activeCount

const segmentData = [
  ...(rookieCount > 0 ? [{ label: "Rookies (active, < 1yr)", value: rookieCount }] : []),
  ...(activeCount - rookieCount > 0 ? [{ label: "Active (> 1yr)", value: activeCount - rookieCount }] : []),
  ...(inactiveCount > 0 ? [{ label: "Inactive", value: inactiveCount }] : []),
]

const contributorRows = sorted.map((c) => ({
  id: c.data.email,
  contributor: getContributorDisplayName(c.data),
  href: getContributorHref(c.data.email),
  email: c.data.userName ? c.data.email : "",
  status: c.data.isRookie ? "Rookie" : c.data.isActive ? "Active" : "Inactive",
  allTime: c.data.commitsAllTime,
  commits30Days: c.data.commits30Days ?? null,
  commits90Days: c.data.commits90Days ?? null,
  commits180Days: c.data.commits180Days ?? null,
  commits365Days: c.data.commits365Days ?? null,
  firstCommit: c.data.firstCommit,
  lastCommit: c.data.lastCommit,
  percentage: c.data.percentage,
}))
---

<Dashboard title="Contributors" projectName={projectName}>
  <h2>Contributors</h2>
  <p class="subtitle">
    {sorted.length} contributors, {totalCommits.toLocaleString()} total commits
    {activeCount > 0 && <> &middot; {activeCount} active</>}
    {rookieCount > 0 && <> &middot; {rookieCount} rookies</>}
  </p>

  {segmentData.length > 1 && (
    <section class="section">
      <h3>Contributor Activity</h3>
      <DonutChart client:load data={segmentData} valueLabel="contributors" />
    </section>
  )}

  <section class="section">
    <h3>Top Contributors</h3>
    <HorizontalBarChart client:load data={contribBarData} valueLabel="commits" />
  </section>

  <ReportDataGrid
    client:load
    title="Contributor Table"
    description="Search by name, email, status, or commit window while keeping the activity charts above."
    searchPlaceholder="Search contributor, email, or status"
    rows={contributorRows}
    columns={[
      { field: "contributor", headerName: "Contributor", type: "link", hrefField: "href", secondaryField: "email", minWidth: 260, flex: 1.3 },
      { field: "status", headerName: "Status", minWidth: 120 },
      { field: "allTime", headerName: "All Time", type: "number", minWidth: 120, sort: "desc" },
      { field: "commits30Days", headerName: "30d", type: "number", minWidth: 100 },
      { field: "commits90Days", headerName: "90d", type: "number", minWidth: 100 },
      { field: "commits180Days", headerName: "180d", type: "number", minWidth: 100 },
      { field: "commits365Days", headerName: "365d", type: "number", minWidth: 100 },
      { field: "firstCommit", headerName: "First Commit", type: "date", minWidth: 140 },
      { field: "lastCommit", headerName: "Last Commit", type: "date", minWidth: 140 },
      { field: "percentage", headerName: "%", minWidth: 100 },
    ]}
  />
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  .section { margin-bottom: 1.5rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
</style>
