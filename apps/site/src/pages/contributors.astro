---
import { getCollection, getEntry } from "astro:content"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const contributors = await getCollection("contributors")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Sort by commits descending
const sorted = [...contributors].sort((a, b) => b.data.commitsAllTime - a.data.commitsAllTime)
const totalCommits = sorted.reduce((sum, c) => sum + c.data.commitsAllTime, 0)

function displayName(c: { email: string; userName?: string }): string {
  if (c.userName) return c.userName
  const at = c.email.indexOf("@")
  return at > 0 ? c.email.slice(0, at) : c.email
}

const contribBarData = sorted.slice(0, 15).map((c) => ({
  label: displayName(c.data),
  value: c.data.commitsAllTime,
}))

const rookieCount = sorted.filter((c) => c.data.isRookie).length
const activeCount = sorted.filter((c) => c.data.isActive).length
---

<Dashboard title="Contributors" projectName={projectName}>
  <h2>Contributors</h2>
  <p class="subtitle">
    {sorted.length} contributors, {totalCommits.toLocaleString()} total commits
    {activeCount > 0 && <> &middot; {activeCount} active</>}
    {rookieCount > 0 && <> &middot; {rookieCount} rookies</>}
  </p>

  <section class="section">
    <HorizontalBarChart client:load data={contribBarData} valueLabel="commits" />
  </section>

  <table>
    <thead>
      <tr>
        <th>Contributor</th>
        <th>All Time</th>
        <th>30d</th>
        <th>90d</th>
        <th>180d</th>
        <th>365d</th>
        <th>First Commit</th>
        <th>Last Commit</th>
        <th>%</th>
      </tr>
    </thead>
    <tbody>
      {sorted.map((c) => (
        <tr class={c.data.isActive ? "" : "inactive"}>
          <td class="contributor">
            <span class="name">{displayName(c.data)}</span>
            {c.data.isRookie && <span class="badge rookie" title="First commit less than a year ago">rookie</span>}
            {c.data.userName && <div class="email-sub">{c.data.email}</div>}
          </td>
          <td>{c.data.commitsAllTime}</td>
          <td>{c.data.commits30Days || ""}</td>
          <td>{c.data.commits90Days || ""}</td>
          <td>{c.data.commits180Days || ""}</td>
          <td>{c.data.commits365Days || ""}</td>
          <td class="date">{c.data.firstCommit}</td>
          <td class="date">{c.data.lastCommit}</td>
          <td>{c.data.percentage}</td>
        </tr>
      ))}
    </tbody>
  </table>
</Dashboard>

<style>
  .subtitle {
    color: var(--color-text-muted);
    margin-bottom: 1.5rem;
    font-size: 0.9rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    overflow: hidden;
    font-size: 0.85rem;
  }

  th, td {
    padding: 0.5rem 0.75rem;
    text-align: left;
    border-bottom: 1px solid var(--color-border);
  }

  th {
    background: #f8fafc;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-text-muted);
  }

  .contributor { min-width: 160px; }
  .name { font-weight: 500; }
  .email-sub { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.7rem; color: var(--color-text-muted); margin-top: 1px; }
  .badge { display: inline-block; margin-left: 0.4rem; padding: 1px 6px; border-radius: 9999px; font-size: 0.6rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.03em; vertical-align: middle; }
  .rookie { background: #dbeafe; color: #1e40af; }
  .inactive td { opacity: 0.55; }

  .section { margin-bottom: 1.5rem; }
  .date {
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }
</style>
