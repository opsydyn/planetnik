---
import { getCollection, getEntry } from "astro:content"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import ScatterPlot from "../components/charts/ScatterPlot"
import ReportDataGrid from "../components/tables/ReportDataGrid"
import TreemapChart from "../components/charts/Treemap"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Aggregate components from files
const componentMap = new Map<string, { files: number; loc: number; contributors: Set<string> }>()
for (const f of filesMain) {
  for (const comp of f.data.components) {
    const entry = componentMap.get(comp) ?? { files: 0, loc: 0, contributors: new Set<string>() }
    entry.files++
    entry.loc += f.data.linesOfCode
    if (f.data.contributors) {
      for (const c of f.data.contributors) entry.contributors.add(c)
    }
    componentMap.set(comp, entry)
  }
}
const components = [...componentMap.entries()].sort((a, b) => b[1].loc - a[1].loc)
const unassigned = filesMain.filter((f) => f.data.components.length === 0)

const compBarData = components.slice(0, 15).map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const treemapData = components.map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const busFactorData = components
  .filter(([, s]) => s.contributors.size > 0)
  .map(([name, s]) => ({
    x: s.loc,
    y: s.contributors.size,
    label: name,
  }))

const componentRows = components.map(([name, s]) => ({
  id: name,
  component: name,
  files: s.files,
  loc: s.loc,
  contributors: s.contributors.size > 0 ? s.contributors.size : null,
  risk: s.contributors.size > 0 && s.contributors.size <= 2 ? "Bus factor risk" : "",
}))

if (unassigned.length > 0) {
  componentRows.push({
    id: "__unassigned__",
    component: "(unassigned)",
    files: unassigned.length,
    loc: unassigned.reduce((sum, file) => sum + file.data.linesOfCode, 0),
    contributors: null,
    risk: "",
  })
}
---

<Dashboard title="Components" projectName={projectName}>
  <h2>Logical Components</h2>

  {components.length === 0 ? (
    <div class="empty">
      <p>No logical decomposition configured.</p>
      <p class="hint">Add <code>logicalDecompositions</code> to your Planetnik config to group files into components.</p>
    </div>
  ) : (
    <>
      <section class="section">
        <h3>Component Size</h3>
        <TreemapChart client:load data={treemapData} valueLabel="LOC" />
      </section>
      <section class="section">
        <HorizontalBarChart client:load data={compBarData} valueLabel="LOC" />
      </section>
      {busFactorData.length > 0 && (
        <section class="section">
          <h3>Bus Factor Risk (LOC vs Contributors)</h3>
          <ScatterPlot client:load data={busFactorData} xLabel="Lines of Code" yLabel="Contributors" thresholds={{ y: 3 }} />
        </section>
      )}
      <ReportDataGrid
        client:load
        title="Component Inventory"
        description="Search and sort the full logical component inventory while keeping the structure charts above."
        searchPlaceholder="Search component or risk"
        rows={componentRows}
        columns={[
          { field: "component", headerName: "Component", minWidth: 220, flex: 1.1, sort: "asc" },
          { field: "files", headerName: "Files", type: "number", minWidth: 110 },
          { field: "loc", headerName: "LOC", type: "number", minWidth: 120, sort: "desc" },
          { field: "contributors", headerName: "Contributors", type: "number", minWidth: 140 },
          { field: "risk", headerName: "Risk", minWidth: 180 },
        ]}
      />
    </>
  )}
</Dashboard>

<style>
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: #f1f5f9; padding: 0.15em 0.4em; border-radius: 3px; }
</style>
