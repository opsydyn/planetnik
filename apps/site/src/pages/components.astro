---
import { getCollection, getEntry } from "astro:content"
import DonutChart from "../components/charts/DonutChart"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import ScatterPlot from "../components/charts/ScatterPlot"
import ReportDataGrid from "../components/tables/ReportDataGrid"
import TreemapChart from "../components/charts/Treemap"
import { chartHelp } from "../lib/chartHelp"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Aggregate components from files
const componentMap = new Map<string, { files: number; loc: number; contributors: Set<string> }>()
for (const f of filesMain) {
  for (const comp of f.data.components) {
    const entry = componentMap.get(comp) ?? { files: 0, loc: 0, contributors: new Set<string>() }
    entry.files++
    entry.loc += f.data.linesOfCode
    if (f.data.contributors) {
      for (const c of f.data.contributors) entry.contributors.add(c)
    }
    componentMap.set(comp, entry)
  }
}
const components = [...componentMap.entries()].sort((a, b) => b[1].loc - a[1].loc)
const unassigned = filesMain.filter((f) => f.data.components.length === 0)
const singleOwnerComponents = components.filter(([, s]) => s.contributors.size === 1).length
const lowBackupComponents = components.filter(([, s]) => s.contributors.size > 0 && s.contributors.size <= 2).length
const distributedComponents = components.filter(([, s]) => s.contributors.size >= 3).length
const componentCoverageData = [
  ...(singleOwnerComponents > 0 ? [{ label: "Single owner", value: singleOwnerComponents, color: "#ef4444" }] : []),
  ...(lowBackupComponents - singleOwnerComponents > 0
    ? [{ label: "Two contributors", value: lowBackupComponents - singleOwnerComponents, color: "#f59e0b" }]
    : []),
  ...(distributedComponents > 0 ? [{ label: "3+ contributors", value: distributedComponents, color: "#22c55e" }] : []),
  ...(unassigned.length > 0 ? [{ label: "Unassigned files", value: unassigned.length, color: "#94a3b8" }] : []),
]

const compBarData = components.slice(0, 15).map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const treemapData = components.map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const busFactorData = components
  .filter(([, s]) => s.contributors.size > 0)
  .map(([name, s]) => ({
    x: s.loc,
    y: s.contributors.size,
    label: name,
  }))

const componentRows = components.map(([name, s]) => ({
  id: name,
  component: name,
  files: s.files,
  loc: s.loc,
  contributors: s.contributors.size > 0 ? s.contributors.size : null,
  risk: s.contributors.size > 0 && s.contributors.size <= 2 ? "Bus factor risk" : "",
}))

if (unassigned.length > 0) {
  componentRows.push({
    id: "__unassigned__",
    component: "(unassigned)",
    files: unassigned.length,
    loc: unassigned.reduce((sum, file) => sum + file.data.linesOfCode, 0),
    contributors: null,
    risk: "",
  })
}
---

<Dashboard title="Components" projectName={projectName}>
  <h2>Logical Components</h2>

  {components.length === 0 ? (
    <div class="empty">
      <p>No logical decomposition configured.</p>
      <p class="hint">Add <code>logicalDecompositions</code> to your Planetnik config to group files into components.</p>
    </div>
  ) : (
    <>
      <div class="cards">
        <div class="card">
          <div class="card-value">{components.length}</div>
          <div class="card-label">Components</div>
        </div>
        <div class="card card-failed">
          <div class="card-value">{singleOwnerComponents}</div>
          <div class="card-label">Single-Owner Components</div>
        </div>
        <div class="card card-tolerant">
          <div class="card-value">{lowBackupComponents}</div>
          <div class="card-label">Low-Backup Components</div>
        </div>
        <div class="card card-ok">
          <div class="card-value">{distributedComponents}</div>
          <div class="card-label">3+ Contributors</div>
        </div>
      </div>

      {componentCoverageData.length > 1 && (
        <section class="section">
          <h3>Knowledge Coverage</h3>
          <DonutChart client:load data={componentCoverageData} valueLabel="components" helpText={chartHelp.components.knowledgeCoverage} />
        </section>
      )}

      <section class="section">
        <h3>Component Size</h3>
        <TreemapChart client:load data={treemapData} valueLabel="LOC" helpText={chartHelp.components.sizeTreemap} />
      </section>
      <section class="section">
        <HorizontalBarChart client:visible data={compBarData} valueLabel="LOC" helpText={chartHelp.components.sizeBars} />
      </section>
      {busFactorData.length > 0 && (
        <section class="section">
          <h3>Bus Factor Risk (LOC vs Contributors)</h3>
          <ScatterPlot
            client:visible
            data={busFactorData}
            xLabel="Lines of Code"
            yLabel="Contributors"
            thresholds={{ y: 3 }}
            helpText={chartHelp.components.busFactor}
          />
        </section>
      )}
      <ReportDataGrid
        client:visible
        title="Component Inventory"
        description="Search and sort the full logical component inventory while keeping the structure charts above."
        searchPlaceholder="Search component or risk"
        rows={componentRows}
        columns={[
          { field: "component", headerName: "Component", minWidth: 220, flex: 1.1, sort: "asc" },
          { field: "files", headerName: "Files", type: "number", minWidth: 110 },
          { field: "loc", headerName: "LOC", type: "number", minWidth: 120, sort: "desc" },
          { field: "contributors", headerName: "Contributors", type: "number", minWidth: 140 },
          { field: "risk", headerName: "Risk", minWidth: 180 },
        ]}
      />
    </>
  )}
</Dashboard>

<style>
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(170px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
  }
  .card {
    background: var(--color-card);
    border: 1px solid var(--color-border);
    border-radius: 8px;
    padding: 1.25rem;
  }
  .card-value {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--color-accent);
    line-height: 1;
  }
  .card-label {
    font-size: 0.8rem;
    color: var(--color-text-muted);
    margin-top: 0.35rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .card-failed .card-value { color: #dc2626; }
  .card-tolerant .card-value { color: #d97706; }
  .card-ok .card-value { color: #16a34a; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: #f1f5f9; padding: 0.15em 0.4em; border-radius: 3px; }
</style>
