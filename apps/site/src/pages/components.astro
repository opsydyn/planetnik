---
import { getCollection, getEntry } from "astro:content"
import HorizontalBarChart from "../components/charts/HorizontalBarChart"
import TreemapChart from "../components/charts/Treemap"
import Dashboard from "../layouts/Dashboard.astro"

const summary = await getEntry("analysis", "summary")
const filesMain = await getCollection("filesMain")
const projectName = summary?.data.metadata.name ?? "Unknown"

// Aggregate components from files
const componentMap = new Map<string, { files: number; loc: number }>()
for (const f of filesMain) {
  for (const comp of f.data.components) {
    const entry = componentMap.get(comp) ?? { files: 0, loc: 0 }
    entry.files++
    entry.loc += f.data.linesOfCode
    componentMap.set(comp, entry)
  }
}
const components = [...componentMap.entries()].sort((a, b) => b[1].loc - a[1].loc)
const unassigned = filesMain.filter((f) => f.data.components.length === 0)

const compBarData = components.slice(0, 15).map(([name, s]) => ({
  label: name,
  value: s.loc,
}))

const treemapData = components.map(([name, s]) => ({
  label: name,
  value: s.loc,
}))
---

<Dashboard title="Components" projectName={projectName}>
  <h2>Logical Components</h2>

  {components.length === 0 ? (
    <div class="empty">
      <p>No logical decomposition configured.</p>
      <p class="hint">Add <code>logicalDecompositions</code> to your Planetnik config to group files into components.</p>
    </div>
  ) : (
    <>
      <section class="section">
        <h3>Component Size</h3>
        <TreemapChart client:load data={treemapData} valueLabel="LOC" />
      </section>
      <section class="section">
        <HorizontalBarChart client:load data={compBarData} valueLabel="LOC" />
      </section>
      <table>
        <thead>
          <tr><th>Component</th><th>Files</th><th>LOC</th></tr>
        </thead>
        <tbody>
          {components.map(([name, s]) => (
            <tr>
              <td class="comp-name">{name}</td>
              <td>{s.files.toLocaleString()}</td>
              <td>{s.loc.toLocaleString()}</td>
            </tr>
          ))}
          {unassigned.length > 0 && (
            <tr class="muted">
              <td>(unassigned)</td>
              <td>{unassigned.length.toLocaleString()}</td>
              <td>{unassigned.reduce((s, f) => s + f.data.linesOfCode, 0).toLocaleString()}</td>
            </tr>
          )}
        </tbody>
      </table>
    </>
  )}
</Dashboard>

<style>
  .empty { background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; padding: 2rem; text-align: center; }
  .empty p { color: var(--color-text-muted); margin-bottom: 0.5rem; }
  .hint { font-size: 0.85rem; }
  .section { margin-bottom: 2rem; }
  .section h3 { font-size: 1.1rem; font-weight: 600; margin-bottom: 0.75rem; }
  table { width: 100%; border-collapse: collapse; background: var(--color-card); border: 1px solid var(--color-border); border-radius: 8px; overflow: hidden; }
  th, td { padding: 0.5rem 0.75rem; text-align: left; border-bottom: 1px solid var(--color-border); }
  th { background: #f8fafc; font-size: 0.7rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.04em; color: var(--color-text-muted); }
  td { font-size: 0.85rem; }
  .comp-name { font-weight: 500; }
  .muted td { color: var(--color-text-muted); font-style: italic; }
  code { font-family: "SF Mono", "Fira Code", monospace; font-size: 0.85em; background: #f1f5f9; padding: 0.15em 0.4em; border-radius: 3px; }
</style>
