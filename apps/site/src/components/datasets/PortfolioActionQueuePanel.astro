}
.action-evidence summary span {
  margin-left: 0.5rem;
  color: var(--color-text-muted);
  font-weight: 400;
  font-size: 0.65rem;
}
.source-facts {
  display: flex;
  flex-wrap: wrap;
  gap: 0.5rem 1.25rem;
  margin: 0.6rem 0;
}
.source-facts div {
  max-width: 100%;
  overflow-wrap: anywhere;
}
.source-facts dt {
  color: var(--color-text-muted);
  font-size: 0.65rem;
}
.source-facts dd {
  margin: 0;
  font-size: 0.71rem;
}
.evidence-links {
  display: grid;
  gap: 0.65rem;
  list-style: none;
  padding: 0;
}
.evidence-links li {
  display: grid;
  gap: 0.25rem;
  border-top: 1px solid var(--color-border);
  padding-top: 0.65rem;
  overflow-wrap: anywhere;
}
.evidence-links li > span,
.evidence-links li > code {
  color: var(--color-text-muted);
  font-size: 0.64rem;
  line-height: 1.5;
}
.action-empty,
.action-note {
  padding: 1rem;
  border: 1px dashed var(--color-border);
  font-size: 0.8rem;
  line-height: 1.6;
  color: var(--color-text-secondary);
}
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}
:is(a, button, input, select, summary):focus-visible {
  outline: 2px solid var(--color-accent-strong);
  outline-offset: 3px;
}
@media (max-width: 850px) {
  .filter-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .window-filter {
    grid-column: 1 / -1;
  }
}
@media (max-width: 600px) {
  .action-item-header,
  .queue-header {
    flex-direction: column;
    align-items: start;
  }
  .action-factors {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .action-item {
    padding: 0.85rem;
  }
  .filter-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}
</style>
