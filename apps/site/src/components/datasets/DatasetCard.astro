---
import type { DatasetDescriptor } from "@planetnik/common";
import {
	formatExploreMetric,
	getDatasetInitials,
	getDatasetModeLabel,
	getDatasetRecommendedView,
	getDatasetSearchText,
	getDatasetStatusLabel,
	type ExploreAudience,
} from "../../lib/datasets/explore";

interface Props {
	dataset: DatasetDescriptor;
	href: string;
	previewHref: string;
	audience: ExploreAudience;
	overviewHref?: string | null;
	codeCityHref?: string | null;
}

const { dataset, href, previewHref, audience, overviewHref = null, codeCityHref = null } = Astro.props;
const initials = getDatasetInitials(dataset.title, dataset.id);
const modeLabel = getDatasetModeLabel(dataset.mode);
const statusLabel = getDatasetStatusLabel(dataset.availability);
const recommendedView = getDatasetRecommendedView(dataset, audience);
const snapshotDate = dataset.snapshot?.generatedAt.slice(0, 10);
const sourceHost = dataset.provenance.sourceUrl
	? (() => {
			try {
				return new URL(dataset.provenance.sourceUrl).hostname.replace(/^www\./u, "");
			} catch {
				return dataset.provenance.sourceUrl;
			}
		})()
	: undefined;

const statEntries = [
	{ key: "repositories", label: "Repos", value: dataset.stats.repositories },
	{ key: "loc", label: "LOC", value: dataset.stats.loc },
	{ key: "files", label: "Files", value: dataset.stats.files },
	{ key: "contributors", label: "Contributors", value: dataset.stats.contributors },
	{ key: "commits", label: "Commits", value: dataset.stats.commits },
].filter((entry) => entry.value !== undefined);

const languageSummary = dataset.languages.slice(0, 4);
const searchText = getDatasetSearchText(dataset);
const dataLanguages = dataset.languages.map((language) => `${language.key} ${language.label}`).join(" ");
const dataTags = dataset.tags.join(" ");
const availabilityClass = `is-${dataset.availability}`;
---

<article
	class={`dataset-card ${availabilityClass}`}
	data-dataset-card
	data-dataset-id={dataset.id}
	data-search={searchText}
	data-mode={dataset.mode}
	data-availability={dataset.availability}
	data-languages={dataLanguages}
	data-tags={dataTags}
	data-capabilities={dataset.capabilities.join(" ")}
	data-loc={dataset.stats.loc ?? ""}
	data-contributors={dataset.stats.contributors ?? ""}
	data-generated-at={dataset.snapshot?.generatedAt ?? ""}
	data-featured={dataset.curation.featured ? "true" : "false"}
	data-order={dataset.curation.order}
	data-overview-href={overviewHref ?? ""}
	data-code-city-href={codeCityHref ?? ""}
>
	<header class="dataset-card-header">
		<div class="dataset-mark" aria-hidden="true">{initials}</div>
		<div class="dataset-card-identity">
			<div class="dataset-card-kicker">
				<span>{modeLabel}</span>
				<span class={`dataset-status ${availabilityClass}`}>
					<span class="status-dot" aria-hidden="true"></span>
					{statusLabel}
				</span>
			</div>
			<h3><a href={previewHref}>{dataset.title}</a></h3>
		</div>
	</header>

	<p class="dataset-card-description">{dataset.description}</p>

	{statEntries.length > 0 ? (
		<dl class="dataset-stat-grid">
			{statEntries.map((entry) => (
				<div class="dataset-stat">
					<dt>{entry.label}</dt>
					<dd>{formatExploreMetric(entry.value)}</dd>
				</div>
			))}
		</dl>
	) : (
		<p class="dataset-no-stats">Metrics will appear after this snapshot is generated.</p>
	)}

	{languageSummary.length > 0 ? (
		<ul class="dataset-language-list" aria-label="Languages in this snapshot">
			{languageSummary.map((language) => (
				<li>
					<span class="language-swatch" aria-hidden="true"></span>
					<span>{language.label}</span>
					<span class="language-share">{language.share.toFixed(1)}%</span>
				</li>
			))}
		</ul>
	) : null}

	<footer class="dataset-card-footer">
		<span>
			{snapshotDate ? `Verified ${snapshotDate}` : "Snapshot not generated"}
		</span>
		{sourceHost ? <span class="dataset-source">{sourceHost}</span> : null}
		{dataset.provenance.license ? <span>{dataset.provenance.license}</span> : null}
	</footer>

	<div class="dataset-card-actions">
		{dataset.availability === "planned" ? (
			<span class="dataset-action dataset-action-disabled" aria-disabled="true">
				Planned
			</span>
		) : (
			<a
				class="dataset-action dataset-action-primary"
				href={href}
				data-primary-action
				data-astro-reload={recommendedView === "code-city" ? true : undefined}
			>
				{recommendedView === "code-city" ? "Open Code City" : "Open snapshot"}
				<span aria-hidden="true">→</span>
			</a>
		)}
		<a class="dataset-action dataset-action-secondary" href={previewHref} data-preview-trigger={dataset.id}>
			Preview
		</a>
		{dataset.provenance.sourceUrl ? (
			<a
				class="dataset-source-link"
				href={dataset.provenance.sourceUrl}
				target="_blank"
				rel="noopener noreferrer"
			>
				Source
			</a>
		) : null}
	</div>
</article>

<style>
	.dataset-card {
		display: grid;
		gap: 1rem;
		min-width: 0;
		padding: 1.25rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		background:
			radial-gradient(circle at 100% 0, var(--color-accent-soft), transparent 32%),
			var(--color-card);
		box-shadow: 0 12px 28px color-mix(in srgb, var(--color-text) 5%, transparent);
		transition: border-color 150ms ease, box-shadow 150ms ease, transform 150ms ease;
	}

	.dataset-card:hover {
		border-color: var(--color-border-strong);
		box-shadow: 0 18px 36px color-mix(in srgb, var(--color-text) 9%, transparent);
		transform: translateY(-2px);
	}

	.dataset-card.is-planned {
		background: var(--color-surface-subtle);
		box-shadow: none;
	}

	.dataset-card-header {
		display: flex;
		align-items: flex-start;
		gap: 0.8rem;
		min-width: 0;
	}

	.dataset-mark {
		display: grid;
		place-items: center;
		flex: 0 0 2.75rem;
		height: 2.75rem;
		border: 1px solid var(--color-border-strong);
		border-radius: 0.7rem;
		background: linear-gradient(145deg, var(--color-accent), var(--color-warm));
		color: #fff;
		font-family: var(--font-heading-stack);
		font-size: 0.85rem;
		font-weight: 700;
		letter-spacing: 0.04em;
	}

	.dataset-card-identity {
		min-width: 0;
	}

	.dataset-card-kicker {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.5rem;
		color: var(--color-text-muted);
		font-size: 0.68rem;
		font-weight: 700;
		letter-spacing: 0.09em;
		line-height: 1.2;
		text-transform: uppercase;
	}

	.dataset-status {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		letter-spacing: 0.04em;
	}

	.status-dot {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--color-text-muted);
	}

	.dataset-status.is-ready .status-dot {
		background: var(--color-green);
	}

	.dataset-status.is-partial .status-dot {
		background: var(--color-yellow);
	}

	.dataset-status.is-planned .status-dot {
		background: var(--color-accent);
	}

	.dataset-card h3 {
		margin: 0.35rem 0 0;
		font-family: var(--font-heading-stack);
		font-size: 1.08rem;
		line-height: 1.15;
		text-wrap: balance;
	}

	.dataset-card h3 a {
		color: var(--color-text);
		text-decoration: none;
	}

	.dataset-card h3 a:hover {
		color: var(--color-accent-strong);
	}

	.dataset-card-description {
		margin: 0;
		min-height: 2.8em;
		color: var(--color-text-secondary);
		font-size: 0.86rem;
		line-height: 1.55;
	}

	.dataset-stat-grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.55rem;
		margin: 0;
	}

	.dataset-stat {
		display: grid;
		gap: 0.15rem;
		padding: 0.58rem 0.65rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-inline);
		background: color-mix(in srgb, var(--color-surface-subtle) 72%, transparent);
	}

	.dataset-stat dt {
		color: var(--color-text-muted);
		font-size: 0.64rem;
		font-weight: 700;
		letter-spacing: 0.07em;
		text-transform: uppercase;
	}

	.dataset-stat dd {
		margin: 0;
		color: var(--color-text);
		font-family: var(--font-heading-stack);
		font-size: 1rem;
		font-weight: 700;
	}

	.dataset-no-stats {
		margin: 0;
		padding: 0.7rem;
		border: 1px dashed var(--color-border);
		color: var(--color-text-muted);
		font-size: 0.78rem;
		line-height: 1.45;
	}

	.dataset-language-list {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.dataset-language-list li {
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		padding: 0.28rem 0.48rem;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-pill);
		color: var(--color-text-secondary);
		font-size: 0.71rem;
	}

	.language-swatch {
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 50%;
		background: var(--color-accent);
	}

	.dataset-language-list li:nth-child(2) .language-swatch {
		background: var(--color-warm);
	}

	.dataset-language-list li:nth-child(3) .language-swatch {
		background: var(--chart-palette-3);
	}

	.dataset-language-list li:nth-child(4) .language-swatch {
		background: var(--chart-palette-4);
	}

	.language-share {
		color: var(--color-text-muted);
		font-variant-numeric: tabular-nums;
	}

	.dataset-card-footer {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem 0.75rem;
		color: var(--color-text-muted);
		font-size: 0.71rem;
	}

	.dataset-source {
		max-width: 14rem;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.dataset-card-actions {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 0.55rem;
		padding-top: 0.15rem;
		border-top: 1px solid var(--color-border);
	}

	.dataset-action,
	.dataset-source-link {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		min-height: 2rem;
		padding: 0.42rem 0.7rem;
		border-radius: var(--radius-inline);
		font-size: 0.74rem;
		font-weight: 700;
		text-decoration: none;
		transition: background 140ms ease, color 140ms ease, border-color 140ms ease;
	}

	.dataset-action-primary {
		border: 1px solid var(--color-accent);
		background: var(--color-accent);
		color: #fff;
	}

	.dataset-action-primary:hover {
		border-color: var(--color-accent-strong);
		background: var(--color-accent-strong);
	}

	.dataset-action-secondary {
		border: 1px solid var(--color-border-strong);
		color: var(--color-text);
	}

	.dataset-action-secondary:hover {
		border-color: var(--color-accent);
		background: var(--color-accent-soft);
		color: var(--color-accent-strong);
	}

	.dataset-action-disabled {
		border: 1px dashed var(--color-border-strong);
		color: var(--color-text-muted);
		cursor: not-allowed;
	}

	.dataset-source-link {
		margin-left: auto;
		color: var(--color-text-muted);
	}

	.dataset-source-link:hover {
		color: var(--color-accent-strong);
		text-decoration: underline;
	}

	.dataset-action:focus-visible,
	.dataset-source-link:focus-visible,
	.dataset-card h3 a:focus-visible {
		outline: 2px solid var(--color-accent);
		outline-offset: 3px;
	}

	@media (min-width: 560px) {
		.dataset-stat-grid {
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dataset-card {
			transition: none;
		}

		.dataset-card:hover {
			transform: none;
		}
	}
</style>
