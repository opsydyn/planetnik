---
import SharedBreadcrumb from "@planetnik/report-ui/shell/Breadcrumb";
import type { BreadcrumbItem } from "@planetnik/report-ui/shell/Breadcrumb";
import { route } from "../lib/route";

interface Props {
	title: string;
	reportMode: string;
	repoScope?: {
		repoKey: string;
		repoName: string;
	};
}

const { title, reportMode, repoScope } = Astro.props;
const isLandscape = reportMode === "landscape";

const crumbs: BreadcrumbItem[] = [];

if (isLandscape) {
	crumbs.push({ label: "Landscape", href: route("/landscape") });

	if (repoScope) {
		crumbs.push({
			label: "Repositories",
			href: route("/landscape/repositories"),
		});
		crumbs.push({
			label: repoScope.repoName,
			href: route(
				`/landscape/repositories/${encodeURIComponent(repoScope.repoKey)}`,
			),
		});
	}
} else {
	crumbs.push({ label: "Dashboard", href: route("/") });
}

crumbs.push({ label: title });
---

<SharedBreadcrumb items={crumbs} />
