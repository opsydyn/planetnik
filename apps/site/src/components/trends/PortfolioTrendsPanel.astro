---
import type { CrossRepositoryMetricRollup, CrossRepositoryTrends } from "@planetnik/common"
import { route } from "../../lib/route"

interface Props {
  trends: CrossRepositoryTrends
}

const { trends } = Astro.props as Props

function formatValue(value: number | null): string {
  return value === null ? "—" : value.toLocaleString("en-GB")
}

function formatDelta(value: number | null): string {
  if (value === null) return "—"
  return `${value > 0 ? "+" : ""}${value.toLocaleString("en-GB")}`
}

function deltaClass(value: number | null): string {
  if (value === null || value === 0) return ""
  return value > 0 ? "portfolio-value--increase" : "portfolio-value--decrease"
}

function coverageLabel(metric: CrossRepositoryMetricRollup, total: number): string {
  return `${metric.currentCoverage}/${total} repositories`
}

function historyLabel(status: CrossRepositoryTrends["datasets"][number]["history"]["status"]): string {
  if (status === "compatible") return "Comparable history"
  if (status === "incompatible") return "History rejected"
  if (status === "invalid") return "History invalid"
  return "No comparison pair"
}

function statusLabel(status: CrossRepositoryTrends["datasets"][number]["status"]): string {
  if (status === "included") return "Included"
  if (status === "planned") return "Planned"
  if (status === "excluded") return "Excluded"
  return "Unavailable"
}

function metricDescription(metric: CrossRepositoryMetricRollup): string {
  if (metric.unit === "lines") return "source lines"
  if (metric.unit === "people") return "people"
  if (metric.unit === "links") return "internal links"
  return metric.unit
}

const completeMetricCount = trends.metrics.filter(
  (metric) => metric.currentCoverage === trends.coverage.includedRepositories,
).length
---

{trends.status === "ready" ? (
  <section class="portfolio-trends-panel" data-portfolio-trends-status="ready" aria-labelledby="portfolio-trends-panel-title">
    <header class="portfolio-trends-panel-header">
      <div>
        <p class="trends-eyebrow">Canonical portfolio roll-up</p>
        <h2 id="portfolio-trends-panel-title">A shared view across the showcase.</h2>
        <p>{trends.message} Values are summed only for metrics with a stable cross-repository meaning; each row retains its snapshot and <code>metrics.json</code> provenance.</p>
      </div>
      <span class="portfolio-trends-count">{trends.coverage.includedRepositories} repositories · {trends.coverage.compatibleHistories} comparable histories</span>
    </header>

    <div class="portfolio-summary-grid" aria-label="Portfolio trend summary">
      <article class="portfolio-summary-card portfolio-summary-card--accent">
        <span>Included repositories</span>
        <strong>{trends.coverage.includedRepositories.toLocaleString("en-GB")}</strong>
        <small>of {trends.coverage.repositoryEntries.toLocaleString("en-GB")} repository entries</small>
      </article>
      <article class="portfolio-summary-card">
        <span>Metric coverage</span>
        <strong>{completeMetricCount}/{trends.metrics.length}</strong>
        <small>metrics present in every included snapshot</small>
      </article>
      <article class="portfolio-summary-card">
        <span>Comparable histories</span>
        <strong>{trends.coverage.compatibleHistories.toLocaleString("en-GB")}</strong>
        <small>latest per-repository pairs</small>
      </article>
      <article class="portfolio-summary-card">
        <span>Material movement</span>
        <strong>{trends.movement.totalChanged.toLocaleString("en-GB")}</strong>
        <small>{trends.movement.metricChanged.toLocaleString("en-GB")} metrics · {trends.movement.entityChanged.toLocaleString("en-GB")} entities</small>
      </article>
    </div>

    <section class="portfolio-footprint" aria-labelledby="portfolio-footprint-title">
      <header class="portfolio-section-heading">
        <div>
          <p class="trends-eyebrow">Comparable metric contract</p>
          <h3 id="portfolio-footprint-title">Current footprint and movement</h3>
        </div>
        <p>Baseline and change columns use only repositories with a compatible two-snapshot history. A dash means evidence is absent, not zero.</p>
      </header>
      <div class="portfolio-table-wrap">
        <table class="portfolio-metric-table">
          <thead>
            <tr>
              <th scope="col">Metric</th>
              <th scope="col">Latest total</th>
              <th scope="col">Baseline total</th>
              <th scope="col">Change</th>
              <th scope="col">Coverage</th>
            </tr>
          </thead>
          <tbody>
            {trends.metrics.map((metric) => (
              <tr>
                <th scope="row">
                  <span>{metric.label}</span>
                  <small>{metricDescription(metric)}</small>
                </th>
                <td>{formatValue(metric.current)}</td>
                <td>{formatValue(metric.baseline)}</td>
                <td class={deltaClass(metric.delta)}>{formatDelta(metric.delta)}</td>
                <td>
                  <span class="portfolio-coverage-value">{coverageLabel(metric, trends.coverage.includedRepositories)}</span>
                  <small>{metric.deltaCoverage > 0 ? `${metric.deltaCoverage} comparable` : "No comparable delta"}</small>
                  {metric.provenance.current.length > 0 || metric.provenance.baseline.length > 0 ? (
                    <details class="portfolio-metric-evidence">
                      <summary>Evidence</summary>
                      <ul>
                        {metric.provenance.current.map((provenance, index) => (
                          <li>
                            <span>Current · </span>
                            {metric.currentRepositories[index] ? (
                              <a href={route(`/datasets/${metric.currentRepositories[index]}`)}>{metric.currentRepositories[index]}</a>
                            ) : null}
                            <code>{provenance.snapshotId} · {provenance.record}</code>
                          </li>
                        ))}
                        {metric.provenance.baseline.map((provenance, index) => (
                          <li>
                            <span>Baseline · </span>
                            {metric.baselineRepositories[index] ? (
                              <a href={route(`/datasets/${metric.baselineRepositories[index]}`)}>{metric.baselineRepositories[index]}</a>
                            ) : null}
                            <code>{provenance.snapshotId} · {provenance.record}</code>
                          </li>
                        ))}
                      </ul>
                    </details>
                  ) : null}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="portfolio-provenance-note">The roll-up is intentionally conservative: extension-specific metrics, repo-specific decompositions, and absent shards are not normalised into portfolio totals.</p>
    </section>

    <section class="portfolio-evidence" aria-labelledby="portfolio-evidence-title">
      <header class="portfolio-section-heading">
        <div>
          <p class="trends-eyebrow">Evidence coverage</p>
          <h3 id="portfolio-evidence-title">Every repository keeps its own trail.</h3>
        </div>
        <p>Open a repository detail page for the snapshot or its Trends route when a comparable pair is available.</p>
      </header>
      <div class="portfolio-repository-list">
        {trends.datasets.map((dataset) => (
          <article class={`portfolio-repository-card portfolio-repository-card--${dataset.status}`}>
            <div class="portfolio-repository-card-heading">
              <div>
                <a href={route(`/datasets/${dataset.id}`)}>{dataset.title}</a>
                <span><code>{dataset.id}</code></span>
              </div>
              <span class={`portfolio-status portfolio-status--${dataset.status}`}>{statusLabel(dataset.status)}</span>
            </div>
            {dataset.status === "included" ? (
              <div class="portfolio-repository-meta">
                <span>{dataset.snapshot ? `Snapshot ${dataset.snapshot.snapshotId}` : "Snapshot unavailable"}</span>
                <span>{historyLabel(dataset.history.status)}</span>
                {dataset.movement ? <span>{dataset.movement.totalChanged.toLocaleString("en-GB")} changed</span> : null}
              </div>
            ) : (
              <p>{dataset.reason}</p>
            )}
            {dataset.status === "included" && dataset.history.status === "compatible" ? (
              <a class="portfolio-repository-link" href={route(`/datasets/${dataset.id}/trends`)}>Open Trends <span aria-hidden="true">→</span></a>
            ) : null}
          </article>
        ))}
      </div>
    </section>
  </section>
) : (
  <section class="portfolio-trends-panel portfolio-trends-panel--empty" data-portfolio-trends-status="empty" aria-labelledby="portfolio-trends-empty-title">
    <p class="trends-eyebrow">Canonical portfolio roll-up</p>
    <h2 id="portfolio-trends-empty-title">No repository snapshots to compare yet.</h2>
    <p>{trends.message}</p>
    <div class="portfolio-empty-coverage">
      <span>{trends.coverage.plannedEntries} planned</span>
      <span>{trends.coverage.unavailableEntries} unavailable</span>
      <span>{trends.coverage.excludedEntries} excluded</span>
    </div>
  </section>
)}

<style>
  .portfolio-trends-panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .portfolio-trends-panel-header,
  .portfolio-section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .portfolio-trends-panel-header {
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .trends-eyebrow {
    margin: 0 0 0.4rem;
    color: var(--color-accent-strong);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .portfolio-trends-panel h2,
  .portfolio-section-heading h3 {
    margin: 0;
    font-family: var(--font-heading-stack);
    line-height: 1.05;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .portfolio-trends-panel h2 {
    font-size: clamp(1.65rem, 4vw, 2.7rem);
  }

  .portfolio-section-heading h3 {
    font-size: 1.3rem;
  }

  .portfolio-trends-panel-header p:not(.trends-eyebrow),
  .portfolio-section-heading > p,
  .portfolio-repository-card p,
  .portfolio-trends-panel--empty > p:not(.trends-eyebrow) {
    max-width: 52rem;
    margin: 0.7rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.83rem;
    line-height: 1.6;
  }

  .portfolio-trends-count {
    flex: 0 0 auto;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-border-strong);
    color: var(--color-text-secondary);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .portfolio-summary-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .portfolio-summary-card {
    display: grid;
    gap: 0.28rem;
    min-height: 6.8rem;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 55%, var(--color-card));
  }

  .portfolio-summary-card--accent {
    border-color: var(--color-accent);
    background: var(--color-accent-soft);
  }

  .portfolio-summary-card span,
  .portfolio-summary-card small,
  .portfolio-metric-table small,
  .portfolio-repository-card span,
  .portfolio-repository-card p,
  .portfolio-empty-coverage {
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .portfolio-summary-card strong {
    color: var(--color-text);
    font-family: var(--font-heading-stack);
    font-size: 1.65rem;
    line-height: 1;
  }

  .portfolio-footprint,
  .portfolio-evidence {
    display: grid;
    gap: 0.85rem;
    padding-top: 1rem;
    border-top: 1px solid var(--color-border);
  }

  .portfolio-section-heading {
    align-items: start;
  }

  .portfolio-section-heading > p {
    max-width: 30rem;
    margin: 0;
    text-align: right;
  }

  .portfolio-table-wrap {
    overflow-x: auto;
    border: 1px solid var(--color-border);
  }

  .portfolio-metric-table {
    width: 100%;
    min-width: 46rem;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .portfolio-metric-table th,
  .portfolio-metric-table td {
    padding: 0.7rem 0.75rem;
    border-bottom: 1px solid var(--color-border);
    text-align: right;
    vertical-align: middle;
  }

  .portfolio-metric-table thead th {
    color: var(--color-text-muted);
    font-size: 0.63rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .portfolio-metric-table tbody tr:last-child th,
  .portfolio-metric-table tbody tr:last-child td {
    border-bottom: 0;
  }

  .portfolio-metric-table tbody th {
    display: grid;
    gap: 0.18rem;
    color: var(--color-text);
    text-align: left;
  }

  .portfolio-metric-table td {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .portfolio-metric-table td:last-child {
    display: grid;
    gap: 0.18rem;
    justify-items: end;
    white-space: normal;
  }

  .portfolio-coverage-value {
    color: var(--color-text-secondary);
  }

  .portfolio-value--increase {
    color: var(--color-warm) !important;
    font-weight: 700;
  }

  .portfolio-value--decrease {
    color: var(--color-accent-strong) !important;
    font-weight: 700;
  }

  .portfolio-provenance-note {
    margin: 0;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    line-height: 1.5;
  }

  .portfolio-repository-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .portfolio-repository-card {
    display: grid;
    gap: 0.55rem;
    min-width: 0;
    padding: 0.8rem;
    border: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 55%, var(--color-card));
  }

  .portfolio-repository-card--included {
    border-left: 3px solid var(--color-accent);
  }

  .portfolio-repository-card--planned {
    border-left: 3px solid var(--color-warm);
  }

  .portfolio-repository-card-heading {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 0.65rem;
  }

  .portfolio-repository-card-heading > div {
    display: grid;
    gap: 0.18rem;
    min-width: 0;
  }

  .portfolio-repository-card-heading a {
    overflow: hidden;
    color: var(--color-text);
    font-family: var(--font-heading-stack);
    font-size: 0.95rem;
    font-weight: 700;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portfolio-repository-card-heading a:hover,
  .portfolio-repository-link:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .portfolio-repository-card-heading code {
    color: var(--color-text-muted);
    font-size: 0.62rem;
  }

  .portfolio-status {
    flex: 0 0 auto;
    padding: 0.24rem 0.35rem;
    border: 1px solid var(--color-border-strong);
    font-size: 0.59rem !important;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .portfolio-status--included {
    border-color: var(--color-accent);
    color: var(--color-accent-strong) !important;
  }

  .portfolio-status--planned {
    border-color: var(--color-warm);
    color: var(--color-warm) !important;
  }

  .portfolio-metric-evidence {
    max-width: 21rem;
    text-align: left;
  }

  .portfolio-metric-evidence summary {
    cursor: pointer;
    color: var(--color-accent-strong);
    font-size: 0.64rem;
    font-weight: 700;
  }

  .portfolio-metric-evidence ul {
    display: grid;
    gap: 0.25rem;
    max-height: 9rem;
    margin: 0.4rem 0 0;
    padding-left: 1rem;
    overflow: auto;
  }

  .portfolio-metric-evidence li {
    color: var(--color-text-muted);
    font-size: 0.6rem;
    line-height: 1.35;
  }

  .portfolio-metric-evidence a {
    color: var(--color-accent-strong);
    font-weight: 700;
    text-decoration: none;
  }

  .portfolio-metric-evidence a:hover {
    text-decoration: underline;
  }

  .portfolio-metric-evidence code {
    display: block;
    overflow-wrap: anywhere;
  }

  .portfolio-repository-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.75rem;
    color: var(--color-text-muted);
    font-size: 0.67rem;
  }

  .portfolio-repository-meta span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .portfolio-repository-link {
    justify-self: start;
    color: var(--color-accent-strong);
    font-size: 0.7rem;
    font-weight: 700;
    text-decoration: none;
  }

  .portfolio-trends-panel--empty {
    min-height: 16rem;
    align-content: center;
    justify-items: start;
  }

  .portfolio-trends-panel--empty h2 {
    max-width: 30rem;
  }

  .portfolio-empty-coverage {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-top: 0.4rem;
  }

  .portfolio-empty-coverage span {
    padding: 0.4rem 0.5rem;
    border: 1px solid var(--color-border-strong);
  }

  @media (max-width: 900px) {
    .portfolio-summary-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .portfolio-trends-panel-header,
    .portfolio-section-heading {
      display: grid;
      gap: 0.75rem;
    }

    .portfolio-trends-count {
      justify-self: start;
    }

    .portfolio-section-heading > p {
      max-width: none;
      text-align: left;
    }

    .portfolio-repository-list {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 480px) {
    .portfolio-summary-grid {
      grid-template-columns: 1fr;
    }

    .portfolio-trends-panel {
      padding: 0.9rem;
    }
  }
</style>
