---
import type { SnapshotHistoryReadResult } from "../../lib/datasets/snapshotHistory.js"
import {
  buildSnapshotTrendViewModel,
  type SnapshotTrendEntityRow,
  type SnapshotTrendProjectSide,
  type SnapshotTrendRow,
} from "../../lib/datasets/snapshotTrendsView.js"

interface Props {
  result: SnapshotHistoryReadResult
}

const { result } = Astro.props as Props
const view = buildSnapshotTrendViewModel(result)

function formatDate(value: string): string {
  const date = new Date(value)
  return Number.isNaN(date.valueOf())
    ? value
    : new Intl.DateTimeFormat("en-GB", { dateStyle: "medium", timeZone: "UTC" }).format(date)
}

function formatValue(value: number | null): string {
  return value === null ? "—" : value.toLocaleString("en-GB")
}

function formatEntityValue(value: unknown): string {
  if (value === null || value === undefined) return "—"
  if (typeof value === "number") return Number.isFinite(value) ? value.toLocaleString("en-GB") : "—"
  if (typeof value === "boolean") return value ? "Yes" : "No"
  if (typeof value === "string") return value
  const serialised = JSON.stringify(value)
  if (!serialised) return "—"
  return serialised.length > 96 ? `${serialised.slice(0, 93)}…` : serialised
}

function formatDelta(value: number | null): string {
  if (value === null) return "—"
  return `${value > 0 ? "+" : ""}${value.toLocaleString("en-GB")}`
}

function metricAnchor(row: SnapshotTrendRow, index: number): string {
  const safeId = row.id.toLowerCase().replace(/[^a-z0-9]+/gu, "-").replace(/^-+|-+$/gu, "") || "metric"
  return `trend-metric-${index}-${safeId}`
}

function directionLabel(row: SnapshotTrendRow): string {
  if (row.direction === "increase") return "Increased"
  if (row.direction === "decrease") return "Decreased"
  if (row.direction === "unchanged") return "Unchanged"
  if (row.direction === "added") return "Added"
  return "Removed"
}

function entityDirectionLabel(row: SnapshotTrendEntityRow): string {
  if (row.direction === "changed") return "Changed"
  if (row.direction === "unchanged") return "Unchanged"
  if (row.direction === "added") return "Added"
  return "Removed"
}

function entityAnchor(domain: string, row: SnapshotTrendEntityRow, index: number): string {
  const safeId = row.id.toLowerCase().replace(/[^a-z0-9]+/gu, "-").replace(/^-+|-+$/gu, "") || "entity"
  return `trend-${domain}-${index}-${safeId}`
}

function entityFields(row: SnapshotTrendEntityRow): readonly string[] {
  const values = row.current ?? row.baseline
  if (!values) return []
  const preferred = row.changedFields.length > 0 ? row.changedFields : Object.keys(values).slice(0, 3)
  return preferred.slice(0, 3)
}

function entityValueSummary(row: SnapshotTrendEntityRow, side: "baseline" | "current"): string {
  const values = side === "baseline" ? row.baseline : row.current
  if (!values) return "—"
  const fields = entityFields(row)
  if (fields.length === 0) return "—"
  return fields.map((field) => `${field}: ${formatEntityValue(values[field])}`).join(" · ")
}

function evidenceEntries(row: SnapshotTrendEntityRow, side: "baseline" | "current"): readonly string[] {
  const shards = side === "baseline" ? row.baselineShards : row.currentShards
  const records = side === "baseline" ? row.baselineRecords : row.currentRecords
  if (records.length === 0) return []
  const shardLabel = shards.length > 0 ? `${shards.join(", ")} · ` : ""
  return records.map((record) => `${shardLabel}${record}`)
}

function entityChangedCount(rows: readonly SnapshotTrendEntityRow[]): number {
  return rows.filter((row) => row.direction !== "unchanged").length
}

const entityDomainLabels = {
  components: "Components",
  hotspots: "Hotspots",
  controls: "Controls",
  ownership: "Ownership",
} as const

function coverageDetails(side: SnapshotTrendProjectSide): string {
  const details: string[] = []
  if (side.missingDomains.length > 0) {
    details.push(`not emitted: ${side.missingDomains.map((domain) => entityDomainLabels[domain]).join(", ")}`)
  }
  if (side.emptyDomains.length > 0) {
    details.push(`empty: ${side.emptyDomains.map((domain) => entityDomainLabels[domain]).join(", ")}`)
  }
  return details.length > 0 ? details.join(" · ") : "all lenses populated"
}

function entityDisplayRows(rows: readonly SnapshotTrendEntityRow[], limit = 60): readonly SnapshotTrendEntityRow[] {
  const changed = rows.filter((row) => row.direction !== "unchanged")
  const unchanged = rows.filter((row) => row.direction === "unchanged")
  return [...changed, ...unchanged].slice(0, limit)
}

const statusLabel = view.status === "missing" ? "History unavailable" : view.status === "invalid" ? "History invalid" : "Comparison rejected"
---

{view.status === "compatible" ? (
  <section class="trends-panel" data-trends-status="compatible" aria-labelledby="snapshot-trends-title">
    <header class="trends-panel-header">
      <div>
        <p class="trends-eyebrow">Canonical snapshot comparison</p>
        <h2 id="snapshot-trends-title">Latest movement</h2>
        <p>{view.message} Every row stays tied to its snapshot and <code>metrics.json</code> record.</p>
      </div>
      <span class="trends-count">{view.project.movement.totalChanged} changed · {view.project.current.metricCount} metrics · {view.project.current.entityCount} entities</span>
    </header>

    <div class="snapshot-strip" aria-label="Compared snapshots">
      <article class="snapshot-card" id="snapshot-baseline">
        <p class="snapshot-role">Baseline</p>
        <a href="#trend-metrics" class="snapshot-date">{formatDate(view.baseline.generatedAt)}</a>
        <code title={view.baseline.snapshotId}>{view.baseline.snapshotId}</code>
        <span>Source directory <code>{view.baseline.relativeDataDir}</code></span>
      </article>
      <span class="snapshot-arrow" aria-hidden="true">→</span>
      <article class="snapshot-card snapshot-card--current" id="snapshot-current">
        <p class="snapshot-role">Current</p>
        <a href="#trend-metrics" class="snapshot-date">{formatDate(view.current.generatedAt)}</a>
        <code title={view.current.snapshotId}>{view.current.snapshotId}</code>
        <span>Source directory <code>{view.current.relativeDataDir}</code></span>
      </article>
    </div>

    <section class="project-rollup" id="trend-project" data-coverage-status={view.project.coverage.status} aria-labelledby="trend-project-title">
      <header class="project-rollup-header">
        <div>
          <p class="trends-eyebrow">Project roll-up</p>
          <h3 id="trend-project-title">What changed at a glance</h3>
          <p>Aggregate movement across the project-level metrics and entity lenses. Counts remain derived from the compared canonical snapshots.</p>
        </div>
        <span class={`coverage-status coverage-status--${view.project.coverage.status}`}>{view.project.coverage.status} coverage</span>
      </header>

      <div class="project-rollup-grid">
        <article class="project-rollup-card">
          <span>Material movement</span>
          <strong>{view.project.movement.totalChanged.toLocaleString("en-GB")}</strong>
          <small>{view.project.movement.metricChanged.toLocaleString("en-GB")} metrics · {view.project.movement.entityChanged.toLocaleString("en-GB")} entities · {(
            view.project.movement.metricAdded + view.project.movement.entityAdded
          ).toLocaleString("en-GB")} added · {(
            view.project.movement.metricRemoved + view.project.movement.entityRemoved
          ).toLocaleString("en-GB")} removed</small>
        </article>
        <article class="project-rollup-card">
          <span>Baseline footprint</span>
          <strong>{(view.project.baseline.metricCount + view.project.baseline.entityCount).toLocaleString("en-GB")}</strong>
          <small>{view.project.baseline.metricCount.toLocaleString("en-GB")} metrics · {view.project.baseline.entityCount.toLocaleString("en-GB")} entities</small>
        </article>
        <article class="project-rollup-card project-rollup-card--current">
          <span>Current footprint</span>
          <strong>{(view.project.current.metricCount + view.project.current.entityCount).toLocaleString("en-GB")}</strong>
          <small>{view.project.current.metricCount.toLocaleString("en-GB")} metrics · {view.project.current.entityCount.toLocaleString("en-GB")} entities</small>
        </article>
      </div>

      <div class="coverage-notice" data-coverage-status={view.project.coverage.status} aria-label="Snapshot data coverage">
        <div>
          <p class="coverage-notice-title">Evidence coverage</p>
          <p>{view.project.coverage.caveat}</p>
        </div>
        <div class="coverage-sides">
          <p><strong>Baseline</strong><span>{view.project.baseline.entityCount.toLocaleString("en-GB")} entity records · {coverageDetails(view.project.baseline)}</span></p>
          <p><strong>Current</strong><span>{view.project.current.entityCount.toLocaleString("en-GB")} entity records · {coverageDetails(view.project.current)}</span></p>
        </div>
      </div>
    </section>

    <div class="trends-table-wrap" id="trend-metrics">
      <table class="trends-table">
        <caption>Metric movement between the two latest canonical snapshots</caption>
        <thead>
          <tr>
            <th scope="col">Metric</th>
            <th scope="col">Baseline</th>
            <th scope="col">Current</th>
            <th scope="col">Movement</th>
            <th scope="col">Evidence</th>
          </tr>
        </thead>
        <tbody>
          {view.rows.map((row, index) => {
            const anchor = metricAnchor(row, index)
            return (
              <tr id={anchor} data-trend-direction={row.direction}>
                <th scope="row"><code>{row.id}</code></th>
                <td class="numeric">{formatValue(row.baseline)}</td>
                <td class="numeric">{formatValue(row.current)}</td>
                <td>
                  <span class={`trend-direction trend-direction--${row.direction}`}>
                    {directionLabel(row)}{row.delta === null ? "" : ` (${formatDelta(row.delta)})`}
                  </span>
                </td>
                <td class="evidence-cell">
                  {row.baselineRecord ? <a href={`#${anchor}`} aria-label={`${row.id} baseline record`}>Baseline <code>{row.baselineRecord}</code></a> : null}
                  {row.currentRecord ? <a href={`#${anchor}`} aria-label={`${row.id} current record`}>Current <code>{row.currentRecord}</code></a> : null}
                </td>
              </tr>
            )
          })}
        </tbody>
      </table>
    </div>

    {view.entitySections?.map((section) => {
      const sectionChanged = entityChangedCount(section.rows)
      const displayRows = entityDisplayRows(section.rows)
      const hiddenCount = section.rows.length - displayRows.length
      const sectionId = "trend-entities-" + section.domain
      return (
        <section class="entity-section" id={sectionId} data-entity-domain={section.domain} aria-labelledby={sectionId + "-title"}>
          <header class="entity-section-header">
            <div>
              <p class="trends-eyebrow">Entity lens</p>
              <h3 id={sectionId + "-title"}>{section.label}</h3>
              <p>
                {section.status === "compatible"
                  ? sectionChanged + " changed · " + section.rows.length + " tracked. " + (hiddenCount > 0 ? "Showing " + displayRows.length + " priority rows; unchanged and lower-priority rows stay in the canonical snapshot." : "Values are compacted for scanning.") + " Evidence stays linked to canonical JSON records."
                  : section.message}
              </p>
            </div>
            <span class={"entity-status entity-status--" + section.status}>{section.status === "compatible" ? "Compared" : "Unavailable"}</span>
          </header>

          {section.status === "compatible" && section.rows.length > 0 ? (
            <details class="entity-details" open={section.domain === "components"}>
              <summary>{section.domain === "components" ? "Inspect component movement" : "Inspect " + section.label.toLowerCase() + " movement"}</summary>
              <div class="trends-table-wrap">
                <table class="trends-table entity-table">
                  <caption>{section.label} movement between the two latest canonical snapshots</caption>
                  <thead>
                    <tr>
                      <th scope="col">{section.domain === "ownership" ? "Contributor" : "Entity"}</th>
                      <th scope="col">Baseline</th>
                      <th scope="col">Current</th>
                      <th scope="col">Movement</th>
                      <th scope="col">Evidence</th>
                    </tr>
                  </thead>
                  <tbody>
                    {displayRows.map((row, index) => {
                      const anchor = entityAnchor(section.domain, row, index)
                      const baselineEvidence = evidenceEntries(row, "baseline")
                      const currentEvidence = evidenceEntries(row, "current")
                      return (
                        <tr id={anchor} data-trend-direction={row.direction}>
                          <th scope="row"><code>{row.id}</code></th>
                          <td class="entity-value">{entityValueSummary(row, "baseline")}</td>
                          <td class="entity-value">{entityValueSummary(row, "current")}</td>
                          <td>
                            <span class={"trend-direction trend-direction--" + row.direction}>
                              {entityDirectionLabel(row)}
                              {row.direction === "changed" && row.changedFields.length > 0 ? " · " + row.changedFields.join(", ") : ""}
                            </span>
                          </td>
                          <td class="evidence-cell">
                            {baselineEvidence.map((evidence) => <a href={"#" + anchor} aria-label={row.id + " baseline record"}>Baseline <code>{evidence}</code></a>)}
                            {currentEvidence.map((evidence) => <a href={"#" + anchor} aria-label={row.id + " current record"}>Current <code>{evidence}</code></a>)}
                          </td>
                        </tr>
                      )
                    })}
                  </tbody>
                </table>
              </div>
            </details>
          ) : (
            <p class="entity-empty">{section.status === "compatible" ? "No " + section.label.toLowerCase() + " records were present in either snapshot." : "This lens will appear when both snapshots expose the canonical shard."}</p>
          )}
        </section>
      )
    })}
  </section>
) : (
  <section class="trends-panel trends-panel--state" data-trends-status={view.status} aria-labelledby="snapshot-trends-state-title">
    <p class="trends-eyebrow">{statusLabel}</p>
    <h2 id="snapshot-trends-state-title">
      {view.status === "missing" ? "No comparable snapshot history yet." : "Snapshot history cannot be compared."}
    </h2>
    <p>{view.message}</p>
    {view.status === "missing" ? (
      <p class="trends-hint">
        Add a <code>snapshot-history.json</code> manifest beside the report data directory with at least two canonical v2 snapshot directories.
      </p>
    ) : null}
  </section>
)}

<style>
  .trends-panel {
    display: grid;
    gap: 1.25rem;
    padding: 1.25rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-card);
  }

  .trends-panel-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--color-border);
  }

  .trends-panel-header h2,
  .trends-panel--state h2 {
    margin: 0;
    font-family: var(--font-heading-stack);
    font-size: clamp(1.35rem, 3vw, 2rem);
    letter-spacing: -0.03em;
  }

  .trends-panel-header p:last-child,
  .trends-panel--state > p:not(.trends-eyebrow):not(.trends-hint) {
    max-width: 48rem;
    margin: 0.5rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.86rem;
    line-height: 1.55;
  }

  .trends-eyebrow,
  .snapshot-role {
    margin: 0 0 0.35rem;
    color: var(--color-accent-strong);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .trends-count {
    flex: 0 0 auto;
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.7rem;
    font-weight: 700;
    white-space: nowrap;
  }

  .snapshot-strip {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: stretch;
    gap: 0.75rem;
  }

  .snapshot-card {
    display: grid;
    gap: 0.3rem;
    min-width: 0;
    padding: 0.85rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted, color-mix(in srgb, var(--color-card) 82%, var(--color-border)));
  }

  .snapshot-card--current {
    border-color: var(--color-accent);
    box-shadow: inset 3px 0 var(--color-accent);
  }

  .snapshot-card code {
    overflow: hidden;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .snapshot-card > span {
    color: var(--color-text-muted);
    font-size: 0.7rem;
  }

  .snapshot-card > span code {
    color: var(--color-text-secondary);
  }

  .snapshot-date {
    color: var(--color-text);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
  }

  .snapshot-date:hover,
  .evidence-cell a:hover {
    color: var(--color-accent-strong);
    text-decoration: underline;
  }

  .snapshot-arrow {
    align-self: center;
    color: var(--color-accent-strong);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .trends-table-wrap {
    overflow-x: auto;
  }

  .trends-table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.78rem;
  }

  .trends-table caption {
    margin-bottom: 0.6rem;
    color: var(--color-text-muted);
    font-size: 0.7rem;
    text-align: left;
  }

  .trends-table th,
  .trends-table td {
    padding: 0.7rem 0.55rem;
    border-top: 1px solid var(--color-border);
    text-align: left;
    vertical-align: top;
  }

  .trends-table thead th {
    color: var(--color-text-muted);
    font-size: 0.64rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .trends-table tbody th {
    color: var(--color-text);
    font-weight: 600;
  }

  .trends-table tbody tr:target {
    background: var(--color-accent-soft);
  }

  .project-rollup {
    display: grid;
    gap: 0.85rem;
    padding: 1rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted, color-mix(in srgb, var(--color-card) 88%, var(--color-border)));
  }

  .project-rollup-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .project-rollup-header h3 {
    margin: 0;
    font-family: var(--font-heading-stack);
    font-size: 1.05rem;
    letter-spacing: -0.02em;
  }

  .project-rollup-header p:last-child {
    max-width: 52rem;
    margin: 0.35rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .coverage-status {
    flex: 0 0 auto;
    padding: 0.28rem 0.45rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .coverage-status--complete {
    border-color: color-mix(in srgb, #15803d 42%, var(--color-border));
    color: #15803d;
  }

  .coverage-status--partial {
    border-color: color-mix(in srgb, #a16207 42%, var(--color-border));
    color: #a16207;
  }

  .coverage-status--unavailable {
    border-color: color-mix(in srgb, #b91c1c 42%, var(--color-border));
    color: #b91c1c;
  }

  .project-rollup-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.65rem;
  }

  .project-rollup-card {
    display: grid;
    gap: 0.18rem;
    padding: 0.7rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .project-rollup-card--current {
    border-color: var(--color-accent);
    box-shadow: inset 3px 0 var(--color-accent);
  }

  .project-rollup-card span,
  .project-rollup-card small {
    color: var(--color-text-muted);
    font-size: 0.68rem;
  }

  .project-rollup-card strong {
    color: var(--color-text);
    font-size: 1.15rem;
    font-variant-numeric: tabular-nums;
  }

  .coverage-notice {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 1rem;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    background: var(--color-card);
  }

  .coverage-notice-title {
    margin: 0;
    color: var(--color-text);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .coverage-notice > div:first-child p:last-child {
    margin: 0.28rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    line-height: 1.45;
  }

  .coverage-sides {
    display: grid;
    gap: 0.38rem;
  }

  .coverage-sides p {
    display: grid;
    gap: 0.12rem;
    margin: 0;
    color: var(--color-text-secondary);
    font-size: 0.68rem;
    line-height: 1.4;
  }

  .coverage-sides strong {
    color: var(--color-text);
    font-size: 0.66rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .entity-section {
    display: grid;
    gap: 0.85rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--color-border);
  }

  .entity-section-header {
    display: flex;
    align-items: start;
    justify-content: space-between;
    gap: 1rem;
  }

  .entity-section-header h3 {
    margin: 0;
    font-family: var(--font-heading-stack);
    font-size: 1.1rem;
    letter-spacing: -0.02em;
  }

  .entity-section-header p:last-child {
    max-width: 52rem;
    margin: 0.35rem 0 0;
    color: var(--color-text-secondary);
    font-size: 0.76rem;
    line-height: 1.5;
  }

  .entity-status {
    flex: 0 0 auto;
    padding: 0.25rem 0.45rem;
    border: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .entity-status--compatible {
    border-color: color-mix(in srgb, #15803d 42%, var(--color-border));
    color: #15803d;
  }

  .entity-details {
    border: 1px solid var(--color-border);
    background: var(--color-surface-muted, color-mix(in srgb, var(--color-card) 90%, var(--color-border)));
  }

  .entity-details > summary {
    cursor: pointer;
    padding: 0.65rem 0.75rem;
    color: var(--color-text-secondary);
    font-size: 0.72rem;
    font-weight: 700;
    list-style-position: inside;
  }

  .entity-details[open] > summary {
    border-bottom: 1px solid var(--color-border);
  }

  .entity-table {
    font-size: 0.72rem;
  }

  .entity-table th,
  .entity-table td {
    padding-block: 0.58rem;
  }

  .entity-value {
    max-width: 20rem;
    color: var(--color-text-secondary);
    line-height: 1.45;
  }

  .entity-empty {
    margin: 0;
    padding: 0.7rem 0.8rem;
    border: 1px dashed var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.76rem;
  }

  .numeric {
    color: var(--color-text-secondary);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .trend-direction {
    display: inline-flex;
