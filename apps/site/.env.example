# Copy to .env for local development.
# Prefer absolute paths to avoid cwd ambiguity.

# Named dataset selection for local development.
# Recommended for keeping multiple reusable datasets under the repo root.
# PLANETNIK_DATASETS_ROOT=/Users/alan/Projects/planetnik/datasets
# PLANETNIK_DATASET=effect-ts

# Single-repository analysis data directory
# Run `planetnik init && planetnik extractGitHistory && planetnik generateReports` on a target repo first
# PLANETNIK_DATA_DIR=/absolute/path/to/repo/_planetnik/reports/data

# Landscape (multi-repo) analysis data directory
# Run `planetnik analyzeLandscape --config landscape-config.json --outputFolder ./datasets/effect-ts`
# PLANETNIK_LANDSCAPE_DATA_DIR=/Users/alan/Projects/planetnik/datasets/effect-ts/_planetnik_landscape/reports/data

# CopilotKit runtime URL for the Intelligence chat interface
PUBLIC_COPILOT_RUNTIME_URL=http://localhost:4111/api/copilotkit
