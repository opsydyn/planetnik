{
  "$schema": "https://biomejs.dev/schemas/2.6.2/schema.json",
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noStaticOnlyClass": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useNodejsImportProtocol": "off"
      }
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded"
    }
  },
  "files": {
    "includes": [
      "biome.json",
      "knip.json",
      "package.json",
      "tsconfig.base.json",
      "packages/**/*.json",
      "packages/**/*.ts",
      "packages/**/*.tsx",
      "apps/**/*.json",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "!apps/**/*.open-api.json",
      "!apps/**/*.astro",
      "!apps/**/dist"
    ]
  },
  "overrides": [
    {
      "includes": ["apps/site/src/components/charts/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "noStaticElementInteractions": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/site/src/components/coupling/**/*.tsx"],
      "linter": {
        "rules": {
          "a11y": {
            "useSemanticElements": "off"
          }
        }
      }
    },
    {
      "includes": ["apps/site/src/components/charts/HorizontalBarChart.tsx"],
      "linter": {
        "rules": {
          "security": {
            "noDangerouslySetInnerHtml": "off"
          }
        }
      }
    }
  ]
}
