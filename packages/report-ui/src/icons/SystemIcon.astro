---
import {
	SystemIcon as ReactSystemIcon,
	type SystemIconName,
} from "./SystemIcon";

interface Props {
	name: SystemIconName;
	size?: number | string;
	title?: string;
	class?: string;
	decorative?: boolean;
}

const {
	name,
	size = 18,
	title,
	class: className,
	decorative = !title,
} = Astro.props;
---

<ReactSystemIcon
	name={name}
	size={size}
	title={title}
	className={className}
	aria-hidden={decorative ? true : undefined}
	aria-label={decorative ? undefined : title}
	role={decorative ? undefined : "img"}
/>
