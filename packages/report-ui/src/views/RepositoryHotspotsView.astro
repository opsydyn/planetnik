---
import DistributionChart from "../charts/DistributionChart";
import DonutChart from "../charts/DonutChart";
import HorizontalBarChart from "../charts/HorizontalBarChart";
import ReportDataGrid from "../tables/ReportDataGrid";
import type { GridRow } from "../tables/ReportDataGrid.types";

interface MetricCard {
	readonly label: string;
	readonly value: string;
	readonly detail?: string | null;
	readonly accentColor?: string;
}

interface DonutItem {
	readonly label: string;
	readonly value: number;
}

interface DistributionItem {
	readonly label: string;
	readonly value: number;
	readonly detail: string;
}

interface ChartItem {
	readonly label: string;
	readonly value: number;
}

interface Props {
	heading: string;
	subtitle: string;
	backHref?: string;
	backLabel?: string;
	cards: ReadonlyArray<MetricCard>;
	severityData: ReadonlyArray<DonutItem>;
	severityColors: ReadonlyArray<string>;
	kindData: ReadonlyArray<DistributionItem>;
	dominantDimensionData: ReadonlyArray<DistributionItem>;
	topHotspotData: ReadonlyArray<ChartItem>;
	hotspotRows: ReadonlyArray<GridRow>;
}

const {
	heading,
	subtitle,
	backHref,
	backLabel = "Back to repository",
	cards,
	severityData,
	severityColors,
	kindData,
	dominantDimensionData,
	topHotspotData,
	hotspotRows,
} = Astro.props as Props;

const severityHelpText =
	"Shows the severity breakdown across all ranked hotspots. Critical and High items represent structural pressure that is large enough to affect delivery safety if left unaddressed.";
const byKindHelpText =
	"Splits hotspots into files, units, and components. Unit-heavy distributions often point to extraction opportunities; component-heavy distributions may indicate boundary problems.";
const dominantRiskHelpText =
	"Shows which risk type is driving the most hotspots. Coordination-led clusters usually require team-level interventions; structural-risk clusters usually respond to refactoring.";
const topItemsHelpText =
	"Ranks the highest-scored hotspots directly. Start with the top items when looking for the fastest structural improvement opportunities in this repository.";
---

{backHref ? (
	<a class="back-link" href={backHref}>&larr; {backLabel}</a>
) : null}

<header class="page-header">
	<div>
		<h2>{heading}</h2>
		<p class="subtitle">{subtitle}</p>
	</div>
</header>

{hotspotRows.length === 0 ? (
	<div class="empty">
		<p>No hotspot data exported for this repository yet.</p>
		<p class="hint">Generate reports with the latest Planetnik CLI to produce <code>hotspots.json</code>.</p>
	</div>
) : (
	<>
		<section class="stats-grid">
			{cards.map((card) => (
				<article class="stat-card">
					<div class="stat-value" style={card.accentColor ? `color: ${card.accentColor}` : ""}>{card.value}</div>
					<div class="stat-label">{card.label}</div>
					{card.detail ? <div class="stat-detail">{card.detail}</div> : null}
				</article>
			))}
		</section>

		{severityData.length > 1 && (
			<section class="chart-section">
				<h3>Severity Mix</h3>
				<DonutChart
					client:visible
					data={severityData}
					valueLabel="hotspots"
					helpText={severityHelpText}
					{...(severityColors.length > 0 ? { colors: severityColors } : {})}
				/>
			</section>
		)}

		{kindData.length > 0 && (
			<section class="chart-section">
				<h3>Hotspots by Kind</h3>
				<DistributionChart client:visible data={[...kindData]} helpText={byKindHelpText} />
			</section>
		)}

		{dominantDimensionData.length > 0 && (
			<section class="chart-section">
				<h3>Dominant Risk Type</h3>
				<DistributionChart client:visible data={[...dominantDimensionData]} helpText={dominantRiskHelpText} />
			</section>
		)}

		{topHotspotData.length > 0 && (
			<section class="chart-section">
				<h3>Top Hotspots</h3>
				<HorizontalBarChart client:visible data={topHotspotData} valueLabel="score" helpText={topItemsHelpText} />
			</section>
		)}

		<section class="chart-section">
			<ReportDataGrid
				client:visible
				title="Hotspot Queue"
				description="Search by kind, score, path, component, or reason while keeping the ranked queue above."
				searchPlaceholder="Search hotspot, component, or reason"
				rows={hotspotRows}
				columns={[
					{ field: "name", headerName: "Item", type: "link", hrefField: "href", secondaryField: "parent", minWidth: 320, flex: 1.5, sort: "asc" },
					{ field: "kind", headerName: "Kind", minWidth: 110 },
					{ field: "severity", headerName: "Severity", minWidth: 120 },
					{ field: "score", headerName: "Score", type: "number", minWidth: 100, sort: "desc" },
					{ field: "dominantDimension", headerName: "Primary Risk", minWidth: 170 },
					{ field: "size", headerName: "Size", type: "number", minWidth: 100 },
					{ field: "commits", headerName: "Commits", type: "number", minWidth: 100 },
					{ field: "contributors", headerName: "Contributors", type: "number", minWidth: 120 },
					{ field: "temporalLinks", headerName: "Temporal Links", type: "number", minWidth: 140 },
					{ field: "complexity", headerName: "Complexity", type: "number", minWidth: 110 },
					{ field: "structuralRisk", headerName: "Structural", type: "number", minWidth: 120 },
					{ field: "changePressure", headerName: "Change", type: "number", minWidth: 110 },
					{ field: "coordinationCost", headerName: "Coordination", type: "number", minWidth: 130 },
					{ field: "knowledgeRisk", headerName: "Knowledge", type: "number", minWidth: 120 },
					{ field: "suggestedAction", headerName: "Suggested Action", type: "multiline", minWidth: 280, flex: 1.2 },
					{ field: "reasons", headerName: "Why It Is Hot", type: "multiline", minWidth: 340, flex: 1.6 },
				]}
				paginationPageSize={15}
			/>
		</section>
	</>
)}

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.92rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header {
		margin-bottom: 1.25rem;
	}

	.page-header h2 {
		margin-bottom: 0.25rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin-top: 0.35rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.stat-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 1.25rem;
	}

	.stat-value {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		margin-top: 0.35rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.stat-detail {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		margin-top: 0.35rem;
	}

	.chart-section {
		margin-bottom: 2rem;
	}

	.chart-section h3 {
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
	}

	.empty {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 2rem;
		text-align: center;
	}

	.empty p {
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.hint {
		font-size: 0.85rem;
	}

	code {
		font-family: "SF Mono", "Fira Code", monospace;
		font-size: 0.85em;
		background: var(--color-surface-muted, #f1f5f9);
		padding: 0.15em 0.4em;
		border-radius: var(--radius-inline);
	}

	@media (max-width: 640px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem;
		}

		.stat-card {
			padding: 1rem;
		}

		.stat-value {
			font-size: 1.35rem;
		}
	}
</style>
