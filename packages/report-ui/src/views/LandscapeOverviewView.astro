---
import DonutChart from "../charts/DonutChart";
import type { DonutItem } from "../charts/DonutChart";
import HorizontalBarChart from "../charts/HorizontalBarChart";
import type { HorizontalBarItem } from "../charts/HorizontalBarChart";
import StaticReportTable from "../tables/StaticReportTable.astro";
import { formatReportDate } from "../utils/reportDates.js";

interface MetricCard {
	readonly label: string;
	readonly value: string;
}

interface TopRepositoryRow {
	readonly name: string;
	readonly href?: string;
	readonly mainLinesOfCode: string;
	readonly contributors: string;
	readonly latestCommitDate: string;
}

interface LanguageInventoryRow {
	readonly extension: string;
	readonly repositories: string;
	readonly linesOfCode: string;
	readonly percentage: string;
}

interface Props {
	heading?: string;
	subtitle: string;
	cards: ReadonlyArray<MetricCard>;
	languageMix: ReadonlyArray<DonutItem>;
	largestLanguages: ReadonlyArray<HorizontalBarItem>;
	topRepositories: ReadonlyArray<TopRepositoryRow>;
	languageInventory: ReadonlyArray<LanguageInventoryRow>;
	languageMixHelpText?: string;
	largestLanguagesHelpText?: string;
	mutedNote?: string;
}

const {
	heading = "Landscape Dashboard",
	subtitle,
	cards,
	languageMix,
	largestLanguages,
	topRepositories,
	languageInventory,
	languageMixHelpText,
	largestLanguagesHelpText,
	mutedNote,
} = Astro.props as Props;
---

<h2>{heading}</h2>
<p class="subtitle">{subtitle}</p>

<div class="cards">
	{cards.map((card) => (
		<div class="card">
			<div class="card-value">{card.value}</div>
			<div class="card-label">{card.label}</div>
		</div>
	))}
</div>

{
	languageMix.length > 0 ? (
		<div class="two-up">
			<section class="section">
				<h3>Language Mix</h3>
				<DonutChart
					client:visible
					data={languageMix}
					valueLabel="LOC"
					helpText={languageMixHelpText}
				/>
			</section>

			<section class="section">
				<h3>Largest Languages</h3>
				<HorizontalBarChart
					client:visible
					data={largestLanguages}
					valueLabel="LOC"
					maxItems={10}
					helpText={largestLanguagesHelpText}
				/>
			</section>
		</div>
	) : null
}

<section class="section">
	<h3>Top Repositories</h3>
	<StaticReportTable ariaLabel="Landscape top repositories">
		<thead>
			<tr>
				<th><span>Repository</span></th>
				<th><span>Main LOC</span></th>
				<th><span>Contributors</span></th>
				<th><span>Latest Commit</span></th>
			</tr>
		</thead>
		<tbody>
			{topRepositories.map((repository) => (
				<tr>
					<td>
						{repository.href ? (
							<a class="table-link" href={repository.href}>
								{repository.name}
							</a>
						) : (
							repository.name
						)}
					</td>
					<td class="report-static-table__num">{repository.mainLinesOfCode}</td>
					<td class="report-static-table__num">{repository.contributors}</td>
					<td>{formatReportDate(repository.latestCommitDate)}</td>
				</tr>
			))}
		</tbody>
	</StaticReportTable>
</section>

{
	languageInventory.length > 0 ? (
		<section class="section">
			<h3>Language Inventory</h3>
			<StaticReportTable ariaLabel="Landscape language inventory">
				<thead>
					<tr>
						<th><span>Extension</span></th>
						<th><span>Repositories</span></th>
						<th><span>Lines of Code</span></th>
						<th><span>% of Total</span></th>
					</tr>
				</thead>
				<tbody>
					{languageInventory.map((language) => (
						<tr>
							<td>
								<code class="report-static-table__code">{language.extension}</code>
							</td>
							<td class="report-static-table__num">{language.repositories}</td>
							<td class="report-static-table__num">{language.linesOfCode}</td>
							<td class="report-static-table__num">{language.percentage}</td>
						</tr>
					))}
				</tbody>
			</StaticReportTable>
		</section>
	) : null
}

{
	mutedNote ? (
		<section class="section section-muted">
			<p>{mutedNote}</p>
		</section>
	) : null
}

<style>
	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
		max-width: 72ch;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1.1rem 1.2rem;
	}

	.card-value {
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.card-label {
		margin-top: 0.45rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.section {
		margin-bottom: 1.75rem;
	}

	.section h3 {
		font-size: 1.1rem;
		font-weight: 700;
		margin-bottom: 0.8rem;
	}

	.two-up {
		display: grid;
		gap: 1.25rem;
		margin-bottom: 1rem;
	}

	.section-muted {
		color: var(--color-text-muted);
	}

	.table-link {
		color: inherit;
		text-decoration: none;
		font-weight: 600;
	}

	.table-link:hover {
		text-decoration: underline;
	}

	@media (min-width: 720px) {
		.cards {
			grid-template-columns: repeat(4, minmax(0, 1fr));
		}

		.two-up {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
</style>
