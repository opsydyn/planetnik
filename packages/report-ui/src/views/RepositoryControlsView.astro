---
import type { DistributionItem } from "../charts/DistributionChart";
import DistributionChart from "../charts/DistributionChart";
import DonutChart from "../charts/DonutChart";
import ReportDataGrid from "../tables/ReportDataGrid";
import type { GridRow } from "../tables/ReportDataGrid.types";

interface MetricCard {
	readonly label: string;
	readonly value: string;
	readonly detail?: string | null;
	readonly color?: string;
}

interface DonutItem {
	readonly label: string;
	readonly value: number;
}

interface Props {
	heading: string;
	subtitle: string;
	backHref?: string;
	backLabel?: string;
	cards: ReadonlyArray<MetricCard>;
	statusChartData: ReadonlyArray<DonutItem>;
	statusChartColors: ReadonlyArray<string>;
	goalRows: ReadonlyArray<DistributionItem>;
	controlRows: ReadonlyArray<GridRow>;
}

const {
	heading,
	subtitle,
	backHref,
	backLabel = "Back to repository",
	cards,
	statusChartData,
	statusChartColors,
	goalRows,
	controlRows,
} = Astro.props as Props;

const statusHelpText =
	"Shows how goals and controls are currently passing, failing, or tolerated. Treat failed slices as immediate policy breaks and tolerant slices as emerging debt.";
const goalsHelpText =
	"Shows where controls are concentrated by goal. Goals with many failed or tolerant entries usually need the next round of engineering attention.";
---

{backHref ? (
	<a class="back-link" href={backHref}>&larr; {backLabel}</a>
) : null}

<header class="page-header">
	<div>
		<h2>{heading}</h2>
		<p class="subtitle">{subtitle}</p>
	</div>
</header>

{controlRows.length === 0 ? (
	<div class="empty">
		<p>No goals and controls data exported for this repository yet.</p>
		<p class="hint">Add <code>goalsAndControls</code> to the source configuration to define quality gates and metric thresholds.</p>
	</div>
) : (
	<>
		<section class="stats-grid">
			{cards.map((card) => (
				<article class="stat-card">
					<div class="stat-value" style={card.color ? `color: ${card.color}` : ""}>{card.value}</div>
					<div class="stat-label">{card.label}</div>
					{card.detail ? <div class="stat-detail">{card.detail}</div> : null}
				</article>
			))}
		</section>

		{statusChartData.length > 1 && (
			<section class="chart-section">
				<h3>Control Status</h3>
				<DonutChart
					client:visible
					data={statusChartData}
					valueLabel="controls"
					helpText={statusHelpText}
					{...(statusChartColors.length > 0 ? { colors: statusChartColors } : {})}
				/>
			</section>
		)}

		{goalRows.length > 0 && (
			<section class="chart-section">
				<h3>Goal Coverage</h3>
				<DistributionChart client:visible data={goalRows} helpText={goalsHelpText} />
			</section>
		)}

		{controlRows.length > 0 && (
			<section class="chart-section">
				<h3>Control Inventory</h3>
				<ReportDataGrid
					client:visible
					title="Control Inventory"
					description="Search controls by goal, metric, status, or description while keeping the status summary above."
					searchPlaceholder="Search goal, metric, or status"
					rows={controlRows}
					columns={[
						{ field: "goal", headerName: "Goal", minWidth: 220, flex: 1.1 },
						{ field: "metric", headerName: "Metric", type: "code", minWidth: 220, flex: 1 },
						{ field: "value", headerName: "Value", type: "number", minWidth: 110 },
						{ field: "desiredRange", headerName: "Desired Range", type: "code", minWidth: 150 },
						{ field: "status", headerName: "Status", minWidth: 130, sort: "asc" },
						{ field: "description", headerName: "Description", type: "multiline", minWidth: 260, flex: 1.3 },
					]}
				/>
			</section>
		)}
	</>
)}

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.92rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header {
		margin-bottom: 1.25rem;
	}

	.page-header h2 {
		margin-bottom: 0.25rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		font-size: 0.9rem;
		margin-top: 0.35rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
		gap: 1rem;
		margin-bottom: 2rem;
	}

	.stat-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 1.25rem;
	}

	.stat-value {
		font-size: 1.75rem;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.stat-label {
		font-size: 0.8rem;
		color: var(--color-text-muted);
		margin-top: 0.35rem;
		text-transform: uppercase;
		letter-spacing: 0.04em;
	}

	.stat-detail {
		font-size: 0.75rem;
		color: var(--color-text-muted);
		margin-top: 0.35rem;
	}

	.chart-section {
		margin-bottom: 2rem;
	}

	.chart-section h3 {
		font-size: 1.1rem;
		font-weight: 600;
		margin-bottom: 0.75rem;
	}

	.empty {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 8px;
		padding: 2rem;
		text-align: center;
	}

	.empty p {
		color: var(--color-text-muted);
		margin-bottom: 0.5rem;
	}

	.hint {
		font-size: 0.85rem;
	}

	code {
		font-family: "SF Mono", "Fira Code", monospace;
		font-size: 0.85em;
		background: var(--color-surface-muted, #f1f5f9);
		color: var(--color-text, inherit);
		padding: 0.15em 0.4em;
		border-radius: 3px;
	}

	@media (max-width: 640px) {
		.stats-grid {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.75rem;
		}

		.stat-card {
			padding: 1rem;
		}

		.stat-value {
			font-size: 1.35rem;
		}
	}
</style>
