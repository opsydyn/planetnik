---
import HorizontalBarChart from "../charts/HorizontalBarChart";
import type { HorizontalBarItem } from "../charts/HorizontalBarChart";
import ReportDataGrid from "../tables/ReportDataGrid";
import type { GridRow } from "../tables/ReportDataGrid.types";

interface MetricCard {
	readonly label: string;
	readonly value: string;
}

interface Props {
	heading?: string;
	subtitle: string;
	cards: ReadonlyArray<MetricCard>;
	topTagBars: ReadonlyArray<HorizontalBarItem>;
	rows: ReadonlyArray<GridRow>;
	untaggedRepositories: ReadonlyArray<string>;
	chartHelpText?: string;
	searchPlaceholder?: string;
	emptyHint?: string;
}

const props = Astro.props as Props;

const {
	heading = "Tags",
	subtitle,
	cards,
	topTagBars,
	rows,
	untaggedRepositories,
	chartHelpText,
	searchPlaceholder = "Search tag, group, or repository",
	emptyHint = "Add tagGroups to the landscape configuration to populate this page.",
} = props;
---

<h2>{heading}</h2>
<p class="subtitle">{subtitle}</p>

<div class="cards">
	{cards.map((card) => (
		<div class="card">
			<div class="card-value">{card.value}</div>
			<div class="card-label">{card.label}</div>
		</div>
	))}
</div>

{
	topTagBars.length > 0 ? (
		<>
			<section class="section">
				<h3>Most Used Tags</h3>
				<HorizontalBarChart
					client:visible
					data={topTagBars}
					valueLabel="repositories"
					maxItems={12}
					helpText={chartHelpText}
				/>
			</section>

			<ReportDataGrid
				client:visible
				title="Tag Inventory"
				description="Search tags by group, tag name, or repository."
				searchPlaceholder={searchPlaceholder}
				rows={rows}
				columns={[
					{ field: "group", headerName: "Group", minWidth: 150 },
					{ field: "tag", headerName: "Tag", minWidth: 160 },
					{ field: "repositoryCount", headerName: "Repositories", type: "number", minWidth: 120, sort: "desc" },
					{ field: "totalMainLinesOfCode", headerName: "Main LOC", type: "number", minWidth: 120 },
					{ field: "repositories", headerName: "Repositories", type: "multiline", minWidth: 360, flex: 1.5 },
				]}
			/>
		</>
	) : (
		<div class="empty">
			<p>No landscape tags were exported for this dataset.</p>
			<p class="hint">{emptyHint}</p>
		</div>
	)
}

<section class="section section-muted">
	<h3>Untagged Repositories
		{untaggedRepositories.length > 0 && (
			<span class="untagged-count">{untaggedRepositories.length}</span>
		)}
	</h3>
	{untaggedRepositories.length > 0 ? (
		<div class="untagged-chips">
			{untaggedRepositories.map((name) => (
				<span class="untagged-chip">{name}</span>
			))}
		</div>
	) : (
		<p class="untagged-empty">All repositories are tagged.</p>
	)}
</section>

<style>
	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
		max-width: 72ch;
	}

	.cards {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.9rem;
		margin-bottom: 1.5rem;
	}

	.card,
	.empty {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: var(--radius-card);
		padding: 1.1rem 1.2rem;
	}

	.card-value {
		font-size: 1.9rem;
		font-weight: 700;
		color: var(--color-accent);
		line-height: 1;
	}

	.card-label {
		margin-top: 0.45rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.section {
		margin-bottom: 1.75rem;
	}

	.section h3 {
		display: flex;
		align-items: baseline;
		gap: 0.5rem;
		font-size: 1.1rem;
		font-weight: 700;
		margin-bottom: 0.8rem;
	}

	.section-muted p,
	.hint {
		color: var(--color-text-muted);
	}

	.untagged-count {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.1em 0.5em;
		border-radius: var(--radius-badge);
		background: var(--color-surface-subtle);
		color: var(--color-text-muted);
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.04em;
	}

	.untagged-chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
	}

	.untagged-chip {
		display: inline-block;
		padding: 0.3em 0.65em;
		border: 1px solid var(--color-border);
		border-radius: var(--radius-badge);
		background: var(--color-card);
		color: var(--color-text-muted);
		font-size: 0.8rem;
		font-family: var(--font-mono);
		line-height: 1.4;
		white-space: nowrap;
	}

	.untagged-empty {
		color: var(--color-text-muted);
	}

	@media (max-width: 720px) {
		.cards {
			grid-template-columns: 1fr;
		}
	}
</style>
