---
import TopologyGraph from "../topology/TopologyGraph";

type ContributorImpactDimensionKey =
	| "complexity_reduction"
	| "boundary_shaping"
	| "knowledge_spread"
	| "coordination_relief"
	| "change_enablement";

interface ContributorImpactContributor {
	email: string;
	display_name: string;
	glue_score: number;
	snacking_score: number;
	structural_impact_score: number;
	visible_activity_score: number;
	collaborator_count: number;
	shared_files_count: number;
	commits_count: number;
	files_touched: number;
	components_touched: number;
	dominant_dimension: ContributorImpactDimensionKey;
	dimensions: Record<ContributorImpactDimensionKey, number>;
	top_components: Array<{ name: string; files: number; commits: number }>;
	top_routes: string[];
	reasons: string[];
	is_glue: boolean;
	is_snacking: boolean;
}

type PeopleDep = { from: string; to: string; count: number; files: string[] };

interface Props {
	heading: string;
	subtitle: string;
	backHref?: string;
	periods: Record<string, PeopleDep[]>;
	impactPeriods: Record<string, ContributorImpactContributor[]>;
	contributorHrefBase?: string | null;
	componentsHref?: string | null;
}

const {
	heading,
	subtitle,
	backHref,
	periods,
	impactPeriods,
	contributorHrefBase = null,
	componentsHref = null,
} = Astro.props;
---

<div>
	{backHref ? (
		<a class="back-link" href={backHref}>&larr; Back to {heading}</a>
	) : null}
	<h2>{heading} Topology</h2>
	<p class="subtitle">{subtitle}</p>
	<TopologyGraph
		client:only="react"
		periods={periods}
		impactPeriods={impactPeriods}
		contributorHrefBase={contributorHrefBase}
		componentsHref={componentsHref}
	/>
</div>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.92rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.subtitle {
		color: var(--color-text-muted);
		margin-bottom: 1.5rem;
		font-size: 0.9rem;
	}
</style>
