---
import ReportDataGrid from "../tables/ReportDataGrid";
import type { GridRow } from "../tables/ReportDataGrid.types";

interface MetricCard {
	readonly label: string;
	readonly value: string;
	readonly detail?: string | null;
}

interface ExternalLink {
	readonly label: string;
	readonly href: string;
}

interface Props {
	heading: string;
	subtitle: string;
	backHref?: string;
	backLabel?: string;
	cards: ReadonlyArray<MetricCard>;
	links?: ReadonlyArray<ExternalLink>;
	contributorRows: ReadonlyArray<GridRow>;
}

const props = Astro.props as Props;

const {
	heading,
	subtitle,
	backHref,
	backLabel = "Back to repositories",
	cards,
	links = [],
	contributorRows,
} = props;
---

{backHref ? (
	<a class="back-link" href={backHref}>
		&larr; {backLabel}
	</a>
) : null}

<header class="page-header">
	<div>
		<h2>{heading}</h2>
		<p class="subtitle">{subtitle}</p>
	</div>
	{links.length > 0 ? (
		<div class="link-list">
			{links.map((link) => (
				<a href={link.href} target="_blank" rel="noreferrer">
					{link.label}
				</a>
			))}
		</div>
	) : null}
</header>

<section class="stats-grid">
	{cards.map((card) => (
		<article class="stat-card">
			<div class="stat-value">{card.value}</div>
			<div class="stat-label">{card.label}</div>
			{card.detail ? <div class="stat-detail">{card.detail}</div> : null}
		</article>
	))}
</section>

<ReportDataGrid
	client:visible
	title="Repository Contributors"
	description="Drill into the contributors active in this repository and open their repo-scoped detail pages."
	searchPlaceholder="Search contributor or impact signal"
	rows={contributorRows}
	columns={[
		{ field: "contributor", headerName: "Contributor", type: "link", hrefField: "href", secondaryField: "email", minWidth: 240, flex: 1.3, sort: "asc" },
		{ field: "type", headerName: "Type", minWidth: 100 },
		{ field: "commitsCount", headerName: "Commits", type: "number", minWidth: 110, sort: "desc" },
		{ field: "commits30d", headerName: "Commits (30d)", type: "number", minWidth: 130 },
		{ field: "commits90d", headerName: "Commits (90d)", type: "number", minWidth: 130 },
		{ field: "glueScore", headerName: "Glue Score", minWidth: 120 },
		{ field: "structuralImpact", headerName: "Structural Impact", minWidth: 150 },
		{ field: "snackRisk", headerName: "Snack Risk", minWidth: 120 },
		{ field: "signal", headerName: "Signal", minWidth: 180 },
		{ field: "firstCommitDate", headerName: "First Commit", type: "date", minWidth: 130 },
		{ field: "latestCommitDate", headerName: "Latest Commit", type: "date", minWidth: 130 },
	]}
/>

<style>
	.back-link {
		display: inline-block;
		margin-bottom: 1rem;
		color: var(--color-text-muted);
		text-decoration: none;
		font-size: 0.92rem;
	}

	.back-link:hover {
		color: var(--color-accent);
	}

	.page-header {
		display: flex;
		justify-content: space-between;
		align-items: flex-start;
		gap: 1rem;
		margin-bottom: 1.25rem;
	}

	.subtitle {
		color: var(--color-text-muted);
		max-width: 70ch;
		margin-top: 0.35rem;
	}

	.link-list {
		display: flex;
		flex-wrap: wrap;
		justify-content: flex-end;
		gap: 0.65rem;
	}

	.link-list a {
		color: var(--color-accent);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.stats-grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
		gap: 1rem;
		margin-bottom: 1.5rem;
	}

	.stat-card {
		background: var(--color-card);
		border: 1px solid var(--color-border);
		border-radius: 16px;
		padding: 1rem 1.1rem;
	}

	.stat-value {
		font-size: 2rem;
		font-weight: 700;
		line-height: 1.05;
		color: var(--color-text);
	}

	.stat-label {
		margin-top: 0.45rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.05em;
	}

	.stat-detail {
		margin-top: 0.55rem;
		color: var(--color-text-muted);
		font-size: 0.92rem;
	}

	@media (max-width: 720px) {
		.page-header {
			flex-direction: column;
		}

		.link-list {
			justify-content: flex-start;
		}
	}
</style>
